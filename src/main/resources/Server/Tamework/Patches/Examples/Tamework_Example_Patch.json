{
  "Id": "Tamework_Example_Patch",
  "Target": "Server/NPC/Roles/_Core/Templates/Tamework_Example_Patch.json",
  "Priority": 0,
  "Enabled": true,
  "Operations": [
    {
      "Id": "merge-tamework-parameters",
      "Op": "Merge",
      "Path": "/Parameters",
      "Value": {
        "MasterTargetSlot": {
          "Value": "MasterTarget",
          "Description": "Target slot used to store the owner/master."
        },
        "SpawnerEmptyItemID": {
          "Value": [
            "Spawner_Tamework_Example"
          ],
          "TypeHint": "String",
          "Description": "Item IDs that can pick up this NPC."
        },
        "CanFollow": {
          "Value": true,
          "Description": "Whether command-driven Follow behavior is enabled for this role."
        },
        "CanHold": {
          "Value": true,
          "Description": "Whether command-driven Hold behavior is enabled for this role."
        },
        "CanDefend": {
          "Value": true,
          "Description": "Whether Defend state behavior is enabled for this role."
        },
        "CanAttackTarget": {
          "Value": true,
          "Description": "Whether Attack Target commands are allowed to drive this role into Defend behavior."
        },
        "CanMoveToLocation": {
          "Value": true,
          "Description": "Whether Move To Location command behavior is enabled for this role."
        },
        "CanReturnHome": {
          "Value": true,
          "Description": "Whether Return Home command behavior is enabled for this role."
        },
        "CanRecall": {
          "Value": true,
          "Description": "Whether Recall command behavior is enabled for this role."
        },
        "CanSetHome": {
          "Value": true,
          "Description": "Whether Set Home should be considered available for this role."
        },
        "CanBreedPair": {
          "Value": true,
          "Description": "Whether breeding pair approach behavior is enabled for this role."
        },
        "TestTameItemsParam": {
          "Value": [
            "Plant_Fruit_Apple"
          ],
          "TypeHint": "String",
          "Description": "Items accepted by the example Tame interaction."
        },
        "TestFeedItemsParam": {
          "Value": [
            "Plant_Fruit_Apple"
          ],
          "TypeHint": "String",
          "Description": "Items accepted by the example Feed interaction."
        }
      }
    },
    {
      "Id": "sleep-transitions",
      "Op": "Insert",
      "Path": "/StateTransitions",
      "Position": "After",
      "Find": {
        "$Comment": "Patch anchor: state transitions"
      },
      "Existing": {
        "$Comment": "Tamework patch: sleep transitions"
      },
      "Value": {
        "$Comment": "Tamework patch: sleep transitions",
        "States": [
          {
            "From": [
              "Idle",
              "Hold"
            ],
            "To": [
              "Sleep"
            ]
          },
          {
            "From": [
              "Sleep"
            ],
            "To": [
              "Idle",
              "Hold",
              "Defend"
            ]
          }
        ],
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Status"
          }
        ]
      }
    },
    {
      "Id": "follow-hold-transitions",
      "Op": "Insert",
      "Path": "/StateTransitions",
      "Position": "After",
      "Find": {
        "$Comment": "Tamework patch: sleep transitions"
      },
      "Existing": {
        "$Comment": "Tamework patch: follow/hold transitions"
      },
      "Value": {
        "$Comment": "Tamework patch: follow/hold transitions",
        "States": [
          {
            "From": [],
            "To": [
              "Follow",
              "Hold",
              "CommandMove",
              "Defend",
              "BreedPair",
              "NeedsSeekWater",
              "NeedsSeekFood"
            ]
          }
        ],
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Status"
          }
        ]
      }
    },
    {
      "Id": "return-idle-transition",
      "Op": "Insert",
      "Path": "/StateTransitions",
      "Position": "After",
      "Find": {
        "$Comment": "Tamework patch: follow/hold transitions"
      },
      "Existing": {
        "$Comment": "Tamework patch: return to idle"
      },
      "Value": {
        "$Comment": "Tamework patch: return to idle",
        "States": [
          {
            "From": [
              "Follow",
              "Hold",
              "CommandMove",
              "Defend",
              "BreedPair",
              "NeedsSeekWater",
              "NeedsSeekFood"
            ],
            "To": [
              "Idle"
            ]
          }
        ],
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Status"
          }
        ]
      }
    },
    {
      "Id": "command-move",
      "Op": "Insert",
      "Path": "/Instructions",
      "Position": "After",
      "Find": {
        "$Comment": "Patch anchor: command behaviors"
      },
      "Existing": {
        "$Comment": "Tamework patch: command move bridge"
      },
      "Value": {
        "$Comment": "Tamework patch: command move bridge",
        "Enabled": {
          "Compute": "CanMoveToLocation || CanReturnHome"
        },
        "Continue": true,
        "Sensor": {
          "Type": "Any"
        },
        "Instructions": [
          {
            "Reference": "Component_Tamework_Instruction_Command_Move",
            "Modify": {
              "_ExportStates": [
