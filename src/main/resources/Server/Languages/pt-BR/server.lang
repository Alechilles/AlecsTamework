tamework.commands.clearOwned.description = Remover permanentemente os companheiros comuns de um jogador.
tamework.commands.clearOwned.usage = Uso: /tw debug clear-owned [self|jogador|UUID] [confirm]
tamework.commands.clearOwned.unknownPlayer = Jogador não encontrado. Use self, o nome de um jogador conectado ou um UUID.
tamework.commands.clearOwned.unavailable = A limpeza de companheiros está indisponível ou falhou. Consulte o registro do servidor.
tamework.commands.clearOwned.preview = Dono {owner}: {count} companheiros comuns podem ser removidos; {skipped} perfis protegidos serão ignorados. Companheiros capturados, em currais, de listas gerenciadas e vinculados não são excluídos. Isso remove permanentemente os animais vivos e as entradas de animais mortos ou perdidos. Execute /tw debug clear-owned {owner} confirm para continuar.
tamework.commands.clearOwned.started = Removendo {count} companheiros comuns de {owner}. Feche o menu de companheiros durante a limpeza.
tamework.commands.clearOwned.completed = Limpeza de {owner}: {cleared} removidos, {skipped} ignorados, {failed} falhas. Animais não carregados serão removidos quando forem carregados novamente. O armazenamento protegido e os companheiros vinculados permanecem inalterados.
tamework.commands.companions.description = Resolver companheiros em itens de captura, em Coop ou perdidos.
tamework.commands.companions.forget.description = Esquecer o companheiro de um jogador que está em um item de captura.
tamework.commands.companions.forget.usage = Uso: /tw companions forget <self|jogador|UUID> <nome ou id do companheiro> [confirm]
tamework.commands.companions.forget.nothingToDo = {name} não está em um item de captura, ou é um companheiro vinculado, então não há nada para esquecer aqui.
tamework.commands.companions.forget.preview = {name} ({id}) de {owner} está em um item de captura. Esquecer solta o companheiro para sempre, libera a vaga do dono e esvazia qualquer cópia restante do item. Execute /tw companions forget {owner} {id} confirm para continuar.
tamework.commands.companions.forget.done = {name} foi esquecido. A vaga de {owner} está livre.
tamework.commands.companions.restore.description = Restaurar ao seu lado o companheiro de um jogador que está em um item de captura, em Coop ou perdido.
tamework.commands.companions.restore.usage = Uso: /tw companions restore <self|jogador|UUID> <nome ou id do companheiro> [confirm]
tamework.commands.companions.restore.nothingToDo = {name} não está em um item de captura, em Coop nem perdido, ou é um companheiro vinculado, então não há nada para restaurar aqui.
tamework.commands.companions.restore.preview = {name} ({id}) de {owner} pode ser restaurado ao seu lado. Qualquer item de captura ou entrada de Coop restante dele deixará de funcionar. Execute /tw companions restore {owner} {id} confirm para continuar.
tamework.commands.companions.restore.noPlacement = Não há um lugar seguro ao seu lado. Vá para um local aberto e tente novamente.
