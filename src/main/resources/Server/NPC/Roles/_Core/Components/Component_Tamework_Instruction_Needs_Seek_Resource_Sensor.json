{
  "Type": "Component",
  "Class": "Instruction",
  "Interface": "Tamework.Instruction.NeedsSeekResourceSensor",
  "DefaultState": ".Listen",
  "Parameters": {
    "_ImportStates": [
      "OnNeedsSeekWaterActive",
      "OnNeedsSeekFoodActive"
    ],
    "NeedsSeekTargetSlot": {
      "Value": "TameworkNeedsSeekTarget",
      "Description": "Stored destination slot used while a needs resource seek is active."
    },
    "NeedsSeekClearTargetSlot": {
      "Value": "TameworkNeedsSeekTransientTarget",
      "Description": "Target slot cleared when starting a needs-seek pass. Keep separate from LockedTarget to avoid clobbering unrelated follow/interaction targets."
    },
    "NeedsSeekWhenHungerBelowRatio": {
      "Value": 0.85,
      "Description": "Start food seeking when normalized hunger is at or below this ratio."
    },
    "NeedsSeekWhenThirstBelowRatio": {
      "Value": 0.85,
      "Description": "Start water seeking when normalized thirst is at or below this ratio."
    },
    "NeedsSeekFoodNearTieBiasRatio": {
      "Value": 0.05,
      "Description": "When hunger and thirst are both low, prefer food if hunger is within this normalized ratio above thirst."
    },
    "NeedsSeekWaterSearchRange": {
      "Value": 16,
      "Description": "Water search radius in blocks."
    },
    "NeedsSeekFoodSearchRange": {
      "Value": 16,
      "Description": "Food-container search radius in blocks."
    },
    "NeedsSeekFoodItemIds": {
      "Value": [],
      "TypeHint": "String",
      "Description": "Allowed food item ids when seeking food containers."
    },
    "NeedsSeekFailedCooldownName": {
      "Value": "NeedsSeek_Failed_Cooldown",
      "Description": "Timer name used to throttle repeated failed seek attempts."
    }
  },
  "Content": {
    "$Comment": "Needs resource sensor pass; emits seek states when needs are low and target sensors resolve.",
    "Continue": true,
    "Sensor": {
      "Type": "Any"
    },
    "Instructions": [
      {
        "$Comment": "No-op listen branch to satisfy local state pairing validation.",
        "Continue": true,
        "Sensor": {
          "Type": "State",
          "State": ".Listen"
        }
      },
      {
        "$Comment": "Prefer food seek when hunger is close to or below thirst and a food target is resolvable.",
        "Continue": false,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".Listen"
            },
            {
              "Type": "TameworkNeedBelow",
              "Need": "Hunger",
              "RatioBelow": {
                "Compute": "NeedsSeekWhenHungerBelowRatio"
              }
            },
            {
              "Type": "TameworkNeedLowest",
              "Need": "Hunger",
              "OtherNeed": "Thirst",
              "AllowedHigherBy": {
                "Compute": "NeedsSeekFoodNearTieBiasRatio"
              }
            },
            {
              "Type": "Timer",
              "Name": {
                "Compute": "NeedsSeekFailedCooldownName"
              },
              "State": "Stopped"
            },
            {
              "Type": "TameworkNeedsResourceTarget",
              "Need": "Hunger",
              "RatioBelow": {
                "Compute": "NeedsSeekWhenHungerBelowRatio"
              },
              "ResourceType": "FoodContainer",
              "Range": {
                "Compute": "NeedsSeekFoodSearchRange"
              },
              "ItemIds": {
                "Compute": "NeedsSeekFoodItemIds"
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "StorePosition",
            "Slot": {
              "Compute": "NeedsSeekTargetSlot"
            }
          },
          {
            "Type": "ReleaseTarget",
            "TargetSlot": {
              "Compute": "NeedsSeekClearTargetSlot"
            }
          },
          {
            "Type": "ParentState",
            "State": "OnNeedsSeekFoodActive"
          }
        ]
      },
      {
        "$Comment": "Prefer water seek when thirst is the lowest active need and a water target is resolvable.",
        "Continue": false,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".Listen"
            },
            {
              "Type": "TameworkNeedBelow",
              "Need": "Thirst",
              "RatioBelow": {
                "Compute": "NeedsSeekWhenThirstBelowRatio"
              }
            },
            {
              "Type": "TameworkNeedLowest",
              "Need": "Thirst",
              "OtherNeed": "Hunger"
            },
            {
              "Type": "Timer",
              "Name": {
                "Compute": "NeedsSeekFailedCooldownName"
              },
              "State": "Stopped"
            },
            {
              "Type": "TameworkNeedsResourceTarget",
              "Need": "Thirst",
              "RatioBelow": {
                "Compute": "NeedsSeekWhenThirstBelowRatio"
              },
              "ResourceType": "Water",
              "Range": {
                "Compute": "NeedsSeekWaterSearchRange"
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "StorePosition",
            "Slot": {
              "Compute": "NeedsSeekTargetSlot"
            }
          },
          {
            "Type": "ReleaseTarget",
            "TargetSlot": {
              "Compute": "NeedsSeekClearTargetSlot"
            }
          },
          {
            "Type": "ParentState",
            "State": "OnNeedsSeekWaterActive"
          }
        ]
      },
      {
        "$Comment": "Fallback water seek when thirst is low and a water target is resolvable.",
        "Continue": false,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".Listen"
            },
            {
              "Type": "TameworkNeedBelow",
              "Need": "Thirst",
              "RatioBelow": {
                "Compute": "NeedsSeekWhenThirstBelowRatio"
              }
            },
            {
              "Type": "Timer",
              "Name": {
                "Compute": "NeedsSeekFailedCooldownName"
              },
              "State": "Stopped"
            },
            {
              "Type": "TameworkNeedsResourceTarget",
              "Need": "Thirst",
              "RatioBelow": {
                "Compute": "NeedsSeekWhenThirstBelowRatio"
              },
              "ResourceType": "Water",
              "Range": {
                "Compute": "NeedsSeekWaterSearchRange"
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "StorePosition",
            "Slot": {
              "Compute": "NeedsSeekTargetSlot"
            }
          },
          {
            "Type": "ReleaseTarget",
            "TargetSlot": {
              "Compute": "NeedsSeekClearTargetSlot"
            }
          },
          {
            "Type": "ParentState",
            "State": "OnNeedsSeekWaterActive"
          }
        ]
      },
      {
        "$Comment": "Fallback food seek when hunger is low and a food container target is resolvable.",
        "Continue": false,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".Listen"
            },
            {
              "Type": "TameworkNeedBelow",
              "Need": "Hunger",
              "RatioBelow": {
                "Compute": "NeedsSeekWhenHungerBelowRatio"
              }
            },
            {
              "Type": "Timer",
              "Name": {
                "Compute": "NeedsSeekFailedCooldownName"
              },
              "State": "Stopped"
            },
            {
              "Type": "TameworkNeedsResourceTarget",
              "Need": "Hunger",
              "RatioBelow": {
                "Compute": "NeedsSeekWhenHungerBelowRatio"
              },
              "ResourceType": "FoodContainer",
              "Range": {
                "Compute": "NeedsSeekFoodSearchRange"
              },
              "ItemIds": {
                "Compute": "NeedsSeekFoodItemIds"
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "StorePosition",
            "Slot": {
              "Compute": "NeedsSeekTargetSlot"
            }
          },
          {
            "Type": "ReleaseTarget",
            "TargetSlot": {
              "Compute": "NeedsSeekClearTargetSlot"
            }
          },
          {
            "Type": "ParentState",
            "State": "OnNeedsSeekFoodActive"
          }
        ]
      }
    ]
  }
}
