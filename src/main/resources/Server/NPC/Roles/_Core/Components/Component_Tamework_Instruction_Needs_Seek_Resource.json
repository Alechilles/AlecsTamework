{
  "Type": "Component",
  "Class": "Instruction",
  "Interface": "Tamework.Instruction.NeedsSeekResourceMove",
  "DefaultState": ".Default",
  "Parameters": {
    "_ImportStates": [
      "OnNeedsSeekComplete"
    ],
    "NeedsSeekTargetSlot": {
      "Value": "TameworkNeedsSeekTarget",
      "Description": "Stored destination slot used while a needs resource seek is active."
    },
    "NeedsSeekActiveTargetSlot": {
      "Value": "TameworkNeedsSeekActiveTarget",
      "Description": "Locked destination slot copied from the planner target when movement starts."
    },
    "NeedsSeekResourceType": {
      "Value": "Auto",
      "Description": "Resource consume mode used at seek completion (Auto, Water, FoodContainer)."
    },
    "NeedsSeekFoodItemIDs": {
      "Value": [],
      "TypeHint": "String",
      "Description": "Optional allowed food item ids passed to consume action for container intake."
    },
    "NeedsSeekWhenHungerBelowRatio": {
      "Value": 0.85,
      "Description": "Repeat food consumption while normalized hunger is at or below this ratio."
    },
    "NeedsSeekWhenThirstBelowRatio": {
      "Value": 0.85,
      "Description": "Repeat water consumption while normalized thirst is at or below this ratio."
    },
    "NeedsSeekSlowDownDistance": {
      "Value": 4,
      "Description": "Distance where needs-seek movement starts slowing down."
    },
    "NeedsSeekConsumeMaintainMinDistance": {
      "Value": 1,
      "Description": "Minimum distance to maintain from consume target before consume can complete."
    },
    "NeedsSeekConsumeMaintainMaxDistance": {
      "Value": 2,
      "Description": "Maximum distance to maintain from consume target before consume can complete."
    },
    "NeedsSeekConsumeStartDistance": {
      "Value": 2.25,
      "Description": "Relaxed arrival distance that starts consume delay when vanilla Seek stops slightly outside the strict maintain band."
    },
    "NeedsSeekConsumeMaintainDistanceRange": {
      "Value": [
        1,
        2
      ],
      "Description": "Desired distance band used by MaintainDistance while recovering consume position."
    },
    "NeedsSeekRelativeSpeed": {
      "Value": 0.75,
      "Description": "Relative movement speed while seeking needs resources."
    },
    "NeedsSeekUsePathfinder": {
      "Value": true,
      "Description": "Use nav pathfinding while moving to a needs resource target."
    },
    "NeedsSeekUseSteering": {
      "Value": true,
      "Description": "Allow vanilla Seek to use simple steering when available while pathfinding remains enabled."
    },
    "NeedsSeekUseBestPath": {
      "Value": false,
      "Description": "Allow partial best-path fallback if a full route cannot be found."
    },
    "NeedsSeekRelaxedMoveConstraints": {
      "Value": false,
      "Description": "Disable relaxed movement so seek follows stricter path constraints."
    },
    "NeedsSeekAvoidBlockDamage": {
      "Value": true,
      "Description": "Avoid environmental block damage while pathing to needs resources."
    },
    "NeedsSeekReachable": {
      "Value": false,
      "Description": "Let custom needs preflight own resource reachability so seek movement can path to consume range without rechecking exact-target reachability."
    },
    "NeedsSeekReadRange": {
      "Value": 96,
      "Description": "Range used to read stored resource-seek destinations."
    },
    "NeedsSeekMoveTimeoutRange": {
      "Value": [
        15,
        15
      ],
      "Description": "Fail-safe maximum move time before resource seek completes."
    },
    "NeedsSeekStallGraceSeconds": {
      "Value": 8,
      "Description": "Seconds after movement start before insufficient progress rejects the active resource target."
    },
    "NeedsSeekStallMinProgress": {
      "Value": 0.75,
      "Description": "Minimum distance the NPC must close toward a resource target before the stall grace period ends."
    },
    "NeedsSeekConsumeDelayRange": {
      "Value": [
        0.5,
        0.75
      ],
      "Description": "Short pause after reaching the resource before completing seek."
    },
    "NeedsSeekConsumeAnimation": {
      "Value": "Eat",
      "Description": "Status animation played while completing needs resource consumption."
    },
    "NeedsSeekFailedCooldownName": {
      "Value": "NeedsSeek_Failed_Cooldown",
      "Description": "Timer name used to throttle repeated failed seek attempts."
    },
    "NeedsSeekFailedCooldownRange": {
      "Value": [
        4,
        6
      ],
      "Description": "Cooldown duration after nav/path failures before another seek can be started."
    }
  },
  "Content": {
    "$Comment": "Needs resource movement runtime using local states only. Parent template gates activation.",
    "Continue": true,
    "Sensor": {
      "Type": "Any"
    },
    "Instructions": [
      {
        "$Comment": "No-op default branch to satisfy local state pairing validation.",
        "Continue": true,
        "Sensor": {
          "Type": "State",
          "State": ".Default"
        }
      },
      {
        "$Comment": "If seek state has no readable target, immediately return to parent completion state.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".Default"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "ReadPosition",
                "Slot": {
                  "Compute": "NeedsSeekTargetSlot"
                },
                "Range": {
                  "Compute": "NeedsSeekReadRange"
                }
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "TimerStart",
            "Name": {
              "Compute": "NeedsSeekFailedCooldownName"
            },
            "StartValueRange": {
              "Compute": "NeedsSeekFailedCooldownRange"
            },
            "RestartValueRange": {
              "Compute": "NeedsSeekFailedCooldownRange"
            }
          },
          {
            "Type": "TimerRestart",
            "Name": {
              "Compute": "NeedsSeekFailedCooldownName"
            }
          },
          {
            "Type": "ReleaseTarget",
            "TargetSlot": {
              "Compute": "NeedsSeekActiveTargetSlot"
            }
          },
          {
            "Type": "ParentState",
            "State": "OnNeedsSeekComplete"
          }
        ]
      },
      {
        "$Comment": "Initialize runtime when not already moving/consuming and a target exists.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "Not",
              "Sensor": {
                "Type": "State",
                "State": ".Move"
              }
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "State",
                "State": ".PostConsume"
              }
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "State",
                "State": ".ConsumeDelay"
              }
            },
            {
              "Type": "ReadPosition",
              "Slot": {
                "Compute": "NeedsSeekTargetSlot"
              },
              "Range": {
                "Compute": "NeedsSeekReadRange"
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "StorePosition",
            "Slot": {
              "Compute": "NeedsSeekActiveTargetSlot"
            }
          },
          {
            "Type": "TameworkNeedsResourceMovementDiagnostic",
            "ResourceType": {
              "Compute": "NeedsSeekResourceType"
            },
            "Stage": "move_start",
            "Detail": "target_read"
          },
          {
            "Type": "TimerStart",
            "Name": "NeedsSeek_Move_Timeout",
            "StartValueRange": {
              "Compute": "NeedsSeekMoveTimeoutRange"
            },
            "RestartValueRange": {
              "Compute": "NeedsSeekMoveTimeoutRange"
            }
          },
          {
            "Type": "TimerRestart",
            "Name": "NeedsSeek_Move_Timeout"
          },
          {
            "Type": "State",
            "State": ".Move"
          }
        ]
      },
      {
        "$Comment": "Move runtime while active.",
        "Sensor": {
          "Type": "State",
          "State": ".Move"
        },
        "Instructions": [
          {
            "$Comment": "Clear lingering status animation on move entry so locomotion can play (prevents sit/sleep sliding).",
            "Continue": true,
            "Sensor": {
              "Type": "Any",
              "Once": true
            },
            "Actions": [
              {
                "Type": "PlayAnimation",
                "Slot": "Status"
              }
            ]
          },
          {
            "$Comment": "Throttled diagnostic probe while vanilla Seek owns movement.",
            "Continue": true,
            "Sensor": {
              "Type": "ReadPosition",
              "Slot": {
                "Compute": "NeedsSeekActiveTargetSlot"
              },
              "Range": {
                "Compute": "NeedsSeekReadRange"
              }
            },
            "Actions": [
              {
                "Type": "TameworkNeedsResourceMovementDiagnostic",
                "ResourceType": {
                  "Compute": "NeedsSeekResourceType"
                },
                "Stage": "move_probe",
                "Detail": "before_seek"
              }
            ]
          },
          {
            "$Comment": "When close enough, start a short consume delay.",
            "Continue": true,
            "Sensor": {
              "Type": "ReadPosition",
              "Slot": {
                "Compute": "NeedsSeekActiveTargetSlot"
              },
              "Range": {
                "Compute": "NeedsSeekConsumeStartDistance"
              }
            },
            "Actions": [
              {
                "Type": "TameworkNeedsResourceMovementDiagnostic",
                "ResourceType": {
                  "Compute": "NeedsSeekResourceType"
                },
                "Stage": "consume_delay_start",
                "Detail": "within_consume_range"
              },
              {
                "Type": "PlayAnimation",
                "Slot": "Status",
                "Animation": {
                  "Compute": "NeedsSeekConsumeAnimation"
                }
              },
              {
                "Type": "TimerStart",
                "Name": "NeedsSeek_Consume_Delay",
                "StartValueRange": {
                  "Compute": "NeedsSeekConsumeDelayRange"
                },
                "RestartValueRange": {
                  "Compute": "NeedsSeekConsumeDelayRange"
                }
              },
              {
                "Type": "TimerRestart",
                "Name": "NeedsSeek_Consume_Delay"
              },
              {
                "Type": "State",
                "State": ".ConsumeDelay"
              }
            ]
          },
          {
            "$Comment": "If destination can no longer be read, recover immediately.",
            "Continue": true,
            "Sensor": {
              "Type": "Not",
              "Sensor": {
                "Type": "ReadPosition",
                "Slot": {
                  "Compute": "NeedsSeekActiveTargetSlot"
                },
                "Range": {
                  "Compute": "NeedsSeekReadRange"
                }
              }
            },
            "Actions": [
              {
                "Type": "TameworkNeedsResourceMovementDiagnostic",
                "ResourceType": {
                  "Compute": "NeedsSeekResourceType"
                },
                "Stage": "target_lost",
                "Detail": "target_unreadable"
              },
              {
                "Type": "TimerStart",
                "Name": {
                  "Compute": "NeedsSeekFailedCooldownName"
                },
                "StartValueRange": {
                  "Compute": "NeedsSeekFailedCooldownRange"
                },
                "RestartValueRange": {
                  "Compute": "NeedsSeekFailedCooldownRange"
                }
              },
              {
                "Type": "TimerRestart",
                "Name": {
                  "Compute": "NeedsSeekFailedCooldownName"
                }
              },
              {
                "Type": "ReleaseTarget",
                "TargetSlot": {
                  "Compute": "NeedsSeekActiveTargetSlot"
                }
              },
              {
                "Type": "State",
                "State": ".Default"
              },
              {
                "Type": "ParentState",
                "State": "OnNeedsSeekComplete"
              }
            ]
          },
          {
            "$Comment": "Abort seek quickly when nav reports no viable path.",
            "Continue": true,
            "Sensor": {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "Nav",
                  "NavStates": [
                    "Defer",
                    "Aborted"
                  ]
                },
                {
                  "Type": "ReadPosition",
                  "Slot": {
                    "Compute": "NeedsSeekActiveTargetSlot"
                  },
                  "Range": {
                    "Compute": "NeedsSeekReadRange"
                  }
                }
              ]
            },
            "Actions": [
              {
                "Type": "TameworkNeedsResourceMovementDiagnostic",
                "ResourceType": {
                  "Compute": "NeedsSeekResourceType"
                },
                "Stage": "nav_defer",
                "Detail": "path_deferred_or_aborted"
              },
              {
                "Type": "TameworkNeedsResourceRejectTarget",
                "ResourceType": {
                  "Compute": "NeedsSeekResourceType"
                }
              },
              {
                "Type": "TimerStart",
                "Name": {
                  "Compute": "NeedsSeekFailedCooldownName"
                },
                "StartValueRange": {
                  "Compute": "NeedsSeekFailedCooldownRange"
                },
                "RestartValueRange": {
                  "Compute": "NeedsSeekFailedCooldownRange"
                }
              },
              {
                "Type": "TimerRestart",
                "Name": {
                  "Compute": "NeedsSeekFailedCooldownName"
                }
              },
              {
                "Type": "ReleaseTarget",
                "TargetSlot": {
                  "Compute": "NeedsSeekActiveTargetSlot"
                }
              },
              {
                "Type": "State",
                "State": ".Default"
              },
              {
                "Type": "ParentState",
                "State": "OnNeedsSeekComplete"
              }
            ]
          },
          {
            "$Comment": "Abort seek when movement stays blocked long enough that the live path is no longer useful.",
            "Continue": true,
            "Sensor": {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "Nav",
                  "NavStates": [
                    "Blocked"
                  ],
                  "ThrottleDuration": 2
                },
                {
                  "Type": "ReadPosition",
                  "Slot": {
                    "Compute": "NeedsSeekActiveTargetSlot"
                  },
                  "Range": {
                    "Compute": "NeedsSeekReadRange"
                  }
                }
              ]
            },
            "Actions": [
              {
                "Type": "TameworkNeedsResourceMovementDiagnostic",
                "ResourceType": {
                  "Compute": "NeedsSeekResourceType"
                },
                "Stage": "nav_blocked",
                "Detail": "path_blocked"
              },
              {
                "Type": "TameworkNeedsResourceRejectTarget",
                "ResourceType": {
                  "Compute": "NeedsSeekResourceType"
                }
              },
              {
                "Type": "TimerStart",
                "Name": {
                  "Compute": "NeedsSeekFailedCooldownName"
                },
                "StartValueRange": {
                  "Compute": "NeedsSeekFailedCooldownRange"
                },
                "RestartValueRange": {
                  "Compute": "NeedsSeekFailedCooldownRange"
                }
              },
              {
                "Type": "TimerRestart",
                "Name": {
                  "Compute": "NeedsSeekFailedCooldownName"
                }
              },
              {
                "Type": "ReleaseTarget",
                "TargetSlot": {
                  "Compute": "NeedsSeekActiveTargetSlot"
                }
              },
              {
                "Type": "State",
                "State": ".Default"
              },
              {
                "Type": "ParentState",
                "State": "OnNeedsSeekComplete"
              }
            ]
          },
          {
            "$Comment": "Abort seek when movement fails to make progress after the stall grace period.",
            "Continue": true,
            "Sensor": {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "TameworkNeedsResourceMovementStalled",
                  "ResourceType": {
                    "Compute": "NeedsSeekResourceType"
                  },
                  "GraceSeconds": {
                    "Compute": "NeedsSeekStallGraceSeconds"
                  },
                  "MinProgress": {
                    "Compute": "NeedsSeekStallMinProgress"
                  }
                },
                {
                  "Type": "ReadPosition",
                  "Slot": {
                    "Compute": "NeedsSeekActiveTargetSlot"
                  },
                  "Range": {
                    "Compute": "NeedsSeekReadRange"
                  },
                  "MinRange": {
                    "Compute": "NeedsSeekConsumeStartDistance"
                  }
                }
              ]
            },
            "Actions": [
              {
                "Type": "TameworkNeedsResourceMovementDiagnostic",
                "ResourceType": {
                  "Compute": "NeedsSeekResourceType"
                },
                "Stage": "move_stalled",
                "Detail": "insufficient_progress"
              },
              {
                "Type": "TameworkNeedsResourceRejectTarget",
                "ResourceType": {
                  "Compute": "NeedsSeekResourceType"
                }
              },
              {
                "Type": "TimerStart",
                "Name": {
                  "Compute": "NeedsSeekFailedCooldownName"
                },
                "StartValueRange": {
                  "Compute": "NeedsSeekFailedCooldownRange"
                },
                "RestartValueRange": {
                  "Compute": "NeedsSeekFailedCooldownRange"
                }
              },
              {
                "Type": "TimerRestart",
                "Name": {
                  "Compute": "NeedsSeekFailedCooldownName"
                }
              },
              {
                "Type": "TameworkNeedsResourceReleaseTarget",
                "ResourceType": {
                  "Compute": "NeedsSeekResourceType"
                }
              },
              {
                "Type": "ReleaseTarget",
                "TargetSlot": {
                  "Compute": "NeedsSeekActiveTargetSlot"
                }
              },
              {
                "Type": "State",
                "State": ".Default"
              },
              {
                "Type": "ParentState",
                "State": "OnNeedsSeekComplete"
              }
            ]
          },
          {
            "$Comment": "Fail-safe completion when move timeout has elapsed.",
            "Continue": true,
            "Sensor": {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "Timer",
                  "Name": "NeedsSeek_Move_Timeout",
                  "State": "Stopped"
                },
                {
                  "Type": "ReadPosition",
                  "Slot": {
                    "Compute": "NeedsSeekActiveTargetSlot"
                  },
                  "Range": {
                    "Compute": "NeedsSeekReadRange"
                  }
                }
              ]
            },
            "Actions": [
              {
                "Type": "TameworkNeedsResourceMovementDiagnostic",
                "ResourceType": {
                  "Compute": "NeedsSeekResourceType"
                },
                "Stage": "move_timeout",
                "Detail": "timeout_elapsed"
              },
              {
                "Type": "TameworkNeedsResourceRejectTarget",
                "ResourceType": {
                  "Compute": "NeedsSeekResourceType"
                }
              },
              {
                "Type": "TimerStart",
                "Name": {
                  "Compute": "NeedsSeekFailedCooldownName"
                },
                "StartValueRange": {
                  "Compute": "NeedsSeekFailedCooldownRange"
                },
                "RestartValueRange": {
                  "Compute": "NeedsSeekFailedCooldownRange"
                }
              },
              {
                "Type": "TimerRestart",
                "Name": {
                  "Compute": "NeedsSeekFailedCooldownName"
                }
              },
              {
                "Type": "ReleaseTarget",
                "TargetSlot": {
                  "Compute": "NeedsSeekActiveTargetSlot"
                }
              },
              {
                "Type": "State",
                "State": ".Default"
              },
              {
                "Type": "ParentState",
                "State": "OnNeedsSeekComplete"
              }
            ]
          },
          {
            "$Comment": "Seek toward the stored destination.",
            "Sensor": {
              "Type": "ReadPosition",
              "Slot": {
                "Compute": "NeedsSeekActiveTargetSlot"
              },
              "Range": {
                "Compute": "NeedsSeekReadRange"
              },
              "MinRange": {
                "Compute": "NeedsSeekConsumeStartDistance"
              }
            },
            "BodyMotion": {
              "Type": "Seek",
              "UsePathfinder": {
                "Compute": "NeedsSeekUsePathfinder"
              },
              "UseSteering": {
                "Compute": "NeedsSeekUseSteering"
              },
              "UseBestPath": {
                "Compute": "NeedsSeekUseBestPath"
              },
              "RelaxedMoveConstraints": {
                "Compute": "NeedsSeekRelaxedMoveConstraints"
              },
              "AvoidBlockDamage": {
                "Compute": "NeedsSeekAvoidBlockDamage"
              },
              "Reachable": {
                "Compute": "NeedsSeekReachable"
              },
              "SlowDownDistance": {
                "Compute": "NeedsSeekSlowDownDistance"
              },
              "StopDistance": {
                "Compute": "NeedsSeekConsumeStartDistance"
              },
              "RelativeSpeed": {
                "Compute": "NeedsSeekRelativeSpeed"
              }
            }
          }
        ]
      },
      {
        "$Comment": "If outside consume maintain band during consume delay, re-seek the stored adjacent stand position.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".ConsumeDelay"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "ReadPosition",
                "Slot": {
                  "Compute": "NeedsSeekActiveTargetSlot"
                },
                "Range": {
                  "Compute": "NeedsSeekConsumeMaintainMaxDistance"
                },
                "MinRange": {
                  "Compute": "NeedsSeekConsumeMaintainMinDistance"
                }
              }
            }
          ]
        },
        "BodyMotion": {
          "Type": "MaintainDistance",
          "DesiredDistanceRange": {
            "Compute": "NeedsSeekConsumeMaintainDistanceRange"
          },
          "MoveThreshold": 0.1,
          "StrafingDurationRange": [
            0,
            0
          ],
          "RelativeForwardsSpeed": {
            "Compute": "NeedsSeekRelativeSpeed"
          },
          "RelativeBackwardsSpeed": {
            "Compute": "NeedsSeekRelativeSpeed"
          }
        }
      },
      {
        "$Comment": "When within consume maintain band, keep facing the consume target while waiting out delay.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".ConsumeDelay"
            },
            {
              "Type": "ReadPosition",
              "Slot": {
                "Compute": "NeedsSeekActiveTargetSlot"
              },
              "Range": {
                "Compute": "NeedsSeekConsumeMaintainMaxDistance"
              },
              "MinRange": {
                "Compute": "NeedsSeekConsumeMaintainMinDistance"
              }
            }
          ]
        },
        "HeadMotion": {
          "Type": "Aim"
        },
        "BodyMotion": {
          "Type": "MatchLook"
        }
      },
      {
        "$Comment": "Fail-safe completion if consume delay cannot recover target before move timeout.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".ConsumeDelay"
            },
            {
              "Type": "Timer",
              "Name": "NeedsSeek_Move_Timeout",
              "State": "Stopped"
            },
            {
              "Type": "ReadPosition",
              "Slot": {
                "Compute": "NeedsSeekActiveTargetSlot"
              },
              "Range": {
                "Compute": "NeedsSeekReadRange"
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "TameworkNeedsResourceMovementDiagnostic",
            "ResourceType": {
              "Compute": "NeedsSeekResourceType"
            },
            "Stage": "consume_delay_timeout",
            "Detail": "timeout_elapsed"
          },
          {
            "Type": "TameworkNeedsResourceRejectTarget",
            "ResourceType": {
              "Compute": "NeedsSeekResourceType"
            }
          },
          {
            "Type": "TimerStart",
            "Name": {
              "Compute": "NeedsSeekFailedCooldownName"
            },
            "StartValueRange": {
              "Compute": "NeedsSeekFailedCooldownRange"
            },
            "RestartValueRange": {
              "Compute": "NeedsSeekFailedCooldownRange"
            }
          },
          {
            "Type": "TimerRestart",
            "Name": {
              "Compute": "NeedsSeekFailedCooldownName"
            }
          },
          {
            "Type": "ReleaseTarget",
            "TargetSlot": {
              "Compute": "NeedsSeekActiveTargetSlot"
            }
          },
          {
            "Type": "State",
            "State": ".Default"
          },
          {
            "Type": "ParentState",
            "State": "OnNeedsSeekComplete"
          }
        ]
      },
      {
        "$Comment": "Finalize seek after consume delay.",
        "Sensor": {
          "Type": "State",
          "State": ".ConsumeDelay"
        },
        "Instructions": [
          {
            "Sensor": {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "Timer",
                  "Name": "NeedsSeek_Consume_Delay",
                  "State": "Stopped"
                },
                {
                  "Type": "ReadPosition",
                  "Slot": {
                    "Compute": "NeedsSeekActiveTargetSlot"
                  },
                  "Range": {
                    "Compute": "NeedsSeekConsumeMaintainMaxDistance"
