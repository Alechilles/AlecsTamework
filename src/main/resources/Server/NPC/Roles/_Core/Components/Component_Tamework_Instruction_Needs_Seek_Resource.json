{
  "Type": "Component",
  "Class": "Instruction",
  "Interface": "Tamework.Instruction.NeedsSeekResourceMove",
  "DefaultState": ".Default",
  "Parameters": {
    "_ImportStates": [
      "OnNeedsSeekComplete"
    ],
    "NeedsSeekTargetSlot": {
      "Value": "TameworkNeedsSeekTarget",
      "Description": "Stored destination slot used while a needs resource seek is active."
    },
    "NeedsSeekResourceType": {
      "Value": "Auto",
      "Description": "Resource consume mode used at seek completion (Auto, Water, FoodContainer)."
    },
    "NeedsSeekFoodItemIDs": {
      "Value": [],
      "TypeHint": "String",
      "Description": "Optional allowed food item ids passed to consume action for container intake."
    },
    "NeedsSeekWhenHungerBelowRatio": {
      "Value": 0.85,
      "Description": "Hunger ratio gate used to decide whether food seek should keep running."
    },
    "NeedsSeekWhenThirstBelowRatio": {
      "Value": 0.85,
      "Description": "Thirst ratio gate used to decide whether water seek should keep running."
    },
    "NeedsSeekCheckHunger": {
      "Value": false,
      "Description": "Whether hunger threshold checks should gate seek continuation."
    },
    "NeedsSeekCheckThirst": {
      "Value": false,
      "Description": "Whether thirst threshold checks should gate seek continuation."
    },
    "NeedsSeekSlowDownDistance": {
      "Value": 2.4,
      "Description": "Distance where needs-seek movement starts slowing down."
    },
    "NeedsSeekStopDistance": {
      "Value": 0.35,
      "Description": "Distance considered close enough to the resource target."
    },
    "NeedsSeekConsumeDistanceOffset": {
      "Value": 0.2,
      "Description": "Extra distance margin added to stop distance when allowing eat/drink completion."
    },
    "NeedsSeekRelativeSpeed": {
      "Value": 0.55,
      "Description": "Relative movement speed while seeking needs resources."
    },
    "NeedsSeekUsePathfinder": {
      "Value": true,
      "Description": "Use nav pathfinding while moving to a needs resource target."
    },
    "NeedsSeekUseSteering": {
      "Value": true,
      "Description": "Allow steering assist while pathfinding to a needs resource target."
    },
    "NeedsSeekUseBestPath": {
      "Value": false,
      "Description": "Allow partial best-path fallback if a full route cannot be found."
    },
    "NeedsSeekRelaxedMoveConstraints": {
      "Value": false,
      "Description": "Disable relaxed movement so seek follows stricter path constraints."
    },
    "NeedsSeekAvoidBlockDamage": {
      "Value": true,
      "Description": "Avoid environmental block damage while pathing to needs resources."
    },
    "NeedsSeekReachable": {
      "Value": false,
      "Description": "Require direct hitbox overlap with target position before considering goal reached."
    },
    "NeedsSeekReadRange": {
      "Value": 96,
      "Description": "Range used to read stored resource-seek destinations."
    },
    "NeedsSeekMoveTimeoutRange": {
      "Value": [
        8,
        10
      ],
      "Description": "Fail-safe maximum move time before resource seek completes."
    },
    "NeedsSeekConsumeDelayRange": {
      "Value": [
        1,
        1.2
      ],
      "Description": "Short pause after reaching the resource before completing seek."
    },
    "NeedsSeekFailedCooldownName": {
      "Value": "NeedsSeek_Failed_Cooldown",
      "Description": "Timer name used to throttle repeated failed seek attempts."
    },
    "NeedsSeekFailedCooldownRange": {
      "Value": [
        4,
        6
      ],
      "Description": "Cooldown duration after nav/path failures before another seek can be started."
    }
  },
  "Content": {
    "$Comment": "Needs resource movement runtime using local states only. Parent template gates activation.",
    "Continue": true,
    "Sensor": {
      "Type": "Any"
    },
    "Instructions": [
      {
        "$Comment": "No-op default branch to satisfy local state pairing validation.",
        "Continue": true,
        "Sensor": {
          "Type": "State",
          "State": ".Default"
        }
      },
      {
        "$Comment": "If seek state has no readable target, immediately return to parent completion state.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".Default"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "ReadPosition",
                "Slot": {
                  "Compute": "NeedsSeekTargetSlot"
                },
                "Range": {
                  "Compute": "NeedsSeekReadRange"
                }
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".Complete"
          }
        ]
      },
      {
        "$Comment": "Water seek: if thirst is no longer below threshold, stop seek immediately.",
        "Continue": true,
        "Enabled": {
          "Compute": "NeedsSeekCheckThirst"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".Default"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "TameworkNeedBelow",
                "Need": "Thirst",
                "RatioBelow": {
                  "Compute": "NeedsSeekWhenThirstBelowRatio"
                }
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".Complete"
          }
        ]
      },
      {
        "$Comment": "Food seek: if hunger is no longer below threshold, stop seek immediately.",
        "Continue": true,
        "Enabled": {
          "Compute": "NeedsSeekCheckHunger"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".Default"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "TameworkNeedBelow",
                "Need": "Hunger",
                "RatioBelow": {
                  "Compute": "NeedsSeekWhenHungerBelowRatio"
                }
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".Complete"
          }
        ]
      },
      {
        "$Comment": "Initialize runtime when not already moving/consuming and a target exists.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "Not",
              "Sensor": {
                "Type": "State",
                "State": ".Move"
              }
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "State",
                "State": ".ConsumeDelay"
              }
            },
            {
              "Type": "ReadPosition",
              "Slot": {
                "Compute": "NeedsSeekTargetSlot"
              },
              "Range": {
                "Compute": "NeedsSeekReadRange"
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Status"
          },
          {
            "Type": "TimerStart",
            "Name": "NeedsSeek_Move_Timeout",
            "StartValueRange": {
              "Compute": "NeedsSeekMoveTimeoutRange"
            },
            "RestartValueRange": {
              "Compute": "NeedsSeekMoveTimeoutRange"
            }
          },
          {
            "Type": "TimerRestart",
            "Name": "NeedsSeek_Move_Timeout"
          },
          {
            "Type": "State",
            "State": ".Move"
          }
        ]
      },
      {
        "$Comment": "Move runtime while active.",
        "Sensor": {
          "Type": "State",
          "State": ".Move"
        },
        "Instructions": [
          {
            "$Comment": "Water seek: if thirst no longer needs refill during travel, stop immediately.",
            "Continue": true,
            "Enabled": {
              "Compute": "NeedsSeekCheckThirst"
            },
            "Sensor": {
              "Type": "Not",
              "Sensor": {
                "Type": "TameworkNeedBelow",
                "Need": "Thirst",
                "RatioBelow": {
                  "Compute": "NeedsSeekWhenThirstBelowRatio"
                }
              }
            },
            "Actions": [
              {
                "Type": "State",
                "State": ".Complete"
              }
            ]
          },
          {
            "$Comment": "Food seek: if hunger no longer needs refill during travel, stop immediately.",
            "Continue": true,
            "Enabled": {
              "Compute": "NeedsSeekCheckHunger"
            },
            "Sensor": {
              "Type": "Not",
              "Sensor": {
                "Type": "TameworkNeedBelow",
                "Need": "Hunger",
                "RatioBelow": {
                  "Compute": "NeedsSeekWhenHungerBelowRatio"
                }
              }
            },
            "Actions": [
              {
                "Type": "State",
                "State": ".Complete"
              }
            ]
          },
          {
            "$Comment": "When close enough, start a short consume delay.",
            "Continue": true,
            "Sensor": {
              "Type": "ReadPosition",
              "Slot": {
                "Compute": "NeedsSeekTargetSlot"
              },
              "Range": {
                "Compute": "NeedsSeekStopDistance + NeedsSeekConsumeDistanceOffset"
              }
            },
            "Actions": [
              {
                "Type": "TimerStart",
                "Name": "NeedsSeek_Consume_Delay",
                "StartValueRange": {
                  "Compute": "NeedsSeekConsumeDelayRange"
                },
                "RestartValueRange": {
                  "Compute": "NeedsSeekConsumeDelayRange"
                }
              },
              {
                "Type": "TimerRestart",
                "Name": "NeedsSeek_Consume_Delay"
              },
              {
                "Type": "State",
                "State": ".ConsumeDelay"
              }
            ]
          },
          {
            "$Comment": "If destination can no longer be read, recover immediately.",
            "Continue": true,
            "Sensor": {
              "Type": "Not",
              "Sensor": {
                "Type": "ReadPosition",
                "Slot": {
                  "Compute": "NeedsSeekTargetSlot"
                },
                "Range": {
                  "Compute": "NeedsSeekReadRange"
                }
              }
            },
            "Actions": [
              {
                "Type": "State",
                "State": ".Complete"
              }
            ]
          },
          {
            "$Comment": "Abort seek quickly when nav reports no viable path.",
            "Continue": true,
            "Sensor": {
              "Type": "Nav",
              "NavStates": [
                "Defer"
              ]
            },
            "Actions": [
              {
                "Type": "TimerStart",
                "Name": {
                  "Compute": "NeedsSeekFailedCooldownName"
                },
                "StartValueRange": {
                  "Compute": "NeedsSeekFailedCooldownRange"
                },
                "RestartValueRange": {
                  "Compute": "NeedsSeekFailedCooldownRange"
                }
              },
              {
                "Type": "TimerRestart",
                "Name": {
                  "Compute": "NeedsSeekFailedCooldownName"
                }
              },
              {
                "Type": "State",
                "State": ".Complete"
              }
            ]
          },
          {
            "$Comment": "Fail-safe completion when move timeout has elapsed.",
            "Continue": true,
            "Sensor": {
              "Type": "Timer",
              "Name": "NeedsSeek_Move_Timeout",
              "State": "Stopped"
            },
            "Actions": [
              {
                "Type": "State",
                "State": ".Complete"
              }
            ]
          },
          {
            "$Comment": "Seek toward the stored destination.",
            "Sensor": {
              "Type": "ReadPosition",
              "Slot": {
                "Compute": "NeedsSeekTargetSlot"
              },
              "Range": {
                "Compute": "NeedsSeekReadRange"
              },
              "MinRange": {
                "Compute": "NeedsSeekStopDistance + NeedsSeekConsumeDistanceOffset"
              }
            },
            "BodyMotion": {
              "Type": "Seek",
              "UsePathfinder": {
                "Compute": "NeedsSeekUsePathfinder"
              },
              "UseSteering": {
                "Compute": "NeedsSeekUseSteering"
              },
              "UseBestPath": {
                "Compute": "NeedsSeekUseBestPath"
              },
              "RelaxedMoveConstraints": {
                "Compute": "NeedsSeekRelaxedMoveConstraints"
              },
              "AvoidBlockDamage": {
                "Compute": "NeedsSeekAvoidBlockDamage"
              },
              "Reachable": {
                "Compute": "NeedsSeekReachable"
              },
              "SlowDownDistance": {
                "Compute": "NeedsSeekSlowDownDistance"
              },
              "StopDistance": {
                "Compute": "NeedsSeekStopDistance"
              },
              "RelativeSpeed": {
                "Compute": "NeedsSeekRelativeSpeed"
              }
            }
          }
        ]
      },
      {
        "$Comment": "Stop movement while waiting out consume delay.",
        "Continue": true,
        "Sensor": {
          "Type": "State",
          "State": ".ConsumeDelay"
        },
        "BodyMotion": {
          "Type": "Nothing"
        }
      },
      {
        "$Comment": "Finalize seek after consume delay.",
        "Sensor": {
          "Type": "State",
          "State": ".ConsumeDelay"
        },
        "Instructions": [
          {
            "$Comment": "Water seek: if thirst no longer needs refill while waiting, finish immediately.",
            "Continue": true,
            "Enabled": {
              "Compute": "NeedsSeekCheckThirst"
            },
            "Sensor": {
              "Type": "Not",
              "Sensor": {
                "Type": "TameworkNeedBelow",
                "Need": "Thirst",
                "RatioBelow": {
                  "Compute": "NeedsSeekWhenThirstBelowRatio"
                }
              }
            },
            "Actions": [
              {
                "Type": "State",
                "State": ".Complete"
              }
            ]
          },
          {
            "$Comment": "Food seek: if hunger no longer needs refill while waiting, finish immediately.",
            "Continue": true,
            "Enabled": {
              "Compute": "NeedsSeekCheckHunger"
            },
            "Sensor": {
              "Type": "Not",
              "Sensor": {
                "Type": "TameworkNeedBelow",
                "Need": "Hunger",
                "RatioBelow": {
                  "Compute": "NeedsSeekWhenHungerBelowRatio"
                }
              }
            },
            "Actions": [
              {
                "Type": "State",
                "State": ".Complete"
              }
            ]
          },
          {
            "Sensor": {
              "Type": "Timer",
              "Name": "NeedsSeek_Consume_Delay",
              "State": "Stopped"
            },
            "Actions": [
              {
                "Type": "TameworkNeedsResourceConsume",
                "ResourceType": {
                  "Compute": "NeedsSeekResourceType"
                },
                "FoodItemIDs": {
                  "Compute": "NeedsSeekFoodItemIDs"
                }
              },
              {
                "Type": "State",
                "State": ".Complete"
              }
            ]
          }
        ]
      },
      {
        "$Comment": "Completion local state: clear movement/pose before returning to parent idle flow.",
        "Continue": true,
        "Sensor": {
          "Type": "State",
          "State": ".Complete"
        },
        "BodyMotion": {
          "Type": "Nothing"
        }
      },
      {
        "$Comment": "Clear status slot while completing to avoid posture slide carryover.",
        "Continue": true,
        "Sensor": {
          "Type": "State",
          "State": ".Complete"
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Status"
          }
        ]
      },
      {
        "$Comment": "Exit completion local state and return to parent completion state.",
        "Sensor": {
          "Type": "State",
          "State": ".Complete"
        },
        "Instructions": [
          {
            "Sensor": {
              "Type": "Any",
              "Once": true
            },
            "ActionsBlocking": true,
            "Actions": [
              {
                "Type": "Timeout",
                "Delay": [
                  0,
                  0
                ]
              },
              {
                "Type": "State",
                "State": ".Default"
              },
              {
                "Type": "ParentState",
                "State": "OnNeedsSeekComplete"
              }
            ]
          }
        ]
      }
    ]
  }
}
