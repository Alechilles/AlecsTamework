{
  "$Comment": "Barebones player following functionality",
  "Type": "Component",
  "Class": "Instruction",
  "Interface": "Tamework.Instruction.Follow",
  "DefaultState": ".Default",
  "Parameters": {
    "MasterTargetSlot": {
      "Value": "MasterTarget",
      "Description": "Target slot used to track the owner/master."
    },
    "FollowSeekSlowDownDistance": {
      "Value": 5,
      "Description": "How far from the master to start slowing down when seeking."
    },
    "FollowSeekStopDistance": {
      "Value": 3,
      "Description": "How far from the master to stop when seeking."
    },
    "FollowSeekRelativeSpeed": {
      "Value": 1,
      "Description": "Relative speed used when seeking the master."
    }
  },
  "Content": {
    "$Comment": "Default Follow State: Seek the master target using a simple target-based loop.",
    "Continue": true,
    "Sensor": {
      "Type": "Any"
    },
    "Instructions": [
      {
        "Reference": "Component_Tamework_Instruction_Follow_Formation",
        "Modify": {
          "MasterTargetSlot": {
            "Compute": "MasterTargetSlot"
          },
          "FormationRange": 40,
          "FormationRelativeSpeed": {
            "Compute": "FollowSeekRelativeSpeed"
          }
        }
      },
      {
        "Sensor": {
          "Type": "State",
          "State": ".Default"
        },
        "Instructions": [
          {
            "Sensor": {
              "Type": "Target",
              "TargetSlot": {
                "Compute": "MasterTargetSlot"
              }
            },
            "BodyMotion": {
              "Type": "Seek",
              "SlowDownDistance": {
                "Compute": "FollowSeekSlowDownDistance"
              },
              "StopDistance": {
                "Compute": "FollowSeekStopDistance"
              },
              "RelativeSpeed": {
                "Compute": "FollowSeekRelativeSpeed"
              }
            }
          }
        ]
      }
    ]
  }
}
