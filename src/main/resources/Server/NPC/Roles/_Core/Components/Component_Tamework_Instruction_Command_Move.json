{
  "Type": "Component",
  "Class": "Instruction",
  "Interface": "Tamework.Instruction.CommandMove",
  "Parameters": {
    "CommandMoveTargetSlot": {
      "Value": "TameworkCommandMoveTarget",
      "Description": "Stored position slot used as the active command-move destination."
    },
    "CommandMoveHookIdRaycast": {
      "Value": "Tamework.Command.MoveToPosition.RaycastHit",
      "Description": "Hook id consumed for move-to-ping commands."
    },
    "CommandMoveHookIdStoredHome": {
      "Value": "Tamework.Command.MoveToPosition.StoredHome",
      "Description": "Hook id consumed for return-home commands."
    },
    "CommandMoveSeekSlowDownDistance": {
      "Value": 4,
      "Description": "Distance from destination where movement starts to slow."
    },
    "CommandMoveSeekStopDistance": {
      "Value": 1.3,
      "Description": "Distance from destination considered reached."
    },
    "CommandMoveSeekRelativeSpeed": {
      "Value": 1,
      "Description": "Relative seek speed while executing move commands."
    }
  },
  "Content": {
    "$Comment": "Global bridge that converts command-item move hooks into movement behavior.",
    "Continue": true,
    "Sensor": {
      "Type": "Any"
    },
    "Instructions": [
      {
        "$Comment": "Move-to-ping hook: store destination and switch to command move state.",
        "Continue": true,
        "Sensor": {
          "Type": "TameworkHook",
          "HookId": {
            "Compute": "CommandMoveHookIdRaycast"
          }
        },
        "Actions": [
          {
            "Type": "StorePosition",
            "Slot": {
              "Compute": "CommandMoveTargetSlot"
            }
          },
          {
            "Type": "ReleaseTarget",
            "TargetSlot": "LockedTarget"
          },
          {
            "Type": "State",
            "State": "CommandMove"
          }
        ]
      },
      {
        "$Comment": "Return-home hook: store destination and switch to command move state.",
        "Continue": true,
        "Sensor": {
          "Type": "TameworkHook",
          "HookId": {
            "Compute": "CommandMoveHookIdStoredHome"
          }
        },
        "Actions": [
          {
            "Type": "StorePosition",
            "Slot": {
              "Compute": "CommandMoveTargetSlot"
            }
          },
          {
            "Type": "ReleaseTarget",
            "TargetSlot": "LockedTarget"
          },
          {
            "Type": "State",
            "State": "CommandMove"
          }
        ]
      },
      {
        "$Comment": "CommandMove runtime behavior.",
        "Sensor": {
          "Type": "State",
          "State": "CommandMove"
        },
        "Instructions": [
          {
            "$Comment": "When close enough, complete the move.",
            "Continue": true,
            "Sensor": {
              "Type": "ReadPosition",
              "Slot": {
                "Compute": "CommandMoveTargetSlot"
              },
              "Range": {
                "Compute": "CommandMoveSeekStopDistance + 0.2"
              }
            },
            "Actions": [
              {
                "Type": "State",
                "State": "Hold"
              }
            ]
          },
          {
            "$Comment": "If no destination exists, recover immediately.",
            "Continue": true,
            "Sensor": {
              "Type": "Not",
              "Sensor": {
                "Type": "ReadPosition",
                "Slot": {
                  "Compute": "CommandMoveTargetSlot"
                }
              }
            },
            "Actions": [
              {
                "Type": "State",
                "State": "Hold"
              }
            ]
          },
          {
            "$Comment": "Seek to the stored command destination.",
            "Sensor": {
              "Type": "ReadPosition",
              "Slot": {
                "Compute": "CommandMoveTargetSlot"
              }
            },
            "BodyMotion": {
              "Type": "Seek",
              "SlowDownDistance": {
                "Compute": "CommandMoveSeekSlowDownDistance"
              },
              "StopDistance": {
                "Compute": "CommandMoveSeekStopDistance"
              },
              "RelativeSpeed": {
                "Compute": "CommandMoveSeekRelativeSpeed"
              }
            }
          }
        ]
      }
    ]
  }
}
