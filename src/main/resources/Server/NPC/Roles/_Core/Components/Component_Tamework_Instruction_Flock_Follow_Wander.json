{
  "$Comment": "Applies flock leash behavior as an overlay without requiring a dedicated flock-follow state.",
  "Type": "Component",
  "Class": "Instruction",
  "DefaultState": ".Default",
  "Parameters": {
    "LeashEnabled": {
      "Value": true,
      "Description": "Whether follower-to-leader leash behavior is enabled."
    },
    "FlockFollowerWanderRadius": {
      "Value": 4,
      "Description": "How far followers are allowed to drift from their flock leader."
    },
    "FlockFollowerStopDistance": {
      "Value": 2,
      "Description": "How close followers stop when moving back toward their leader."
    },
    "FlockFollowerRelativeSpeed": {
      "Value": 1,
      "Description": "Relative speed used by leash seek behavior."
    },
    "BabyDirectFollowEnabled": {
      "Value": false,
      "Description": "Whether baby followers should tighten formation after leash catch-up."
    },
    "BabyDirectFollowRadius": {
      "Value": 3,
      "Description": "Extra-close leash radius used for baby direct-follow catch-up."
    },
    "BabyDirectFollowStopDistance": {
      "Value": 1.5,
      "Description": "How close baby followers stop during direct-follow catch-up."
    },
    "BabyDirectFollowRelativeSpeed": {
      "Value": 1,
      "Description": "Relative speed used during baby direct-follow catch-up."
    },
    "BabyDirectFollowDurationRange": {
      "Value": [
        "PT6S",
        "PT12S"
      ],
      "Description": "How long to keep baby direct-follow active after a leash event."
    }
  },
  "Content": {
    "Continue": true,
    "Sensor": {
      "Type": "Any"
    },
    "Instructions": [
      {
        "$Comment": "Safety: non-babies must never retain the baby direct-follow flag.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "Not",
              "Sensor": {
                "Type": "TameworkLifeStage",
                "Stage": "Baby"
              }
            },
            {
              "Type": "Or",
              "Sensors": [
                {
                  "Type": "Flag",
                  "Name": "Tamework_Baby_DirectFollow",
                  "Set": true
                },
                {
                  "Type": "Flag",
                  "Name": "Tamework_Baby_DirectFollow_LeashLatch",
                  "Set": true
                }
              ]
            }
          ]
        },
        "Actions": [
          {
            "Type": "SetFlag",
            "Name": "Tamework_Baby_DirectFollow",
            "SetTo": false
          },
          {
            "Type": "SetFlag",
            "Name": "Tamework_Baby_DirectFollow_LeashLatch",
            "SetTo": false
          }
        ]
      },
      {
        "$Comment": "Re-arm direct-follow only after the leash trigger condition fully clears.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "Flag",
              "Name": "Tamework_Baby_DirectFollow_LeashLatch",
              "Set": true
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "And",
                "Sensors": [
                  {
                    "Type": "TameworkLifeStage",
                    "Stage": "Baby"
                  },
                  {
                    "Type": "And",
                    "Sensors": [
                      {
                        "Type": "FlockLeader"
                      },
                      {
                        "Type": "Self",
                        "Filters": [
                          {
                            "Type": "Flock",
                            "FlockStatus": "Follower"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "Type": "Leash",
                    "Range": {
                      "Compute": "BabyDirectFollowRadius"
                    }
                  }
                ]
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "SetFlag",
            "Name": "Tamework_Baby_DirectFollow_LeashLatch",
            "SetTo": false
          }
        ]
      },
      {
        "$Comment": "Safety: if no direct-follow alarm exists, clear any stale follow flag.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "Flag",
              "Name": "Tamework_Baby_DirectFollow",
              "Set": true
            },
            {
              "Type": "Alarm",
              "Name": "Tamework_Baby_DirectFollow_Window",
              "State": "Unset"
            }
          ]
        },
        "Actions": [
          {
            "Type": "SetFlag",
            "Name": "Tamework_Baby_DirectFollow",
            "SetTo": false
          }
        ]
      },
      {
        "$Comment": "Safety: when direct-follow alarm expires, clear flag and consume passed alarm state.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "Flag",
              "Name": "Tamework_Baby_DirectFollow",
              "Set": true
            },
            {
              "Type": "Alarm",
              "Name": "Tamework_Baby_DirectFollow_Window",
              "State": "Passed",
              "Clear": true
            }
          ]
        },
        "Actions": [
          {
            "Type": "SetFlag",
            "Name": "Tamework_Baby_DirectFollow",
            "SetTo": false
          }
        ]
      },
      {
        "$Comment": "Arm the baby direct-follow window when a baby follower triggers leash catch-up.",
        "Continue": true,
        "Enabled": {
          "Compute": "BabyDirectFollowEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "TameworkLifeStage",
              "Stage": "Baby"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "Flag",
                "Name": "Tamework_Baby_DirectFollow_LeashLatch",
                "Set": true
              }
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "Flag",
                "Name": "Tamework_Baby_DirectFollow",
                "Set": true
              }
            },
            {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "FlockLeader"
                },
                {
                  "Type": "Self",
                  "Filters": [
                    {
                      "Type": "Flock",
                      "FlockStatus": "Follower"
                    }
                  ]
                }
              ]
            },
            {
              "Type": "Leash",
              "Range": {
                "Compute": "BabyDirectFollowRadius"
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "SetFlag",
            "Name": "Tamework_Baby_DirectFollow_LeashLatch",
            "SetTo": true
          },
          {
            "Type": "SetFlag",
            "Name": "Tamework_Baby_DirectFollow",
            "SetTo": true
          },
          {
            "Type": "SetAlarm",
            "Name": "Tamework_Baby_DirectFollow_Window",
            "DurationRange": {
              "Compute": "BabyDirectFollowDurationRange"
            }
          }
        ]
      },
      {
        "$Comment": "During the active window, babies directly follow their flock leader even after closing distance.",
        "Enabled": {
          "Compute": "BabyDirectFollowEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "TameworkLifeStage",
              "Stage": "Baby"
            },
            {
              "Type": "Flag",
              "Name": "Tamework_Baby_DirectFollow",
              "Set": true
            },
            {
              "Type": "Alarm",
              "Name": "Tamework_Baby_DirectFollow_Window",
              "State": "Set"
            },
            {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "FlockLeader"
                },
                {
                  "Type": "Self",
                  "Filters": [
                    {
                      "Type": "Flock",
                      "FlockStatus": "Follower"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "BodyMotion": {
          "Type": "Seek",
          "SlowDownDistance": {
            "Compute": "BabyDirectFollowStopDistance + 1"
          },
          "StopDistance": {
            "Compute": "BabyDirectFollowStopDistance"
          },
          "RelativeSpeed": {
            "Compute": "BabyDirectFollowRelativeSpeed"
          },
          "AbortDistance": 100
        }
      },
      {
        "$Comment": "Enter local flock-follow substate only when leash pullback is actually needed.",
        "Continue": true,
        "Enabled": {
          "Compute": "LeashEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".Default"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "Flag",
                "Name": "Tamework_Baby_DirectFollow",
                "Set": true
              }
            },
            {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "FlockLeader"
                },
                {
                  "Type": "Self",
                  "Filters": [
                    {
                      "Type": "Flock",
                      "FlockStatus": "Follower"
                    }
                  ]
                }
              ]
            },
            {
              "Type": "Leash",
              "Range": {
                "Compute": "FlockFollowerWanderRadius"
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".FlockFollow"
          }
        ]
      },
      {
        "$Comment": "Leave local flock-follow substate after regrouping or if direct-follow takes over.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".FlockFollow"
            },
            {
              "Type": "Or",
              "Sensors": [
                {
                  "Type": "Flag",
                  "Name": "Tamework_Baby_DirectFollow",
                  "Set": true
                },
                {
                  "Type": "Not",
                  "Sensor": {
                    "Type": "And",
                    "Sensors": [
                      {
                        "Type": "And",
                        "Sensors": [
                          {
                            "Type": "FlockLeader"
                          },
                          {
                            "Type": "Self",
                            "Filters": [
                              {
                                "Type": "Flock",
                                "FlockStatus": "Follower"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "Type": "Leash",
                        "Range": {
                          "Compute": "FlockFollowerWanderRadius"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".Default"
          }
        ]
      },
      {
        "$Comment": "While in local flock-follow substate, run follower leash movement.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".FlockFollow"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "Flag",
                "Name": "Tamework_Baby_DirectFollow",
                "Set": true
              }
            }
          ]
        },
        "Reference": "Component_Instruction_Leash_To_Flock_Leader",
        "Modify": {
          "Enabled": {
            "Compute": "LeashEnabled"
          },
          "WanderRadius": {
            "Compute": "FlockFollowerWanderRadius"
          },
          "StopDistance": {
            "Compute": "FlockFollowerStopDistance"
          },
          "RelativeSpeed": {
            "Compute": "FlockFollowerRelativeSpeed"
          }
        }
      }
    ]
  }
}
