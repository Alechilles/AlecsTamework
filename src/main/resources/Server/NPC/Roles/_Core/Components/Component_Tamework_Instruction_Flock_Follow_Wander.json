{
  "$Comment": "Applies flock leash behavior as an overlay. Babies can use a tighter leash profile but the same leash behavior.",
  "Type": "Component",
  "Class": "Instruction",
  "Parameters": {
    "LeashEnabled": {
      "Value": true,
      "Description": "Whether follower-to-leader leash behavior is enabled."
    },
    "FlockFollowerWanderRadius": {
      "Value": 4,
      "Description": "How far followers are allowed to drift from their flock leader."
    },
    "FlockFollowerStopDistance": {
      "Value": 2,
      "Description": "How close followers stop when moving back toward their leader."
    },
    "FlockFollowerRelativeSpeed": {
      "Value": 0.7,
      "Description": "Relative speed used by leash seek behavior."
    },
    "FlockFollowDurationRange": {
      "Value": [
        0,
        0
      ],
      "Description": "Deprecated compatibility field. Leash-only mode does not use timed follow windows."
    },
    "BabyDirectFollowEnabled": {
      "Value": false,
      "Description": "If true, use baby leash profile (tighter radius/stop) instead of adult leash profile."
    },
    "BabyDirectFollowRadius": {
      "Value": 3,
      "Description": "Tighter leash radius used for babies."
    },
    "BabyDirectFollowStopDistance": {
      "Value": 1.5,
      "Description": "Stop distance used for babies when regrouping."
    },
    "BabyDirectFollowRelativeSpeed": {
      "Value": 0.7,
      "Description": "Relative speed used for babies when regrouping."
    },
    "BabyDirectFollowDurationRange": {
      "Value": [
        6,
        12
      ],
      "Description": "Deprecated compatibility field. Leash-only mode does not use timed follow windows."
    }
  },
  "Content": {
    "Continue": true,
    "Sensor": {
      "Type": "Any"
    },
    "Instructions": [
      {
        "$Comment": "Adult/default leash profile.",
        "Continue": true,
        "Enabled": {
          "Compute": "LeashEnabled && !BabyDirectFollowEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "FlockLeader"
                },
                {
                  "Type": "Self",
                  "Filters": [
                    {
                      "Type": "Flock",
                      "FlockStatus": "Follower"
                    }
                  ]
                }
              ]
            },
            {
              "Type": "Leash",
              "Range": {
                "Compute": "FlockFollowerWanderRadius"
              }
            }
          ]
        },
        "Reference": "Component_Instruction_Leash_To_Flock_Leader",
        "Modify": {
          "Enabled": {
            "Compute": "LeashEnabled"
          },
          "WanderRadius": {
            "Compute": "FlockFollowerWanderRadius"
          },
          "StopDistance": {
            "Compute": "FlockFollowerStopDistance"
          },
          "RelativeSpeed": {
            "Compute": "FlockFollowerRelativeSpeed"
          }
        }
      },
      {
        "$Comment": "Baby leash profile: same leash behavior as adults, but tighter radius/stop/speed.",
        "Continue": true,
        "Enabled": {
          "Compute": "LeashEnabled && BabyDirectFollowEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "FlockLeader"
                },
                {
                  "Type": "Self",
                  "Filters": [
                    {
                      "Type": "Flock",
                      "FlockStatus": "Follower"
                    }
                  ]
                }
              ]
            },
            {
              "Type": "Leash",
              "Range": {
                "Compute": "BabyDirectFollowRadius"
              }
            }
          ]
        },
        "Reference": "Component_Instruction_Leash_To_Flock_Leader",
        "Modify": {
          "Enabled": {
            "Compute": "LeashEnabled"
          },
          "WanderRadius": {
            "Compute": "BabyDirectFollowRadius"
          },
          "StopDistance": {
            "Compute": "BabyDirectFollowStopDistance"
          },
          "RelativeSpeed": {
            "Compute": "BabyDirectFollowRelativeSpeed"
          }
        }
      }
    ]
  }
}
