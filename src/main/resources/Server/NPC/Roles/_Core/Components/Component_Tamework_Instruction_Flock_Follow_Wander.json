{
  "$Comment": "Applies flock leash behavior as an overlay using local substates and timers.",
  "Type": "Component",
  "Class": "Instruction",
  "DefaultState": ".Default",
  "Parameters": {
    "LeashEnabled": {
      "Value": true,
      "Description": "Whether follower-to-leader leash behavior is enabled."
    },
    "FlockFollowerWanderRadius": {
      "Value": 4,
      "Description": "How far followers are allowed to drift from their flock leader."
    },
    "FlockFollowerStopDistance": {
      "Value": 2,
      "Description": "How close followers stop when moving back toward their leader."
    },
    "FlockFollowerRelativeSpeed": {
      "Value": 1,
      "Description": "Relative speed used by leash seek behavior."
    },
    "BabyDirectFollowEnabled": {
      "Value": false,
      "Description": "Whether baby followers should tighten formation after leash catch-up."
    },
    "BabyDirectFollowRadius": {
      "Value": 3,
      "Description": "Extra-close leash radius used to trigger baby direct-follow catch-up."
    },
    "BabyDirectFollowStopDistance": {
      "Value": 1.5,
      "Description": "How close baby followers stop during direct-follow catch-up."
    },
    "BabyDirectFollowRelativeSpeed": {
      "Value": 1,
      "Description": "Relative speed used during baby direct-follow catch-up."
    },
    "BabyDirectFollowDurationRange": {
      "Value": [
        "PT6S",
        "PT12S"
      ],
      "Description": "How long babies remain in direct-follow after a leash trigger."
    }
  },
  "Content": {
    "Continue": true,
    "Sensor": {
      "Type": "Any"
    },
    "Instructions": [
      {
        "$Comment": "Enter timed baby direct-follow when a baby follower leashes too far.",
        "Continue": true,
        "Enabled": {
          "Compute": "BabyDirectFollowEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".Default"
            },
            {
              "Type": "TameworkLifeStage",
              "Stage": "Baby"
            },
            {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "FlockLeader"
                },
                {
                  "Type": "Self",
                  "Filters": [
                    {
                      "Type": "Flock",
                      "FlockStatus": "Follower"
                    }
                  ]
                }
              ]
            },
            {
              "Type": "Leash",
              "Range": {
                "Compute": "BabyDirectFollowRadius"
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "SetAlarm",
            "Name": "Tamework_Baby_DirectFollow_Window",
            "DurationRange": {
              "Compute": "BabyDirectFollowDurationRange"
            }
          },
          {
            "Type": "State",
            "State": ".FlockFollow"
          }
        ]
      },
      {
        "$Comment": "Enter standard flock-follow for non-babies when leash is needed.",
        "Continue": true,
        "Enabled": {
          "Compute": "LeashEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".Default"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "TameworkLifeStage",
                "Stage": "Baby"
              }
            },
            {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "FlockLeader"
                },
                {
                  "Type": "Self",
                  "Filters": [
                    {
                      "Type": "Flock",
                      "FlockStatus": "Follower"
                    }
                  ]
                }
              ]
            },
            {
              "Type": "Leash",
              "Range": {
                "Compute": "FlockFollowerWanderRadius"
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".FlockFollow"
          }
        ]
      },
      {
        "$Comment": "Safety: if follower/leader preconditions are lost, leave flock-follow.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".FlockFollow"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "And",
                "Sensors": [
                  {
                    "Type": "FlockLeader"
                  },
                  {
                    "Type": "Self",
                    "Filters": [
                      {
                        "Type": "Flock",
                        "FlockStatus": "Follower"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".Default"
          }
        ]
      },
      {
        "$Comment": "Exit timed baby direct-follow when its timer expires.",
        "Continue": true,
        "Enabled": {
          "Compute": "BabyDirectFollowEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".FlockFollow"
            },
            {
              "Type": "TameworkLifeStage",
              "Stage": "Baby"
            },
            {
              "Type": "Alarm",
              "Name": "Tamework_Baby_DirectFollow_Window",
              "State": "Passed",
              "Clear": true
            }
          ]
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".Default"
          }
        ]
      },
      {
        "$Comment": "Safety: if baby timed follow has no active timer, exit flock-follow.",
        "Continue": true,
        "Enabled": {
          "Compute": "BabyDirectFollowEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".FlockFollow"
            },
            {
              "Type": "TameworkLifeStage",
              "Stage": "Baby"
            },
            {
              "Type": "Alarm",
              "Name": "Tamework_Baby_DirectFollow_Window",
              "State": "Unset"
            }
          ]
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".Default"
          }
        ]
      },
      {
        "$Comment": "Exit standard flock-follow for non-babies once regrouped.",
        "Continue": true,
        "Enabled": {
          "Compute": "LeashEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".FlockFollow"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "TameworkLifeStage",
                "Stage": "Baby"
              }
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "Leash",
                "Range": {
                  "Compute": "FlockFollowerWanderRadius"
                }
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".Default"
          }
        ]
      },
      {
        "$Comment": "Timed direct-follow motion for babies while the follow timer is active.",
        "Enabled": {
          "Compute": "BabyDirectFollowEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".FlockFollow"
            },
            {
              "Type": "TameworkLifeStage",
              "Stage": "Baby"
            },
            {
              "Type": "Alarm",
              "Name": "Tamework_Baby_DirectFollow_Window",
              "State": "Set"
            },
            {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "FlockLeader"
                },
                {
                  "Type": "Self",
                  "Filters": [
                    {
                      "Type": "Flock",
                      "FlockStatus": "Follower"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "BodyMotion": {
          "Type": "Seek",
          "SlowDownDistance": {
            "Compute": "BabyDirectFollowStopDistance + 1"
          },
          "StopDistance": {
            "Compute": "BabyDirectFollowStopDistance"
          },
          "RelativeSpeed": {
            "Compute": "BabyDirectFollowRelativeSpeed"
          },
          "AbortDistance": 100
        }
      },
      {
        "$Comment": "Standard flock leash motion while in flock-follow substate for non-babies.",
        "Continue": true,
        "Enabled": {
          "Compute": "LeashEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".FlockFollow"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "TameworkLifeStage",
                "Stage": "Baby"
              }
            }
          ]
        },
        "Reference": "Component_Instruction_Leash_To_Flock_Leader",
        "Modify": {
          "Enabled": {
            "Compute": "LeashEnabled"
          },
          "WanderRadius": {
            "Compute": "FlockFollowerWanderRadius"
          },
          "StopDistance": {
            "Compute": "FlockFollowerStopDistance"
          },
          "RelativeSpeed": {
            "Compute": "FlockFollowerRelativeSpeed"
          }
        }
      }
    ]
  }
}
