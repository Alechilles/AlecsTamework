{
  "$Comment": "Applies flock leash behavior as an overlay using local substates and timeout chains.",
  "Type": "Component",
  "Class": "Instruction",
  "DefaultState": ".Default",
  "Parameters": {
    "LeashEnabled": {
      "Value": true,
      "Description": "Whether follower-to-leader leash behavior is enabled."
    },
    "FlockFollowerWanderRadius": {
      "Value": 4,
      "Description": "How far followers are allowed to drift from their flock leader."
    },
    "FlockFollowerStopDistance": {
      "Value": 2,
      "Description": "How close followers stop when moving back toward their leader."
    },
    "FlockFollowerRelativeSpeed": {
      "Value": 1,
      "Description": "Relative speed used by leash seek behavior."
    },
    "FlockFollowDurationRange": {
      "Value": [
        4,
        7
      ],
      "Description": "How long standard flock-follow runs after a leash trigger."
    },
    "BabyDirectFollowEnabled": {
      "Value": false,
      "Description": "Whether babies should use dedicated direct-follow speed/timing."
    },
    "BabyDirectFollowRadius": {
      "Value": 4,
      "Description": "Leash radius used while baby direct-follow is active."
    },
    "BabyDirectFollowStopDistance": {
      "Value": 1.5,
      "Description": "How close baby followers stop during timed direct-follow."
    },
    "BabyDirectFollowRelativeSpeed": {
      "Value": 1,
      "Description": "Relative speed used during timed baby direct-follow."
    },
    "BabyDirectFollowDurationRange": {
      "Value": [
        6,
        12
      ],
      "Description": "How long timed baby direct-follow runs after a leash trigger."
    }
  },
  "Content": {
    "Continue": true,
    "Sensor": {
      "Type": "Any"
    },
    "Instructions": [
      {
        "$Comment": "Non-baby followers: leash toward leader while remaining in default behavior flow.",
        "Continue": true,
        "Enabled": {
          "Compute": "LeashEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".Default"
            },
            {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "FlockLeader"
                },
                {
                  "Type": "Self",
                  "Filters": [
                    {
                      "Type": "Flock",
                      "FlockStatus": "Follower"
                    }
                  ]
                }
              ]
            },
            {
              "Type": "Leash",
              "Range": {
                "Compute": "FlockFollowerWanderRadius"
              }
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "TameworkLifeStage",
                "Stage": "Baby"
              }
            }
          ]
        },
        "Reference": "Component_Instruction_Leash_To_Flock_Leader",
        "Modify": {
          "Enabled": {
            "Compute": "LeashEnabled"
          },
          "WanderRadius": {
            "Compute": "FlockFollowerWanderRadius"
          },
          "StopDistance": {
            "Compute": "FlockFollowerStopDistance"
          },
          "RelativeSpeed": {
            "Compute": "FlockFollowerRelativeSpeed"
          }
        }
      },
      {
        "$Comment": "Enter baby-only direct-follow substate when a baby follower is outside leash range.",
        "Continue": true,
        "Enabled": {
          "Compute": "LeashEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".Default"
            },
            {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "FlockLeader"
                },
                {
                  "Type": "Self",
                  "Filters": [
                    {
                      "Type": "Flock",
                      "FlockStatus": "Follower"
                    }
                  ]
                }
              ]
            },
            {
              "Type": "Leash",
              "Range": {
                "Compute": "FlockFollowerWanderRadius"
              }
            },
            {
              "Type": "TameworkLifeStage",
              "Stage": "Baby"
            }
          ]
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Status"
          },
          {
            "Type": "State",
            "State": ".FlockFollow"
          }
        ]
      },
      {
        "$Comment": "Safety: non-babies must never remain in direct-follow state.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".FlockFollow"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "TameworkLifeStage",
                "Stage": "Baby"
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".StopFollow"
          }
        ]
      },
      {
        "$Comment": "Safety: if baby direct-follow is disabled, exit direct-follow state immediately.",
        "Continue": true,
        "Enabled": {
          "Compute": "!BabyDirectFollowEnabled"
        },
        "Sensor": {
          "Type": "State",
          "State": ".FlockFollow"
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".StopFollow"
          }
        ]
      },
      {
        "$Comment": "Safety: if flock leader/follower requirements are lost, leave local follow state.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".FlockFollow"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "And",
                "Sensors": [
                  {
                    "Type": "FlockLeader"
                  },
                  {
                    "Type": "Self",
                    "Filters": [
                      {
                        "Type": "Flock",
                        "FlockStatus": "Follower"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".StopFollow"
          }
        ]
      },
      {
        "$Comment": "Baby direct-follow branch (if enabled).",
        "Enabled": {
          "Compute": "BabyDirectFollowEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".FlockFollow"
            },
            {
              "Type": "TameworkLifeStage",
              "Stage": "Baby"
            }
          ]
        },
        "Instructions": [
          {
            "Continue": true,
            "Reference": "Component_Instruction_Leash_To_Flock_Leader",
            "Modify": {
              "Enabled": {
                "Compute": "LeashEnabled"
              },
              "WanderRadius": {
                "Compute": "BabyDirectFollowRadius"
              },
              "StopDistance": {
                "Compute": "BabyDirectFollowStopDistance"
              },
              "RelativeSpeed": {
                "Compute": "BabyDirectFollowRelativeSpeed"
              }
            }
          },
          {
            "Sensor": {
              "Type": "Any",
              "Once": true
            },
            "ActionsBlocking": true,
            "Actions": [
              {
                "Type": "Timeout",
                "Delay": {
                  "Compute": "BabyDirectFollowDurationRange"
                }
              },
              {
                "Type": "State",
                "State": ".LeashLatch"
              }
            ]
          }
        ]
      },
      {
        "$Comment": "Keep status slot clear while following so locomotion animations can play.",
        "Continue": true,
        "Sensor": {
          "Type": "State",
          "State": ".FlockFollow"
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Status"
          }
        ]
      },
      {
        "$Comment": "Cancel seek motion while latched, waiting for leash clear.",
        "Continue": true,
        "Sensor": {
          "Type": "State",
          "State": ".LeashLatch"
        },
        "BodyMotion": {
          "Type": "Nothing"
        }
      },
      {
        "$Comment": "Latch release: once leash condition clears, return to default and allow future trigger.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".LeashLatch"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "Leash",
                "Range": {
                  "Compute": "FlockFollowerWanderRadius"
                }
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".StopFollow"
          }
        ]
      },
      {
        "$Comment": "Safety: if leader/follower relationship is gone while latched, return to default.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": ".LeashLatch"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "And",
                "Sensors": [
                  {
                    "Type": "FlockLeader"
                  },
                  {
                    "Type": "Self",
                    "Filters": [
                      {
                        "Type": "Flock",
                        "FlockStatus": "Follower"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "State",
            "State": ".StopFollow"
          }
        ]
      },
      {
        "$Comment": "Hard stop: clear any lingering seek before returning to default behaviors.",
        "Continue": true,
        "Sensor": {
          "Type": "State",
          "State": ".StopFollow"
        },
        "BodyMotion": {
          "Type": "Nothing"
        }
      },
      {
        "$Comment": "One-tick local stop state to flush motion before returning to default.",
        "Sensor": {
          "Type": "State",
          "State": ".StopFollow"
        },
        "Instructions": [
          {
            "Sensor": {
              "Type": "Any",
              "Once": true
            },
            "ActionsBlocking": true,
            "Actions": [
              {
                "Type": "Timeout",
                "Delay": [
                  0,
                  0
                ]
              },
              {
                "Type": "State",
                "State": ".Default"
              }
            ]
          }
        ]
      }
    ]
  }
}
