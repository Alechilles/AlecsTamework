{
  "$Comment": "Applies flock leash behavior as an overlay. Uses FlockFollower* params for all roles; baby roles should override those params directly.",
  "Type": "Component",
  "Class": "Instruction",
  "Parameters": {
    "LeashEnabled": {
      "Value": true,
      "Description": "Whether follower-to-leader leash behavior is enabled."
    },
    "FlockFollowerWanderRadius": {
      "Value": 7,
      "Description": "How far followers are allowed to drift from their flock leader."
    },
    "FlockFollowerStopDistance": {
      "Value": 4,
      "Description": "How close followers stop when moving back toward their leader."
    },
    "FlockFollowerRelativeSpeed": {
      "Value": 0.7,
      "Description": "Relative speed used by leash seek behavior."
    },
    "FlockFollowerLeashSyncIntervalRange": {
      "Value": [
        0.5,
        2
      ],
      "Description": "How often follower leash position is refreshed to the current flock leader."
    }
  },
  "Content": {
    "Continue": true,
    "Sensor": {
      "Type": "Any"
    },
    "Instructions": [
      {
        "$Comment": "Keep the follower leash point synced to the current leader position.",
        "Continue": true,
        "Enabled": {
          "Compute": "LeashEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "FlockLeader"
            },
            {
              "Type": "Self",
              "Filters": [
                {
                  "Type": "Flock",
                  "FlockStatus": "Follower"
                }
              ]
            }
          ]
        },
        "Actions": [
          {
            "Type": "Timeout",
            "Delay": {
              "Compute": "FlockFollowerLeashSyncIntervalRange"
            },
            "Action": {
              "Type": "SetLeashPosition",
              "ToTarget": true
            }
          }
        ]
      },
      {
        "$Comment": "Clear status-slot posture loops so followers do not slide while leash movement is active.",
        "Continue": true,
        "Enabled": {
          "Compute": "LeashEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "FlockLeader"
                },
                {
                  "Type": "Self",
                  "Filters": [
                    {
                      "Type": "Flock",
                      "FlockStatus": "Follower"
                    }
                  ]
                }
              ]
            },
            {
              "Type": "Leash",
              "Range": {
                "Compute": "FlockFollowerWanderRadius"
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Status"
          }
        ]
      },
      {
        "$Comment": "Leash profile using role/template FlockFollower* values.",
        "Continue": true,
        "Enabled": {
          "Compute": "LeashEnabled"
        },
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "FlockLeader"
                },
                {
                  "Type": "Self",
                  "Filters": [
                    {
                      "Type": "Flock",
                      "FlockStatus": "Follower"
                    }
                  ]
                }
              ]
            },
            {
              "Type": "Leash",
              "Range": {
                "Compute": "FlockFollowerWanderRadius"
              }
            }
          ]
        },
        "Reference": "Component_Instruction_Leash_To_Flock_Leader",
        "Modify": {
          "Enabled": {
            "Compute": "LeashEnabled"
          },
          "WanderRadius": {
            "Compute": "FlockFollowerWanderRadius"
          },
          "StopDistance": {
            "Compute": "FlockFollowerStopDistance"
          },
          "RelativeSpeed": {
            "Compute": "FlockFollowerRelativeSpeed"
          }
        }
      }
    ]
  }
}
