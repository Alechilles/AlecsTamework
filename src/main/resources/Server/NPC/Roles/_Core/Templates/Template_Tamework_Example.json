  "StateTransitions": [
    {
      "$Comment": "Play sleep animation when entering Sleep from Idle/Hold. If your NPC uses looping sit/lie animations, add an extra transition that plays a stand-up animation when leaving that state.",
      "States": [
        {
          "From": [
            "Idle",
            "Hold"
          ],
          "To": [
            "Sleep"
          ]
        }
      ],
      "Actions": {
        "Reference": "Component_ActionList_Sleep"
      }
    },
    {
      "$Comment": "Play wake animation when leaving Sleep.",
      "States": [
        {
          "From": [
            "Sleep"
          ],
          "To": [
            "Idle",
            "Hold",
            "Defend"
          ]
        }
      ],
      "Actions": {
        "Reference": "Component_ActionList_Wake"
      }
    },
    {
      "$Comment": "Clear any looping status animation when leaving Hold/Sleep so locomotion can play.",
      "States": [
        {
          "From": [
            "Hold",
            "Sleep",
            "NeedsSeekWater",
            "NeedsSeekFood"
          ],
          "To": [
            "Idle",
            "Defend"
          ]
        }
      ],
      "Actions": [
        {
          "Type": "PlayAnimation",
          "Slot": "Status"
        }
      ]
    },
    {
      "$Comment": "Clear looping status animation when entering needs seek from hold/sleep.",
      "States": [
        {
          "From": [
            "Hold",
            "Sleep"
          ],
          "To": [
            "NeedsSeekWater",
            "NeedsSeekFood"
          ]
        }
      ],
      "Actions": [
        {
          "Type": "PlayAnimation",
          "Slot": "Status"
        }
      ]
    }
  ],
  "Instructions": [
    {
      "$Comment": "Bridge command-item move hooks into NPC movement.",
      "Continue": true,
      "Sensor": {
        "Type": "Any"
      },
      "Instructions": [
        {
          "Reference": "Component_Tamework_Instruction_Command_Move",
          "Modify": {
            "_ExportStates": [
              "CommandMove",
              "Hold"
            ]
          }
        }
      ]
    },
    {
      "$Comment": "No-op branch to pair the CommandMove state with a state sensor.",
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "CommandMove"
      }
    },
    {
      "$Comment": "Bridge needs-seek sensor pass while in Idle state.",
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "Idle"
      },
      "Instructions": [
        {
          "Reference": "Component_Tamework_Instruction_Needs_Seek_Resource_Sensor",
          "Modify": {
            "NeedsSeekFoodItemIds": {
              "Compute": "FoodItemIDs"
            },
            "_ExportStates": [
              "NeedsSeekWater",
              "NeedsSeekFood"
            ]
          }
        }
      ]
    },
    {
      "$Comment": "Needs-seek water movement runtime while in NeedsSeekWater state.",
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "NeedsSeekWater"
      },
      "Instructions": [
        {
          "Reference": "Component_Tamework_Instruction_Needs_Seek_Resource",
          "Modify": {
            "NeedsSeekResourceType": "Water",
            "_ExportStates": [
              "Idle"
            ]
          }
        }
      ]
    },
    {
      "$Comment": "Needs-seek food movement runtime while in NeedsSeekFood state.",
