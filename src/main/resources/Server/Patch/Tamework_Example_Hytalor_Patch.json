                {
                  "Type": "TameworkIsOwner"
                },
                {
                  "Type": "TameworkIsTamed"
                },
                {
                  "Type": "State",
                  "State": "Idle"
                }
              ]
            },
            "Actions": [
              {
                "Type": "State",
                "State": "Follow"
              },
              {
                "Type": "SpawnParticles",
                "Offset": {
                  "Compute": "InteractParticleOffset"
                },
                "ParticleSystem": "Follow"
              },
              {
                "Type": "PlaySound",
                "SoundEventId": {
                  "Compute": "InteractSoundFollow"
                }
              }
            ]
          }
        ],
        "_find": {
          "$Comment": "Tamework: HasInteracted"
        },
        "$Comment": "Tamework: HasInteracted"
      },
      {
        "_op": "replace",
        "_findAll": "$[?(@.Enabled && @.Enabled.Compute=='IsHarvestable')]",
        "Enabled": {
          "Compute": "IsHarvestable"
        },
        "Instructions": [
          {
            "Sensor": {
              "$Comment": "Check the negative first so we can exit early and avoid the rest of the logic",
              "Type": "Not",
              "Sensor": {
                "Type": "And",
                "Sensors": [
                  {
                    "Type": "Alarm",
                    "Name": "Harvest_Ready",
                    "State": "Unset"
                  },
                  {
                    "Type": "CanInteract",
                    "Attitudes": {
                      "Compute": "HarvestRequiredAttitudes"
                    }
                  }
                ]
              }
            },
            "Actions": [
              {
                "Type": "SetInteractable",
                "Interactable": true,
                "ShowPrompt": false
              }
            ]
          },
          {
            "$Comment": "Allow contextual interactions (shearing) but hide F key prompt",
            "Continue": true,
            "Sensor": {
              "Type": "Any"
            },
            "Actions": [
              {
                "Type": "SetInteractable",
                "Interactable": true,
                "ShowPrompt": false
              }
            ]
          },
          {
            "$Comment": "Harvest action triggered by left-click with appropriate tool",
            "Sensor": {
              "Type": "And",
              "Sensors": [
                {
                  "Enabled": {
                    "Compute": "!isEmpty(HarvestInteractionContext)"
                  },
                  "Type": "InteractionContext",
                  "Context": {
                    "Compute": "HarvestInteractionContext"
                  }
                },
                {
                  "Type": "Alarm",
                  "Name": "Harvest_Ready",
                  "State": "Unset"
                }
              ]
            },
            "Actions": [
              {
                "Type": "State",
                "State": "$Harvest"
              }
            ]
          }
        ]
      },
      {
        "_op": "replace",
        "_findAll": "$[?(@.Enabled && @.Enabled.Compute=='IsMountable')]",
        "Enabled": {
          "Compute": "false"
        },
        "Instructions": []
      }
    ]
  },
  "StateTransitions": [
    {
      "$Comment": "Allow tamework follow/hold state changes.",
      "_op": "add",
      "States": [
