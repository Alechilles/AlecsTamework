$A = "TameworkPanelActionStyles.ui";
$C = "Common.ui";

Group {
  Anchor: (Top: 0, Left: 0, Right: 0, Height: 30);

  Group #FieldRowBackground {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Background: #202723;
  }

  Group #FieldGuideDepth1 {
    Anchor: (Top: 0, Left: 14, Width: 2, Bottom: 0);
    Background: #526a57;
    Visible: false;
  }

  Group #FieldGuideDepth2 {
    Anchor: (Top: 0, Left: 36, Width: 2, Bottom: 0);
    Background: #526a57;
    Visible: false;
  }

  Label #FieldNameTop {
    Anchor: (Top: 3, Left: 8, Width: 304, Height: 24);
    Text: %server.tamework.ui.configEditor.field.nameDefault;
    Style: (FontSize: 12, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
  }

  Label #FieldNameNested {
    Anchor: (Top: 3, Left: 30, Width: 282, Height: 24);
    Text: %server.tamework.ui.configEditor.field.nameDefault;
    Style: (FontSize: 12, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
    Visible: false;
  }

  Label #FieldNameDeep {
    Anchor: (Top: 3, Left: 52, Width: 260, Height: 24);
    Text: %server.tamework.ui.configEditor.field.nameDefault;
    Style: (FontSize: 12, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
    Visible: false;
  }

  TextButton #FieldTooltipButton {
    Anchor: (Top: 3, Left: 8, Width: 304, Height: 24);
    Text: "";
    TooltipText: "";
    Style: TextButtonStyle(
      Default: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
      Hovered: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
      Pressed: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
      Disabled: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000))
    );
    Visible: false;
  }

  Label #FieldModeChip {
    Anchor: (Top: 3, Left: 374, Width: 74, Height: 24);
    Text: %server.tamework.ui.configEditor.field.mode.noLocal;
    Style: (FontSize: 11, TextColor: #afb6b0, HorizontalAlignment: Center, VerticalAlignment: Center);
    Visible: false;
  }

  Group #FieldStateBadge {
    Anchor: (Top: 3, Left: 294, Width: 16, Height: 24);
    LayoutMode: Middle;
    Visible: false;

    Group {
      Anchor: (Width: 16, Height: 16);
      Background: #00000000;

      Group #FieldStateBadgeCheckIcon {
        Anchor: (Top: 1, Left: 1, Width: 14, Height: 14);
        Background: "TwConfigAccept.png";
        Visible: false;
      }

      Group #FieldStateBadgeCautionIcon {
        Anchor: (Top: 0, Left: 0, Width: 16, Height: 16);
        Background: "TwConfigCaution.png";
        Visible: false;
      }
    }
  }

  TextButton #FieldSourceChip {
    Anchor: (Top: 3, Left: 374, Width: 88, Height: 24);
    Text: %server.tamework.ui.configEditor.source.default.label;
    Style: $A.@PanelButton;
    TooltipText: "";
  }

  Group #FieldValueHost {
    Anchor: (Top: 3, Left: 466, Right: 6, Height: 24);

    CheckBox #FieldCheckBox {
      Anchor: (Top: 1, Left: 0, Width: 22, Height: 22);
      Background: #252c27;
      OutlineColor: #4a5a50;
      OutlineSize: 1;
      Padding: (Full: 4);
      Style: $C.@DefaultCheckBoxStyle;
      Visible: false;
    }

    TextField #FieldTextInput {
      Anchor: (Top: 0, Left: 0, Right: 0, Height: 24);
      Style: $A.@PanelInputFieldStyle;
      PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
      Background: #252c27;
      Padding: (Horizontal: 8);
      PlaceholderText: %server.tamework.ui.configEditor.field.valuePlaceholder;
      MaxLength: 256;
      Visible: false;
    }

    DropdownBox #FieldDropdown {
      Anchor: (Top: 0, Left: 0, Right: 0, Height: 24);
      Style: (...$A.@PanelDropdown, HorizontalPadding: 8);
      MaxSelection: 1;
      NoItemsText: %server.tamework.ui.configEditor.field.noOptions;
      Visible: false;
    }

    Label #FieldHandoff {
      Anchor: (Top: 0, Left: 0, Right: 0, Height: 24);
      Text: "";
      Style: (FontSize: 11, TextColor: #afb6b0, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      Visible: false;
    }
  }

  TextButton #FieldResetButton {
    Anchor: (Top: 3, Left: 314, Width: 56, Height: 24);
    Text: %server.tamework.ui.shared.button.reset;
    Style: $A.@PanelButton;
    Visible: false;
  }
}

