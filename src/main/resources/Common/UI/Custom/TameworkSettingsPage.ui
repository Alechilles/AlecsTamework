$A = "TameworkPanelActionStyles.ui";
$C = "Common.ui";

@SettingsLabelTooltipStyle = $C.@DefaultTextTooltipStyle;

@SettingsLabelTooltipButtonStyle = TextButtonStyle(
  Default: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Hovered: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Pressed: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Disabled: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000))
);

$C.@PageOverlay {
  LayoutMode: Middle;

  Group #TwSettingsRoot {
    Anchor: (Width: 740, Height: 760);
    Background: (TexturePath: "Tamework/PanelActions/Base_Default.png", Border: 3);

    Group #Title {
      Anchor: (Top: 3, Left: 3, Right: 3, Height: 48);
      Background: #252b27;
      Group { Anchor: (Top: 7, Left: 12, Width: 34, Height: 34); Background: "Tamework/Telemetry/TameworkConsentIcon.png"; }
      Label #TwSettingsTitle {
        Anchor: (Left: 56, Right: 278, Height: 48);
        Text: "Tamework Settings";
        Style: (FontSize: 23, RenderBold: true, TextColor: #f0eee7, VerticalAlignment: Center);
      }
      TextButton #TwSettingsRefreshButton {
        Anchor: (Top: 9, Right: 164, Width: 96, Height: 30);
        Text: "Refresh";
        Style: $A.@PanelButton;
      }
      TextButton #TwSettingsApplyButton {
        Anchor: (Top: 9, Right: 58, Width: 96, Height: 30);
        Text: "Apply";
        Style: $A.@PanelButtonSelected;
      }
      Group {
        Anchor: (Top: 9, Right: 14, Width: 30, Height: 30);
        TextButton #TwSettingsCloseButton {
          Anchor: (Full: 0);
          Text: "";
          TooltipText: %server.tamework.ui.shared.button.close;
          Style: $A.@Remove;
        }
        Group { Anchor: (Top: 3, Left: 3, Width: 24, Height: 24); HitTestVisible: false; Background: "Tamework/PanelActions/Remove_Glyph_Default.png"; }
      }
    }

    Group #Content {
      Anchor: (Top: 56, Left: 10, Right: 10, Bottom: 12);
      LayoutMode: Top;
      Padding: (Left: 10, Right: 10, Top: 6, Bottom: 8);

      Group #TwSettingsUnsavedWarning {
        Anchor: (Height: 20);
        Visible: false;

        // One visible frame and one transparent frame, each held for one second.
        Sprite {
          Anchor: (Left: 0, Width: 20, Height: 20);
          TexturePath: "Tamework/PanelActions/UnsavedWarning.png";
          Frame: (Width: 32, Height: 32, PerRow: 2, Count: 2);
          FramesPerSecond: 1;
          RepeatCount: 0;
        }

        Label #TwSettingsUnsavedText {
          Anchor: (Left: 26, Right: 26, Height: 20);
          Text: "";
          Style: (FontSize: 14, RenderBold: true, TextColor: #ffcf40, HorizontalAlignment: Center, VerticalAlignment: Center);
        }

        Sprite {
          Anchor: (Right: 0, Width: 20, Height: 20);
          TexturePath: "Tamework/PanelActions/UnsavedWarning.png";
          Frame: (Width: 32, Height: 32, PerRow: 2, Count: 2);
          FramesPerSecond: 1;
          RepeatCount: 0;
        }
      }

      Label #TwSettingsStatusLine {
        Anchor: (Top: 0, Height: 20);
        Text: "";
        Style: (FontSize: 12, TextColor: #c4dbc9, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      Group {
        Anchor: (Top: 6);
        FlexWeight: 1;
        Background: #181c1a;
        Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);

        Group #TwSettingsViewport {
          Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
          LayoutMode: TopScrolling;
          KeepScrollPosition: true;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Left: 4, Right: 0, Top: 2, Bottom: 2);

          Group #TwSettingsRows {
            LayoutMode: Top;
            Anchor: (Left: 0, Right: 0, Bottom: 0);

            Group {
              Anchor: (Height: 34);
              Background: #252c27;
              Padding: (Left: 8, Right: 8);

              Label #TwSettingsExperiencePresetsLabel {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "Experience Presets";
                Style: (FontSize: 16, RenderBold: true, TextColor: #c4dbc9, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsExperiencePresetsTooltip {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "";
                TooltipText: "Loads bundled presets for the major companion experience toggles below without changing the rest of the settings page.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsLoadPresetLabel {
                Anchor: (Left: 0, Width: 120, Height: 28);
                Text: "Load Preset";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsLoadPresetTooltip {
                Anchor: (Left: 0, Width: 120, Height: 28);
                Text: "";
                TooltipText: "Choose a preset to change the companion experience toggles below. Review the rest of the page before applying.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              DropdownBox #TwSettingsPresetDropdown {
                Anchor: (Left: 126, Width: 220, Height: 28);
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8);
                MaxSelection: 1;
                NoItemsText: "No preset";
              }

              TextButton #TwSettingsLoadPresetButton {
                Anchor: (Left: 354, Width: 110, Height: 28);
                Text: "Load Preset";
                Style: $A.@PanelButton;
              }
            }

            Group {
              Anchor: (Height: 18);

              Label #TwSettingsPresetNoteLabel {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "Presets only change the experience toggles below. Review everything else before applying.";
                Style: (FontSize: 11, TextColor: #afb6b0, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
              }

              TextButton #TwSettingsPresetNoteTooltip {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "";
                TooltipText: "Preset loads only affect the main experience toggles in this section. They do not change ownership, population, or claims settings.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 34);
              Background: #252c27;
              Padding: (Left: 8, Right: 8);

              Label #TwSettingsRecallSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "Recall / Return Home";
                Style: (FontSize: 16, RenderBold: true, TextColor: #c4dbc9, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsRecallSectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "";
                TooltipText: "Controls whether recall and return-home commands may teleport companions when normal movement cannot reach them.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsRecallTeleportingLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Enable Recall Teleporting";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsRecallTeleportingTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "When disabled, recall and return-home commands will not teleport unloaded or distant companions. Use Locate to see their last recorded location.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsRecallTeleportingEnabledCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 34);
              Background: #252c27;
              Padding: (Left: 8, Right: 8);

              Label #TwSettingsCompanionSystemsLabel {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "Companion Systems";
                Style: (FontSize: 16, RenderBold: true, TextColor: #c4dbc9, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsCompanionSystemsTooltip {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "";
                TooltipText: "High-level toggles for the main companion gameplay systems that Tamework can run.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsNeedsEnabledLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Enable Needs System";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsEnabledTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Turns hunger and thirst simulation on or off for companions.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsNeedsEnabledCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsHappinessEnabledLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Enable Happiness System";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsHappinessEnabledTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Turns happiness tracking on or off for companions.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsHappinessEnabledCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsPassiveBreedingEnabledLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Enable Passive Breeding";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsPassiveBreedingTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Allows companions to breed on their own when breeding conditions are met.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsPassiveBreedingEnabledCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsBreedingRequiresHappinessLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Breeding Requires Happiness";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsBreedingRequiresHappinessTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Requires companions to satisfy happiness rules before passive breeding can happen.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsBreedingRequiresHappinessCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsLevelingEnabledLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Enable Leveling System";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsLevelingEnabledTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Allows companions to gain XP, level up, and apply level-based stat growth.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsLevelingEnabledCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsTalentsEnabledLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Enable Talents System";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsTalentsEnabledTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Allows companion talent points, talent spending, and purchased passive talent effects.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsTalentsEnabledCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsBreedingGenderEnabledLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Enable Breeding Genders";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsBreedingGenderTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Turns companion gender assignment and gender-aware breeding checks on or off.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsBreedingGenderEnabledCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsTraitsEnabledLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Enable Traits System";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsTraitsEnabledTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Turns trait generation and trait-based companion effects on or off.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsTraitsEnabledCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 34);
              Background: #252c27;
              Padding: (Left: 8, Right: 8);

              Label #TwSettingsNeedsSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "Needs (Hunger/Thirst)";
                Style: (FontSize: 16, RenderBold: true, TextColor: #c4dbc9, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsSectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "";
                TooltipText: "Controls hunger and thirst damage, offline decay behavior, and how needs-based damage is calculated.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsNeedsResourceModeLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Needs Resource Mode";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsResourceModeTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Controls how hungry or thirsty companions reach food and water.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              DropdownBox #TwSettingsNeedsResourceModeDropdown {
                Anchor: (Left: 356, Width: 290, Height: 28);
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8);
                MaxSelection: 1;
                NoItemsText: "No resource modes";
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsNeedsDamageEnabledLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Enable Hunger/Thirst Damage";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsDamageEnabledTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Applies damage when hunger or thirst reaches the configured minimum threshold.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsNeedsDamageEnabledCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsNeedsTickPolicyModeLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Needs Tick Policy";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsTickPolicyTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Chooses when needs are allowed to tick, such as after an owner's offline grace period or whenever any player keeps the area loaded.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              DropdownBox #TwSettingsNeedsTickPolicyModeDropdown {
                Anchor: (Left: 356, Width: 290, Height: 28);
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8);
                MaxSelection: 1;
                NoItemsText: "No policy";
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsNeedsOwnerOfflineGraceHoursLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Owner Offline Grace Hours";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsOfflineGraceTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "How many hours an owner can stay offline before needs begin decaying under the owner-online grace policy.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              TextField #TwSettingsNeedsOwnerOfflineGraceHoursInput {
                Anchor: (Left: 356, Width: 290, Height: 28);
                Style: $A.@PanelInputFieldStyle;
                PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
                Background: #252c27;
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Horizontal: 8);
                PlaceholderText: "72";
                MaxLength: 12;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsNeedsOwnerOfflineDecayMultiplierLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Owner Offline Decay Multiplier";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsOfflineDecayMultiplierTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Multiplier applied to needs decay after the owner has been offline longer than the grace period.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              TextField #TwSettingsNeedsOwnerOfflineDecayMultiplierInput {
                Anchor: (Left: 356, Width: 290, Height: 28);
                Style: $A.@PanelInputFieldStyle;
                PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
                Background: #252c27;
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Horizontal: 8);
                PlaceholderText: "1";
                MaxLength: 12;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsNeedsDamageModelLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Needs Damage Model";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsDamageModelTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Chooses how starvation or dehydration damage is calculated once a need bottoms out.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              DropdownBox #TwSettingsNeedsDamageModelDropdown {
                Anchor: (Left: 356, Width: 290, Height: 28);
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8);
                MaxSelection: 1;
                NoItemsText: "No model";
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsNeedsDamageDualNeedRuleLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Dual Need Rule";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsDualNeedRuleTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Chooses whether low hunger and low thirst use only the higher damage amount or add both together.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              DropdownBox #TwSettingsNeedsDamageDualNeedRuleDropdown {
                Anchor: (Left: 356, Width: 290, Height: 28);
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8);
                MaxSelection: 1;
                NoItemsText: "No rule";
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsNeedsStarvationDamagePerMinuteLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Starvation Damage Per Minute";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsStarvationDamageTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Damage applied per minute when hunger is depleted and the current damage model uses starvation damage.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              TextField #TwSettingsNeedsStarvationDamagePerMinuteInput {
                Anchor: (Left: 356, Width: 290, Height: 28);
                Style: $A.@PanelInputFieldStyle;
                PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
                Background: #252c27;
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Horizontal: 8);
                PlaceholderText: "2";
                MaxLength: 12;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsNeedsDehydrationDamagePerMinuteLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Dehydration Damage Per Minute";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsDehydrationDamageTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Damage applied per minute when thirst is depleted and the current damage model uses dehydration damage.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              TextField #TwSettingsNeedsDehydrationDamagePerMinuteInput {
                Anchor: (Left: 356, Width: 290, Height: 28);
                Style: $A.@PanelInputFieldStyle;
                PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
                Background: #252c27;
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Horizontal: 8);
                PlaceholderText: "3";
                MaxLength: 12;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsNeedsDamageLethalLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Needs Damage Is Lethal";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsDamageLethalTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "When enabled, needs damage can kill companions. When disabled, it stops at 1 health.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsNeedsDamageLethalCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 34);
              Background: #252c27;
              Padding: (Left: 8, Right: 8);

              Label #TwSettingsOwnershipSectionLabel {
