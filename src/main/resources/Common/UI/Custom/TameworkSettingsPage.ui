            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 34);
              Background: #252c27;
              Padding: (Left: 8, Right: 8);

              Label #TwSettingsReviveSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "Revive System";
                Style: (FontSize: 16, RenderBold: true, TextColor: #c4dbc9, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsReviveSectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "";
                TooltipText: "Controls whether dead owned companions can use Tamework's revive flow.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsReviveSystemEnabledLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Enable Revive System";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsReviveEnabledTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Allows supported Tamework revive and respawn behavior for owned companions.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsReviveSystemEnabledCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 34);
              Background: #252c27;
              Padding: (Left: 8, Right: 8);

              Label #TwSettingsPopulationSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "Population";
                Style: (FontSize: 16, RenderBold: true, TextColor: #c4dbc9, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsPopulationSectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "";
                TooltipText: "Controls the per-player owned companion cap used by Tamework.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsPopulationLimitLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Limit Per Player Owned Total";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsPopulationLimitTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Maximum number of owned companions a player can have before Tamework blocks additional ownership or acquisition.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              TextField #TwSettingsPopulationLimitInput {
                Anchor: (Left: 356, Width: 290, Height: 28);
                Style: $A.@PanelInputFieldStyle;
                PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
                Background: #252c27;
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Horizontal: 8);
                PlaceholderText: "0";
                MaxLength: 8;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsPopulationScopeLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Per Player Limit Scope";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsPopulationScopeTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Chooses whether the population limit is counted separately per world or across the entire universe.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              DropdownBox #TwSettingsPopulationScopeDropdown {
                Anchor: (Left: 356, Width: 290, Height: 28);
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8);
                MaxSelection: 1;
                NoItemsText: "No scope";
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 34);
              Background: #252c27;
              Padding: (Left: 8, Right: 8);

              Label #TwSettingsSimpleClaimsSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "Simple Claims";
                Style: (FontSize: 16, RenderBold: true, TextColor: #c4dbc9, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsSimpleClaimsSectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "";
                TooltipText: "Controls Tamework's integration with Simple Claims for breeding and protection rules.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsSimpleClaimsEnabledLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Enable Simple Claims Integration";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsSimpleClaimsEnabledTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Turns Simple Claims integration on or off for claim-aware breeding and protection checks.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsSimpleClaimsEnabledCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
