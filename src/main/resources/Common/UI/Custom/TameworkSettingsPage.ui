            Group {
              Anchor: (Height: 18);

              Label #TwSettingsCaptureTradeNoteLabel {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "Note: Enabling both allows trading captured mobs between players.";
                Style: (FontSize: 11, TextColor: #afb6b0, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsOwnershipTradingNoteTooltip {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "";
                TooltipText: "If both capture clears owner and spawn sets owner are enabled, captured companions can be transferred between players.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Top: 4, Height: 18);

              Label #TwSettingsGeneralSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "General";
                Style: (FontSize: 12, RenderBold: true, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsOwnershipGeneralTooltip {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "";
                TooltipText: "Owner requirement rules for common companion interactions.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsInteractionRequiresOwnerLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Interaction Requires Owner";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsInteractionRequiresOwnerTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Restricts supported companion interactions so only the owner can use them.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsInteractionRequiresOwnerCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsLinkingRequiresOwnerLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Linking Requires Owner";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsLinkingRequiresOwnerTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Restricts command-item linking so only the owner can link a companion.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsLinkingRequiresOwnerCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
