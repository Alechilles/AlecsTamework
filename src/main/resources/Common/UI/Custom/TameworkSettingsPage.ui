                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: %server.tamework.ui.settings.tooltip.breedingRequiresClaim;
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsBreedingRequiresClaimCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: $A.@SlateQuiet;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsSimpleClaimsProtectLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: %server.tamework.ui.settings.label.simpleClaimsProtect;
                Style: (FontSize: 13, TextColor: #c2ccd6, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsSimpleClaimsProtectTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: %server.tamework.ui.settings.tooltip.simpleClaimsProtect;
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsSimpleClaimsProtectCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: $A.@SlateQuiet;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 34);

              Group { Anchor: (Left: 0, Top: 7, Width: 4, Height: 20); Background: #5fe0c0; }
              Group { Anchor: (Left: 0, Right: 12, Bottom: 0, Height: 1); Background: #ffffff(0.1); }

              Label #TwSettingsTelemetrySectionLabel {
                Anchor: (Left: 14, Right: 12, Height: 34);
                Text: %server.tamework.ui.settings.label.telemetrySection;
                Style: @SettingsSectionLabel;
              }

              TextButton #TwSettingsCrashTelemetrySectionTooltip {
                Anchor: (Left: 0, Right: 12, Height: 34);
                Text: "";
                TooltipText: %server.tamework.ui.settings.tooltip.telemetrySection;
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 44);

              Label #TwSettingsTelemetryConsentInstructionLabel {
                Anchor: (Left: 0, Right: 16, Height: 42);
                Text: %server.tamework.ui.settings.note.telemetryConsentCommand;
                Style: (FontSize: 13, TextColor: #c2ccd6, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
              }
            }
          }
        }
      }
    }
  }
}


