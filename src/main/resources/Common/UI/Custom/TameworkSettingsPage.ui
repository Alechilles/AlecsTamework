                Style: @SettingsLabelTooltipButtonStyle;
              }

              TextField #TwSettingsClaimLimitChunkInput {
                Anchor: (Left: 356, Width: 290, Height: 28);
                Style: $A.@PanelInputFieldStyle;
                PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
                Background: #252c27;
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Horizontal: 8);
                PlaceholderText: "0";
                MaxLength: 8;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsClaimLimitTotalLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Breeding Limit Per Claim Total";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsClaimLimitTotalTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Maximum number of bred companions allowed across the entire claim.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              TextField #TwSettingsClaimLimitTotalInput {
                Anchor: (Left: 356, Width: 290, Height: 28);
                Style: $A.@PanelInputFieldStyle;
                PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
                Background: #252c27;
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Horizontal: 8);
                PlaceholderText: "0";
                MaxLength: 8;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsBreedingRequiresClaimLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Breeding Requires Claim";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsBreedingRequiresClaimTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Requires breeding to happen inside a Simple Claims claim.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsBreedingRequiresClaimCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsSimpleClaimsProtectLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Protect Tamed From Non-Members";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsSimpleClaimsProtectTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Prevents non-members of a claim from harming or interfering with owned companions inside that claim.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsSimpleClaimsProtectCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 34);
              Background: #252c27;
              Padding: (Left: 8, Right: 8);

              Label #TwSettingsTelemetrySectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "Beacon Consent";
                Style: (FontSize: 16, RenderBold: true, TextColor: #c4dbc9, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsCrashTelemetrySectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "";
                TooltipText: "Telemetry consent is managed by the shared Beacon command.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 44);

              Label #TwSettingsTelemetryConsentInstructionLabel {
                Anchor: (Left: 0, Right: 16, Height: 42);
                Text: "Use /beacon consent to review or change Tamework telemetry consent. This settings page no longer edits telemetry.";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
              }
            }
          }
        }
      }
    }
  }
}


