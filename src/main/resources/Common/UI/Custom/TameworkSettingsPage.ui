$C = "Common.ui";

@SettingsLabelTooltipStyle = TextTooltipStyle(
  Background: #0f1e30(0.96),
  MaxWidth: 280,
  LabelStyle: (Wrap: true, FontSize: 13, TextColor: #eef4fb),
  Padding: 12
);

@SettingsLabelTooltipButtonStyle = TextButtonStyle(
  Default: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Hovered: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Pressed: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Disabled: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000))
);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer #TwSettingsRoot {
    Anchor: (Width: 590, Height: 700);

    #Title {
      $C.@Title #TwSettingsTitle {
        @Alignment = Start;
        @Text = "Tamework Settings";
      }

      Group {
        Anchor: (Top: 5, Right: 10, Width: 304, Height: 24);

        TextButton #TwSettingsRefreshButton {
          Anchor: (Left: 0, Width: 94, Height: 24);
          Text: "Refresh";
          Style: (...$C.@SmallSecondaryTextButtonStyle);
        }

        TextButton #TwSettingsApplyButton {
          Anchor: (Left: 102, Width: 94, Height: 24);
          Text: "Apply";
          Style: (...$C.@SmallSecondaryTextButtonStyle);
        }

        TextButton #TwSettingsCloseButton {
          Anchor: (Right: 0, Width: 94, Height: 24);
          Text: "Close";
          Style: (...$C.@SmallSecondaryTextButtonStyle);
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 10, Right: 10, Top: 6, Bottom: 8);

      Label #TwSettingsStatusLine {
        Anchor: (Top: 0, Height: 20);
        Text: "";
        Style: (FontSize: 12, TextColor: #c6d7ea, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      Group {
        Anchor: (Top: 6);
        FlexWeight: 1;
        Background: #13243a;
        Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);

        Group #TwSettingsViewport {
          Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
          LayoutMode: TopScrolling;
          KeepScrollPosition: true;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Left: 4, Right: 0, Top: 2, Bottom: 2);

          Group #TwSettingsRows {
            LayoutMode: Top;
            Anchor: (Left: 0, Right: 0, Bottom: 0);

            Group {
              Anchor: (Height: 24);

              Label #TwSettingsExperiencePresetsLabel {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "Experience Presets";
                Style: (FontSize: 16, RenderBold: true, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsExperiencePresetsTooltip {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "";
                TooltipText: "Loads bundled presets for the major companion experience toggles below without changing the rest of the settings page.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsLoadPresetLabel {
                Anchor: (Left: 0, Width: 120, Height: 24);
                Text: "Load Preset";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsLoadPresetTooltip {
                Anchor: (Left: 0, Width: 120, Height: 24);
                Text: "";
                TooltipText: "Choose a preset to change the companion experience toggles below. Review the rest of the page before applying.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              DropdownBox #TwSettingsPresetDropdown {
                Anchor: (Left: 126, Width: 220, Height: 24);
                Style: (...$C.@DefaultDropdownBoxStyle, HorizontalPadding: 8);
                MaxSelection: 1;
                NoItemsText: "No preset";
              }

              TextButton #TwSettingsLoadPresetButton {
                Anchor: (Left: 354, Width: 110, Height: 24);
                Text: "Load Preset";
                Style: (...$C.@SmallSecondaryTextButtonStyle);
              }
            }

            Group {
              Anchor: (Height: 18);

              Label #TwSettingsPresetNoteLabel {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "Presets only change the experience toggles below. Review everything else before applying.";
                Style: (FontSize: 11, TextColor: #9fb5ce, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
              }

              TextButton #TwSettingsPresetNoteTooltip {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "";
                TooltipText: "Preset loads only affect the main experience toggles in this section. They do not change ownership, population, or claims settings.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 24);

              Label #TwSettingsRecallSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "Recall / Return Home";
                Style: (FontSize: 16, RenderBold: true, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsRecallSectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "";
                TooltipText: "Controls whether recall and return-home commands may teleport companions when normal movement cannot reach them.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsRecallTeleportingLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Enable Recall Teleporting";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsRecallTeleportingTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "When disabled, recall and return-home commands will not teleport unloaded or distant companions. Use Locate to see their last recorded location.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsRecallTeleportingEnabledCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 24);

              Label #TwSettingsCompanionSystemsLabel {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "Companion Systems";
                Style: (FontSize: 16, RenderBold: true, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsCompanionSystemsTooltip {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "";
                TooltipText: "High-level toggles for the main companion gameplay systems that Tamework can run.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsNeedsEnabledLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Enable Needs System";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsEnabledTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Turns hunger and thirst simulation on or off for companions.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsNeedsEnabledCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsHappinessEnabledLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Enable Happiness System";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsHappinessEnabledTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Turns happiness tracking on or off for companions.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsHappinessEnabledCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsPassiveBreedingEnabledLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Enable Passive Breeding";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsPassiveBreedingTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Allows companions to breed on their own when breeding conditions are met.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsPassiveBreedingEnabledCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsBreedingRequiresHappinessLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Breeding Requires Happiness";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsBreedingRequiresHappinessTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Requires companions to satisfy happiness rules before passive breeding can happen.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsBreedingRequiresHappinessCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsLevelingEnabledLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Enable Leveling System";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsLevelingEnabledTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Allows companions to gain XP, level up, and apply level-based stat growth.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsLevelingEnabledCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsTalentsEnabledLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Enable Talents System";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsTalentsEnabledTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Allows companion talent points, talent spending, and purchased passive talent effects.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsTalentsEnabledCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsBreedingGenderEnabledLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Enable Breeding Genders";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsBreedingGenderTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Turns companion gender assignment and gender-aware breeding checks on or off.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsBreedingGenderEnabledCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsTraitsEnabledLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Enable Traits System";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsTraitsEnabledTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Turns trait generation and trait-based companion effects on or off.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsTraitsEnabledCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 24);

              Label #TwSettingsNeedsSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "Needs (Hunger/Thirst)";
                Style: (FontSize: 16, RenderBold: true, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsSectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "";
                TooltipText: "Controls hunger and thirst damage, offline decay behavior, and how needs-based damage is calculated.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsNeedsResourceModeLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Needs Resource Mode";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsResourceModeTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Controls how hungry or thirsty companions reach food and water.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              DropdownBox #TwSettingsNeedsResourceModeDropdown {
                Anchor: (Left: 256, Width: 250, Height: 24);
                Style: (...$C.@DefaultDropdownBoxStyle, HorizontalPadding: 8);
                MaxSelection: 1;
                NoItemsText: "No resource modes";
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsNeedsDamageEnabledLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Enable Hunger/Thirst Damage";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsDamageEnabledTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Applies damage when hunger or thirst reaches the configured minimum threshold.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsNeedsDamageEnabledCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsNeedsTickPolicyModeLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Needs Tick Policy";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsTickPolicyTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Chooses when needs are allowed to tick, such as after an owner's offline grace period or whenever any player keeps the area loaded.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              DropdownBox #TwSettingsNeedsTickPolicyModeDropdown {
                Anchor: (Left: 256, Width: 250, Height: 24);
                Style: (...$C.@DefaultDropdownBoxStyle, HorizontalPadding: 8);
                MaxSelection: 1;
                NoItemsText: "No policy";
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsNeedsOwnerOfflineGraceHoursLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Owner Offline Grace Hours";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsOfflineGraceTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "How many hours an owner can stay offline before needs begin decaying under the owner-online grace policy.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              TextField #TwSettingsNeedsOwnerOfflineGraceHoursInput {
                Anchor: (Left: 256, Width: 250, Height: 24);
                Style: $C.@DefaultInputFieldStyle;
                PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
                Background: $C.@InputBoxBackground;
                Padding: (Horizontal: 8);
                PlaceholderText: "72";
                MaxLength: 12;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsNeedsOwnerOfflineDecayMultiplierLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Owner Offline Decay Multiplier";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsOfflineDecayMultiplierTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Multiplier applied to needs decay after the owner has been offline longer than the grace period.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              TextField #TwSettingsNeedsOwnerOfflineDecayMultiplierInput {
                Anchor: (Left: 256, Width: 250, Height: 24);
                Style: $C.@DefaultInputFieldStyle;
                PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
                Background: $C.@InputBoxBackground;
                Padding: (Horizontal: 8);
                PlaceholderText: "1";
                MaxLength: 12;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsNeedsDamageModelLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Needs Damage Model";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsDamageModelTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Chooses how starvation or dehydration damage is calculated once a need bottoms out.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              DropdownBox #TwSettingsNeedsDamageModelDropdown {
                Anchor: (Left: 256, Width: 250, Height: 24);
                Style: (...$C.@DefaultDropdownBoxStyle, HorizontalPadding: 8);
                MaxSelection: 1;
                NoItemsText: "No model";
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsNeedsDamageDualNeedRuleLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Dual Need Rule";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsDualNeedRuleTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Chooses whether low hunger and low thirst use only the higher damage amount or add both together.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              DropdownBox #TwSettingsNeedsDamageDualNeedRuleDropdown {
                Anchor: (Left: 256, Width: 250, Height: 24);
                Style: (...$C.@DefaultDropdownBoxStyle, HorizontalPadding: 8);
                MaxSelection: 1;
                NoItemsText: "No rule";
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsNeedsStarvationDamagePerMinuteLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Starvation Damage Per Minute";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsStarvationDamageTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Damage applied per minute when hunger is depleted and the current damage model uses starvation damage.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              TextField #TwSettingsNeedsStarvationDamagePerMinuteInput {
                Anchor: (Left: 256, Width: 250, Height: 24);
                Style: $C.@DefaultInputFieldStyle;
                PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
                Background: $C.@InputBoxBackground;
                Padding: (Horizontal: 8);
                PlaceholderText: "2";
                MaxLength: 12;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsNeedsDehydrationDamagePerMinuteLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Dehydration Damage Per Minute";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsDehydrationDamageTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Damage applied per minute when thirst is depleted and the current damage model uses dehydration damage.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              TextField #TwSettingsNeedsDehydrationDamagePerMinuteInput {
                Anchor: (Left: 256, Width: 250, Height: 24);
                Style: $C.@DefaultInputFieldStyle;
                PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
                Background: $C.@InputBoxBackground;
                Padding: (Horizontal: 8);
                PlaceholderText: "3";
                MaxLength: 12;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsNeedsDamageLethalLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Needs Damage Is Lethal";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsNeedsDamageLethalTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "When enabled, needs damage can kill companions. When disabled, it stops at 1 health.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsNeedsDamageLethalCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 24);

              Label #TwSettingsOwnershipSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "Ownership";
                Style: (FontSize: 16, RenderBold: true, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsOwnershipSectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "";
                TooltipText: "Controls owner-only protections, capture behavior, and general ownership checks for companions.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 18);

              Label #TwSettingsDamageProtectionSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "Damage Protection";
                Style: (FontSize: 12, RenderBold: true, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsOwnershipDamageProtectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "";
                TooltipText: "Protection rules that apply to owned companions during damage events.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsBlockOwnerDamageLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Block Owner Damage";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsBlockOwnerDamageTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Prevents the owner from damaging their own owned companions.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsBlockOwnerDamageCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsBlockAllDamageIfOwnedLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Block All Player Damage If Owned";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsBlockAllPlayerDamageTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Prevents all player-sourced damage against owned companions.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsBlockAllDamageIfOwnedCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsInvulnerableIfOwnedLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Invulnerable If Owned";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsInvulnerableIfOwnedTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Makes owned companions ignore all damage, not just player damage.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsInvulnerableIfOwnedCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Top: 4, Height: 18);

              Label #TwSettingsCaptureSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "Capture";
                Style: (FontSize: 12, RenderBold: true, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsOwnershipCaptureTooltip {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "";
                TooltipText: "Rules for owner requirements during capture and spawn flows.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsCaptureRequiresOwnerLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Capture Requires Owner";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsCaptureRequiresOwnerTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Requires a companion to already have an owner before it can be captured with supported Tamework items.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsCaptureRequiresOwnerCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsSpawnRequiresOwnerLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Spawn Requires Owner";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsSpawnRequiresOwnerTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Requires an owner assignment before a companion can be spawned from supported Tamework items.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsSpawnRequiresOwnerCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsCaptureClearsOwnerLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Capture Clears Owner";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsCaptureClearsOwnerTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Removes ownership when a companion is captured.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsCaptureClearsOwnerCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsSpawnSetsOwnerLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Spawn Sets Owner";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsSpawnSetsOwnerTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Assigns the spawning player as owner when the companion is spawned.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsSpawnSetsOwnerCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 18);

              Label #TwSettingsCaptureTradeNoteLabel {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "Note: Enabling both allows trading captured mobs between players.";
                Style: (FontSize: 11, TextColor: #9fb5ce, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsOwnershipTradingNoteTooltip {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "";
                TooltipText: "If both capture clears owner and spawn sets owner are enabled, captured companions can be transferred between players.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Top: 4, Height: 18);

              Label #TwSettingsGeneralSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "General";
                Style: (FontSize: 12, RenderBold: true, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsOwnershipGeneralTooltip {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "";
                TooltipText: "Owner requirement rules for common companion interactions.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsInteractionRequiresOwnerLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Interaction Requires Owner";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsInteractionRequiresOwnerTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Restricts supported companion interactions so only the owner can use them.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsInteractionRequiresOwnerCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsLinkingRequiresOwnerLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Linking Requires Owner";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsLinkingRequiresOwnerTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Restricts command-item linking so only the owner can link a companion.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsLinkingRequiresOwnerCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 24);

              Label #TwSettingsReviveSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "Revive System";
                Style: (FontSize: 16, RenderBold: true, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsReviveSectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "";
                TooltipText: "Controls whether dead owned companions can use Tamework's revive flow.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsReviveSystemEnabledLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Enable Revive System";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsReviveEnabledTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Allows supported Tamework revive and respawn behavior for owned companions.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsReviveSystemEnabledCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 24);

              Label #TwSettingsPopulationSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "Population";
                Style: (FontSize: 16, RenderBold: true, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsPopulationSectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "";
                TooltipText: "Controls the per-player owned companion cap used by Tamework.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsPopulationLimitLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Limit Per Player Owned Total";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsPopulationLimitTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Maximum number of owned companions a player can have before Tamework blocks additional ownership or acquisition.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              TextField #TwSettingsPopulationLimitInput {
                Anchor: (Left: 256, Width: 250, Height: 24);
                Style: $C.@DefaultInputFieldStyle;
                PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
                Background: $C.@InputBoxBackground;
                Padding: (Horizontal: 8);
                PlaceholderText: "0";
                MaxLength: 8;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsPopulationScopeLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Per Player Limit Scope";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsPopulationScopeTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Chooses whether the population limit is counted separately per world or across the entire universe.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              DropdownBox #TwSettingsPopulationScopeDropdown {
                Anchor: (Left: 256, Width: 250, Height: 24);
                Style: (...$C.@DefaultDropdownBoxStyle, HorizontalPadding: 8);
                MaxSelection: 1;
                NoItemsText: "No scope";
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 24);

              Label #TwSettingsSimpleClaimsSectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "Simple Claims";
                Style: (FontSize: 16, RenderBold: true, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsSimpleClaimsSectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "";
                TooltipText: "Controls Tamework's integration with Simple Claims for breeding and protection rules.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsClaimProviderLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Claim Provider";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsClaimProviderTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Chooses which claim plugin provides claim-aware population limits.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              DropdownBox #TwSettingsClaimProviderDropdown {
                Anchor: (Left: 256, Width: 250, Height: 24);
                Style: (...$C.@DefaultDropdownBoxStyle, HorizontalPadding: 8);
                MaxSelection: 1;
                NoItemsText: "No provider";
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsSimpleClaimsEnabledLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Enable Simple Claims Integration";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsSimpleClaimsEnabledTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Turns Simple Claims integration on or off for claim-aware breeding and protection checks.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsSimpleClaimsEnabledCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsClaimLimitChunkLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Breeding Limit Per Claim Chunk";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsClaimLimitChunkTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Maximum number of bred companions allowed in a single claim chunk.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              TextField #TwSettingsClaimLimitChunkInput {
                Anchor: (Left: 256, Width: 250, Height: 24);
                Style: $C.@DefaultInputFieldStyle;
                PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
                Background: $C.@InputBoxBackground;
                Padding: (Horizontal: 8);
                PlaceholderText: "0";
                MaxLength: 8;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsClaimLimitTotalLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Breeding Limit Per Claim Total";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsClaimLimitTotalTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Maximum number of bred companions allowed across the entire claim.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              TextField #TwSettingsClaimLimitTotalInput {
                Anchor: (Left: 256, Width: 250, Height: 24);
                Style: $C.@DefaultInputFieldStyle;
                PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
                Background: $C.@InputBoxBackground;
                Padding: (Horizontal: 8);
                PlaceholderText: "0";
                MaxLength: 8;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsBreedingRequiresClaimLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Breeding Requires Claim";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsBreedingRequiresClaimTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Requires breeding to happen inside a Simple Claims claim.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsBreedingRequiresClaimCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 26);

              Label #TwSettingsSimpleClaimsProtectLabel {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "Protect Tamed From Non-Members";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsSimpleClaimsProtectTooltip {
                Anchor: (Left: 0, Width: 250, Height: 24);
                Text: "";
                TooltipText: "Prevents non-members of a claim from harming or interfering with owned companions inside that claim.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsSimpleClaimsProtectCheck {
                Anchor: (Top: 1, Left: 256, Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 24);

              Label #TwSettingsTelemetrySectionLabel {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "Telemetry Consent";
                Style: (FontSize: 16, RenderBold: true, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsCrashTelemetrySectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 24);
                Text: "";
                TooltipText: "Telemetry consent is managed by the shared Alec's Telemetry command.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 44);

              Label #TwSettingsTelemetryConsentInstructionLabel {
                Anchor: (Left: 0, Right: 16, Height: 42);
                Text: "Use /telemetry consent to review or change Tamework telemetry consent. This settings page no longer edits telemetry.";
                Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
              }
            }
          }
        }
      }
    }
  }
}


