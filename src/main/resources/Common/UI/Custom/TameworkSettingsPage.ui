            Group {
              Anchor: (Height: 34);

              Label #TwSettingsCaptureRequiresOwnerLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Capture Requires Owner";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsCaptureRequiresOwnerTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
