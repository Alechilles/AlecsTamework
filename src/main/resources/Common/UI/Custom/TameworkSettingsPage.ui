              }

              TextButton #TwSettingsOwnershipSectionTooltip {
                Anchor: (Left: 0, Right: 0, Height: 28);
                Text: "";
                TooltipText: "Controls owner-only protections, capture behavior, and general ownership checks for companions.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 18);

              Label #TwSettingsDamageProtectionSectionLabel {
