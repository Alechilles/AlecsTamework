$A = "TameworkSlateStyles.ui";
$C = "Common.ui";

@SettingsLabelTooltipStyle = $C.@DefaultTextTooltipStyle;

// Section headers: a teal marker, an uppercase label and a faint rule under it.
@SettingsSectionLabel = LabelStyle(FontSize: 13, FontName: "Secondary", RenderUppercase: true, LetterSpacing: 1, TextColor: #eef2f6, HorizontalAlignment: Start, VerticalAlignment: Center);
@SettingsSubsectionLabel = LabelStyle(FontSize: 10, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center);

@SettingsLabelTooltipButtonStyle = TextButtonStyle(
  Default: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Hovered: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Pressed: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Disabled: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000))
);

$C.@PageOverlay {
  LayoutMode: Middle;

  Group #TwSettingsRoot {
    Anchor: (Width: 740, Height: 760);

    AssetImage { Anchor: (Full: 0); AssetPath: "Tamework/UI/Slate/page_settings.png"; FallbackTexturePath: "UI/Custom/Tamework/Slate/Clear.png"; HitTestVisible: false; }

    Group #Title {
      Anchor: (Top: 0, Left: 0, Right: 0, Height: 48);
      Group { Anchor: (Top: 7, Left: 18, Width: 34, Height: 34); Background: "Tamework/Telemetry/TameworkConsentIcon.png"; HitTestVisible: false; }
      Label #TwSettingsTitle {
        Anchor: (Left: 64, Right: 280, Height: 48);
        Text: %server.tamework.ui.settings.title;
        Style: $A.@SlateTitle;
      }
      TextButton #TwSettingsRefreshButton {
        Anchor: (Top: 9, Right: 164, Width: 96, Height: 30);
        Text: %server.tamework.ui.shared.button.refresh;
        Style: $A.@PanelButtonQuiet;
      }
      TextButton #TwSettingsApplyButton {
        Anchor: (Top: 9, Right: 58, Width: 96, Height: 30);
        Text: %server.tamework.ui.shared.button.apply;
        Style: $A.@PanelButtonPrimary;
      }
      Group {
        Anchor: (Top: 10, Right: 16, Width: 28, Height: 28);
        TextButton #TwSettingsCloseButton {
          Anchor: (Full: 0);
          Text: "";
          TooltipText: %server.tamework.ui.shared.button.close;
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
          Style: $A.@ActionQuiet;
        }
        Group { Anchor: (Top: 2, Left: 2, Width: 24, Height: 24); HitTestVisible: false; Background: (TexturePath: "Tamework/PanelActions/Remove_Glyph_Default.png", Color: #c2ccd6); }
      }
    }

    Group #Content {
      Anchor: (Top: 52, Left: 12, Right: 12, Bottom: 12);
      LayoutMode: Top;

      Group #TwSettingsUnsavedWarning {
        Anchor: (Left: 8, Right: 8, Height: 20);
        Visible: false;

        // One visible frame and one transparent frame, each held for one second.
        Sprite {
          Anchor: (Left: 130, Width: 20, Height: 20);
          TexturePath: "Tamework/PanelActions/UnsavedWarning.png";
          Frame: (Width: 32, Height: 32, PerRow: 2, Count: 2);
          FramesPerSecond: 1;
          RepeatCount: 0;
        }

        Label #TwSettingsUnsavedText {
          Anchor: (Left: 26, Right: 26, Height: 20);
          Text: "";
          Style: (FontSize: 12, RenderBold: true, TextColor: #f2c66d, HorizontalAlignment: Center, VerticalAlignment: Center);
        }

        Sprite {
          Anchor: (Right: 130, Width: 20, Height: 20);
          TexturePath: "Tamework/PanelActions/UnsavedWarning.png";
          Frame: (Width: 32, Height: 32, PerRow: 2, Count: 2);
          FramesPerSecond: 1;
          RepeatCount: 0;
        }
      }

      Label #TwSettingsStatusLine {
        Anchor: (Left: 8, Right: 8, Height: 20);
        Text: "";
        Style: (FontSize: 12, TextColor: #c2ccd6, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      // The scrolling rows sit in an inset well.
      Group {
        Anchor: (Top: 6);
        FlexWeight: 1;
        Background: $A.@SlateTray;
        Padding: (Left: 12, Right: 6, Top: 8, Bottom: 8);

        Group #TwSettingsViewport {
          Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
          LayoutMode: TopScrolling;
          KeepScrollPosition: true;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Left: 2, Right: 0, Top: 2, Bottom: 2);

          Group #TwSettingsRows {
            LayoutMode: Top;
            Anchor: (Left: 0, Right: 0, Bottom: 0);

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsAnnouncementsLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: %server.tamework.ui.settings.label.announcements;
                Style: (FontSize: 13, TextColor: #c2ccd6, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsAnnouncementsTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: %server.tamework.ui.settings.tooltip.announcements;
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsAnnouncementsEnabledCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: $A.@SlateQuiet;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Group { Anchor: (Left: 0, Top: 7, Width: 4, Height: 20); Background: #5fe0c0; }
              Group { Anchor: (Left: 0, Right: 12, Bottom: 0, Height: 1); Background: #ffffff(0.1); }

              Label #TwSettingsExperiencePresetsLabel {
                Anchor: (Left: 14, Right: 12, Height: 34);
                Text: %server.tamework.ui.settings.label.experiencePresets;
                Style: @SettingsSectionLabel;
              }

              TextButton #TwSettingsExperiencePresetsTooltip {
                Anchor: (Left: 0, Right: 12, Height: 34);
                Text: "";
                TooltipText: %server.tamework.ui.settings.tooltip.experiencePresets;
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsLoadPresetLabel {
                Anchor: (Left: 0, Width: 120, Height: 28);
                Text: %server.tamework.ui.settings.label.loadPreset;
                Style: (FontSize: 13, TextColor: #c2ccd6, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsLoadPresetTooltip {
                Anchor: (Left: 0, Width: 120, Height: 28);
                Text: "";
                TooltipText: %server.tamework.ui.settings.tooltip.loadPreset;
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              DropdownBox #TwSettingsPresetDropdown {
                Anchor: (Left: 126, Right: 12, Height: 28);
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8);
                MaxSelection: 1;
                NoItemsText: %server.tamework.ui.settings.noItems.preset;
              }

            }

            Group {
              Anchor: (Height: 18);

              Label #TwSettingsPresetNoteLabel {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: %server.tamework.ui.settings.note.presetScope;
                Style: (FontSize: 11, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
              }

              TextButton #TwSettingsPresetNoteTooltip {
                Anchor: (Left: 0, Right: 0, Height: 18);
                Text: "";
                TooltipText: %server.tamework.ui.settings.tooltip.presetScope;
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }
            }

            Group { Anchor: (Height: 8); }

            Group {
              Anchor: (Height: 34);

              Group { Anchor: (Left: 0, Top: 7, Width: 4, Height: 20); Background: #5fe0c0; }
              Group { Anchor: (Left: 0, Right: 12, Bottom: 0, Height: 1); Background: #ffffff(0.1); }

              Label #TwSettingsRecallSectionLabel {
                Anchor: (Left: 14, Right: 12, Height: 34);
                Text: %server.tamework.ui.settings.label.recallSection;
                Style: @SettingsSectionLabel;
              }

              TextButton #TwSettingsRecallSectionTooltip {
                Anchor: (Left: 0, Right: 12, Height: 34);
