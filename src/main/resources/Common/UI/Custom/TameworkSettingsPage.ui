              CheckBox #TwSettingsBlockOwnerDamageCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
                Background: (Color: #252c27);
                OutlineColor: #4a5a50;
                OutlineSize: 1;
                Padding: (Full: 4);
                Style: $C.@DefaultCheckBoxStyle;
              }
            }

            Group {
              Anchor: (Height: 34);

              Label #TwSettingsBlockAllDamageIfOwnedLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Block All Player Damage If Owned";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsBlockAllPlayerDamageTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Prevents all player-sourced damage against owned companions.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsBlockAllDamageIfOwnedCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
