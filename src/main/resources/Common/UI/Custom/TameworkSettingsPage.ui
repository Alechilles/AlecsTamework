              Label #TwSettingsClaimLimitChunkLabel {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "Breeding Limit Per Claim Chunk";
                Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Center);
              }

              TextButton #TwSettingsClaimLimitChunkTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Maximum number of bred companions allowed in a single claim chunk.";
