              }

              TextButton #TwSettingsSpawnSetsOwnerTooltip {
                Anchor: (Left: 0, Width: 340, Height: 28);
                Text: "";
                TooltipText: "Assigns the spawning player as owner when the companion is spawned.";
                TextTooltipStyle: @SettingsLabelTooltipStyle;
                Style: @SettingsLabelTooltipButtonStyle;
              }

              CheckBox #TwSettingsSpawnSetsOwnerCheck {
                Anchor: (Top: 3, Left: 356, Width: 22, Height: 22);
