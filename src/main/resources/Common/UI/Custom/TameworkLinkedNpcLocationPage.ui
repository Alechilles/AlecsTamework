$A = "TameworkPanelActionStyles.ui";
$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  Group #TameworkLinkedLocationRoot {
    Anchor: (Width: 600, Height: 230);
    Background: (TexturePath: "Tamework/PanelActions/Base_Default.png", Border: 3);

    Group #Title {
      Anchor: (Top: 3, Left: 3, Right: 3, Height: 54);
      Background: #252b27;
      Group {
        Anchor: (Left: 16, Top: 12, Width: 30, Height: 30);
        Background: "Tamework/PanelActions/Locate_Glyph_Default.png";
        HitTestVisible: false;
      }
      Label #TameworkLinkedLocationTitle {
        Anchor: (Left: 58, Right: 58, Height: 54);
        Style: (FontSize: 20, RenderBold: true, TextColor: #f0eee7, VerticalAlignment: Center);
        Text: "Companion - Location";
      }
      Group {
        Anchor: (Top: 11, Right: 12, Width: 32, Height: 32);
        TextButton #TameworkLinkedLocationCloseButton { Anchor: (Full: 0); Text: ""; TooltipText: %server.tamework.ui.shared.button.close; Style: $A.@Remove; }
        Group { Anchor: (Top: 4, Left: 4, Width: 24, Height: 24); HitTestVisible: false; Background: "Tamework/PanelActions/Remove_Glyph_Default.png"; }
      }
    }
    Group { Anchor: (Top: 57, Left: 3, Right: 3, Height: 1); Background: #4a5a50; }

    Group #Content {
      Anchor: (Top: 74, Left: 22, Right: 22, Bottom: 18);
      LayoutMode: Top;

      Group #TameworkLinkedLocationStatusSection {
        Anchor: (Height: 64);
        Background: #252c27;
        Group { Anchor: (Left: 0, Top: 0, Bottom: 0, Width: 3); Background: #8b9d7c; }
        Label #TameworkLinkedLocationStatus {
          Anchor: (Full: 0);
          Padding: (Horizontal: 16, Vertical: 10);
          Text: "";
          Style: (FontSize: 15, TextColor: #d5ddcd, Wrap: true, VerticalAlignment: Center);
        }
      }
      Group #TameworkLinkedLocationStatusGap { Anchor: (Height: 16); }

      Group #TameworkLinkedLocationDetails {
        Anchor: (Height: 138);
        LayoutMode: Top;
        Group {
          Anchor: (Height: 64);
          Label #TameworkLinkedLocationWorldLabel {
            Anchor: (Top: 0, Left: 0, Right: 0, Height: 20);
            Text: %server.tamework.ui.linkedLocation.worldLabel;
            Style: (FontSize: 14, TextColor: #a9b69f, VerticalAlignment: Center);
          }
          Label #TameworkLinkedLocationWorldValue {
            Anchor: (Top: 23, Left: 0, Right: 0, Height: 30);
            Text: "";
            Style: (FontSize: 18, RenderBold: true, TextColor: #f0eee7, VerticalAlignment: Center);
          }
        }
        Group {
          Anchor: (Height: 74);
          Label #TameworkLinkedLocationCoordinatesLabel {
            Anchor: (Top: 0, Left: 0, Right: 0, Height: 20);
            Text: %server.tamework.ui.linkedLocation.coordinatesLabel;
            Style: (FontSize: 14, TextColor: #a9b69f, VerticalAlignment: Center);
          }
          TextField #TameworkLinkedLocationCoordinatesInput {
            Anchor: (Top: 26, Left: 0, Right: 0, Height: 48);
            Style: $A.@PanelInputFieldStyle;
            PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
            Background: #181c1a;
            OutlineColor: #4a5a50;
            OutlineSize: 1;
            Padding: (Horizontal: 14);
            Value: "";
            MaxLength: 96;
          }
        }
      }
    }
  }
}
