$A = "TameworkPanelActionStyles.ui";
$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  Group #TameworkLinkedLocationRoot {
    Anchor: (Width: 540, Height: 260);
    Background: (TexturePath: "Tamework/PanelActions/Base_Default.png", Border: 3);

    Group #Title {
      Anchor: (Top: 3, Left: 3, Right: 3, Height: 44);
      Background: #252b27;
      Group {
        Anchor: (Top: 7, Right: 10, Width: 28, Height: 28);
        TextButton #TameworkLinkedLocationCloseButton { Anchor: (Full: 0); Text: ""; TooltipText: %server.tamework.ui.shared.button.close; Style: $A.@Remove; }
        Group { Anchor: (Top: 2, Left: 2, Width: 24, Height: 24); HitTestVisible: false; Background: "Tamework/PanelActions/Remove_Glyph_Default.png"; }
      }
      Label #TameworkLinkedLocationTitle {
        Anchor: (Left: 14, Right: 50, Height: 44);
        Style: (FontSize: 20, RenderBold: true, TextColor: #f0eee7, VerticalAlignment: Center);
        Text: "Companion - Location";
      }
    }

    Group #Content {
      Anchor: (Top: 54, Left: 14, Right: 14, Bottom: 14);
      LayoutMode: Top;
      Padding: (Left: 10, Right: 10, Top: 8, Bottom: 8);

      Group {
        Anchor: (Height: 124, Bottom: 14);
        Background: #181c1a;
        Padding: (Left: 12, Right: 12, Top: 12, Bottom: 12);
        LayoutMode: Top;

        Group {
          Anchor: (Height: 32, Bottom: 12);

          Label #TameworkLinkedLocationWorldLabel {
            Anchor: (Left: 0, Width: 108, Height: 32);
            Text: %server.tamework.ui.linkedLocation.worldLabel;
            Style: (FontSize: 14, TextColor: #afb6b0, HorizontalAlignment: Start, VerticalAlignment: Center);
          }

          Label #TameworkLinkedLocationWorldValue {
            Anchor: (Left: 118, Right: 0, Height: 32);
            Text: "";
            Style: (FontSize: 14, TextColor: #f0eee7, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
          }
        }

        Group {
          Anchor: (Height: 44);

          Label #TameworkLinkedLocationCoordinatesLabel {
            Anchor: (Left: 0, Width: 108, Height: 44);
            Text: %server.tamework.ui.linkedLocation.coordinatesLabel;
            Style: (FontSize: 14, TextColor: #afb6b0, HorizontalAlignment: Start, VerticalAlignment: Center);
          }

          TextField #TameworkLinkedLocationCoordinatesInput {
            Style: $A.@PanelInputFieldStyle;
            PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
            Background: #252c27;
        OutlineColor: #4a5a50;
        OutlineSize: 1;
            Anchor: (Left: 118, Right: 0, Height: 44);
            Padding: (Horizontal: 10);
            Value: "";
            MaxLength: 96;
          }
        }
      }

      Group {
        LayoutMode: Right;

      }
    }
  }
}
