$A = "TameworkSlateStyles.ui";
$C = "Common.ui";

@LocationCapsLabel = LabelStyle(FontSize: 10, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #8794a4, VerticalAlignment: Center);

$C.@PageOverlay {
  LayoutMode: Middle;

  // Java sets the height of this window (three variants), so it uses the stretchable plate, not a page picture.
  Group #TameworkLinkedLocationRoot {
    Anchor: (Width: 600, Height: 230);
    // The plate has its 54 px header band and teal rule baked in, so the band follows the cut corner.
    Background: $A.@SlateWindowHeader54;

    Group #Title {
      Anchor: (Top: 3, Left: 3, Right: 3, Height: 54);
      Group {
        Anchor: (Left: 16, Top: 12, Width: 30, Height: 30);
        Background: (TexturePath: "Tamework/PanelActions/Locate_Glyph_Default.png", Color: #5fe0c0);
        HitTestVisible: false;
      }
      Label #TameworkLinkedLocationTitle {
        Anchor: (Left: 58, Right: 58, Height: 54);
        Style: $A.@SlateTitle;
        Text: "";
      }
      Group {
        Anchor: (Top: 13, Right: 13, Width: 28, Height: 28);
        TextButton #TameworkLinkedLocationCloseButton { Anchor: (Full: 0); Text: ""; TooltipText: %server.tamework.ui.shared.button.close; TextTooltipStyle: $C.@DefaultTextTooltipStyle; Style: $A.@ActionQuiet; }
        Group { Anchor: (Top: 2, Left: 2, Width: 24, Height: 24); HitTestVisible: false; Background: (TexturePath: "Tamework/PanelActions/Remove_Glyph_Default.png", Color: #c2ccd6); }
      }
    }

    Group #Content {
      Anchor: (Top: 74, Left: 22, Right: 22, Bottom: 18);
      LayoutMode: Top;

      Group #TameworkLinkedLocationStatusSection {
        Anchor: (Height: 64);
        Background: $A.@SlateQuiet;
        Group { Anchor: (Left: 1, Top: 1, Bottom: 1, Width: 3); Background: #7fa8ee; }
        Label #TameworkLinkedLocationStatus {
          Anchor: (Full: 0);
          Padding: (Horizontal: 18, Vertical: 10);
          Text: "";
          Style: (FontSize: 14, TextColor: #eef2f6, Wrap: true, VerticalAlignment: Center);
        }
      }
      Group #TameworkLinkedLocationStatusGap { Anchor: (Height: 16); }

      Group #TameworkLinkedLocationDetails {
        Anchor: (Height: 138);
        LayoutMode: Top;
        Group {
          Anchor: (Height: 64);
          Label #TameworkLinkedLocationWorldLabel {
            Anchor: (Top: 0, Left: 0, Right: 0, Height: 20);
            Text: %server.tamework.ui.linkedLocation.worldLabel;
            Style: @LocationCapsLabel;
          }
          Label #TameworkLinkedLocationWorldValue {
            Anchor: (Top: 20, Left: 0, Right: 0, Height: 30);
            Text: "";
            Style: (FontSize: 17, RenderBold: true, TextColor: #eef2f6, VerticalAlignment: Center);
          }
        }
        Group {
          Anchor: (Height: 74);
          Label #TameworkLinkedLocationCoordinatesLabel {
            Anchor: (Top: 0, Left: 0, Right: 0, Height: 20);
            Text: %server.tamework.ui.linkedLocation.coordinatesLabel;
            Style: @LocationCapsLabel;
          }
          TextField #TameworkLinkedLocationCoordinatesInput {
            Anchor: (Top: 26, Left: 0, Right: 0, Height: 48);
            Style: $A.@PanelInputFieldStyle;
            PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
            Background: $A.@SlateQuiet;
            Decoration: (
              Default: (Background: $A.@SlateQuiet),
              Focused: (Background: $A.@SlateQuietFocus)
            );
            Padding: (Horizontal: 14);
            Value: "";
            MaxLength: 96;
          }
        }
      }
    }
  }
}
