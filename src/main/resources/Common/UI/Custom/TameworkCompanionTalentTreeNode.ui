$C = "Common.ui";

@TalentNodeButtonLabelStyle = LabelStyle(FontSize: 1, TextColor: #000000(0.0));
@TalentNodeButtonStyle = TextButtonStyle(Default: (Background: (Color: #000000(0.0)), LabelStyle: @TalentNodeButtonLabelStyle), Hovered: (Background: (Color: #ffffff(0.08)), LabelStyle: @TalentNodeButtonLabelStyle), Pressed: (Background: (Color: #ffffff(0.14)), LabelStyle: @TalentNodeButtonLabelStyle), Disabled: (Background: (Color: #000000(0.0)), LabelStyle: @TalentNodeButtonLabelStyle), Sounds: $C.@ButtonSounds);

Group {
  Anchor: (Width: 117, Height: 66);
  Background: #182433(0.96);

  Group #TalentNodeLockedBackground {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Background: #182433(0.96);
    Visible: true;
  }

  Group #TalentNodeUnaffordableBackground {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Background: #3a344a(0.98);
    Visible: false;
  }

  Group #TalentNodeAvailableBackground {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Background: #204c73(0.98);
    Visible: false;
  }

  Group #TalentNodePurchasedBackground {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Background: #1f573c(0.98);
    Visible: false;
  }

  Group #TalentNodeSelected {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Background: #ffffff(0.12);
    Visible: false;
  }

  Label #TalentNodeName {
    Anchor: (Top: 6, Left: 6, Right: 6, Height: 34);
    Text: "Talent";
    Style: (FontSize: 11, RenderBold: true, TextColor: #f0f6ff, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true);
  }

  Label #TalentNodeCost {
    Anchor: (Bottom: 6, Left: 6, Width: 34, Height: 16);
    Text: "1 pt";
    Style: (FontSize: 10, TextColor: #9fc2dd, HorizontalAlignment: Start, VerticalAlignment: Center);
  }

  Label #TalentNodeState {
    Anchor: (Bottom: 6, Right: 6, Width: 62, Height: 16);
    Text: "Locked";
    Style: (FontSize: 10, TextColor: #d8e8f7, HorizontalAlignment: End, VerticalAlignment: Center);
  }

  TextButton #TalentNodeButton {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Style: @TalentNodeButtonStyle;
    Text: "";
  }
}
