$C = "Common.ui";

@TalentNodeButtonLabelStyle = LabelStyle(FontSize: 1, TextColor: #000000(0.0));
@TalentNodeButtonStyle = TextButtonStyle(
  Default: (Background: (Color: #000000(0.0)), LabelStyle: @TalentNodeButtonLabelStyle),
  Hovered: (Background: (Color: #ffffff(0.06)), LabelStyle: @TalentNodeButtonLabelStyle),
  Pressed: (Background: (Color: #ffffff(0.12)), LabelStyle: @TalentNodeButtonLabelStyle),
  Disabled: (Background: (Color: #000000(0.0)), LabelStyle: @TalentNodeButtonLabelStyle),
  Sounds: $C.@ButtonSounds
);

Group {
  Anchor: (Width: 117, Height: 66);
  Background: (TexturePath: "Tamework/PanelActions/Base_Default.png", Border: 3);

  Group #TalentNodeLockedBackground {
    Anchor: (Top: 3, Left: 3, Right: 3, Bottom: 3);
    Background: #202723;
    Visible: true;
  }

  Group #TalentNodeUnaffordableBackground {
    Anchor: (Top: 3, Left: 3, Right: 3, Bottom: 3);
    Background: #3a332e;
    Visible: false;
  }

  Group #TalentNodeAvailableBackground {
    Anchor: (Top: 3, Left: 3, Right: 3, Bottom: 3);
    Background: #314b3c;
    Visible: false;
  }

  Group #TalentNodePurchasedBackground {
    Anchor: (Top: 3, Left: 3, Right: 3, Bottom: 3);
    Background: #28523a;
    Visible: false;
  }

  Group #TalentNodeSelected {
    Anchor: (Top: 1, Left: 1, Right: 1, Bottom: 1);
    Background: #c4dbc9(0.18);
    OutlineColor: #c4dbc9;
    OutlineSize: 1;
    Visible: false;
  }

  Label #TalentNodeName {
    Anchor: (Top: 6, Left: 6, Right: 6, Height: 34);
    Text: "Talent";
    Style: (FontSize: 11, RenderBold: true, TextColor: #e8e4da, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true);
  }

  Label #TalentNodeCost {
    Anchor: (Bottom: 6, Left: 6, Width: 34, Height: 16);
    Text: "1 pt";
    Style: (FontSize: 10, TextColor: #c4dbc9, HorizontalAlignment: Start, VerticalAlignment: Center);
  }

  Label #TalentNodeState {
    Anchor: (Bottom: 6, Right: 6, Width: 62, Height: 16);
    Text: "Locked";
    Style: (FontSize: 10, TextColor: #afb6b0, HorizontalAlignment: End, VerticalAlignment: Center);
  }

  TextButton #TalentNodeButton {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Style: @TalentNodeButtonStyle;
    Text: "";
  }
}
