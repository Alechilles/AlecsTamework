$A = "TameworkSlateStyles.ui";
$C = "Common.ui";

@TalentNodeButtonLabelStyle = LabelStyle(FontSize: 1, TextColor: #000000(0.0));
@TalentNodeButtonStyle = TextButtonStyle(
  Default: (Background: (Color: #000000(0.0)), LabelStyle: @TalentNodeButtonLabelStyle),
  Hovered: (Background: (Color: #ffffff(0.06)), LabelStyle: @TalentNodeButtonLabelStyle),
  Pressed: (Background: (Color: #ffffff(0.12)), LabelStyle: @TalentNodeButtonLabelStyle),
  Disabled: (Background: (Color: #000000(0.0)), LabelStyle: @TalentNodeButtonLabelStyle),
  Sounds: $C.@ButtonSounds
);

// TameworkCompanionTalentsPage picks these by the node's state.
@TalentNodeName = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #eef2f6, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true);
@TalentNodeNamePurchased = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #eafff8, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true);
@TalentNodeNameLocked = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #56606c, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true);
@TalentNodeCost = LabelStyle(FontSize: 10, RenderBold: true, TextColor: #f2c66d, HorizontalAlignment: Start, VerticalAlignment: Center);
@TalentNodeCostLocked = LabelStyle(FontSize: 10, RenderBold: true, TextColor: #56606c, HorizontalAlignment: Start, VerticalAlignment: Center);
@TalentNodeStateAvailable = LabelStyle(FontSize: 10, RenderBold: true, TextColor: #eef2f6, HorizontalAlignment: End, VerticalAlignment: Center);
@TalentNodeStatePurchased = LabelStyle(FontSize: 10, RenderBold: true, TextColor: #5fe0c0, HorizontalAlignment: End, VerticalAlignment: Center);
@TalentNodeStateUnaffordable = LabelStyle(FontSize: 10, RenderBold: true, TextColor: #f0b45a, HorizontalAlignment: End, VerticalAlignment: Center);
@TalentNodeStateLocked = LabelStyle(FontSize: 10, TextColor: #56606c, HorizontalAlignment: End, VerticalAlignment: Center);

Group {
  Anchor: (Width: 117, Height: 66);

  // One plate per state; Java shows exactly one.
  Group #TalentNodeLockedBackground {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Background: $A.@SlateDisabled;
    Visible: true;
  }

  Group #TalentNodeUnaffordableBackground {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Background: $A.@SlateAmber;
    Visible: false;
  }

  Group #TalentNodeAvailableBackground {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Background: $A.@SlateAvailable;
    Visible: false;
  }

  Group #TalentNodePurchasedBackground {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Background: $A.@SlatePrimary;
    Visible: false;
  }

  // The selection ring is an off-atlas picture drawn at 2x for exactly this 117x66 node.
  Group #TalentNodeSelected {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    HitTestVisible: false;
    Visible: false;

    AssetImage #TalentNodeSelectedRing { Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0); AssetPath: "Tamework/UI/Slate/talent_selected.png"; FallbackTexturePath: "UI/Custom/Tamework/Slate/Clear.png"; HitTestVisible: false; }
  }

  Label #TalentNodeName {
    Anchor: (Top: 6, Left: 6, Right: 6, Height: 32);
    Text: "";
    Style: @TalentNodeNameLocked;
  }

  Group { Anchor: (Top: 40, Left: 10, Right: 10, Height: 1); Background: #ffffff(0.07); }

  Label #TalentNodeCost {
    Anchor: (Bottom: 6, Left: 9, Width: 34, Height: 16);
    Text: "";
    Style: @TalentNodeCostLocked;
  }

  Label #TalentNodeState {
    Anchor: (Bottom: 6, Right: 9, Width: 62, Height: 16);
    Text: %server.tamework.ui.talents.state.Locked;
    Style: @TalentNodeStateLocked;
  }

  TextButton #TalentNodeButton {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Style: @TalentNodeButtonStyle;
    Text: "";
  }
}
