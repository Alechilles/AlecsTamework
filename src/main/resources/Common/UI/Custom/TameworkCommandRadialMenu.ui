@Slice6ButtonStyle = TextButtonStyle(
  Default: (Background: (TexturePath: "Tamework/RadialMenu/Default/Cropped/CommandWheelSlice4_Default.png"), LabelStyle: @SliceButtonLabelStyle),
  Hovered: (Background: (TexturePath: "Tamework/RadialMenu/Default/Cropped/CommandWheelSlice4_Hover.png"), LabelStyle: @SliceButtonLabelStyle),
