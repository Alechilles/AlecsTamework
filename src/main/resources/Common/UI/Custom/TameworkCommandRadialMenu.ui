$A = "TameworkSlateStyles.ui";
$C = "Common.ui";
@CommandAssignmentKeyStyle = LabelStyle(FontSize: 10, RenderBold: true, LetterSpacing: 1, TextColor: #eef2f6, Alignment: Center);
@CommandAssignmentDropdownStyle = (...$A.@PanelDropdown, HorizontalPadding: 10, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, TextColor: #eef2f6, RenderUppercase: false, FontSize: 11), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #eef2f6, RenderUppercase: false, FontSize: 11), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #eef2f6, RenderUppercase: false, FontSize: 11));
$C.@PageOverlay {
 LayoutMode: Middle;
 Group #TameworkCommandMenuWheel {
  Anchor: (Width: 1120, Height: 860);
  Visible: false;
  Group #TameworkCommandMenuSurface {
   Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
   // A stretchable atlas plate with the header band baked in. This window is open for long stretches and updates
   // often, so it uses no off-atlas picture: a full-window AssetImage here made the client hitch.
   Background: $A.@SlateWindowHeader48;
  }
  Group #TameworkCommandMenuContent {
   Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
   Group #TameworkCommandMenuHeader {
    Anchor: (Top: 3, Left: 3, Right: 3, Height: 42);
    Group #TameworkCommandMenuLogo { Anchor: (Top: 4, Left: 20, Width: 34, Height: 34); Background: "Tamework/Telemetry/TameworkConsentIcon.png"; TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    Label #TameworkCommandMenuTitle { Anchor: (Left: 66, Right: 478, Height: 42); Text: ""; Style: (FontSize: 18, FontName: "Secondary", LetterSpacing: 1, TextColor: #eef2f6, VerticalAlignment: Center); }
    Label #TameworkContributorCapacity { Anchor: (Top: 8, Right: 286, Width: 180, Height: 26); Visible: false; Text: ""; Style: (FontSize: 12, TextColor: #bfcdd5, HorizontalAlignment: End, VerticalAlignment: Center); TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    TextButton #CommandMenuHelpButton {
      Anchor: (Top: 8, Right: 186, Width: 88, Height: 26);
      Text: %server.tamework.ui.guide.help;
      Style: $A.@PanelButtonQuiet;
    }
    Label #TameworkCommandMenuSubtitle { Anchor: (Left: 330, Width: 500, Height: 42); Text: ""; Visible: false; Style: (FontSize: 12, TextColor: #96a9be); }
    TextButton #CommandMenuFeedbackButton {
      Anchor: (Top: 8, Right: 86, Width: 92, Height: 26);
      Text: %server.tamework.ui.commandMenu.feedback;
      TooltipText: %server.tamework.ui.commandMenu.feedbackTooltip;
      Style: $A.@PanelButtonQuiet;
    }
    Group #CommandMenuSettings {
     Anchor: (Top: 8, Right: 50, Width: 28, Height: 26);
     Visible: false;
     TextButton #CommandMenuSettingsButton { Anchor: (Full: 0); Text: ""; Style: $A.@ActionQuiet; TooltipText: %server.tamework.ui.settings.title; }
     Group { Anchor: (Top: 1, Left: 2, Width: 24, Height: 24); HitTestVisible: false; Background: (TexturePath: "Tamework/PanelActions/Settings_Glyph_Default.png", Color: #bfcdd5); }
    }
    Group #CommandMenuClose {
     Anchor: (Top: 7, Right: 14, Width: 28, Height: 28);
     TextButton #CommandMenuCloseButton { Anchor: (Full: 0); Text: ""; TooltipText: %server.tamework.ui.shared.button.close; Style: $A.@ActionQuiet; }
     Group { Anchor: (Top: 2, Left: 2, Width: 24, Height: 24); HitTestVisible: false; Background: (TexturePath: "Tamework/PanelActions/Remove_Glyph_Default.png", Color: #bfcdd5); }
    }
   }
   Group #TameworkCommandAssignments {
     Anchor: (Top: 54, Left: 12, Width: 160, Bottom: 16);
    Background: $A.@SlateTray;
    Group #TameworkCommandPrimaryAssignment {
     Anchor: (Top: 8, Left: 8, Right: 8, Height: 70);
     Label { Anchor: (Top: 5, Left: 8, Width: 40, Height: 20); Text: "LMB"; Style: @CommandAssignmentKeyStyle; Background: $A.@SlateNormal; }
     Group { Anchor: (Top: 15, Left: 56, Right: 8, Height: 1); Background: #ffffff(0.08); }
     DropdownBox #TameworkCommandPrimary { Anchor: (Top: 34, Left: 8, Right: 8, Height: 28); Style: @CommandAssignmentDropdownStyle; HitTestVisible: true; MaxSelection: 1; NoItemsText: %server.tamework.ui.commandMenu.noCommands; }
    }
    Group #TameworkCommandHotswapQAssignment {
     Anchor: (Top: 86, Left: 8, Right: 8, Height: 70);
     Label { Anchor: (Top: 5, Left: 8, Width: 40, Height: 20); Text: "Q"; Style: @CommandAssignmentKeyStyle; Background: $A.@SlateNormal; }
     Group { Anchor: (Top: 15, Left: 56, Right: 8, Height: 1); Background: #ffffff(0.08); }
     DropdownBox #TameworkCommandHotswapQ { Anchor: (Top: 34, Left: 8, Right: 8, Height: 28); Style: @CommandAssignmentDropdownStyle; HitTestVisible: true; MaxSelection: 1; NoItemsText: %server.tamework.ui.commandMenu.noCommands; }
    }
    Group #TameworkCommandHotswapEAssignment {
     Anchor: (Top: 164, Left: 8, Right: 8, Height: 70);
     Label { Anchor: (Top: 5, Left: 8, Width: 40, Height: 20); Text: "E"; Style: @CommandAssignmentKeyStyle; Background: $A.@SlateNormal; }
     Group { Anchor: (Top: 15, Left: 56, Right: 8, Height: 1); Background: #ffffff(0.08); }
     DropdownBox #TameworkCommandHotswapE { Anchor: (Top: 34, Left: 8, Right: 8, Height: 28); Style: @CommandAssignmentDropdownStyle; HitTestVisible: true; MaxSelection: 1; NoItemsText: %server.tamework.ui.commandMenu.noCommands; }
    }
    Group #TameworkCommandHotswapRAssignment {
     Anchor: (Top: 242, Left: 8, Right: 8, Height: 70);
     Label { Anchor: (Top: 5, Left: 8, Width: 40, Height: 20); Text: "R"; Style: @CommandAssignmentKeyStyle; Background: $A.@SlateNormal; }
     Group { Anchor: (Top: 15, Left: 56, Right: 8, Height: 1); Background: #ffffff(0.08); }
     DropdownBox #TameworkCommandHotswapR { Anchor: (Top: 34, Left: 8, Right: 8, Height: 28); Style: @CommandAssignmentDropdownStyle; HitTestVisible: true; MaxSelection: 1; NoItemsText: %server.tamework.ui.commandMenu.noCommands; }
    }

    Group #TameworkGroupQuickSelect {
     Anchor: (Top: 328, Left: 8, Right: 8, Bottom: 8);
     Group { Anchor: (Top: -6, Left: 0, Right: 0, Height: 1); Background: #ffffff(0.08); }
     Label { Anchor: (Top: 6, Left: 8, Right: 38, Height: 24); Text: %server.tamework.ui.linkedPanel.manageGroups; Style: (FontSize: 10, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #bfcdd5, HorizontalAlignment: Start, VerticalAlignment: Center); }
     Group { Anchor: (Top: 5, Right: 5, Width: 26, Height: 26);
      TextButton #TameworkLinkedPanelManageGroupsButton { Anchor: (Full: 0); Text: ""; TooltipText: %server.tamework.ui.shared.button.edit; Style: $A.@ActionQuiet; }
      Group { Anchor: (Top: 5, Left: 5, Width: 16, Height: 16); Background: (TexturePath: "Tamework/PanelControls/GroupEdit.png", Color: #bfcdd5); HitTestVisible: false; }
     }
     Group { Anchor: (Top: 36, Left: 4, Right: 4, Bottom: 72); LayoutMode: TopScrolling; KeepScrollPosition: true; ScrollbarStyle: $C.@DefaultScrollbarStyle; Padding: (Top: 2, Bottom: 4);
      Group #TameworkGroupQuickSelectList { Anchor: (Left: 0, Right: 0); LayoutMode: Top; }
     }
     Group #CompanionGroupActions {
      Anchor: (Left: 4, Right: 4, Bottom: 4, Height: 64);
      LayoutMode: Top;
      Visible: false;
      TextButton #CompanionAddGroup {
       Anchor: (Height: 28);
       Text: %server.tamework.ui.companions.addGroup;
       Style: $A.@PanelButton;
      }
      Group { Anchor: (Height: 4); }
      TextButton #CompanionClearSelection {
       Anchor: (Height: 28);
       Text: %server.tamework.ui.companions.clearSelection;
       Style: $A.@PanelButtonQuiet;
      }
     }
    }
   }
  }
    // Legacy wheel selectors stay mounted for existing page bindings, but the
    // command sidebar is the only visible command-selection surface.
    Group #TameworkCommandLegacyWheel {
      Anchor: (Top: 0, Left: 0, Width: 1, Height: 1);
      Visible: false;

      Label #TameworkCommandMenuCurrent { Text: ""; }

      TextButton #CommandButton0 { Text: ""; }
      TextButton #CommandButton1 { Text: ""; }
      TextButton #CommandButton2 { Text: ""; }
      TextButton #CommandButton3 { Text: ""; }
      TextButton #CommandButton4 { Text: ""; }
      TextButton #CommandButton5 { Text: ""; }
      TextButton #CommandButton6 { Text: ""; }
      TextButton #CommandButton7 { Text: ""; }

      Label #CommandLabel0 { Text: ""; }
      Label #CommandLabel1 { Text: ""; }
      Label #CommandLabel2 { Text: ""; }
      Label #CommandLabel3 { Text: ""; }
      Label #CommandLabel4 { Text: ""; }
      Label #CommandLabel5 { Text: ""; }
      Label #CommandLabel6 { Text: ""; }
      Label #CommandLabel7 { Text: ""; }
    }
  }
}
