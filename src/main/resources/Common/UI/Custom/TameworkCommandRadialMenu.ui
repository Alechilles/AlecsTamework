$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  Group #TameworkCommandMenuWheel {
    Anchor: (Width: 780, Height: 700);
    Background: (TexturePath: "Common/ContainerPatch.png", Border: 23);

    Label #TameworkCommandMenuTitle {
      Anchor: (Top: 24, Width: 620, Height: 36, Left: 80);
      Text: "";
      Style: (
        FontSize: 28,
        RenderBold: true,
        TextColor: #ffffff,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
    }

    Label #TameworkCommandMenuSubtitle {
      Anchor: (Top: 58, Width: 620, Height: 24, Left: 80);
      Text: "";
      Style: (
        FontSize: 16,
        TextColor: #dbe4e7,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
    }

    Group {
      Anchor: (Top: 256, Left: 242, Width: 296, Height: 120);
      Background: (Color: #111824(0.85));
    }

    Label #TameworkCommandMenuCurrent {
      Anchor: (Top: 272, Width: 280, Height: 90, Left: 250);
      Text: "";
      Style: (
        FontSize: 18,
        RenderBold: true,
        TextColor: #ffffff,
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
        Wrap: true
      );
    }

    $C.@SmallSecondaryTextButton #CommandButton0 {
      @Anchor = (Top: 96, Left: 290, Width: 200);
      Text: "";
      Visible: false;
    }

    $C.@SmallSecondaryTextButton #CommandButton1 {
      @Anchor = (Top: 166, Left: 522, Width: 200);
      Text: "";
      Visible: false;
    }

    $C.@SmallSecondaryTextButton #CommandButton2 {
      @Anchor = (Top: 320, Left: 570, Width: 200);
      Text: "";
      Visible: false;
    }

    $C.@SmallSecondaryTextButton #CommandButton3 {
      @Anchor = (Top: 474, Left: 522, Width: 200);
      Text: "";
      Visible: false;
    }

    $C.@SmallSecondaryTextButton #CommandButton4 {
      @Anchor = (Top: 544, Left: 290, Width: 200);
      Text: "";
      Visible: false;
    }

    $C.@SmallSecondaryTextButton #CommandButton5 {
      @Anchor = (Top: 474, Left: 58, Width: 200);
      Text: "";
      Visible: false;
    }

    $C.@SmallSecondaryTextButton #CommandButton6 {
      @Anchor = (Top: 320, Left: 10, Width: 200);
      Text: "";
      Visible: false;
    }

    $C.@SmallSecondaryTextButton #CommandButton7 {
      @Anchor = (Top: 166, Left: 58, Width: 200);
      Text: "";
      Visible: false;
    }

    $C.@SecondaryTextButton #CommandMenuCloseButton {
      @Anchor = (Bottom: 20, Width: 160, Left: 310);
      Text: "Close";
    }
  }
}
