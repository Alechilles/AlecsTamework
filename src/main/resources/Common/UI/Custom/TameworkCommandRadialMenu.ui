      Visible: false;
    }

    TextButton #CommandButton4 {
      Anchor: (Top: 577, Left: 352, Width: 217, Height: 142);
      Style: @Slice4ButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton5 {
      Anchor: (Top: 486, Left: 187, Width: 207, Height: 207);
      Style: @Slice5ButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton6 {
      Anchor: (Top: 312, Left: 161, Width: 142, Height: 217);
      Style: @Slice6ButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton7 {
      Anchor: (Top: 147, Left: 187, Width: 207, Height: 207);
      Style: @Slice7ButtonStyle;
      Text: "";
      Visible: false;
    }

    Label #CommandLabel0 {
      Anchor: (Top: 151, Left: 340, Width: 240, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    Label #CommandLabel1 {
      Anchor: (Top: 225, Left: 528, Width: 220, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    Label #CommandLabel2 {
      Anchor: (Top: 403, Left: 602, Width: 220, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    Label #CommandLabel3 {
      Anchor: (Top: 581, Left: 528, Width: 220, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    Label #CommandLabel4 {
      Anchor: (Top: 655, Left: 340, Width: 240, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    Label #CommandLabel5 {
      Anchor: (Top: 581, Left: 172, Width: 220, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    Label #CommandLabel6 {
      Anchor: (Top: 403, Left: 98, Width: 220, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    Label #CommandLabel7 {
      Anchor: (Top: 225, Left: 172, Width: 220, Height: 34);
      Text: "";
