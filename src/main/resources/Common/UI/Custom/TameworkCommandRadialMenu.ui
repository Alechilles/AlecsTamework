  Pressed: (Background: (TexturePath: "Tamework/RadialMenu/Default/Cropped/CommandWheelSlice3_Pressed.png"), LabelStyle: @SliceButtonLabelStyle),
  Disabled: (Background: (TexturePath: "Tamework/RadialMenu/Default/Cropped/CommandWheelSlice3_Default.png", Color: #ffffff(0.5)), LabelStyle: @SliceButtonDisabledLabelStyle),
  Sounds: $C.@ButtonSounds
