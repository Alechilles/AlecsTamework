$C = "Common.ui";

@SliceLabelStyle = LabelStyle(
  FontSize: 16,
  RenderBold: true,
  RenderUppercase: true,
  TextColor: #d6e0ec,
  HorizontalAlignment: Center,
  VerticalAlignment: Center,
  OutlineColor: #000000(0.7)
);

@SliceButtonLabelStyle = LabelStyle(
  FontSize: 14,
  RenderBold: true,
  RenderUppercase: true,
  TextColor: #00000000,
  HorizontalAlignment: Center,
  VerticalAlignment: Center
);

@SliceButtonDisabledLabelStyle = LabelStyle(
  ...@SliceButtonLabelStyle
);

@Slice0ButtonStyle = TextButtonStyle(
  Default: (Background: (TexturePath: "Tamework/CommandWheelSlice0_Default.png"), LabelStyle: @SliceButtonLabelStyle),
  Hovered: (Background: (TexturePath: "Tamework/CommandWheelSlice0_Hover.png"), LabelStyle: @SliceButtonLabelStyle),
  Pressed: (Background: (TexturePath: "Tamework/CommandWheelSlice0_Pressed.png"), LabelStyle: @SliceButtonLabelStyle),
  Disabled: (Background: (TexturePath: "Tamework/CommandWheelSlice0_Default.png", Color: #ffffff(0.5)), LabelStyle: @SliceButtonDisabledLabelStyle)
);

@Slice1ButtonStyle = TextButtonStyle(
  Default: (Background: (TexturePath: "Tamework/CommandWheelSlice1_Default.png"), LabelStyle: @SliceButtonLabelStyle),
  Hovered: (Background: (TexturePath: "Tamework/CommandWheelSlice1_Hover.png"), LabelStyle: @SliceButtonLabelStyle),
  Pressed: (Background: (TexturePath: "Tamework/CommandWheelSlice1_Pressed.png"), LabelStyle: @SliceButtonLabelStyle),
  Disabled: (Background: (TexturePath: "Tamework/CommandWheelSlice1_Default.png", Color: #ffffff(0.5)), LabelStyle: @SliceButtonDisabledLabelStyle)
);

@Slice2ButtonStyle = TextButtonStyle(
  Default: (Background: (TexturePath: "Tamework/CommandWheelSlice2_Default.png"), LabelStyle: @SliceButtonLabelStyle),
  Hovered: (Background: (TexturePath: "Tamework/CommandWheelSlice2_Hover.png"), LabelStyle: @SliceButtonLabelStyle),
  Pressed: (Background: (TexturePath: "Tamework/CommandWheelSlice2_Pressed.png"), LabelStyle: @SliceButtonLabelStyle),
  Disabled: (Background: (TexturePath: "Tamework/CommandWheelSlice2_Default.png", Color: #ffffff(0.5)), LabelStyle: @SliceButtonDisabledLabelStyle)
);

@Slice3ButtonStyle = TextButtonStyle(
  Default: (Background: (TexturePath: "Tamework/CommandWheelSlice3_Default.png"), LabelStyle: @SliceButtonLabelStyle),
  Hovered: (Background: (TexturePath: "Tamework/CommandWheelSlice3_Hover.png"), LabelStyle: @SliceButtonLabelStyle),
  Pressed: (Background: (TexturePath: "Tamework/CommandWheelSlice3_Pressed.png"), LabelStyle: @SliceButtonLabelStyle),
  Disabled: (Background: (TexturePath: "Tamework/CommandWheelSlice3_Default.png", Color: #ffffff(0.5)), LabelStyle: @SliceButtonDisabledLabelStyle)
);

@Slice4ButtonStyle = TextButtonStyle(
  Default: (Background: (TexturePath: "Tamework/CommandWheelSlice4_Default.png"), LabelStyle: @SliceButtonLabelStyle),
  Hovered: (Background: (TexturePath: "Tamework/CommandWheelSlice4_Hover.png"), LabelStyle: @SliceButtonLabelStyle),
  Pressed: (Background: (TexturePath: "Tamework/CommandWheelSlice4_Pressed.png"), LabelStyle: @SliceButtonLabelStyle),
  Disabled: (Background: (TexturePath: "Tamework/CommandWheelSlice4_Default.png", Color: #ffffff(0.5)), LabelStyle: @SliceButtonDisabledLabelStyle)
);

@Slice5ButtonStyle = TextButtonStyle(
  Default: (Background: (TexturePath: "Tamework/CommandWheelSlice5_Default.png"), LabelStyle: @SliceButtonLabelStyle),
  Hovered: (Background: (TexturePath: "Tamework/CommandWheelSlice5_Hover.png"), LabelStyle: @SliceButtonLabelStyle),
  Pressed: (Background: (TexturePath: "Tamework/CommandWheelSlice5_Pressed.png"), LabelStyle: @SliceButtonLabelStyle),
  Disabled: (Background: (TexturePath: "Tamework/CommandWheelSlice5_Default.png", Color: #ffffff(0.5)), LabelStyle: @SliceButtonDisabledLabelStyle)
);

@Slice6ButtonStyle = TextButtonStyle(
  Default: (Background: (TexturePath: "Tamework/CommandWheelSlice6_Default.png"), LabelStyle: @SliceButtonLabelStyle),
  Hovered: (Background: (TexturePath: "Tamework/CommandWheelSlice6_Hover.png"), LabelStyle: @SliceButtonLabelStyle),
  Pressed: (Background: (TexturePath: "Tamework/CommandWheelSlice6_Pressed.png"), LabelStyle: @SliceButtonLabelStyle),
  Disabled: (Background: (TexturePath: "Tamework/CommandWheelSlice6_Default.png", Color: #ffffff(0.5)), LabelStyle: @SliceButtonDisabledLabelStyle)
);

@Slice7ButtonStyle = TextButtonStyle(
  Default: (Background: (TexturePath: "Tamework/CommandWheelSlice7_Default.png"), LabelStyle: @SliceButtonLabelStyle),
  Hovered: (Background: (TexturePath: "Tamework/CommandWheelSlice7_Hover.png"), LabelStyle: @SliceButtonLabelStyle),
  Pressed: (Background: (TexturePath: "Tamework/CommandWheelSlice7_Pressed.png"), LabelStyle: @SliceButtonLabelStyle),
  Disabled: (Background: (TexturePath: "Tamework/CommandWheelSlice7_Default.png", Color: #ffffff(0.5)), LabelStyle: @SliceButtonDisabledLabelStyle)
);

$C.@PageOverlay {
  LayoutMode: Middle;

  Group #TameworkCommandMenuWheel {
    Anchor: (Width: 920, Height: 760);
    Visible: false;

    Label #TameworkCommandMenuTitle {
      Anchor: (Top: 18, Width: 620, Height: 42, Left: 150);
      Text: "";
      Style: (
        FontSize: 38,
        RenderBold: true,
        TextColor: #ffffff,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
    }

    Label #TameworkCommandMenuSubtitle {
      Anchor: (Top: 62, Width: 620, Height: 26, Left: 150);
      Text: "";
      Style: (
        FontSize: 16,
        TextColor: #dbe4e7,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
    }

    Group #CommandWheelOuterRing {
      Anchor: (Top: 100, Left: 140, Width: 640, Height: 640);
      Background: (TexturePath: "Tamework/CommandWheelRingOuter.png");
    }

    Group #CommandWheelInnerRing {
      Anchor: (Top: 100, Left: 140, Width: 640, Height: 640);
      Background: (TexturePath: "Tamework/CommandWheelRingInner.png");
    }

    Group {
      Anchor: (Top: 298, Left: 306, Width: 308, Height: 144);
      Background: (Color: #06101a(0.42));
    }

    Label #TameworkCommandMenuCurrent {
      Anchor: (Top: 310, Width: 284, Height: 120, Left: 318);
      Text: "";
      Style: (
        FontSize: 24,
        RenderBold: true,
        TextColor: #ffffff,
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
        Wrap: true,
        OutlineColor: #000000(0.7)
      );
    }

    TextButton #CommandButton0 {
      Anchor: (Top: 165, Left: 370, Width: 180, Height: 112);
      Style: @Slice0ButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton1 {
      Anchor: (Top: 188, Left: 523, Width: 169, Height: 170);
      Style: @Slice1ButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton2 {
