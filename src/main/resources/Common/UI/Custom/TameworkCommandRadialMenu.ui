$C = "Common.ui";

@WheelCommandButtonStyle = TextButtonStyle(
  Default: (
    Background: #00000000,
    LabelStyle: (
      FontSize: 18,
      RenderBold: true,
      RenderUppercase: true,
      TextColor: #cfdae8,
      HorizontalAlignment: Center,
      VerticalAlignment: Center,
      ShrinkTextToFit: true,
      MinShrinkTextToFitFontSize: 12
    )
  ),
  Hovered: (
    Background: #2a4460(0.58),
    LabelStyle: (
      FontSize: 18,
      RenderBold: true,
      RenderUppercase: true,
      TextColor: #ffffff,
      HorizontalAlignment: Center,
      VerticalAlignment: Center,
      ShrinkTextToFit: true,
      MinShrinkTextToFitFontSize: 12
    )
  ),
  Pressed: (
    Background: #3d5f82(0.72),
    LabelStyle: (
      FontSize: 18,
      RenderBold: true,
      RenderUppercase: true,
      TextColor: #ffffff,
      HorizontalAlignment: Center,
      VerticalAlignment: Center,
      ShrinkTextToFit: true,
      MinShrinkTextToFitFontSize: 12
    )
  ),
  Disabled: (
    Background: #00000000,
    LabelStyle: (
      FontSize: 18,
      RenderBold: true,
      RenderUppercase: true,
      TextColor: #738296,
      HorizontalAlignment: Center,
      VerticalAlignment: Center,
      ShrinkTextToFit: true,
      MinShrinkTextToFitFontSize: 12
    )
  )
);

$C.@PageOverlay {
  LayoutMode: Middle;

  Group #TameworkCommandMenuWheel {
    Anchor: (Width: 920, Height: 760);
    Visible: false;

    Label #TameworkCommandMenuTitle {
      Anchor: (Top: 20, Width: 620, Height: 36, Left: 150);
      Text: "";
      Style: (
        FontSize: 38,
        RenderBold: true,
        TextColor: #ffffff,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
    }

    Label #TameworkCommandMenuSubtitle {
      Anchor: (Top: 62, Width: 620, Height: 24, Left: 150);
      Text: "";
      Style: (
        FontSize: 16,
        TextColor: #dbe4e7,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
    }

    Group #CommandWheelOuterRing {
      Anchor: (Top: 104, Left: 174, Width: 572, Height: 572);
      Background: (TexturePath: "Tamework/CommandWheelRingOuter.png");
    }

    Group #CommandWheelInnerRing {
      Anchor: (Top: 174, Left: 244, Width: 432, Height: 432);
      Background: (TexturePath: "Tamework/CommandWheelRingInner.png");
    }

    Label #TameworkCommandMenuCurrent {
      Anchor: (Top: 330, Width: 280, Height: 120, Left: 320);
      Text: "";
      Style: (
        FontSize: 24,
        RenderBold: true,
        TextColor: #ffffff,
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
        Wrap: true,
        OutlineColor: #0a111a(0.8)
      );
    }

    TextButton #CommandButton0 {
      Anchor: (Top: 118, Left: 355, Width: 210, Height: 40);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton1 {
      Anchor: (Top: 205, Left: 585, Width: 210, Height: 40);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton2 {
      Anchor: (Top: 370, Left: 640, Width: 210, Height: 40);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton3 {
      Anchor: (Top: 535, Left: 585, Width: 210, Height: 40);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton4 {
      Anchor: (Top: 622, Left: 355, Width: 210, Height: 40);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton5 {
      Anchor: (Top: 535, Left: 125, Width: 210, Height: 40);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton6 {
      Anchor: (Top: 370, Left: 70, Width: 210, Height: 40);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton7 {
      Anchor: (Top: 205, Left: 125, Width: 210, Height: 40);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    $C.@SecondaryTextButton #CommandMenuCloseButton {
      @Anchor = (Bottom: 10, Width: 180, Left: 370);
      Text: "Close";
    }
  }
}
