    }

    TextButton #CommandButton4 {
      Anchor: (Top: 563, Left: 370, Width: 180, Height: 112);
      Style: @Slice4ButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton5 {
      Anchor: (Top: 483, Left: 228, Width: 170, Height: 169);
      Style: @Slice5ButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton6 {
      Anchor: (Top: 331, Left: 205, Width: 112, Height: 179);
      Style: @Slice6ButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton7 {
      Anchor: (Top: 188, Left: 228, Width: 170, Height: 170);
      Style: @Slice7ButtonStyle;
      Text: "";
      Visible: false;
    }

    Label #CommandLabel0 {
      Anchor: (Top: 128, Left: 330, Width: 260, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    Label #CommandLabel1 {
      Anchor: (Top: 203, Left: 575, Width: 220, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    Label #CommandLabel2 {
      Anchor: (Top: 364, Left: 676, Width: 220, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    Label #CommandLabel3 {
      Anchor: (Top: 540, Left: 575, Width: 220, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    Label #CommandLabel4 {
      Anchor: (Top: 608, Left: 330, Width: 260, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    Label #CommandLabel5 {
      Anchor: (Top: 540, Left: 125, Width: 220, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    Label #CommandLabel6 {
      Anchor: (Top: 364, Left: 24, Width: 220, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    Label #CommandLabel7 {
      Anchor: (Top: 203, Left: 125, Width: 220, Height: 34);
      Text: "";
      Style: @SliceLabelStyle;
      Visible: false;
    }

    $C.@SecondaryTextButton #CommandMenuCloseButton {
      @Anchor = (Bottom: 12, Width: 180, Left: 370);
      Text: "Close";
    }
  }
}
