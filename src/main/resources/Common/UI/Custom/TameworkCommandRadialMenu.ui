$C = "Common.ui";

@WheelCommandButtonStyle = TextButtonStyle(
  Default: (
    Background: #0c1522(0.32),
    LabelStyle: (
      FontSize: 17,
      RenderBold: true,
      RenderUppercase: true,
      TextColor: #cfdae8,
      HorizontalAlignment: Center,
      VerticalAlignment: Center,
      ShrinkTextToFit: true,
      MinShrinkTextToFitFontSize: 12
    )
  ),
  Hovered: (
    Background: #2f4f74(0.82),
    LabelStyle: (
      FontSize: 17,
      RenderBold: true,
      RenderUppercase: true,
      TextColor: #ffffff,
      HorizontalAlignment: Center,
      VerticalAlignment: Center,
      ShrinkTextToFit: true,
      MinShrinkTextToFitFontSize: 12
    )
  ),
  Pressed: (
    Background: #436a91(0.88),
    LabelStyle: (
      FontSize: 17,
      RenderBold: true,
      RenderUppercase: true,
      TextColor: #ffffff,
      HorizontalAlignment: Center,
      VerticalAlignment: Center,
      ShrinkTextToFit: true,
      MinShrinkTextToFitFontSize: 12
    )
  ),
  Disabled: (
    Background: #0c1522(0.18),
    LabelStyle: (
      FontSize: 17,
      RenderBold: true,
      RenderUppercase: true,
      TextColor: #738296,
      HorizontalAlignment: Center,
      VerticalAlignment: Center,
      ShrinkTextToFit: true,
      MinShrinkTextToFitFontSize: 12
    )
  )
);

$C.@PageOverlay {
  LayoutMode: Middle;

  Group #TameworkCommandMenuWheel {
    Anchor: (Width: 980, Height: 820);
    Visible: false;

    Label #TameworkCommandMenuTitle {
      Anchor: (Top: 20, Width: 620, Height: 36, Left: 180);
      Text: "";
      Style: (
        FontSize: 38,
        RenderBold: true,
        TextColor: #ffffff,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
    }

    Label #TameworkCommandMenuSubtitle {
      Anchor: (Top: 64, Width: 620, Height: 24, Left: 180);
      Text: "";
      Style: (
        FontSize: 16,
        TextColor: #dbe4e7,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
    }

    $C.@CircularProgressBar #CommandWheelOuterRing {
      @Anchor = (Top: 120, Left: 180);
      @Size = 620;
      Value: 1.0;
      Color: #4f79a5(0.56);
      Background: #0b1320(0.2);
    }

    $C.@CircularProgressBar #CommandWheelInnerRing {
      @Anchor = (Top: 220, Left: 280);
      @Size = 420;
      Value: 1.0;
      Color: #365d87(0.46);
      Background: #0d1724(0.06);
    }

    Label #TameworkCommandMenuCurrent {
      Anchor: (Top: 374, Width: 300, Height: 112, Left: 340);
      Text: "";
      Style: (
        FontSize: 24,
        RenderBold: true,
        TextColor: #ffffff,
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
        Wrap: true,
        OutlineColor: #0a111a(0.8)
      );
    }

    TextButton #CommandButton0 {
      Anchor: (Top: 103, Left: 375, Width: 230, Height: 44);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton1 {
      Anchor: (Top: 192, Left: 591, Width: 230, Height: 44);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton2 {
      Anchor: (Top: 408, Left: 680, Width: 230, Height: 44);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton3 {
      Anchor: (Top: 624, Left: 591, Width: 230, Height: 44);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton4 {
      Anchor: (Top: 713, Left: 375, Width: 230, Height: 44);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton5 {
      Anchor: (Top: 624, Left: 159, Width: 230, Height: 44);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton6 {
      Anchor: (Top: 408, Left: 70, Width: 230, Height: 44);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    TextButton #CommandButton7 {
      Anchor: (Top: 192, Left: 159, Width: 230, Height: 44);
      Style: @WheelCommandButtonStyle;
      Text: "";
      Visible: false;
    }

    $C.@SecondaryTextButton #CommandMenuCloseButton {
      @Anchor = (Bottom: 22, Width: 180, Left: 400);
      Text: "Close";
    }
  }
}
