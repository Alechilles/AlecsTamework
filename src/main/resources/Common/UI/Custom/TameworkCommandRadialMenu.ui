$A = "TameworkPanelActionStyles.ui";
$C = "Common.ui";
@CommandAssignmentKeyStyle = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #c4dbc9, Alignment: Center);
@CommandAssignmentDropdownStyle = (...$A.@PanelDropdown, HorizontalPadding: 4, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, TextColor: #e8e4da, RenderUppercase: false, FontSize: 11), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #e8e4da, RenderUppercase: false, FontSize: 11), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #f0eee7, RenderUppercase: false, FontSize: 11));
$C.@PageOverlay {
 LayoutMode: Middle;
 Group #TameworkCommandMenuWheel {
  Anchor: (Width: 1120, Height: 820);
  Visible: false;
  Group #TameworkCommandMenuSurface {
   Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
   Background: (TexturePath: "Tamework/PanelActions/Base_Default.png", Border: 3);
  }
  Group #TameworkCommandMenuContent {
   Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
   Group #TameworkCommandMenuHeader {
    Anchor: (Top: 3, Left: 3, Right: 3, Height: 42);
    Background: #252b27;
    Group #TameworkCommandMenuLogo { Anchor: (Top: 4, Left: 12, Width: 34, Height: 34); Background: "Tamework/Telemetry/TameworkConsentIcon.png"; }
    Label #TameworkCommandMenuTitle { Anchor: (Left: 56, Right: 286, Height: 42); Text: ""; Style: (FontSize: 23, RenderBold: true, TextColor: #f0eee7, VerticalAlignment: Center); }
    TextButton #CommandMenuHelpButton {
      Anchor: (Top: 8, Right: 186, Width: 88, Height: 26);
      Text: %server.tamework.ui.guide.help;
      Style: $A.@PanelButton;
    }
    Label #TameworkCommandMenuSubtitle { Anchor: (Left: 330, Width: 500, Height: 42); Text: ""; Visible: false; Style: (FontSize: 12, TextColor: #afb6b0); }
    TextButton #CommandMenuFeedbackButton {
      Anchor: (Top: 8, Right: 86, Width: 92, Height: 26);
      Text: %server.tamework.ui.commandMenu.feedback;
      TooltipText: %server.tamework.ui.commandMenu.feedbackTooltip;
      Style: $A.@PanelButton;
    }
    Group #CommandMenuSettings {
     Anchor: (Top: 8, Right: 50, Width: 28, Height: 26);
     Visible: false;
     TextButton #CommandMenuSettingsButton { Anchor: (Full: 0); Text: ""; Style: $A.@PanelButton; TooltipText: %server.tamework.ui.settings.title; }
     Group { Anchor: (Top: 1, Left: 2, Width: 24, Height: 24); HitTestVisible: false; Background: (TexturePath: "Tamework/PanelActions/Settings_Glyph_Default.png"); }
    }
    Group #CommandMenuClose {
     Anchor: (Top: 7, Right: 14, Width: 28, Height: 28);
     TextButton #CommandMenuCloseButton { Anchor: (Full: 0); Text: ""; TooltipText: %server.tamework.ui.shared.button.close; Style: $A.@Remove; }
     Group { Anchor: (Top: 2, Left: 2, Width: 24, Height: 24); HitTestVisible: false; Background: (TexturePath: "Tamework/PanelActions/Remove_Glyph_Default.png"); }
    }
   }
   Group #TameworkCommandAssignments {
     Anchor: (Top: 54, Left: 12, Width: 160, Bottom: 16);
    Background: #171d19;
    OutlineColor: #414845;
    OutlineSize: 1;
    Group #TameworkCommandPrimaryAssignment {
     Anchor: (Top: 8, Left: 8, Right: 8, Height: 70);
     Background: #202923;
     OutlineColor: #414845;
     OutlineSize: 1;
     Label { Anchor: (Top: 4, Left: 8, Right: 8, Height: 24); Text: "LMB"; Style: @CommandAssignmentKeyStyle; }
     Group { Anchor: (Top: 29, Left: 8, Right: 8, Height: 1); Background: #414845(0.72); }
     DropdownBox #TameworkCommandPrimary { Anchor: (Top: 34, Left: 8, Right: 8, Height: 28); Style: @CommandAssignmentDropdownStyle; HitTestVisible: true; MaxSelection: 1; NoItemsText: %server.tamework.ui.commandMenu.noCommands; }
    }
    Group #TameworkCommandHotswapQAssignment {
     Anchor: (Top: 86, Left: 8, Right: 8, Height: 70);
     Background: #202923;
     OutlineColor: #414845;
     OutlineSize: 1;
     Label { Anchor: (Top: 4, Left: 8, Right: 8, Height: 24); Text: "Q"; Style: @CommandAssignmentKeyStyle; }
     Group { Anchor: (Top: 29, Left: 8, Right: 8, Height: 1); Background: #414845(0.72); }
     DropdownBox #TameworkCommandHotswapQ { Anchor: (Top: 34, Left: 8, Right: 8, Height: 28); Style: @CommandAssignmentDropdownStyle; HitTestVisible: true; MaxSelection: 1; NoItemsText: %server.tamework.ui.commandMenu.noCommands; }
    }
    Group #TameworkCommandHotswapEAssignment {
     Anchor: (Top: 164, Left: 8, Right: 8, Height: 70);
     Background: #202923;
     OutlineColor: #414845;
     OutlineSize: 1;
     Label { Anchor: (Top: 4, Left: 8, Right: 8, Height: 24); Text: "E"; Style: @CommandAssignmentKeyStyle; }
     Group { Anchor: (Top: 29, Left: 8, Right: 8, Height: 1); Background: #414845(0.72); }
     DropdownBox #TameworkCommandHotswapE { Anchor: (Top: 34, Left: 8, Right: 8, Height: 28); Style: @CommandAssignmentDropdownStyle; HitTestVisible: true; MaxSelection: 1; NoItemsText: %server.tamework.ui.commandMenu.noCommands; }
    }
    Group #TameworkCommandHotswapRAssignment {
     Anchor: (Top: 242, Left: 8, Right: 8, Height: 70);
     Background: #202923;
     OutlineColor: #414845;
     OutlineSize: 1;
     Label { Anchor: (Top: 4, Left: 8, Right: 8, Height: 24); Text: "R"; Style: @CommandAssignmentKeyStyle; }
     Group { Anchor: (Top: 29, Left: 8, Right: 8, Height: 1); Background: #414845(0.72); }
     DropdownBox #TameworkCommandHotswapR { Anchor: (Top: 34, Left: 8, Right: 8, Height: 28); Style: @CommandAssignmentDropdownStyle; HitTestVisible: true; MaxSelection: 1; NoItemsText: %server.tamework.ui.commandMenu.noCommands; }
    }

    Group #TameworkGroupQuickSelect {
     Anchor: (Top: 328, Left: 8, Right: 8, Bottom: 8);
     Background: #202923;
     OutlineColor: #414845;
     OutlineSize: 1;
     Label { Anchor: (Top: 6, Left: 8, Right: 38, Height: 24); Text: %server.tamework.ui.linkedPanel.manageGroups; Style: (FontSize: 13, RenderBold: true, TextColor: #c4dbc9, HorizontalAlignment: Start, VerticalAlignment: Center); }
     Group { Anchor: (Top: 5, Right: 5, Width: 26, Height: 26);
      TextButton #TameworkLinkedPanelManageGroupsButton { Anchor: (Full: 0); Text: ""; TooltipText: %server.tamework.ui.shared.button.edit; Style: $A.@GroupRow; }
      Group { Anchor: (Top: 5, Left: 5, Width: 16, Height: 16); Background: "Tamework/PanelControls/GroupEdit.png"; HitTestVisible: false; }
     }
     Group { Anchor: (Top: 36, Left: 4, Right: 4, Bottom: 0); LayoutMode: TopScrolling; KeepScrollPosition: true; ScrollbarStyle: $C.@DefaultScrollbarStyle; Padding: (Top: 2, Bottom: 4);
      Group #TameworkGroupQuickSelectList { Anchor: (Left: 0, Right: 0); LayoutMode: Top; }
     }
    }
   }
  }
    // Legacy wheel selectors stay mounted for existing page bindings, but the
    // command sidebar is the only visible command-selection surface.
    Group #TameworkCommandLegacyWheel {
      Anchor: (Top: 0, Left: 0, Width: 1, Height: 1);
      Visible: false;

      Label #TameworkCommandMenuCurrent { Text: ""; }

      TextButton #CommandButton0 { Text: ""; }
      TextButton #CommandButton1 { Text: ""; }
      TextButton #CommandButton2 { Text: ""; }
      TextButton #CommandButton3 { Text: ""; }
      TextButton #CommandButton4 { Text: ""; }
      TextButton #CommandButton5 { Text: ""; }
      TextButton #CommandButton6 { Text: ""; }
      TextButton #CommandButton7 { Text: ""; }

      Label #CommandLabel0 { Text: ""; }
      Label #CommandLabel1 { Text: ""; }
      Label #CommandLabel2 { Text: ""; }
      Label #CommandLabel3 { Text: ""; }
      Label #CommandLabel4 { Text: ""; }
      Label #CommandLabel5 { Text: ""; }
      Label #CommandLabel6 { Text: ""; }
      Label #CommandLabel7 { Text: ""; }
    }
  }
}
