     ItemGrid #FoodGrid { Anchor: (Top: 13, Left: 3, Width: 28, Height: 28); SlotsPerRow: 1; RenderItemQualityBackground: false; InfoDisplay: None; Style: @FoodItemGridStyle; Visible: false; }
     Label #FoodValuePositive { Anchor: (Top: 3, Left: 10, Width: 24, Height: 14); Text: ""; Visible: false; Background: @FoodChipPositive; Style: @FoodChipTextPositive; }
     Label #FoodValueNegative { Anchor: (Top: 3, Left: 10, Width: 24, Height: 14); Text: ""; Visible: false; Background: @FoodChipNegative; Style: @FoodChipTextNegative; }
     Label #FoodValueNeutral { Anchor: (Top: 3, Left: 10, Width: 24, Height: 14); Text: ""; Visible: false; Background: @FoodChipNeutral; Style: @FoodChipTextNeutral; }
     TextButton #FoodTooltip { Anchor: (Top: 10, Left: 0, Width: 34, Height: 34); Text: ""; TooltipText: ""; Style: @HudTooltipButtonStyle; TextTooltipStyle: @HudTooltipStyle; }
    }
    Group #FoodSlot2 { Anchor: (Top: 0, Left: 76, Width: 34, Height: 46); Visible: false;
