    Label #FoodName { Anchor: (Top: 16, Left: 40, Width: 72, Height: 18); Text: ""; Style: (FontSize: 11, RenderBold: true, TextColor: #eef2f6, HorizontalAlignment: Start, VerticalAlignment: Center); }
   }

   // Each slot is a quiet plate with the happiness change as a small badge on its top-right corner.
   Group #FoodStripBlock {
    Anchor: (Top: 0, Left: 0, Width: 168, Height: 46);
    Visible: false;
    Group #FoodSlot0 { Anchor: (Top: 0, Left: 0, Width: 34, Height: 46); Visible: false;
     Group { Anchor: (Top: 10, Left: 0, Width: 34, Height: 34); Background: $A.@SlateQuiet; }
