$A = "TameworkSlateStyles.ui";
$C = "Common.ui";

// The command-target HUD in the Slate look. Java sets the root height and stacks the rows
// (CommandTargetHudBinder), so the plate is a stretchable 9-patch, not an off-atlas picture.
@HudTooltipLabelStyle = LabelStyle(FontSize: 1, TextColor: #000000(0.0));
@HudTooltipButtonStyle = TextButtonStyle(Default: (Background: (Color: #000000(0.0)), LabelStyle: @HudTooltipLabelStyle), Hovered: (Background: (Color: #000000(0.0)), LabelStyle: @HudTooltipLabelStyle), Pressed: (Background: (Color: #000000(0.0)), LabelStyle: @HudTooltipLabelStyle), Disabled: (Background: (Color: #000000(0.0)), LabelStyle: @HudTooltipLabelStyle), Sounds: $C.@ButtonSounds);
@HudTooltipStyle = $C.@DefaultTextTooltipStyle;
@FoodItemGridStyle = ItemGridStyle(SlotSize: 28, SlotSpacing: 0, SlotIconSize: 28);
@CompatibleFoodItemGridStyle = ItemGridStyle(SlotSize: 28, SlotSpacing: 0, SlotIconSize: 28);

// Java swaps these four by name (LinkedNpcPanelVitalsBinder.bindHud).
@MeterValue = LabelStyle(FontSize: 11, RenderBold: true, TextColor: #eef2f6, HorizontalAlignment: End, VerticalAlignment: Center);
@CooldownValue = LabelStyle(FontSize: 10, TextColor: #bfcdd5, VerticalAlignment: Center);
@CooldownMuted = LabelStyle(FontSize: 10, TextColor: #586d8a, VerticalAlignment: Center);
@CooldownLabel = LabelStyle(FontSize: 9, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #96a9be, VerticalAlignment: Center);

@Caption = LabelStyle(FontSize: 9, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #96a9be, VerticalAlignment: Center);
// Food value badges: the white pill outline is tinted per sign.
@FoodChipTextPositive = LabelStyle(FontSize: 9, RenderBold: true, TextColor: #7fe08f, Alignment: Center);
@FoodChipTextNegative = LabelStyle(FontSize: 9, RenderBold: true, TextColor: #e5786d, Alignment: Center);
@FoodChipTextNeutral = LabelStyle(FontSize: 9, RenderBold: true, TextColor: #bfcdd5, Alignment: Center);
@FoodChipPositive = PatchStyle(TexturePath: "Tamework/Slate/PillDark.png", Border: 7, Color: #7fe08f);
@FoodChipNegative = PatchStyle(TexturePath: "Tamework/Slate/PillDark.png", Border: 7, Color: #e5786d);
@FoodChipNeutral = PatchStyle(TexturePath: "Tamework/Slate/PillDark.png", Border: 7, Color: #96a9be);

Group #Root {
 Anchor: (Top: 218, Right: 26, Width: 344, Height: 300);
 Padding: (Left: 10, Right: 10, Top: 10, Bottom: 10);
 Background: $A.@SlateHud;
 Visible: false;
 Group #HeaderRow {
  Anchor: (Top: 0, Left: 0, Right: 0, Height: 26);
  Group #GenderMaleIcon { Anchor: (Top: 4, Left: 0, Width: 18, Height: 18); Background: (TexturePath: "Tamework/LinkedPanelIcons/Gender_Male.png", Color: #58c9f0); Visible: false; }
  Group #GenderFemaleIcon { Anchor: (Top: 4, Left: 0, Width: 18, Height: 18); Background: (TexturePath: "Tamework/LinkedPanelIcons/Gender_Female.png", Color: #ff86bb); Visible: false; }
  Label #Name { Anchor: (Top: 0, Left: 24, Right: 126, Height: 26); Text: ""; Style: (FontSize: 16, FontName: "Secondary", TextColor: #eef2f6, VerticalAlignment: Center); }
  Group #TraitRingRow { Anchor: (Top: 0, Right: 0, Width: 120, Height: 26); LayoutMode: Left; Visible: false;
   Group #TraitSlot0 { Anchor: (Width: 30, Height: 26); Visible: false;
    Group { Anchor: (Top: 0, Left: 0, Width: 26, Height: 24); Background: $A.@SlateQuiet; }
    Group { Anchor: (Top: 20, Left: 4, Width: 18, Height: 3); Background: #090e14; }
    Group #TraitTick { Anchor: (Top: 20, Left: 4, Width: 18, Height: 3); Background: #e8aa35; }
    Group #TraitIconImage { Anchor: (Top: 1, Left: 4, Width: 18, Height: 18); Visible: false; }
    Label #TraitIcon { Anchor: (Top: 1, Left: 4, Width: 18, Height: 18); Text: ""; Style: (FontSize: 13, TextColor: #f3ead6, Alignment: Center); }
    TextButton #TraitTooltip { Anchor: (Full: 0); Text: ""; Style: @HudTooltipButtonStyle; TextTooltipStyle: @HudTooltipStyle; }
   }
   Group #TraitSlot1 { Anchor: (Width: 30, Height: 26); Visible: false;
    Group { Anchor: (Top: 0, Left: 0, Width: 26, Height: 24); Background: $A.@SlateQuiet; }
    Group { Anchor: (Top: 20, Left: 4, Width: 18, Height: 3); Background: #090e14; }
    Group #TraitTick { Anchor: (Top: 20, Left: 4, Width: 18, Height: 3); Background: #e8aa35; }
    Group #TraitIconImage { Anchor: (Top: 1, Left: 4, Width: 18, Height: 18); Visible: false; }
    Label #TraitIcon { Anchor: (Top: 1, Left: 4, Width: 18, Height: 18); Text: ""; Style: (FontSize: 13, TextColor: #f3ead6, Alignment: Center); }
    TextButton #TraitTooltip { Anchor: (Full: 0); Text: ""; Style: @HudTooltipButtonStyle; TextTooltipStyle: @HudTooltipStyle; }
   }
   Group #TraitSlot2 { Anchor: (Width: 30, Height: 26); Visible: false;
    Group { Anchor: (Top: 0, Left: 0, Width: 26, Height: 24); Background: $A.@SlateQuiet; }
    Group { Anchor: (Top: 20, Left: 4, Width: 18, Height: 3); Background: #090e14; }
    Group #TraitTick { Anchor: (Top: 20, Left: 4, Width: 18, Height: 3); Background: #e8aa35; }
    Group #TraitIconImage { Anchor: (Top: 1, Left: 4, Width: 18, Height: 18); Visible: false; }
    Label #TraitIcon { Anchor: (Top: 1, Left: 4, Width: 18, Height: 18); Text: ""; Style: (FontSize: 13, TextColor: #f3ead6, Alignment: Center); }
    TextButton #TraitTooltip { Anchor: (Full: 0); Text: ""; Style: @HudTooltipButtonStyle; TextTooltipStyle: @HudTooltipStyle; }
   }
   Group #TraitSlot3 { Anchor: (Width: 30, Height: 26); Visible: false;
    Group { Anchor: (Top: 0, Left: 0, Width: 26, Height: 24); Background: $A.@SlateQuiet; }
    Group { Anchor: (Top: 20, Left: 4, Width: 18, Height: 3); Background: #090e14; }
    Group #TraitTick { Anchor: (Top: 20, Left: 4, Width: 18, Height: 3); Background: #e8aa35; }
    Group #TraitIconImage { Anchor: (Top: 1, Left: 4, Width: 18, Height: 18); Visible: false; }
    Label #TraitIcon { Anchor: (Top: 1, Left: 4, Width: 18, Height: 18); Text: ""; Style: (FontSize: 13, TextColor: #f3ead6, Alignment: Center); }
    TextButton #TraitTooltip { Anchor: (Full: 0); Text: ""; Style: @HudTooltipButtonStyle; TextTooltipStyle: @HudTooltipStyle; }
   }
  }
 }
 Label #RoleSubtitle { Anchor: (Top: 26, Left: 24, Right: 126, Height: 16); Text: ""; Visible: false; Style: (FontSize: 11, TextColor: #96a9be, VerticalAlignment: Center); }
 // Talent points sit on a teal chip, the level on a quiet one in gold. Java sets both widths.
 Group #ProgressionRow { Anchor: (Top: 26, Right: 0, Width: 110, Height: 18); Visible: false;
  Group #TalentPointAction { Anchor: (Top: 0, Left: 0, Width: 36, Height: 18); Background: $A.@SlatePrimary; Visible: false;
   Group #TalentPointIcon { Anchor: (Top: 3, Left: 5, Width: 12, Height: 12); Background: (TexturePath: "Tamework/PanelControls/TalentPoints.png", Color: #f2f6fc); }
   Label #TalentPointCountShadow { Anchor: (Left: 18, Width: 16, Height: 18); Text: ""; Visible: false; }
   Label #TalentPointCount { Anchor: (Left: 18, Width: 16, Height: 18); Text: ""; Style: (FontSize: 10, RenderBold: true, TextColor: #f2f6fc, VerticalAlignment: Center); }
  }
  Group #XpProgressRing { Anchor: (Right: 0, Width: 70, Height: 18); Background: $A.@SlateQuiet; Visible: false;
   Label #XpLevelText { Anchor: (Left: 0, Right: 0, Height: 18); Text: ""; Style: (FontSize: 11, RenderBold: true, TextColor: #f2c66d, Alignment: Center); }
   TextButton #XpTooltip { Anchor: (Full: 0); Text: ""; Style: @HudTooltipButtonStyle; TextTooltipStyle: @HudTooltipStyle; }
  }
 }
 Group #HealthRow { Anchor: (Top: 46, Left: 0, Right: 0, Height: 28);
  Group #HealthBar { Anchor: (Top: 0, Left: 0, Right: 0, Height: 22); Background: $A.@SlateTrack;
   Group #HealthFill { Anchor: (Top: 1, Left: 1, Width: 0, Height: 20); Background: #57c87a; }
   Label #HealthTextShadow { Anchor: (Top: 1, Left: 1, Right: -1, Height: 22); Text: ""; Style: (FontSize: 12, RenderBold: true, TextColor: #08100a, HorizontalAlignment: Center, VerticalAlignment: Center); }
   Label #HealthText { Anchor: (Top: 0, Left: 0, Right: 0, Height: 22); Text: ""; Style: (FontSize: 12, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center); }
   TextButton #HealthTooltip { Anchor: (Full: 0); Text: ""; Style: @HudTooltipButtonStyle; TextTooltipStyle: @HudTooltipStyle; }
  }
 }
 Group #StatusRingRow { Anchor: (Top: 80, Left: 0, Width: 324, Height: 42); LayoutMode: Left;
  Group #NeedHappiness { Anchor: (Width: 112, Height: 42);
   Group #NeedIconImage { Anchor: (Top: 0, Left: 0, Width: 16, Height: 16); Visible: false; }
   Label #NeedIcon { Anchor: (Top: 0, Left: 0, Width: 16, Height: 16); Text: ""; Style: (FontSize: 12, TextColor: #f3ead6); }
   Label #NeedValueText { Anchor: (Top: 0, Left: 20, Width: 80, Height: 16); Text: ""; Style: @MeterValue; }
   Group { Anchor: (Top: 22, Left: 0, Width: 100, Height: 6); Background: $A.@SlateTrack; }
   Group #MeterFill { Anchor: (Top: 22, Left: 0, Width: 0, Height: 6); Background: #f2c97c; }
   Label { Anchor: (Top: 30, Left: 0, Width: 100, Height: 12); Text: %server.tamework.ui.linkedPanel.meter.happiness; Style: @Caption; }
   Group #HappinessTargetMarker { Anchor: (Top: 20, Left: 0, Width: 2, Height: 10); Background: #f2c66d; Visible: false; HitTestVisible: false; }
   Group #BreedingThresholdMarker { Anchor: (Top: 13, Left: -7, Width: 14, Height: 12); Background: (TexturePath: "Tamework/LinkedPanelIcons/Breeding_Threshold.png", Color: #ff86bb); Visible: false; HitTestVisible: false; }
   TextButton #NeedTooltip { Anchor: (Top: 0, Left: 0, Width: 100, Height: 42); Text: ""; Style: @HudTooltipButtonStyle; TextTooltipStyle: @HudTooltipStyle; }
  }
  Group #NeedHunger { Anchor: (Width: 112, Height: 42);
   Group #NeedIconImage { Anchor: (Top: 0, Left: 0, Width: 16, Height: 16); Visible: false; }
   Label #NeedIcon { Anchor: (Top: 0, Left: 0, Width: 16, Height: 16); Text: ""; Style: (FontSize: 12, TextColor: #f3ead6); }
   Label #NeedValueText { Anchor: (Top: 0, Left: 20, Width: 80, Height: 16); Text: ""; Style: @MeterValue; }
   Group { Anchor: (Top: 22, Left: 0, Width: 100, Height: 6); Background: $A.@SlateTrack; }
   Group #MeterFill { Anchor: (Top: 22, Left: 0, Width: 0, Height: 6); Background: #d9a066; }
   Label { Anchor: (Top: 30, Left: 0, Width: 100, Height: 12); Text: %server.tamework.ui.linkedPanel.meter.hunger; Style: @Caption; }
   TextButton #NeedTooltip { Anchor: (Top: 0, Left: 0, Width: 100, Height: 42); Text: ""; Style: @HudTooltipButtonStyle; TextTooltipStyle: @HudTooltipStyle; }
  }
  Group #NeedThirst { Anchor: (Width: 100, Height: 42);
   Group #NeedIconImage { Anchor: (Top: 0, Left: 0, Width: 16, Height: 16); Visible: false; }
   Label #NeedIcon { Anchor: (Top: 0, Left: 0, Width: 16, Height: 16); Text: ""; Style: (FontSize: 12, TextColor: #f3ead6); }
   Label #NeedValueText { Anchor: (Top: 0, Left: 20, Width: 80, Height: 16); Text: ""; Style: @MeterValue; }
   Group { Anchor: (Top: 22, Left: 0, Width: 100, Height: 6); Background: $A.@SlateTrack; }
   Group #MeterFill { Anchor: (Top: 22, Left: 0, Width: 0, Height: 6); Background: #84dbff; }
   Label { Anchor: (Top: 30, Left: 0, Width: 100, Height: 12); Text: %server.tamework.ui.linkedPanel.meter.thirst; Style: @Caption; }
   TextButton #NeedTooltip { Anchor: (Top: 0, Left: 0, Width: 100, Height: 42); Text: ""; Style: @HudTooltipButtonStyle; TextTooltipStyle: @HudTooltipStyle; }
  }
 }
 // Age, breeding and harvest share one inset tray. Java sets each cell's size and fill.
 Group #CooldownRow { Anchor: (Top: 128, Left: 0, Right: 0, Height: 46); Padding: (Left: 8, Right: 8, Top: 5, Bottom: 5); Background: $A.@SlateTray; LayoutMode: Left;
  Group #AgeProgress { Anchor: (Width: 104, Height: 36); Visible: false;
   Group #AgeIcon { Anchor: (Top: 8, Left: 0, Width: 18, Height: 18); Background: (TexturePath: "Tamework/LinkedPanelIcons/LifeStage_Adult.png", Color: #78bfc1); }
   Label #AgeStage { Anchor: (Top: 0, Left: 22, Width: 80, Height: 12); Text: ""; Style: (FontSize: 9, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #78bfc1, VerticalAlignment: Center); }
   Group { Anchor: (Top: 15, Left: 22, Width: 78, Height: 6); Background: $A.@SlateTrack; }
   Group #AgeMeterFill { Anchor: (Top: 15, Left: 22, Width: 0, Height: 6); Background: #78bfc1; }
   Label #AgeCountdown { Anchor: (Top: 22, Left: 22, Width: 80, Height: 14); Text: ""; Style: @CooldownValue; }
   TextButton #AgeTooltip { Anchor: (Top: 0, Left: 0, Width: 100, Height: 36); Text: ""; Style: @HudTooltipButtonStyle; TextTooltipStyle: @HudTooltipStyle; }
  }
  Group #BreedingCooldown { Anchor: (Width: 104, Height: 36); Visible: false;
   Group #BreedingCooldownIconImage { Anchor: (Top: 8, Left: 0, Width: 18, Height: 18); Background: (TexturePath: "Tamework/LinkedPanelIcons/Breeding_Cooldown.png", Color: #f3ead6); Visible: false; }
   Group #BreedingCooldownIconMuted { Anchor: (Top: 8, Left: 0, Width: 18, Height: 18); Background: (TexturePath: "Tamework/LinkedPanelIcons/Breeding_Cooldown.png", Color: #586d8a); Visible: false; }
   Label #CooldownLabel { Anchor: (Top: 0, Left: 22, Width: 80, Height: 12); Text: %server.tamework.ui.linkedPanel.meter.breeding; Style: @CooldownLabel; }
   Group { Anchor: (Top: 15, Left: 22, Width: 78, Height: 6); Background: $A.@SlateTrack; }
   Group #MeterFill { Anchor: (Top: 15, Left: 22, Width: 0, Height: 6); Background: #e59ab0; }
   Label #CooldownText { Anchor: (Top: 22, Left: 22, Width: 80, Height: 14); Text: ""; Style: @CooldownValue; }
   TextButton #BreedingCooldownTooltip { Anchor: (Top: 0, Left: 0, Width: 100, Height: 36); Text: ""; Style: @HudTooltipButtonStyle; TextTooltipStyle: @HudTooltipStyle; }
  }
  Group #HarvestCooldown { Anchor: (Width: 100, Height: 36); Visible: false;
   Group #HarvestCooldownIconImage { Anchor: (Top: 8, Left: 0, Width: 18, Height: 18); Background: (TexturePath: "Tamework/LinkedPanelIcons/Harvest_Cooldown.png", Color: #f3ead6); Visible: false; }
   Label #CooldownLabel { Anchor: (Top: 0, Left: 22, Width: 78, Height: 12); Text: %server.tamework.ui.linkedPanel.meter.harvest; Style: @CooldownLabel; }
   Group { Anchor: (Top: 15, Left: 22, Width: 78, Height: 6); Background: $A.@SlateTrack; }
   Group #MeterFill { Anchor: (Top: 15, Left: 22, Width: 0, Height: 6); Background: #f2c66d; }
   Label #CooldownText { Anchor: (Top: 22, Left: 22, Width: 78, Height: 14); Text: ""; Style: @CooldownValue; }
   TextButton #HarvestCooldownTooltip { Anchor: (Top: 0, Left: 0, Width: 100, Height: 36); Text: ""; Style: @HudTooltipButtonStyle; TextTooltipStyle: @HudTooltipStyle; }
  }
 }
 Group #AppearanceDivider { Anchor: (Top: 184, Left: 0, Right: 0, Height: 1); Background: #ffffff(0.08); Visible: false; }
 Group #FoodTameRow {
  Anchor: (Top: 96, Left: 0, Right: 0, Height: 60);
  Visible: false;
  Group { Anchor: (Top: -3, Left: 0, Right: 0, Height: 1); Background: #ffffff(0.08); }

  Group #FoodRow {
   Anchor: (Top: 0, Left: 0, Width: 112, Height: 58);
   Visible: false;

   Label #FoodHeading { Anchor: (Top: 0, Left: 0, Right: 0, Height: 16); Text: ""; Style: @Caption; }
   Group #FavoriteFoodBlock {
    Anchor: (Top: 0, Left: 0, Width: 112, Height: 36);
    Visible: false;
    Group { Anchor: (Top: 1, Left: 0, Width: 34, Height: 34); Background: $A.@SlateQuiet; }
    ItemGrid #FoodItemGrid { Anchor: (Top: 4, Left: 3, Width: 28, Height: 28); SlotsPerRow: 1; RenderItemQualityBackground: false; InfoDisplay: None; Style: @FoodItemGridStyle; Visible: false; }
