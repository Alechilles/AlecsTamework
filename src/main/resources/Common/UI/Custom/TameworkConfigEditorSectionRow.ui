        }

        Group #SectionToggleNestedDirtyBadgeCheckIcon {
          Anchor: (Top: 1, Left: 1, Width: 14, Height: 14);
          Background: "TwConfigAccept.png";
          Visible: false;
        }

        Group #SectionToggleNestedDirtyBadgeCautionIcon {
          Anchor: (Top: 0, Left: 0, Width: 16, Height: 16);
          Background: "TwConfigCaution.png";
          Visible: false;
        }
      }
    }

    Group {
      Anchor: (Width: 94, Height: 24);

      Label #SectionToggleNestedCount {
        Anchor: (Top: 0, Right: 6, Width: 88, Height: 24);
        Text: "0 fields";
        Style: (
          FontSize: 11,
          TextColor: #a9bfd7,
          HorizontalAlignment: End,
          VerticalAlignment: Center
        );
      }
    }

    Group #SectionToggleNestedRightBadge {
      Anchor: (Width: 18, Height: 24);
      LayoutMode: Middle;
      Visible: false;

      Group {
        Anchor: (Width: 16, Height: 16);
        Background: #00000000;

        Group #SectionToggleNestedRightBadgeCheckIcon {
          Anchor: (Top: 1, Left: 1, Width: 14, Height: 14);
          Background: "TwConfigAccept.png";
          Visible: false;
        }

        Group #SectionToggleNestedRightBadgeCautionIcon {
          Anchor: (Top: 0, Left: 0, Width: 16, Height: 16);
          Background: "TwConfigCaution.png";
          Visible: false;
        }
      }
    }
  }

  Button #SectionToggleDeepButton {
    Anchor: (Top: 2, Left: 48, Right: 0, Height: 24);
    LayoutMode: Left;
    Style: ButtonStyle(
      Default: (Background: (Color: #00000000)),
      Hovered: (Background: (Color: #ffffff12)),
      Pressed: (Background: (Color: #ffffff0a))
    );
    Visible: false;

    Group #SectionToggleDeepIconContainer {
      Anchor: (Width: 20, Height: 24);
      LayoutMode: Middle;

      Group #SectionToggleDeepExpandedIcon {
        Anchor: (Width: 12, Height: 7);
        Background: "TwConfigCaretUp.png";
        Visible: true;
      }

      Group #SectionToggleDeepCollapsedIcon {
        Anchor: (Width: 12, Height: 7);
        Background: "TwConfigCaretDown.png";
        Visible: false;
      }
    }

    Label #SectionToggleDeepLabel {
      Anchor: (Height: 24);
      FlexWeight: 1;
      Text: "SECTION";
      Style: (
        FontSize: 13,
        RenderBold: true,
        TextColor: #dbe9f7,
        HorizontalAlignment: Start,
        VerticalAlignment: Center,
        RenderUppercase: true,
        LetterSpacing: 1
      );
    }

    Group #SectionToggleDeepDirtyBadge {
      Anchor: (Width: 18, Height: 24);
      LayoutMode: Middle;
      Visible: false;

      Group #SectionToggleDeepDirtyBadgeCircle {
        Anchor: (Width: 16, Height: 16);
        Background: #00000000;

        Label #SectionToggleDeepDirtyBadgeText {
          Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
          Text: "!";
          Style: (
            FontSize: 10,
            RenderBold: true,
            TextColor: #111111,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
        }

        Group #SectionToggleDeepDirtyBadgeCheckIcon {
          Anchor: (Top: 1, Left: 1, Width: 14, Height: 14);
          Background: "TwConfigAccept.png";
          Visible: false;
        }

        Group #SectionToggleDeepDirtyBadgeCautionIcon {
          Anchor: (Top: 0, Left: 0, Width: 16, Height: 16);
          Background: "TwConfigCaution.png";
          Visible: false;
        }
      }
    }

    Group {
      Anchor: (Width: 94, Height: 24);

      Label #SectionToggleDeepCount {
        Anchor: (Top: 0, Right: 6, Width: 88, Height: 24);
        Text: "0 fields";
        Style: (
          FontSize: 11,
          TextColor: #a9bfd7,
          HorizontalAlignment: End,
          VerticalAlignment: Center
        );
      }
    }

    Group #SectionToggleDeepRightBadge {
      Anchor: (Width: 18, Height: 24);
      LayoutMode: Middle;
      Visible: false;

      Group {
        Anchor: (Width: 16, Height: 16);
        Background: #00000000;

        Group #SectionToggleDeepRightBadgeCheckIcon {
          Anchor: (Top: 1, Left: 1, Width: 14, Height: 14);
          Background: "TwConfigAccept.png";
          Visible: false;
        }

        Group #SectionToggleDeepRightBadgeCautionIcon {
          Anchor: (Top: 0, Left: 0, Width: 16, Height: 16);
          Background: "TwConfigCaution.png";
          Visible: false;
        }
      }
    }
  }
}
