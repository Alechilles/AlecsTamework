        FontSize: 13,
        RenderBold: true,
        TextColor: #e6f0fa,
        HorizontalAlignment: Start,
        VerticalAlignment: Center,
        RenderUppercase: true,
        LetterSpacing: 1
      );
    }

    Group #SectionToggleNestedDirtyBadge {
      Anchor: (Width: 18, Height: 24);
      LayoutMode: Middle;
      Visible: false;

      Group #SectionToggleNestedDirtyBadgeCircle {
        Anchor: (Width: 16, Height: 16);
        Background: #00000000;

        Label #SectionToggleNestedDirtyBadgeText {
