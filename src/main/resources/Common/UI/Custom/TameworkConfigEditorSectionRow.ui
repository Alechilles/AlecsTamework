$C = "Common.ui";

Group {
  Anchor: (Top: 0, Left: 0, Right: 0, Height: 28);

  Group #SectionRowBackground {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Background: #1a2b40;
  }

  Group #SectionGuideDepth1 {
    Anchor: (Top: 0, Left: 14, Width: 2, Bottom: 0);
    Background: #3b5673;
    Visible: false;
  }

  Group #SectionGuideDepth2 {
    Anchor: (Top: 0, Left: 36, Width: 2, Bottom: 0);
    Background: #3b5673;
    Visible: false;
  }

  Button #SectionToggleTopButton {
    Anchor: (Top: 2, Left: 4, Right: 0, Height: 24);
    LayoutMode: Left;
    Style: ButtonStyle(
      Default: (Background: (Color: #00000000)),
      Hovered: (Background: (Color: #ffffff12)),
      Pressed: (Background: (Color: #ffffff0a))
    );

    Group #SectionToggleTopIconContainer {
      Anchor: (Width: 20, Height: 24);
      LayoutMode: Middle;

      Group #SectionToggleTopExpandedIcon {
        Anchor: (Width: 12, Height: 7);
        Background: "TwConfigCaretUp.png";
        Visible: true;
      }

      Group #SectionToggleTopCollapsedIcon {
        Anchor: (Width: 12, Height: 7);
        Background: "TwConfigCaretDown.png";
        Visible: false;
      }
    }

    Label #SectionToggleTopLabel {
      Anchor: (Height: 24);
      FlexWeight: 1;
      Text: "SECTION";
      Style: (
        FontSize: 13,
        RenderBold: true,
        TextColor: #eff4fa,
        HorizontalAlignment: Start,
        VerticalAlignment: Center,
        RenderUppercase: true,
        LetterSpacing: 1
      );
    }

    Group #SectionToggleTopDirtyBadge {
      Anchor: (Width: 18, Height: 24);
      LayoutMode: Middle;
      Visible: false;

      Group #SectionToggleTopDirtyBadgeCircle {
        Anchor: (Width: 16, Height: 16);
        Background: #00000000;

        Label #SectionToggleTopDirtyBadgeText {
          Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
          Text: "!";
          Style: (
            FontSize: 10,
            RenderBold: true,
            TextColor: #111111,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
        }

        Group #SectionToggleTopDirtyBadgeCheckIcon {
          Anchor: (Top: 1, Left: 1, Width: 14, Height: 14);
          Background: "TwConfigAccept.png";
          Visible: false;
        }

        Group #SectionToggleTopDirtyBadgeCautionIcon {
          Anchor: (Top: 0, Left: 0, Width: 16, Height: 16);
          Background: "TwConfigCaution.png";
          Visible: false;
        }
      }
    }

    Group {
      Anchor: (Width: 94, Height: 24);

      Label #SectionToggleTopCount {
        Anchor: (Top: 0, Right: 6, Width: 88, Height: 24);
        Text: "0 fields";
        Style: (
          FontSize: 11,
          TextColor: #a9bfd7,
          HorizontalAlignment: End,
          VerticalAlignment: Center
        );
      }
    }

    Group #SectionToggleTopRightBadge {
      Anchor: (Width: 18, Height: 24);
      LayoutMode: Middle;
      Visible: false;

      Group {
        Anchor: (Width: 16, Height: 16);
        Background: #00000000;

        Group #SectionToggleTopRightBadgeCheckIcon {
          Anchor: (Top: 1, Left: 1, Width: 14, Height: 14);
          Background: "TwConfigAccept.png";
          Visible: false;
        }

        Group #SectionToggleTopRightBadgeCautionIcon {
          Anchor: (Top: 0, Left: 0, Width: 16, Height: 16);
          Background: "TwConfigCaution.png";
          Visible: false;
        }
      }
    }
  }

  Button #SectionToggleNestedButton {
    Anchor: (Top: 2, Left: 26, Right: 0, Height: 24);
    LayoutMode: Left;
    Style: ButtonStyle(
      Default: (Background: (Color: #00000000)),
      Hovered: (Background: (Color: #ffffff12)),
      Pressed: (Background: (Color: #ffffff0a))
    );
    Visible: false;

    Group #SectionToggleNestedIconContainer {
      Anchor: (Width: 20, Height: 24);
