$A = "TameworkSlateStyles.ui";
$C = "Common.ui";

Group #CompanionViewToolbar {
  Anchor: (Top: 10, Right: 10, Width: 378, Height: 28);
  TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  DropdownBox #CompanionViewPicker { Anchor: (Left: 0, Width: 270, Height: 28); Style: $A.@PanelDropdown; MaxSelection: 1; }
  TextButton #CompanionViewSaveNew { Anchor: (Left: 278, Width: 28, Height: 28); Text: ""; TooltipText: %server.tamework.ui.views.saveButton; TextTooltipStyle: $C.@DefaultTextTooltipStyle; Style: $A.@PanelButton; }
  Group #CompanionViewSaveGlyph { Anchor: (Left: 283, Top: 5, Width: 18, Height: 18); Background: (TexturePath: "Tamework/PanelActions/ViewSave_Glyph_Default.png", Color: #eef2f6); HitTestVisible: false; }
  Sprite #CompanionViewSaveGlyphUnsaved { Anchor: (Left: 283, Top: 5, Width: 18, Height: 18); TexturePath: "Tamework/PanelActions/ViewSave_UnsavedPulse.png"; Frame: (Width: 64, Height: 64, PerRow: 2, Count: 2); FramesPerSecond: 1; RepeatCount: 0; HitTestVisible: false; Visible: false; }
  TextButton #CompanionViewManage { Anchor: (Left: 314, Width: 28, Height: 28); Text: ""; TooltipText: %server.tamework.ui.views.manageButton; Style: $A.@PanelButton; }
  Group { Anchor: (Left: 319, Top: 5, Width: 18, Height: 18); Background: (TexturePath: "Tamework/PanelActions/ViewEdit_Glyph_Default.png", Color: #eef2f6); HitTestVisible: false; }
  TextButton #CompanionViewIconButton { Anchor: (Left: 350, Width: 28, Height: 28); Text: ""; TooltipText: %server.tamework.ui.views.fluteIcon; Style: $A.@PanelButton; Visible: false; }
  Group #CompanionViewIconGlyph { Anchor: (Left: 355, Top: 5, Width: 18, Height: 18); Background: (TexturePath: "Tamework/PanelActions/ViewIcon_Glyph_Default.png", Color: #eef2f6); HitTestVisible: false; Visible: false; }
}
TextButton #CompanionAddFilter {
  Anchor: (Top: 46, Right: 10, Width: 92, Height: 28);
  Text: %server.tamework.ui.views.addFilter;
  Style: $A.@PanelButton;
}
Group #CompanionFilterChips {
  Anchor: (Top: 82, Left: 10, Right: 10, Height: 28);
  Visible: false;
  Group #CompanionChipGroups {
    Anchor: (Left: 0, Width: 180, Height: 28);
    TextButton #CompanionChipGroupsEdit { Anchor: (Left: 0, Right: 32, Height: 28); Style: $A.@PanelButtonQuiet; TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    TextButton #CompanionChipGroupsRemove { Anchor: (Right: 0, Width: 28, Height: 28); Text: ""; Style: $A.@Remove; TooltipText: %server.tamework.ui.views.removeFilter; TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    Group { Anchor: (Right: 3, Top: 3, Width: 22, Height: 22); Background: (TexturePath: "Tamework/PanelActions/Remove_Glyph_Default.png", Color: #f2877b); HitTestVisible: false; }
  }
  Group #CompanionChipSpecies {
    Anchor: (Left: 186, Width: 180, Height: 28);
    TextButton #CompanionChipSpeciesEdit { Anchor: (Left: 0, Right: 32, Height: 28); Style: $A.@PanelButtonQuiet; TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    TextButton #CompanionChipSpeciesRemove { Anchor: (Right: 0, Width: 28, Height: 28); Text: ""; Style: $A.@Remove; TooltipText: %server.tamework.ui.views.removeFilter; TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    Group { Anchor: (Right: 3, Top: 3, Width: 22, Height: 22); Background: (TexturePath: "Tamework/PanelActions/Remove_Glyph_Default.png", Color: #f2877b); HitTestVisible: false; }
  }
  Group #CompanionChipSelected {
    Anchor: (Left: 372, Width: 160, Height: 28);
    TextButton #CompanionChipSelectedEdit { Anchor: (Left: 0, Right: 32, Height: 28); Text: %server.tamework.ui.views.selectedChip; Style: $A.@PanelButtonQuiet; }
    TextButton #CompanionChipSelectedRemove { Anchor: (Right: 0, Width: 28, Height: 28); Text: ""; Style: $A.@Remove; TooltipText: %server.tamework.ui.views.removeFilter; TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    Group { Anchor: (Right: 3, Top: 3, Width: 22, Height: 22); Background: (TexturePath: "Tamework/PanelActions/Remove_Glyph_Default.png", Color: #f2877b); HitTestVisible: false; }
  }
  Label #CompanionHiddenSelection { Anchor: (Right: 0, Width: 280, Height: 28); Style: (FontSize: 11, TextColor: #8794a4, HorizontalAlignment: End, VerticalAlignment: Center); }
}
Group #CompanionViewOverlay {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  Background: #06080b(0.82);
  Visible: false;
  Group #CompanionFilterEditor {
    Anchor: (Top: 224, Left: 244, Width: 440, Height: 244);
    Background: $A.@SlateModal;
    Label { Anchor: (Top: 14, Left: 20, Right: 60, Height: 28); Text: %server.tamework.ui.views.filterEditorTitle; Style: (FontSize: 17, FontName: "Secondary", TextColor: #eef2f6); }
    TextButton #CompanionFilterCancel { Anchor: (Top: 12, Right: 14, Width: 28, Height: 28); Text: ""; Style: $A.@Remove; TooltipText: %server.tamework.ui.views.cancel; TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    Group { Anchor: (Top: 14, Right: 16, Width: 24, Height: 24); Background: (TexturePath: "Tamework/PanelActions/Remove_Glyph_Default.png", Color: #f2877b); HitTestVisible: false; }
    Label { Anchor: (Top: 56, Left: 20, Right: 20, Height: 22); Text: %server.tamework.ui.views.filterType; Style: (FontSize: 13, TextColor: #c2ccd6); }
    DropdownBox #CompanionViewType { Anchor: (Top: 80, Left: 20, Right: 20, Height: 30); MaxSelection: 1; Style: $A.@PanelDropdown; }
    Group #CompanionViewSpeciesRow {
      Anchor: (Top: 120, Left: 20, Right: 20, Height: 55); Visible: false;
      Label { Anchor: (Top: 0, Left: 0, Right: 0, Height: 22); Text: %server.tamework.ui.views.species; Style: (FontSize: 13, TextColor: #c2ccd6); }
      DropdownBox #CompanionViewSpecies { Anchor: (Top: 24, Left: 0, Right: 0, Height: 30); MaxSelection: 0; ShowLabel: false; Style: $A.@CompanionGroupDropdown; NoItemsText: %server.tamework.ui.views.anySpecies; }
      Label #CompanionViewSpeciesLabel { Anchor: (Top: 24, Left: 10, Right: 30, Height: 30); Style: (FontSize: 12, TextColor: #c2ccd6, VerticalAlignment: Center); HitTestVisible: false; }
    }
    Group #CompanionViewGroupsRow {
      Anchor: (Top: 120, Left: 20, Right: 20, Height: 55); Visible: false;
      Label { Anchor: (Top: 0, Left: 0, Right: 0, Height: 22); Text: %server.tamework.ui.views.groups; Style: (FontSize: 13, TextColor: #c2ccd6); }
      DropdownBox #CompanionViewGroups { Anchor: (Top: 24, Left: 0, Right: 0, Height: 30); MaxSelection: 0; ShowLabel: false; Style: $A.@CompanionGroupDropdown; NoItemsText: %server.tamework.ui.views.anyGroup; }
      Label #CompanionViewGroupsLabel { Anchor: (Top: 24, Left: 10, Right: 30, Height: 30); Style: (FontSize: 12, TextColor: #c2ccd6, VerticalAlignment: Center); HitTestVisible: false; }
    }
    Label #CompanionViewSelectedHint { Anchor: (Top: 129, Left: 20, Right: 20, Height: 30); Text: %server.tamework.ui.views.selectedOnly; Style: (FontSize: 13, TextColor: #c2ccd6); Visible: false; }
    Label #CompanionViewError { Anchor: (Top: 179, Left: 20, Right: 20, Height: 20); Style: (FontSize: 12, TextColor: #f2877b); }
    TextButton #CompanionViewFilterSave { Anchor: (Top: 202, Right: 20, Width: 125, Height: 28); Text: %server.tamework.ui.views.saveFilter; Style: $A.@PanelButtonPrimary; }
  }
  Group #CompanionViewNameEditor {
    Anchor: (Top: 245, Left: 244, Width: 440, Height: 202);
    Background: $A.@SlateModal;
    Label { Anchor: (Top: 14, Left: 20, Right: 60, Height: 28); Text: %server.tamework.ui.views.editorTitle; Style: (FontSize: 17, FontName: "Secondary", TextColor: #eef2f6); }
    TextButton #CompanionViewCancel { Anchor: (Top: 12, Right: 14, Width: 28, Height: 28); Text: ""; Style: $A.@Remove; TooltipText: %server.tamework.ui.views.cancel; TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    Group { Anchor: (Top: 14, Right: 16, Width: 24, Height: 24); Background: (TexturePath: "Tamework/PanelActions/Remove_Glyph_Default.png", Color: #f2877b); HitTestVisible: false; }
    Label { Anchor: (Top: 60, Left: 20, Right: 20, Height: 22); Text: %server.tamework.ui.views.name; Style: (FontSize: 13, TextColor: #c2ccd6); }
    TextField #CompanionViewName { Anchor: (Top: 84, Left: 20, Right: 20, Height: 30); Style: $A.@PanelInputFieldStyle; PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle; Background: $A.@SlateQuiet; Padding: (Horizontal: 8); MaxLength: 40; PlaceholderText: %server.tamework.ui.views.namePlaceholder; }
    Label #CompanionViewNameError { Anchor: (Top: 120, Left: 20, Right: 20, Height: 20); Style: (FontSize: 12, TextColor: #f2877b); }
    TextButton #CompanionViewDelete { Anchor: (Top: 156, Left: 20, Width: 125, Height: 28); Text: %server.tamework.ui.views.delete; TooltipText: %server.tamework.ui.views.deleteHint; TextTooltipStyle: $C.@DefaultTextTooltipStyle; Style: $A.@PanelButton; }
    TextButton #CompanionViewSave { Anchor: (Top: 156, Right: 20, Width: 125, Height: 28); Text: %server.tamework.ui.views.saveView; Style: $A.@PanelButtonPrimary; }
  }
  Group #CompanionViewIconEditor {
    Anchor: (Top: 249, Left: 244, Width: 440, Height: 194);
    Background: $A.@SlateModal;
    Visible: false;
    Label { Anchor: (Top: 14, Left: 20, Right: 60, Height: 28); Text: %server.tamework.ui.views.chooseIcon; Style: (FontSize: 17, FontName: "Secondary", TextColor: #eef2f6); }
    TextButton #CompanionViewIconCancel { Anchor: (Top: 12, Right: 14, Width: 28, Height: 28); Text: ""; Style: $A.@Remove; TooltipText: %server.tamework.ui.views.cancel; TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    Group { Anchor: (Top: 14, Right: 16, Width: 24, Height: 24); Background: (TexturePath: "Tamework/PanelActions/Remove_Glyph_Default.png", Color: #f2877b); HitTestVisible: false; }
    Group #CompanionViewIconPreviewFrame { Anchor: (Top: 58, Left: 20, Width: 76, Height: 76); Background: $A.@SlateQuiet; }
    ItemIcon #CompanionViewIconPreview { Anchor: (Top: 64, Left: 26, Width: 64, Height: 64); }
    Label { Anchor: (Top: 60, Left: 112, Right: 20, Height: 22); Text: %server.tamework.ui.views.fluteIcon; Style: (FontSize: 13, TextColor: #c2ccd6); }
    DropdownBox #CompanionViewIconPicker { Anchor: (Top: 88, Left: 112, Right: 20, Height: 30); MaxSelection: 1; Style: $A.@PanelDropdown; }
  }
}
