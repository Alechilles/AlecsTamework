$C = "Common.ui";

Group {
  Anchor: (Top: 0, Left: 0, Right: 0, Height: 28);

  Group #AssetRowBackground {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Background: #202723;
  }

  Group #AssetRowSelectedBar {
    Anchor: (Top: 0, Left: 0, Width: 3, Bottom: 0);
    Background: #8bbd9a;
    Visible: false;
  }

  Button #AssetRowButton {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Style: ButtonStyle(
      Default: (Background: (Color: #00000000)),
      Hovered: (Background: (Color: #35423a)),
      Pressed: (Background: (Color: #2d3831))
    );

    Label #AssetRowLabel {
      Anchor: (Top: 0, Left: 8, Right: 8, Height: 28);
      Text: "";
      Style: (
        FontSize: 12,
        TextColor: #e8e4da,
        HorizontalAlignment: Start,
        VerticalAlignment: Center,
        Wrap: false
      );
    }

    Label #AssetRowPackHint {
      Anchor: (Top: 0, Left: 8, Right: 8, Height: 0);
      Text: "";
      Visible: false;
    }
  }
}

