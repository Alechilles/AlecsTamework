$A = "TameworkSlateStyles.ui";
$C = "Common.ui";

Group {
  Anchor: (Top: 0, Left: 0, Right: 4, Height: 28);

  // The list sits on a quiet plate, so an unselected row draws nothing of its own.
  Group #AssetRowBackground {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
  }

  // The selected row: a primary plate under the whole row, shown by TameworkConfigEditorPage.java.
  Group #AssetRowSelectedBar {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Background: $A.@SlatePrimary;
    Visible: false;
  }

  Button #AssetRowButton {
    Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
    Style: ButtonStyle(
      Default: (Background: (Color: #00000000)),
      Hovered: (Background: (Color: #ffffff(0.06))),
      Pressed: (Background: (Color: #000000(0.2)))
    );

    Label #AssetRowLabel {
      Anchor: (Top: 0, Left: 8, Right: 8, Height: 28);
      Text: "";
      Style: (
        FontSize: 12,
        TextColor: #eef2f6,
        HorizontalAlignment: Start,
        VerticalAlignment: Center,
        Wrap: false
      );
    }

    Label #AssetRowPackHint {
      Anchor: (Top: 0, Left: 8, Right: 8, Height: 0);
      Text: "";
      Visible: false;
    }
  }
}

