$A = "TameworkSlateStyles.ui";
$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  Group #TameworkGroupManagerRoot {
    Anchor: (Width: 380, Height: 440);

    AssetImage { Anchor: (Full: 0); AssetPath: "Tamework/UI/Slate/page_groups.png"; FallbackTexturePath: "UI/Custom/Tamework/Slate/Clear.png"; HitTestVisible: false; }

    Group #Title {
      Anchor: (Top: 0, Left: 0, Right: 0, Height: 44);
      Group {
        Anchor: (Top: 8, Right: 14, Width: 28, Height: 28);
        TextButton #TameworkGroupCloseButton { Anchor: (Full: 0); Text: ""; TooltipText: %server.tamework.ui.shared.button.close; TextTooltipStyle: $C.@DefaultTextTooltipStyle; Style: $A.@ActionQuiet; }
        Group { Anchor: (Top: 2, Left: 2, Width: 24, Height: 24); HitTestVisible: false; Background: (TexturePath: "Tamework/PanelActions/Remove_Glyph_Default.png", Color: #bfcdd5); }
      }
      Label #TameworkGroupManagerTitle {
        Anchor: (Left: 22, Right: 52, Height: 44);
        Text: %server.tamework.ui.groupManager.title;
        Style: $A.@SlateTitle;
      }
    }

    Group #Content {
      Anchor: (Top: 52, Left: 12, Right: 12, Bottom: 14);
      LayoutMode: Top;

      Label #TameworkGroupManagerSubtitle {
        Anchor: (Height: 18);
        Text: %server.tamework.ui.groupManager.subtitle.default;
        Style: (
          FontSize: 12,
          TextColor: #96a9be,
          HorizontalAlignment: Start,
          VerticalAlignment: Center
        );
      }

      Group #TameworkGroupManagerInputRow {
        Anchor: (Top: 8, Height: 26);
        LayoutMode: Left;

        TextField #TameworkGroupNameInput {
          Style: $A.@PanelInputFieldStyle;
          PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
          Background: $A.@SlateQuiet;
          Decoration: (
            Default: (Background: $A.@SlateQuiet),
            Focused: (Background: $A.@SlateQuietFocus)
          );
          Anchor: (Width: 238, Height: 26);
          Padding: (Horizontal: 8);
          PlaceholderText: %server.tamework.ui.shared.placeholder.groupName;
          MaxLength: 24;
        }

        Group { Anchor: (Width: 6); }

        ColorPickerDropdownBox #TameworkGroupColorInput {
          Style: $A.@PanelColorPicker;
          Anchor: (Width: 24, Height: 24);
        }

        Group { Anchor: (Width: 6); }

        TextButton #TameworkGroupCreateButton {
          Anchor: (Width: 80, Height: 26);
          Text: %server.tamework.ui.shared.button.create;
          Style: $A.@PanelButtonPrimary;
        }
      }

      // The group list scrolls inside an inset well.
      Group #TameworkGroupManagerBody {
        Anchor: (Top: 10);
        FlexWeight: 1;
        Background: $A.@SlateTray;
        Padding: (Left: 6, Right: 4, Top: 6, Bottom: 6);

        Group #TameworkGroupManagerListViewport {
          Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
          LayoutMode: TopScrolling;
          KeepScrollPosition: true;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Right: 2);

          Group #TameworkGroupManagerList {
            LayoutMode: Top;
            Anchor: (Bottom: 0);
          }
        }

        Label #TameworkGroupManagerEmptyState {
          Anchor: (Top: 4, Left: 6, Right: 6, Height: 22);
          Text: %server.tamework.ui.groupManager.emptyState;
          Style: (
            FontSize: 12,
            TextColor: #96a9be,
            HorizontalAlignment: Start,
            VerticalAlignment: Center
          );
          Visible: false;
        }
      }

      Group #TameworkGroupManagerFooter {
        Anchor: (Top: 8, Height: 26);

        TextButton #TameworkGroupBackButton {
          Anchor: (Left: 0, Width: 100, Height: 26);
          Text: %server.tamework.ui.shared.button.back;
          Style: $A.@PanelButton;
        }

      }
    }
  }
}
