$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer #TameworkGroupManagerRoot {
    Anchor: (Width: 320, Height: 420);

    #Title {
      $C.@Title #TameworkGroupManagerTitle {
        @Text = %server.tamework.ui.groupManager.title;
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 0, Right: 0, Top: 0, Bottom: 8);

      Label #TameworkGroupManagerSubtitle {
        Anchor: (Top: 4, Left: 10, Right: 10, Height: 18);
        Text: %server.tamework.ui.groupManager.subtitle.default;
        Style: (
          FontSize: 13,
          TextColor: #bfd0e5,
          HorizontalAlignment: Start,
          VerticalAlignment: Center
        );
      }

      Group #TameworkGroupManagerInputRow {
        Anchor: (Top: 2, Left: 10, Right: 10, Height: 26);
        LayoutMode: Left;

        TextField #TameworkGroupNameInput {
          Style: $C.@DefaultInputFieldStyle;
          PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
          Background: $C.@InputBoxBackground;
          Anchor: (Width: 186, Height: 24);
          Padding: (Horizontal: 8);
          PlaceholderText: %server.tamework.ui.shared.placeholder.groupName;
          MaxLength: 24;
        }

        Group { Anchor: (Width: 6); }

        ColorPickerDropdownBox #TameworkGroupColorInput {
          Style: $C.@DefaultColorPickerDropdownBoxStyle;
          Anchor: (Width: 24, Height: 24);
        }

        Group { Anchor: (Width: 6); }

        TextButton #TameworkGroupCreateButton {
          Anchor: (Width: 72, Height: 24);
          Text: %server.tamework.ui.shared.button.create;
          Style: (
            ...$C.@SmallSecondaryTextButtonStyle
          );
        }
      }

      Group #TameworkGroupManagerBody {
        Anchor: (Top: 2, Left: 8, Right: 8);
        FlexWeight: 1;

        Group #TameworkGroupManagerListViewport {
          Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
          LayoutMode: TopScrolling;
          KeepScrollPosition: true;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Left: 2, Right: 2, Top: 0, Bottom: 2);

          Group #TameworkGroupManagerList {
            LayoutMode: Top;
            Anchor: (Bottom: 0);
          }
        }

        Label #TameworkGroupManagerEmptyState {
          Anchor: (Top: 4, Left: 2, Right: 2, Height: 22);
          Text: %server.tamework.ui.groupManager.emptyState;
          Style: (
            FontSize: 13,
            TextColor: #b2c3d6,
            HorizontalAlignment: Start,
            VerticalAlignment: Center
          );
          Visible: false;
        }
      }

      Group #TameworkGroupManagerFooter {
        Anchor: (Top: 4, Left: 10, Right: 10, Height: 24);

        TextButton #TameworkGroupBackButton {
          Anchor: (Left: 0, Width: 100, Height: 24);
          Text: %server.tamework.ui.shared.button.back;
          Style: (
            ...$C.@SmallSecondaryTextButtonStyle
          );
        }

        TextButton #TameworkGroupCloseButton {
          Anchor: (Right: 0, Width: 100, Height: 24);
          Text: %server.tamework.ui.shared.button.close;
          Style: (
            ...$C.@SmallSecondaryTextButtonStyle
          );
        }
      }
    }
  }
}

