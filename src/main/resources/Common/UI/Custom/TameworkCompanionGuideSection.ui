Group {
 Anchor: (Left: 0, Right: 0);
 LayoutMode: Top;
 Padding: (Bottom: 14);
 Label #Heading {
  Anchor: (Left: 0, Right: 0);
  Padding: (Bottom: 4);
  Text: "";
  Style: (FontSize: 14, RenderBold: true, TextColor: #f2c66d, Wrap: true, VerticalAlignment: Start);
 }
 Label #Body {
  Anchor: (Left: 0, Right: 0);
  Text: "";
  Style: (FontSize: 13, TextColor: #c2ccd6, Wrap: true, VerticalAlignment: Start);
 }
}
