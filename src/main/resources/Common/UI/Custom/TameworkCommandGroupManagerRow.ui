$C = "Common.ui";

Group {
  Anchor: (Top: 2, Left: 0, Right: 0, Height: 34);
  Background: (TexturePath: "Common/ContainerPanelPatch.png", Border: 4);
  Padding: (Left: 8, Right: 8, Top: 5, Bottom: 5);

  Group #GroupColorSwatch {
    Anchor: (Top: 2, Left: 0, Width: 22, Height: 22);
    Background: #4b657f;
  }

  Label #GroupName {
    Anchor: (Top: 2, Left: 28, Width: 210, Height: 22);
    Text: "Group";
    Style: (
      FontSize: 14,
      RenderBold: true,
      TextColor: #eff4fa,
      HorizontalAlignment: Start,
      VerticalAlignment: Center
    );
  }

  Label #GroupMeta {
    Anchor: (Top: 4, Left: 246, Width: 140, Height: 18);
    Text: "id";
    Style: (
      FontSize: 11,
      TextColor: #9fb3c8,
      HorizontalAlignment: Start,
      VerticalAlignment: Center
    );
  }

  TextButton #RenameButton {
    Anchor: (Top: 2, Right: 154, Width: 64, Height: 24);
    Text: "Rename";
  }

  TextButton #ColorButton {
    Anchor: (Top: 2, Right: 84, Width: 64, Height: 24);
    Text: "Color";
  }

  TextButton #DeleteButton {
    Anchor: (Top: 2, Right: 0, Width: 78, Height: 24);
    Text: "Delete";
  }
}
