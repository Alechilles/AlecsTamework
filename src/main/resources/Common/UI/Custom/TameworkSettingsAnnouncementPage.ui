$A = "TameworkPanelActionStyles.ui";
$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  Group #TwSettingsAnnouncementRoot {
    Anchor: (Width: 620, Height: 440);
    Background: (TexturePath: "Tamework/PanelActions/Base_Default.png", Border: 3);

    Group #Title {
      Anchor: (Top: 3, Left: 3, Right: 3, Height: 44);
      Background: #252b27;
      Label #TwSettingsAnnouncementTitle {
        Anchor: (Left: 14, Right: 14, Height: 44);
        Style: (FontSize: 20, RenderBold: true, TextColor: #f0eee7, VerticalAlignment: Center);
        Text: "Important Alec's Tamework Update";
      }
    }

    Group #Content {
      Anchor: (Top: 54, Left: 14, Right: 14, Bottom: 14);
      LayoutMode: Top;
      Padding: (Left: 10, Right: 10, Top: 6, Bottom: 8);

      Label #TwSettingsAnnouncementSubtitle {
        Anchor: (Height: 44);
        Text: "New features, settings, or updates have been added to Tamework that require your attention.";
        Style: (FontSize: 13, TextColor: #afb6b0, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      Group {
        Anchor: (Top: 6);
        FlexWeight: 1;
        Background: #181c1a;
        Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);

        Group #TwSettingsAnnouncementViewport {
          Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
          LayoutMode: TopScrolling;
          KeepScrollPosition: true;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Left: 4, Right: 0, Top: 2, Bottom: 2);

          Group #TwSettingsAnnouncementRows {
            LayoutMode: Top;
            Anchor: (Left: 0, Right: 0, Bottom: 0);

            Label #TwSettingsAnnouncementBody {
              Anchor: (Height: 720);
              Text: "";
              Style: (FontSize: 13, TextColor: #e8e4da, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
            }
          }
        }
      }

      Group {
        Anchor: (Height: 30);

        CheckBox #TwSettingsAnnouncementOptOutCheck {
          Anchor: (Top: 4, Left: 0, Width: 22, Height: 22);
          Background: (Color: #252c27);
          OutlineColor: #4a5a50;
          OutlineSize: 1;
          Padding: (Full: 4);
          Style: $C.@DefaultCheckBoxStyle;
        }

        Label #TwSettingsAnnouncementOptOutLabel {
          Anchor: (Left: 30, Right: 0, Height: 30);
          Text: "Don't show again until next announcement";
          Style: (FontSize: 12, TextColor: #afb6b0, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
        }
      }

      Group {
        LayoutMode: Right;

        TextButton #TwSettingsAnnouncementLaterButton {
          Style: $A.@PanelButton;
          Text: "Later";
          Anchor: (Width: 128, Height: 30);
        }

        Group {
          Anchor: (Width: 12);
        }

        TextButton #TwSettingsAnnouncementReviewButton {
          Style: $A.@PanelButton;
          Text: "Review Settings";
          Anchor: (Width: 170, Height: 30);
        }
      }
    }
  }
}
