$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer #TwSettingsAnnouncementRoot {
    Anchor: (Width: 620, Height: 440);

    #Title {
      $C.@Title #TwSettingsAnnouncementTitle {
        @Alignment = Start;
        @Text = "Important Alec's Tamework Update";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 10, Right: 10, Top: 6, Bottom: 8);

      Label #TwSettingsAnnouncementSubtitle {
        Anchor: (Height: 44);
        Text: "New features, settings, or updates have been added to Tamework that require your attention.";
        Style: (FontSize: 13, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      Group {
        Anchor: (Top: 6);
        FlexWeight: 1;
        Background: #13243a;
        Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);

        Group #TwSettingsAnnouncementViewport {
          Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
          LayoutMode: TopScrolling;
          KeepScrollPosition: true;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Left: 4, Right: 0, Top: 2, Bottom: 2);

          Group #TwSettingsAnnouncementRows {
            LayoutMode: Top;
            Anchor: (Left: 0, Right: 0, Bottom: 0);

            Label #TwSettingsAnnouncementBody {
              Anchor: (Height: 720);
              Text: "";
              Style: (FontSize: 13, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
            }
          }
        }
      }

      Group {
        Anchor: (Height: 30);

        CheckBox #TwSettingsAnnouncementOptOutCheck {
          Anchor: (Top: 4, Left: 0, Width: 22, Height: 22);
          Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
          Padding: (Full: 4);
          Style: $C.@DefaultCheckBoxStyle;
        }

        Label #TwSettingsAnnouncementOptOutLabel {
          Anchor: (Left: 30, Right: 0, Height: 30);
          Text: "Don't show again until next announcement";
          Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
        }
      }

      Group {
        LayoutMode: Right;

        $C.@SmallSecondaryTextButton #TwSettingsAnnouncementLaterButton {
          @Sounds = $C.@ButtonSounds;
          @Text = "Later";
          @Anchor = (MinWidth: 128);
        }

        Group {
          Anchor: (Width: 12);
        }

        $C.@SmallSecondaryTextButton #TwSettingsAnnouncementReviewButton {
          @Sounds = $C.@ButtonSounds;
          @Text = "Review Settings";
          @Anchor = (Right: 10, MinWidth: 170);
        }
      }
    }
  }
}
