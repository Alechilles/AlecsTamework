$A = "TameworkSlateStyles.ui";
$C = "Common.ui";
Group #TameworkLinkedPanelRoot {
  Anchor: (Top: 54, Left: 176, Width: 928, Height: 790);
 Visible: false;
 Group #TameworkLinkedPanelContainer {
  Anchor: (Top: 0, Left: 0, Width: 928, Height: 790);
Group #Title {
            Anchor: (Top: 10, Left: 10, Right: 10, Height: 30);


Group #TameworkLinkedPanelActiveHighlightControls {
                Anchor: (Top: 0, Left: 306, Width: 130, Height: 28);

                CheckBox #TameworkLinkedPanelActiveHighlightCheck {
                    Anchor: (Top: 3, Left: 0, Width: 22, Height: 22);
                    Background: $A.@SlateQuiet;
                    Padding: (Full: 4);
                    Style: $C.@DefaultCheckBoxStyle;
                }

                Label #TameworkLinkedPanelActiveHighlightLabel {
                    Anchor: (Right: 0, Width: 104, Height: 28);
                    Text: %server.tamework.ui.linkedPanel.activeHighlight.label;
                    Style: (FontSize: 12, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center);
                }
            }
            Group #TameworkLinkedPanelAutoLinkControls {
                Anchor: (Top: 0, Left: 204, Width: 94, Height: 28);

                CheckBox #TameworkLinkedPanelAutoLinkCheck {
                    Anchor: (Top: 3, Left: 0, Width: 22, Height: 22);
                    Background: $A.@SlateQuiet;
                    Padding: (Full: 4);
                    Style: $C.@DefaultCheckBoxStyle;
                }

                Label #TameworkLinkedPanelAutoLinkLabel {
                    Anchor: (Left: 28, Width: 66, Height: 28);
                    Text: %server.tamework.ui.linkedPanel.autoLink.label;
                    Style: (FontSize: 12, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center);
                }
            }

            DropdownBox #TameworkLinkedPanelModeDropdown {
                Visible: false;
                Anchor: (Top: 2, Left: 0, Width: 230, Height: 28);
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, FontSize: 13), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, FontSize: 13), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, RenderBold: true, FontSize: 13));
                MaxSelection: 1;
                NoItemsText: %server.tamework.ui.linkedPanel.mode.noModes;
            }
        Group #TameworkLinkedPanelModeTabs { Anchor: (Top: 0, Left: 0, Width: 196, Height: 30);
          TextButton #TameworkModeLinked { Anchor: (Left: 0, Width: 64, Height: 28); Text: %server.tamework.ui.linkedPanel.mode.linked; Style: $A.@PanelButton; }
          TextButton #TameworkModeNearby { Anchor: (Left: 66, Width: 64, Height: 28); Text: %server.tamework.ui.linkedPanel.mode.nearby; Style: $A.@PanelButton; }
          TextButton #TameworkModeOwned { Anchor: (Left: 132, Width: 64, Height: 28); Text: %server.tamework.ui.linkedPanel.mode.owned; Style: $A.@PanelButton; }
        }

        // Generic companion roster tabs stay hidden for the legacy managed and bonded flows.
        // The command page positions this group beside the shared toolbar when enabled.
        Group #CompanionModeTabs {
          Anchor: (Top: 0, Left: 0, Width: 470, Height: 30);
          LayoutMode: Left;
          Visible: false;
          TextButton #CompanionInWorld { Anchor: (Width: 116, Height: 30); Text: %server.tamework.ui.companions.inWorld; Style: $A.@CompanionTabButton; }
          Group { Anchor: (Width: 4); }
          TextButton #CompanionStored { Anchor: (Width: 96, Height: 30); Text: %server.tamework.ui.companions.stored; Style: $A.@CompanionTabButton; }
          Group { Anchor: (Width: 4); }
          TextButton #CompanionLostDead { Anchor: (Width: 144, Height: 30); Text: %server.tamework.ui.companions.lostDead; Style: $A.@CompanionTabButton; }
          Group { Anchor: (Width: 4); }
          TextButton #CompanionAll { Anchor: (Width: 80, Height: 30); Text: %server.tamework.ui.companions.all; Style: $A.@CompanionTabButton; }
        }

        Group #CompanionNearbyControls {
          Anchor: (Top: 0, Left: 0, Width: 128, Height: 28);
          Visible: false;
          CheckBox #CompanionNearbyCheck {
            Anchor: (Top: 3, Left: 0, Width: 22, Height: 22);
            Background: $A.@SlateQuiet;
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }
          Label #CompanionNearbyLabel {
            Anchor: (Left: 28, Width: 100, Height: 28);
            Text: %server.tamework.ui.companions.nearby;
            Style: (FontSize: 12, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center);
          }
        }

Group #BondedRosterModeTabs { Anchor: (Top: 0, Left: 0, Width: 284, Height: 30); Visible: false;
    TextButton #BondedRosterAll { Anchor: (Left: 0, Width: 68, Height: 28); Text: %server.tamework.ui.roster.filter.all; Style: $A.@PanelButton; }
    TextButton #BondedRosterActive { Anchor: (Left: 72, Width: 68, Height: 28); Text: %server.tamework.ui.roster.filter.active; Style: $A.@PanelButton; }
    TextButton #BondedRosterStored { Anchor: (Left: 144, Width: 68, Height: 28); Text: %server.tamework.ui.roster.filter.stored; Style: $A.@PanelButton; }
    TextButton #BondedRosterDead { Anchor: (Left: 216, Width: 68, Height: 28); Text: %server.tamework.ui.roster.filter.dead; Style: $A.@PanelButton; }
}
Label #BondedRosterCapacity { Anchor: (Top: 0, Right: 0, Width: 250, Height: 28); Visible: false; Style: (FontSize: 11, TextColor: #c2ccd6, HorizontalAlignment: End, VerticalAlignment: Center); TextTooltipStyle: $C.@DefaultTextTooltipStyle; }


Group #TameworkLinkedPanelControlsSecondary {
                Anchor: (Top: 0, Left: 444, Width: 360, Height: 28);
                LayoutMode: Left;

                Label #TameworkLinkedPanelSortLabel {
                    Anchor: (Width: 26, Height: 24);
                    Text: %server.tamework.ui.linkedPanel.sort.label;
                    Style: (FontSize: 12, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center);
                }

                Group {
                    Anchor: (Width: 2);
                }

                DropdownBox #TameworkLinkedPanelSortDropdown {
                    Anchor: (Width: 92, Height: 28);
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, FontSize: 13), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, FontSize: 13), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, RenderBold: true, FontSize: 13));
                    MaxSelection: 1;
                    NoItemsText: %server.tamework.ui.linkedPanel.sort.noneOptions;
                }

                Group {
                    Anchor: (Width: 6);
                }

                Label #TameworkLinkedPanelFilterLabel {
                    Anchor: (Width: 34, Height: 24);
                    Text: %server.tamework.ui.linkedPanel.filter.label;
                    Style: (FontSize: 12, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center);
                }

                Group {
                    Anchor: (Width: 2);
                }

                DropdownBox #TameworkLinkedPanelFilterDropdown {
                    Anchor: (Width: 96, Height: 28);
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, FontSize: 13), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, FontSize: 13), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, RenderBold: true, FontSize: 13));
                    MaxSelection: 1;
                    NoItemsText: %server.tamework.ui.linkedPanel.filter.noneOptions;
                }

                Group {
                    Anchor: (Width: 6);
                }

                Group #TameworkLinkedPanelInlineFilterTextControls {
                    Anchor: (Width: 96, Height: 28);
                    LayoutMode: Left;
                    Visible: false;

                    TextField #TameworkLinkedPanelFilterInput {
                        Style: $A.@PanelInputFieldStyle;
                        PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
                        Background: $A.@SlateQuiet;
                        Decoration: (
                            Default: (Background: $A.@SlateQuiet),
                            Focused: (Background: $A.@SlateQuietFocus)
                        );
                        Anchor: (Width: 96, Height: 28);
                        Padding: (Horizontal: 8);
                        PlaceholderText: %server.tamework.ui.linkedPanel.filter.placeholder;
                        MaxLength: 40;
                    }
                }
            }
Group #TameworkLinkedPanelSubtitleRadiusSlot {
                    Anchor: (Top: 0, Left: 806, Width: 102, Height: 28);
                    LayoutMode: Left;

                    Group {
                        Anchor: (Width: 0);
                    }

                    Group #TameworkLinkedPanelSubtitleRadiusControls {
                        Anchor: (Width: 102, Height: 28);
                        LayoutMode: Left;
                        Visible: false;

                        TextButton #TameworkLinkedPanelRadiusDec {
                            Anchor: (Width: 14, Height: 24);
                            Text: "-";
                        }

                        Group {
                            Anchor: (Width: 1);
                        }

                        Label #TameworkLinkedPanelRadiusValue {
                            Anchor: (Width: 68, Height: 28);
                            Text: %server.tamework.ui.linkedPanel.radius.value.default;
                            Style: (FontSize: 12, TextColor: #eef2f6, HorizontalAlignment: Center, VerticalAlignment: Center);
                        }

                        Group {
                            Anchor: (Width: 4);
                        }

                        TextButton #TameworkLinkedPanelRadiusInc {
                            Anchor: (Width: 14, Height: 24);
                            Text: "+";
                        }
                    }

                    Group {
                        Anchor: (Width: 0);
                    }
                }
}
 Group #Content {
 Anchor: (Top: 44, Left: 10, Right: 10, Bottom: 10);
 LayoutMode: Top;
 Group #TameworkLinkedPanelToolbar { Anchor: (Height: 0); Visible: false;
 Group #TameworkLinkedPanelSubtitleRow { Visible: false; Anchor: (Top: 0, Left: 0, Width: 158, Height: 28);
DropdownBox #TameworkLinkedPanelGroupSelectorDropdown {
                    Anchor: (Top: 0, Left: 0, Width: 152, Height: 28);
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, FontSize: 13), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, FontSize: 13), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, RenderBold: true, FontSize: 13));
                    MaxSelection: 1;
                    NoItemsText: %server.tamework.ui.linkedPanel.groupSelector.noneGroups;
                }
}


}
Label #TameworkLinkedPanelEmptyState {
                Anchor: (Top: 8, Height: 48);
                Text: %server.tamework.ui.linkedPanel.emptyState;
                Style: (FontSize: 14, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Start);
                Visible: false;
            }
Group #TameworkLinkedPanelListViewport {
                Anchor: (Top: 3);
                FlexWeight: 1;
                KeepScrollPosition: true;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;
                Padding: (Left: 7, Right: 2, Top: 1, Bottom: 7);
                LayoutMode: TopScrolling;

                Group #TameworkLinkedPanelList {
                    LayoutMode: Top;
                    Anchor: (Bottom: 6);
                }
            }
Group #TameworkLinkedPanelPagination {
    Anchor: (Height: 34);
    LayoutMode: Left;
    Visible: false;
    Background: #000000(0.22);
    Padding: (Left: 7, Right: 2);
    Label #TameworkLinkedPanelPageRange {
        Anchor: (Width: 330, Height: 28);
        Style: (FontSize: 12, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
    TextButton #CompanionSelectMatching {
        Anchor: (Width: 170, Height: 28);
        Visible: false;
        Text: %server.tamework.ui.views.selectMatching;
        TooltipText: %server.tamework.ui.views.selectMatchingHint;
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Style: $A.@PanelButton;
    }
    Group {
        FlexWeight: 1;
        Anchor: (Height: 28);
    }
    Group #TameworkLinkedPanelPageNavigation {
        Anchor: (Width: 316, Height: 28);
        LayoutMode: Left;
        Visible: false;
        TextButton #TameworkLinkedPanelPagePrevious {
            Anchor: (Width: 96, Height: 28);
            Style: $A.@PanelButton;
            Text: %server.tamework.ui.linkedPanel.pagination.previous;
        }
        Label #TameworkLinkedPanelPageStatus {
            Anchor: (Width: 124, Height: 28);
            Style: (FontSize: 12, TextColor: #c2ccd6, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
        TextButton #TameworkLinkedPanelPageNext {
            Anchor: (Width: 96, Height: 28);
            Style: $A.@PanelButton;
            Text: %server.tamework.ui.linkedPanel.pagination.next;
        }
    }
}
}
        Group #TameworkLinkedPanelGroupAssignOverlay {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
            Background: #06080b(0.8);
            Visible: false;

            Group #TameworkLinkedPanelGroupAssignModal {
                Anchor: (Top: 190, Left: 285, Width: 358, Height: 176);
                Background: $A.@SlateModal;

                Label #TameworkLinkedPanelGroupAssignTitle {
                    Anchor: (Top: 10, Left: 14, Width: 330, Height: 24);
                    Text: %server.tamework.ui.linkedPanel.groupAssign.title;
                    Style: (FontSize: 18, RenderBold: true, TextColor: #eef2f6, HorizontalAlignment: Start, VerticalAlignment: Center);
                }

                Label #TameworkLinkedPanelGroupAssignSubtitle {
                    Anchor: (Top: 40, Left: 14, Width: 330, Height: 24);
                    Text: %server.tamework.ui.linkedPanel.groupAssign.prompt;
                    Style: (FontSize: 12, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center);
                }

                DropdownBox #TameworkLinkedPanelGroupAssignDropdown {
                    Anchor: (Top: 72, Left: 14, Width: 330, Height: 26);
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, FontSize: 12), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, FontSize: 12), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #c2ccd6, RenderUppercase: false, RenderBold: true, FontSize: 12));
                    MaxSelection: 1;
                    NoItemsText: %server.tamework.ui.linkedPanel.groupAssign.noneGroups;
                }

                Group #TameworkLinkedPanelGroupAssignButtons {
                    Anchor: (Top: 112, Left: 14, Width: 330, Height: 30);
                    LayoutMode: Left;

                    Group {
                        Anchor: (Width: 0);
                    }

                    TextButton #TameworkLinkedPanelGroupAssignCancelButton {
                        Style: $A.@PanelButton;
                        Anchor: (Width: 161, Height: 28);
                        Text: %server.tamework.ui.shared.button.cancel;
                    }

                    Group {
                        Anchor: (Width: 8);
                    }

                    TextButton #TameworkLinkedPanelGroupAssignApplyButton {
                        Style: $A.@PanelButtonPrimary;
                        Anchor: (Width: 161, Height: 28);
                        Text: %server.tamework.ui.shared.button.apply;
                    }
                }
            }
        }

        Group #TameworkLinkedPanelReviveOverlay {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
            Background: #06080b(0.82);
            Visible: false;

            Group #TameworkLinkedPanelReviveModal {
                Anchor: (Top: 230, Left: 273, Width: 382, Height: 180);
                Background: $A.@SlateModal;

                Label #TameworkLinkedPanelReviveTitle {
                    Anchor: (Top: 10, Left: 14, Width: 354, Height: 24);
                    Text: %server.tamework.ui.linkedPanel.revive.title;
                    Style: (FontSize: 18, RenderBold: true, TextColor: #eef2f6, HorizontalAlignment: Start, VerticalAlignment: Center);
                }

                Group #TameworkLinkedPanelReviveCostViewport {
                    Anchor: (Top: 44, Left: 14, Width: 354, Height: 88);
                    KeepScrollPosition: true;
                    ScrollbarStyle: $C.@DefaultScrollbarStyle;
                    LayoutMode: TopScrolling;

                    Group #TameworkLinkedPanelReviveCostList {
                        LayoutMode: Top;
                        Anchor: (Bottom: 4);
                    }
                }

                Group #TameworkLinkedPanelReviveActions {
                    Anchor: (Top: 146, Left: 14, Width: 354, Height: 24);
                    LayoutMode: Left;

                    Group { Anchor: (Width: 158); }

                    TextButton #TameworkLinkedPanelReviveCancelButton {
                        Style: $A.@PanelButton;
                        Anchor: (Width: 88, Height: 24);
                        Text: %server.tamework.ui.shared.button.cancel;
                    }

                    Group { Anchor: (Width: 8); }

                    TextButton #TameworkLinkedPanelReviveConfirmButton {
                        Style: $A.@PanelButtonPrimary;
                        Anchor: (Width: 100, Height: 24);
                        Text: %server.tamework.ui.linkedPanel.revive.confirm;
                        Visible: false;
                    }

                    Label #TameworkLinkedPanelReviveBlockedButton {
                        Anchor: (Width: 100, Height: 24);
                        Text: %server.tamework.ui.linkedPanel.revive.confirm;
                        Style: (FontSize: 13, RenderBold: true, TextColor: #56606c, HorizontalAlignment: Center, VerticalAlignment: Center);
                        Visible: false;
                    }
                }
            }
        }

    }
}

