$A = "TameworkPanelActionStyles.ui";
$C = "Common.ui";
Group #TameworkLinkedPanelRoot {
 Anchor: (Top: 100, Left: 16, Width: 1088, Height: 704);
 Visible: false;
 Group #TameworkLinkedPanelContainer {
 Anchor: (Top: 0, Left: 0, Width: 1088, Height: 704);
 Background: #0b1b29;
Group #Title {
            Anchor: (Top: 6, Left: 14, Right: 14, Height: 30);
            $C.@Title #TameworkLinkedPanelTitle {
                @Alignment = Start;
                @Text = %server.tamework.ui.linkedPanel.title.linked;
                Anchor: (Top: 0, Left: 0, Width: 250, Height: 28);
            }

            Group #TameworkLinkedPanelAutoLinkControls {
                Anchor: (Top: 0, Right: 284, Width: 104, Height: 28);

                CheckBox #TameworkLinkedPanelAutoLinkCheck {
                    Anchor: (Top: 3, Left: 0, Width: 22, Height: 22);
                    Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                    Padding: (Full: 4);
                    Style: $C.@DefaultCheckBoxStyle;
                }

                Label #TameworkLinkedPanelAutoLinkLabel {
                    Anchor: (Left: 28, Width: 76, Height: 28);
                    Text: %server.tamework.ui.linkedPanel.autoLink.label;
                    Style: (FontSize: 13, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
                }
            }

            DropdownBox #TameworkLinkedPanelModeDropdown {
                Anchor: (Top: 2, Left: 270, Width: 148, Height: 28);
                OutlineColor: #34526b;
                OutlineSize: 1;
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, RenderUppercase: false, FontSize: 13), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, FontSize: 13), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, RenderBold: true, FontSize: 13));
                MaxSelection: 1;
                NoItemsText: %server.tamework.ui.linkedPanel.mode.noModes;
            }
        $C.@SmallSecondaryTextButton #TameworkLinkedPanelManageGroupsButton {
                    @Sounds = $C.@ButtonSounds;
                    @Anchor = (Right: 2, Width: 130, Height: 28);
                    @Text = %server.tamework.ui.linkedPanel.manageGroups;
                    Style: $A.@PanelButton;
                }
Group #TameworkLinkedPanelSubtitleRadiusSlot {
                    Anchor: (Top: 0, Left: 440, Width: 124, Height: 28);
                    LayoutMode: Left;

                    Group {
                        Anchor: (Width: 12);
                    }

                    Group #TameworkLinkedPanelSubtitleRadiusControls {
                        Anchor: (Width: 100, Height: 24);
                        LayoutMode: Left;
                        Visible: false;

                        TextButton #TameworkLinkedPanelRadiusDec {
                            Anchor: (Width: 14, Height: 24);
                            Text: "-";
                        }

                        Group {
                            Anchor: (Width: 1);
                        }

                        Label #TameworkLinkedPanelRadiusValue {
                            Anchor: (Width: 68, Height: 24);
                            Text: %server.tamework.ui.linkedPanel.radius.value.default;
                            Style: (FontSize: 12, TextColor: #dbe8f6, HorizontalAlignment: Center, VerticalAlignment: Center);
                        }

                        Group {
                            Anchor: (Width: 4);
                        }

                        TextButton #TameworkLinkedPanelRadiusInc {
                            Anchor: (Width: 14, Height: 24);
                            Text: "+";
                        }
                    }

                    Group {
                        Anchor: (Width: 12);
                    }
                }
}
 Group #Content {
 Anchor: (Top: 44, Left: 10, Right: 10, Bottom: 10);
 LayoutMode: Top;
 Group #TameworkLinkedPanelToolbar { Anchor: (Height: 34);
 Group #TameworkLinkedPanelSubtitleRow { Anchor: (Top: 0, Left: 0, Width: 194, Height: 28);
DropdownBox #TameworkLinkedPanelGroupSelectorDropdown {
                    Anchor: (Top: 0, Left: 0, Width: 190, Height: 28);
                    OutlineColor: #34526b;
                OutlineSize: 1;
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, RenderUppercase: false, FontSize: 13), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, FontSize: 13), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, RenderBold: true, FontSize: 13));
                    MaxSelection: 1;
                    NoItemsText: %server.tamework.ui.linkedPanel.groupSelector.noneGroups;
                }
}
Group #TameworkLinkedPanelControlsSecondary {
                Anchor: (Top: 0, Left: 204, Width: 648, Height: 28);
                LayoutMode: Left;

                Label #TameworkLinkedPanelSortLabel {
                    Anchor: (Width: 26, Height: 24);
                    Text: %server.tamework.ui.linkedPanel.sort.label;
                    Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
                }

                Group {
                    Anchor: (Width: 2);
                }

                DropdownBox #TameworkLinkedPanelSortDropdown {
                    Anchor: (Width: 140, Height: 28);
                    OutlineColor: #34526b;
                OutlineSize: 1;
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, RenderUppercase: false, FontSize: 13), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, FontSize: 13), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, RenderBold: true, FontSize: 13));
                    MaxSelection: 1;
                    NoItemsText: %server.tamework.ui.linkedPanel.sort.noneOptions;
                }

                Group {
                    Anchor: (Width: 6);
                }

                Label #TameworkLinkedPanelFilterLabel {
                    Anchor: (Width: 34, Height: 24);
                    Text: %server.tamework.ui.linkedPanel.filter.label;
                    Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
                }

                Group {
                    Anchor: (Width: 2);
                }

                DropdownBox #TameworkLinkedPanelFilterDropdown {
                    Anchor: (Width: 140, Height: 28);
                    OutlineColor: #34526b;
                OutlineSize: 1;
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, RenderUppercase: false, FontSize: 13), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, FontSize: 13), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, RenderBold: true, FontSize: 13));
                    MaxSelection: 1;
                    NoItemsText: %server.tamework.ui.linkedPanel.filter.noneOptions;
                }

                Group {
                    Anchor: (Width: 6);
                }

                Group #TameworkLinkedPanelInlineFilterTextControls {
                    Anchor: (Width: 208, Height: 28);
                    LayoutMode: Left;
                    Visible: false;

                    TextField #TameworkLinkedPanelFilterInput {
                        Style: $C.@DefaultInputFieldStyle;
                        PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
                        Background: $C.@InputBoxBackground;
                        Anchor: (Width: 208, Height: 28);
                        Padding: (Horizontal: 8);
                        PlaceholderText: %server.tamework.ui.linkedPanel.filter.placeholder;
                        MaxLength: 40;
                    }
                }
            }
Group #TameworkLinkedPanelActiveHighlightControls {
                Anchor: (Top: 0, Right: 0, Width: 182, Height: 28);

                CheckBox #TameworkLinkedPanelActiveHighlightCheck {
                    Anchor: (Top: 3, Left: 0, Width: 22, Height: 22);
                    Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                    Padding: (Full: 4);
                    Style: $C.@DefaultCheckBoxStyle;
                }

                Label #TameworkLinkedPanelActiveHighlightLabel {
                    Anchor: (Right: 0, Width: 152, Height: 28);
                    Text: %server.tamework.ui.linkedPanel.activeHighlight.label;
                    Style: (FontSize: 13, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
                }
            }
}
Label #TameworkLinkedPanelEmptyState {
                Anchor: (Top: 8, Height: 48);
                Text: %server.tamework.ui.linkedPanel.emptyState;
                Style: (FontSize: 14, TextColor: #b2c3d6, HorizontalAlignment: Start, VerticalAlignment: Start);
                Visible: false;
            }
Group #TameworkLinkedPanelListViewport {
                Anchor: (Top: 3);
                FlexWeight: 1;
                KeepScrollPosition: true;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;
                Padding: (Left: 7, Right: 2, Top: 1, Bottom: 7);
                LayoutMode: TopScrolling;

                Group #TameworkLinkedPanelList {
                    LayoutMode: Top;
                    Anchor: (Bottom: 6);
                }
            }
}
        Group #TameworkLinkedPanelGroupAssignOverlay {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
            Background: #060b13(0.78);
            Visible: false;

            Group #TameworkLinkedPanelGroupAssignModal {
                Anchor: (Top: 190, Left: 365, Width: 358, Height: 176);
                Background: #102038;

                Label #TameworkLinkedPanelGroupAssignTitle {
                    Anchor: (Top: 10, Left: 14, Width: 330, Height: 24);
                    Text: %server.tamework.ui.linkedPanel.groupAssign.title;
                    Style: (FontSize: 18, RenderBold: true, TextColor: #dce8f6, HorizontalAlignment: Start, VerticalAlignment: Center);
                }

                Label #TameworkLinkedPanelGroupAssignSubtitle {
                    Anchor: (Top: 40, Left: 14, Width: 330, Height: 24);
                    Text: %server.tamework.ui.linkedPanel.groupAssign.prompt;
                    Style: (FontSize: 13, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
                }

                DropdownBox #TameworkLinkedPanelGroupAssignDropdown {
                    Anchor: (Top: 72, Left: 14, Width: 330, Height: 26);
                    OutlineColor: #34526b;
                OutlineSize: 1;
                Style: (...$A.@PanelDropdown, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, RenderUppercase: false, FontSize: 12), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, FontSize: 12), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, RenderBold: true, FontSize: 12));
                    MaxSelection: 1;
                    NoItemsText: %server.tamework.ui.linkedPanel.groupAssign.noneGroups;
                }

                Group #TameworkLinkedPanelGroupAssignButtons {
                    Anchor: (Top: 112, Left: 14, Width: 330, Height: 30);
                    LayoutMode: Left;

                    Group {
                        Anchor: (Width: 138);
                    }

                    $C.@SmallSecondaryTextButton #TameworkLinkedPanelGroupAssignCancelButton {
                        @Sounds = $C.@ButtonSounds;
                        @Anchor = (Width: 180, Height: 28);
                        @Text = %server.tamework.ui.shared.button.cancel;
                    }

                    Group {
                        Anchor: (Width: 8);
                    }

                    $C.@SmallSecondaryTextButton #TameworkLinkedPanelGroupAssignApplyButton {
                        @Sounds = $C.@ButtonSounds;
                        @Anchor = (Width: 180, Height: 28);
                        @Text = %server.tamework.ui.shared.button.apply;
                    }
                }
            }
        }

        Group #TameworkLinkedPanelReviveOverlay {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
            Background: #060b13(0.82);
            Visible: false;

            Group #TameworkLinkedPanelReviveModal {
                Anchor: (Top: 230, Left: 353, Width: 382, Height: 180);
                Background: #102038;

                Label #TameworkLinkedPanelReviveTitle {
                    Anchor: (Top: 10, Left: 14, Width: 354, Height: 24);
                    Text: %server.tamework.ui.linkedPanel.revive.title;
                    Style: (FontSize: 18, RenderBold: true, TextColor: #dce8f6, HorizontalAlignment: Start, VerticalAlignment: Center);
                }

                Group #TameworkLinkedPanelReviveCostViewport {
                    Anchor: (Top: 44, Left: 14, Width: 354, Height: 88);
                    KeepScrollPosition: true;
                    ScrollbarStyle: $C.@DefaultScrollbarStyle;
                    LayoutMode: TopScrolling;

                    Group #TameworkLinkedPanelReviveCostList {
                        LayoutMode: Top;
                        Anchor: (Bottom: 4);
                    }
                }

                Group #TameworkLinkedPanelReviveActions {
                    Anchor: (Top: 146, Left: 14, Width: 354, Height: 24);
                    LayoutMode: Left;

                    Group { Anchor: (Width: 158); }

                    $C.@SmallSecondaryTextButton #TameworkLinkedPanelReviveCancelButton {
                        @Sounds = $C.@ButtonSounds;
                        @Anchor = (Width: 88, Height: 24);
                        @Text = %server.tamework.ui.shared.button.cancel;
                    }

                    Group { Anchor: (Width: 8); }

                    $C.@SmallSecondaryTextButton #TameworkLinkedPanelReviveConfirmButton {
                        @Sounds = $C.@ButtonSounds;
                        @Anchor = (Width: 100, Height: 24);
                        @Text = %server.tamework.ui.linkedPanel.revive.confirm;
                        Visible: false;
                    }

                    Label #TameworkLinkedPanelReviveBlockedButton {
                        Anchor: (Width: 100, Height: 24);
                        Text: %server.tamework.ui.linkedPanel.revive.confirm;
                        Style: (FontSize: 13, RenderBold: true, TextColor: #74869a, HorizontalAlignment: Center, VerticalAlignment: Center);
                        Visible: false;
                    }
                }
            }
        }

    }
}

