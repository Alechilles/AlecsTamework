Group #TameworkLinkedPanelRoot {
  Anchor: (Top: 96, Right: 40, Width: 430, Height: 640);
  LayoutMode: Top;
  Padding: (Horizontal: 14, Vertical: 12);
  Background: #0b1a2c(0.78);
  Visible: false;

  Label #TameworkLinkedPanelTitle {
    Anchor: (Height: 30);
    Text: "Linked Companions";
    Style: (
      FontSize: 24,
      RenderBold: true,
      TextColor: #eef3f8,
      HorizontalAlignment: Start,
      VerticalAlignment: Center
    );
  }

  Label #TameworkLinkedPanelSubtitle {
    Anchor: (Top: 2, Height: 20);
    Text: "Preview panel (separate document)";
    Style: (
      FontSize: 14,
      TextColor: #c4d2e1,
      HorizontalAlignment: Start,
      VerticalAlignment: Center
    );
  }

  Group #TameworkLinkedPanelCard0 {
    Anchor: (Top: 12, Height: 86);
    Background: #13263c(0.86);
    Padding: (Horizontal: 10, Vertical: 8);

    Label #TameworkLinkedPanelCard0Name {
      Anchor: (Height: 22);
      Text: "Companion Name";
      Style: (
        FontSize: 16,
        RenderBold: true,
        TextColor: #eff4fa,
        HorizontalAlignment: Start,
        VerticalAlignment: Center
      );
    }

    Group #TameworkLinkedPanelCard0HealthFrame {
      Anchor: (Top: 8, Height: 14);
      Background: #0a121b(0.95);

      Group #TameworkLinkedPanelCard0HealthFill {
        Anchor: (Left: 1, Top: 1, Width: 220, Height: 12);
        Background: #6fc576;
      }
    }

    Label #TameworkLinkedPanelCard0HealthText {
      Anchor: (Top: 8, Height: 16);
      Text: "Health: 72/100";
      Style: (
        FontSize: 11,
        TextColor: #bed0e3,
        HorizontalAlignment: Start,
        VerticalAlignment: Center
      );
    }
  }

  Group #TameworkLinkedPanelCard1 {
    Anchor: (Top: 8, Height: 86);
    Background: #13263c(0.86);
    Padding: (Horizontal: 10, Vertical: 8);

    Label #TameworkLinkedPanelCard1Name {
      Anchor: (Height: 22);
      Text: "Companion Name";
      Style: (
        FontSize: 16,
        RenderBold: true,
        TextColor: #eff4fa,
        HorizontalAlignment: Start,
        VerticalAlignment: Center
      );
    }

    Group #TameworkLinkedPanelCard1HealthFrame {
      Anchor: (Top: 8, Height: 14);
      Background: #0a121b(0.95);

      Group #TameworkLinkedPanelCard1HealthFill {
        Anchor: (Left: 1, Top: 1, Width: 150, Height: 12);
        Background: #6fc576;
      }
    }

    Label #TameworkLinkedPanelCard1HealthText {
      Anchor: (Top: 8, Height: 16);
      Text: "Health: 45/100";
      Style: (
        FontSize: 11,
        TextColor: #bed0e3,
        HorizontalAlignment: Start,
        VerticalAlignment: Center
      );
    }
  }
}
