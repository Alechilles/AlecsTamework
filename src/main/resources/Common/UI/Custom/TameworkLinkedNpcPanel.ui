$C = "Common.ui";

Group #TameworkLinkedPanelRoot {
  Anchor: (Top: 290, Left: 0, Width: 562, Height: 640);
  Visible: false;

  $C.@DecoratedContainer #TameworkLinkedPanelContainer {
    Anchor: (Top: 0, Left: 132, Width: 430, Height: 640);

    #Title {
      $C.@Title #TameworkLinkedPanelTitle {
        @Alignment = Start;
        @Text = "Linked NPCs";
      }

      DropdownBox #TameworkLinkedPanelModeDropdown {
        Anchor: (Top: 2, Right: 8, Width: 132, Height: 24);
        Style: (
          ...$C.@DefaultDropdownBoxStyle,
          HorizontalPadding: 8,
          LabelStyle: (
            ...$C.@DefaultDropdownBoxLabelStyle,
            RenderUppercase: false,
            FontSize: 11
          ),
          EntryLabelStyle: (
            ...$C.@DefaultDropdownBoxEntryLabelStyle,
            RenderUppercase: false,
            FontSize: 11
          ),
          SelectedEntryLabelStyle: (
            ...$C.@DefaultDropdownBoxEntryLabelStyle,
            RenderUppercase: false,
            RenderBold: true,
            FontSize: 11
          )
        );
        MaxSelection: 1;
        NoItemsText: "No modes";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 10, Right: 6, Top: 6, Bottom: 10);

    Group #TameworkLinkedPanelSubtitleRow {
      Anchor: (Height: 24);

      Label #TameworkLinkedPanelSubtitle {
        Anchor: (Left: 2, Width: 138, Height: 20);
        Text: "No linked NPCs";
        Style: (
          FontSize: 14,
          TextColor: #c4d2e1,
          HorizontalAlignment: Start,
          VerticalAlignment: Center
        );
      }

      Group #TameworkLinkedPanelSubtitleRadiusSlot {
        Anchor: (Left: 147, Width: 124, Height: 24);
        LayoutMode: Left;

        Group { Anchor: (Width: 12); }

        Group #TameworkLinkedPanelSubtitleRadiusControls {
          Anchor: (Width: 100, Height: 24);
          LayoutMode: Left;
          Visible: false;

          TextButton #TameworkLinkedPanelRadiusDec {
            Anchor: (Width: 14, Height: 24);
            Text: "-";
          }

          Group { Anchor: (Width: 1); }

          Label #TameworkLinkedPanelRadiusValue {
            Anchor: (Width: 68, Height: 24);
            Text: "Radius: 24m";
            Style: (
              FontSize: 12,
              TextColor: #dbe8f6,
              HorizontalAlignment: Center,
              VerticalAlignment: Center
            );
          }

          Group { Anchor: (Width: 4); }

          TextButton #TameworkLinkedPanelRadiusInc {
            Anchor: (Width: 14, Height: 24);
            Text: "+";
          }
        }

        Group { Anchor: (Width: 12); }
      }

      $C.@SmallSecondaryTextButton #TameworkLinkedPanelManageGroupsButton {
        @Sounds = $C.@ButtonSounds;
        @Anchor = (Right: 2, Width: 88, Height: 24);
        @Text = "Groups";
      }
    }

    $C.@PanelSeparatorFancy {
      @Anchor = (Top: 2, Bottom: 4);
    }

    Group #TameworkLinkedPanelControlsSecondary {
      Anchor: (Top: 0, Height: 28);
      LayoutMode: Left;

      Label #TameworkLinkedPanelSortLabel {
        Anchor: (Width: 26, Height: 24);
        Text: "Sort:";
        Style: (
          FontSize: 12,
          TextColor: #bfd0e5,
          HorizontalAlignment: Start,
          VerticalAlignment: Center
        );
      }

      Group { Anchor: (Width: 2); }

      DropdownBox #TameworkLinkedPanelSortDropdown {
        Anchor: (Width: 92, Height: 24);
        Style: (
          ...$C.@DefaultDropdownBoxStyle,
          HorizontalPadding: 8,
          LabelStyle: (
            ...$C.@DefaultDropdownBoxLabelStyle,
            RenderUppercase: false,
            FontSize: 11
          ),
          EntryLabelStyle: (
            ...$C.@DefaultDropdownBoxEntryLabelStyle,
            RenderUppercase: false,
            FontSize: 11
          ),
          SelectedEntryLabelStyle: (
            ...$C.@DefaultDropdownBoxEntryLabelStyle,
            RenderUppercase: false,
            RenderBold: true,
            FontSize: 11
          )
        );
        MaxSelection: 1;
        NoItemsText: "No sort options";
      }

      Group { Anchor: (Width: 6); }

      Label #TameworkLinkedPanelFilterLabel {
        Anchor: (Width: 34, Height: 24);
        Text: "Filter:";
        Style: (
          FontSize: 12,
          TextColor: #bfd0e5,
          HorizontalAlignment: Start,
          VerticalAlignment: Center
        );
      }

      Group { Anchor: (Width: 2); }

      DropdownBox #TameworkLinkedPanelFilterDropdown {
        Anchor: (Width: 92, Height: 24);
        Style: (
          ...$C.@DefaultDropdownBoxStyle,
          HorizontalPadding: 8,
          LabelStyle: (
            ...$C.@DefaultDropdownBoxLabelStyle,
            RenderUppercase: false,
            FontSize: 11
          ),
          EntryLabelStyle: (
            ...$C.@DefaultDropdownBoxEntryLabelStyle,
            RenderUppercase: false,
            FontSize: 11
          ),
          SelectedEntryLabelStyle: (
            ...$C.@DefaultDropdownBoxEntryLabelStyle,
            RenderUppercase: false,
            RenderBold: true,
            FontSize: 11
          )
        );
        MaxSelection: 1;
        NoItemsText: "No filter options";
      }

      Group { Anchor: (Width: 6); }

      Group #TameworkLinkedPanelInlineFilterTextControls {
        Anchor: (Width: 138, Height: 24);
        LayoutMode: Left;
        Visible: false;

        TextField #TameworkLinkedPanelFilterInput {
          Style: $C.@DefaultInputFieldStyle;
          PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
          Background: $C.@InputBoxBackground;
          Anchor: (Width: 138, Height: 24);
          Padding: (Horizontal: 8);
          PlaceholderText: "Filter Text";
          MaxLength: 40;
        }
      }
    }

    Label #TameworkLinkedPanelEmptyState {
      Anchor: (Top: 8, Height: 48);
      Text: "No linked NPCs yet. Primary-use on an owned NPC to link it.";
      Style: (
        FontSize: 14,
        TextColor: #b2c3d6,
        HorizontalAlignment: Start,
        VerticalAlignment: Start
      );
      Visible: false;
    }

      Group #TameworkLinkedPanelListViewport {
        Anchor: (Top: 1);
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        KeepScrollPosition: true;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Left: 7, Right: 2, Top: 1, Bottom: 7);

        Group #TameworkLinkedPanelList {
          LayoutMode: Top;
          Anchor: (Bottom: 6);
        }
      }
    }
  }

  Group #TameworkLinkedPanelGroupPickerOverlay {
    Anchor: (Top: 108, Left: 4, Width: 152, Height: 146);
    Background: (TexturePath: "Common/ContainerPanelPatch.png", Border: 4);
    Padding: (Left: 4, Right: 4, Top: 4, Bottom: 4);
    Visible: false;

    Label #TameworkLinkedPanelGroupPickerTitle {
      Anchor: (Top: 0, Left: 2, Right: 2, Height: 16);
      Text: "Set Group";
      Style: (
        FontSize: 11,
        RenderBold: true,
        TextColor: #c8d9ec,
        HorizontalAlignment: Start,
        VerticalAlignment: Center
      );
    }

    Group #TameworkLinkedPanelGroupPickerListViewport {
      Anchor: (Top: 18, Left: 0, Right: 0, Bottom: 0);
      LayoutMode: TopScrolling;
      KeepScrollPosition: true;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;

      Group #TameworkLinkedPanelGroupPickerList {
        LayoutMode: Top;
        Anchor: (Bottom: 0);
      }
    }
  }
}
