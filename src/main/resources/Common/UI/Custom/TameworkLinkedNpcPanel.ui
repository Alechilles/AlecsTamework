$C = "Common.ui";

@RemoveIconButtonLabelStyle = LabelStyle(
  FontSize: 1,
  TextColor: #00000000
);

@RemoveIconButtonStyle = TextButtonStyle(
  Default: (Background: (TexturePath: "Tamework/LinkedPanelRemoveIcon.png"), LabelStyle: @RemoveIconButtonLabelStyle),
  Hovered: (Background: (TexturePath: "Tamework/LinkedPanelRemoveIcon.png", Color: #ffffff(0.9)), LabelStyle: @RemoveIconButtonLabelStyle),
  Pressed: (Background: (TexturePath: "Tamework/LinkedPanelRemoveIcon.png", Color: #ffffff(0.8)), LabelStyle: @RemoveIconButtonLabelStyle),
  Disabled: (Background: (TexturePath: "Tamework/LinkedPanelRemoveIcon.png", Color: #ffffff(0.5)), LabelStyle: @RemoveIconButtonLabelStyle)
);

Group #TameworkLinkedPanelRoot {
  Anchor: (Top: 240, Left: 160, Width: 430, Height: 640);
  LayoutMode: Top;
  Padding: (Horizontal: 14, Vertical: 12);
  Background: #0b1a2c(0.78);
  Visible: false;

  Label #TameworkLinkedPanelTitle {
    Anchor: (Height: 30);
    Text: "Linked Companions";
    Style: (
      FontSize: 24,
      RenderBold: true,
      TextColor: #eef3f8,
      HorizontalAlignment: Start,
      VerticalAlignment: Center
    );
  }

  Label #TameworkLinkedPanelSubtitle {
    Anchor: (Top: 2, Height: 20);
    Text: "No linked companions";
    Style: (
      FontSize: 14,
      TextColor: #c4d2e1,
      HorizontalAlignment: Start,
      VerticalAlignment: Center
    );
  }

  Group #TameworkLinkedPanelCard0 {
    Anchor: (Top: 12, Height: 90);
    Background: #13263c(0.86);
    Padding: (Horizontal: 10, Vertical: 8);
    Visible: false;

    Label #TameworkLinkedPanelCard0Name {
      Anchor: (Top: 0, Left: 0, Width: 286, Height: 22);
      Text: "Companion";
      Style: (FontSize: 16, RenderBold: true, TextColor: #eff4fa, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    TextButton #TameworkLinkedPanelCard0RemoveButton {
      Anchor: (Top: -2, Right: 2, Width: 28, Height: 28);
      Style: @RemoveIconButtonStyle;
      Text: "";
    }

    Group #TameworkLinkedPanelCard0HealthFrame {
      Anchor: (Top: 30, Left: 0, Width: 286, Height: 14);
      Background: #0a121b(0.95);

      Group #TameworkLinkedPanelCard0HealthFill {
        Anchor: (Left: 1, Top: 1, Width: 284, Height: 12);
        Background: #6fc576;
      }
    }

    Label #TameworkLinkedPanelCard0HealthText {
      Anchor: (Top: 50, Left: 0, Width: 286, Height: 16);
      Text: "Health: ?/?";
      Style: (FontSize: 11, TextColor: #bed0e3, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
  }

  Group #TameworkLinkedPanelCard1 {
    Anchor: (Top: 8, Height: 90);
    Background: #13263c(0.86);
    Padding: (Horizontal: 10, Vertical: 8);
    Visible: false;

