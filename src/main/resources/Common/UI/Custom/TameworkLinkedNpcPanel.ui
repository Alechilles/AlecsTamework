$C = "Common.ui";

$C.@DecoratedContainer #TameworkLinkedPanelRoot {
  Anchor: (Top: 290, Left: 132, Width: 430, Height: 640);
  Visible: false;

  #Title {
    $C.@Title #TameworkLinkedPanelTitle {
      @Alignment = Start;
      @Text = "Linked NPCs";
    }

    DropdownBox #TameworkLinkedPanelModeDropdown {
      Anchor: (Top: 2, Right: 8, Width: 132, Height: 24);
      Style: (
        ...$C.@DefaultDropdownBoxStyle,
        HorizontalPadding: 8,
        LabelStyle: (
          ...$C.@DefaultDropdownBoxLabelStyle,
          RenderUppercase: false,
          FontSize: 11
        ),
        EntryLabelStyle: (
          ...$C.@DefaultDropdownBoxEntryLabelStyle,
          RenderUppercase: false,
          FontSize: 11
        ),
        SelectedEntryLabelStyle: (
          ...$C.@DefaultDropdownBoxEntryLabelStyle,
          RenderUppercase: false,
          RenderBold: true,
          FontSize: 11
        )
      );
      MaxSelection: 1;
      NoItemsText: "No modes";
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Left: 10, Right: 6, Top: 8, Bottom: 10);

    Group #TameworkLinkedPanelSubtitleRow {
      Anchor: (Height: 24);

      Label #TameworkLinkedPanelSubtitle {
        Anchor: (Left: 0, Width: 138, Height: 20);
        Text: "No linked NPCs";
        Style: (
          FontSize: 14,
          TextColor: #c4d2e1,
          HorizontalAlignment: Start,
          VerticalAlignment: Center
        );
      }

      Group #TameworkLinkedPanelSubtitleRadiusSlot {
        Anchor: (Left: 145, Width: 124, Height: 24);
        LayoutMode: Left;

        Group { Anchor: (Width: 2); }

        Group #TameworkLinkedPanelSubtitleRadiusControls {
          Anchor: (Width: 120, Height: 24);
          LayoutMode: Left;
          Visible: false;

          TextButton #TameworkLinkedPanelRadiusDec {
            Anchor: (Width: 20, Height: 24);
            Text: "-";
          }

          Group { Anchor: (Width: 3); }

          Label #TameworkLinkedPanelRadiusValue {
            Anchor: (Width: 72, Height: 24);
            Text: "Radius: 24m";
            Style: (
              FontSize: 12,
              TextColor: #dbe8f6,
              HorizontalAlignment: Center,
              VerticalAlignment: Center
            );
          }

          Group { Anchor: (Width: 3); }

          TextButton #TameworkLinkedPanelRadiusInc {
            Anchor: (Width: 20, Height: 24);
            Text: "+";
          }
        }

        Group { Anchor: (Width: 2); }
      }

      $C.@SmallSecondaryTextButton #TameworkLinkedPanelManageGroupsButton {
        @Sounds = $C.@ButtonSounds;
        @Anchor = (Right: 0, Width: 88, Height: 24);
        @Text = "Groups";
      }
    }

    $C.@PanelSeparatorFancy {
      @Anchor = (Top: 2, Bottom: 4);
    }

    Group #TameworkLinkedPanelControlsSecondary {
      Anchor: (Top: 0, Height: 28);
      LayoutMode: Left;

      Label #TameworkLinkedPanelSortLabel {
        Anchor: (Width: 30, Height: 24);
        Text: "Sort:";
        Style: (
          FontSize: 12,
          TextColor: #bfd0e5,
          HorizontalAlignment: Start,
          VerticalAlignment: Center
        );
      }

      Group { Anchor: (Width: 4); }

      DropdownBox #TameworkLinkedPanelSortDropdown {
        Anchor: (Width: 104, Height: 24);
        Style: (
          ...$C.@DefaultDropdownBoxStyle,
          HorizontalPadding: 8,
          LabelStyle: (
            ...$C.@DefaultDropdownBoxLabelStyle,
            RenderUppercase: false,
            FontSize: 11
          ),
          EntryLabelStyle: (
            ...$C.@DefaultDropdownBoxEntryLabelStyle,
            RenderUppercase: false,
            FontSize: 11
          ),
          SelectedEntryLabelStyle: (
            ...$C.@DefaultDropdownBoxEntryLabelStyle,
            RenderUppercase: false,
            RenderBold: true,
            FontSize: 11
          )
        );
        MaxSelection: 1;
        NoItemsText: "No sort options";
      }

      Group { Anchor: (Width: 10); }

      Label #TameworkLinkedPanelFilterLabel {
        Anchor: (Width: 38, Height: 24);
        Text: "Filter:";
        Style: (
          FontSize: 12,
          TextColor: #bfd0e5,
          HorizontalAlignment: Start,
          VerticalAlignment: Center
        );
      }

      Group { Anchor: (Width: 4); }

      DropdownBox #TameworkLinkedPanelFilterDropdown {
        Anchor: (Width: 104, Height: 24);
        Style: (
          ...$C.@DefaultDropdownBoxStyle,
          HorizontalPadding: 8,
          LabelStyle: (
            ...$C.@DefaultDropdownBoxLabelStyle,
            RenderUppercase: false,
            FontSize: 11
          ),
          EntryLabelStyle: (
            ...$C.@DefaultDropdownBoxEntryLabelStyle,
            RenderUppercase: false,
            FontSize: 11
          ),
          SelectedEntryLabelStyle: (
            ...$C.@DefaultDropdownBoxEntryLabelStyle,
            RenderUppercase: false,
            RenderBold: true,
            FontSize: 11
          )
        );
        MaxSelection: 1;
        NoItemsText: "No filter options";
      }

      Group { Anchor: (Width: 8); }

      Label #TameworkLinkedPanelFilterSummary {
        Anchor: (Width: 100, Height: 24);
        Text: "Filters: none";
        Style: (
          FontSize: 12,
          TextColor: #bfd0e5,
          HorizontalAlignment: Start,
          VerticalAlignment: Center
        );
      }
    }

    Group #TameworkLinkedPanelFilterInputRow {
      Anchor: (Top: 1, Height: 28);
      LayoutMode: Left;
      Visible: false;

      Label #TameworkLinkedPanelFilterInputLabel {
        Anchor: (Width: 52, Height: 24);
        Text: "Filter";
        Style: (
          FontSize: 12,
          TextColor: #bfd0e5,
          HorizontalAlignment: Start,
          VerticalAlignment: Center
        );
      }

      Group { Anchor: (Width: 6); }

      TextField #TameworkLinkedPanelFilterInput {
        Style: $C.@DefaultInputFieldStyle;
        PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
        Background: $C.@InputBoxBackground;
        Anchor: (Width: 280, Height: 24);
        Padding: (Horizontal: 8);
        PlaceholderText: "Type to filter selected field";
        MaxLength: 40;
      }

      Group { Anchor: (Width: 6); }

      TextButton #TameworkLinkedPanelFilterClearButton {
        Anchor: (Width: 58, Height: 24);
        Text: "Clear";
      }
    }

    Label #TameworkLinkedPanelEmptyState {
      Anchor: (Top: 8, Height: 48);
      Text: "No linked NPCs yet. Primary-use on an owned NPC to link it.";
      Style: (
        FontSize: 14,
        TextColor: #b2c3d6,
        HorizontalAlignment: Start,
        VerticalAlignment: Start
      );
      Visible: false;
    }

    Group #TameworkLinkedPanelListViewport {
      Anchor: (Top: 1);
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      KeepScrollPosition: true;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Left: 7, Right: 2, Top: 1, Bottom: 7);

      Group #TameworkLinkedPanelList {
        LayoutMode: Top;
        Anchor: (Bottom: 6);
      }
    }
  }
}
