$C = "Common.ui";

Group #TameworkLinkedPanelRoot {
    Anchor: (Top: 290, Left: 0, Width: 562, Height: 640);
    Visible: false;

    $C.@DecoratedContainer #TameworkLinkedPanelContainer {
        Anchor: (Top: 0, Left: 132, Width: 430, Height: 640);

        #Title {
            $C.@Title #TameworkLinkedPanelTitle {
                @Alignment = Start;
                @Text = %server.tamework.ui.linkedPanel.title.linked;
            }

            Group #TameworkLinkedPanelAutoLinkControls {
                Anchor: (Top: 0, Right: 148, Width: 104, Height: 28);

                CheckBox #TameworkLinkedPanelAutoLinkCheck {
                    Anchor: (Top: 3, Left: 0, Width: 22, Height: 22);
                    Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                    Padding: (Full: 4);
                    Style: $C.@DefaultCheckBoxStyle;
                }

                Label #TameworkLinkedPanelAutoLinkLabel {
                    Anchor: (Left: 28, Width: 76, Height: 28);
                    Text: %server.tamework.ui.linkedPanel.autoLink.label;
                    Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
                }
            }

            DropdownBox #TameworkLinkedPanelModeDropdown {
                Anchor: (Top: 2, Right: 8, Width: 132, Height: 24);
                Style: (...$C.@DefaultDropdownBoxStyle, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, RenderUppercase: false, FontSize: 11), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, FontSize: 11), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, RenderBold: true, FontSize: 11));
                MaxSelection: 1;
                NoItemsText: %server.tamework.ui.linkedPanel.mode.noModes;
            }
        }

        #Content {
            LayoutMode: Top;
            Padding: (Left: 10, Right: 6, Top: 6, Bottom: 10);

            Group #TameworkLinkedPanelSubtitleRow {
                Anchor: (Height: 24);

                DropdownBox #TameworkLinkedPanelGroupSelectorDropdown {
                    Anchor: (Left: 2, Width: 138, Height: 24);
                    Style: (...$C.@DefaultDropdownBoxStyle, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, RenderUppercase: false, FontSize: 11), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, FontSize: 11), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, RenderBold: true, FontSize: 11));
                    MaxSelection: 1;
                    NoItemsText: %server.tamework.ui.linkedPanel.groupSelector.noneGroups;
                }

                Group #TameworkLinkedPanelSubtitleRadiusSlot {
                    Anchor: (Left: 147, Width: 124, Height: 24);
                    LayoutMode: Left;

                    Group {
                        Anchor: (Width: 12);
                    }

                    Group #TameworkLinkedPanelSubtitleRadiusControls {
                        Anchor: (Width: 100, Height: 24);
                        LayoutMode: Left;
                        Visible: false;

                        TextButton #TameworkLinkedPanelRadiusDec {
                            Anchor: (Width: 14, Height: 24);
                            Text: "-";
                        }

                        Group {
                            Anchor: (Width: 1);
                        }

                        Label #TameworkLinkedPanelRadiusValue {
                            Anchor: (Width: 68, Height: 24);
                            Text: %server.tamework.ui.linkedPanel.radius.value.default;
                            Style: (FontSize: 12, TextColor: #dbe8f6, HorizontalAlignment: Center, VerticalAlignment: Center);
                        }

                        Group {
                            Anchor: (Width: 4);
                        }

                        TextButton #TameworkLinkedPanelRadiusInc {
                            Anchor: (Width: 14, Height: 24);
                            Text: "+";
                        }
                    }

                    Group {
                        Anchor: (Width: 12);
                    }
                }

                $C.@SmallSecondaryTextButton #TameworkLinkedPanelManageGroupsButton {
                    @Sounds = $C.@ButtonSounds;
                    @Anchor = (Right: 2, Width: 88, Height: 24);
                    @Text = %server.tamework.ui.linkedPanel.manageGroups;
                }
            }

            $C.@PanelSeparatorFancy {
                @Anchor = (Top: 2, Bottom: 4);
            }

            Group #TameworkLinkedPanelControlsSecondary {
                Anchor: (Top: 0, Height: 28);
                LayoutMode: Left;

                Label #TameworkLinkedPanelSortLabel {
                    Anchor: (Width: 26, Height: 24);
                    Text: %server.tamework.ui.linkedPanel.sort.label;
                    Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
                }

                Group {
                    Anchor: (Width: 2);
                }

                DropdownBox #TameworkLinkedPanelSortDropdown {
                    Anchor: (Width: 92, Height: 24);
                    Style: (...$C.@DefaultDropdownBoxStyle, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, RenderUppercase: false, FontSize: 11), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, FontSize: 11), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, RenderBold: true, FontSize: 11));
                    MaxSelection: 1;
                    NoItemsText: %server.tamework.ui.linkedPanel.sort.noneOptions;
                }

                Group {
                    Anchor: (Width: 6);
                }

                Label #TameworkLinkedPanelFilterLabel {
                    Anchor: (Width: 34, Height: 24);
                    Text: %server.tamework.ui.linkedPanel.filter.label;
                    Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
                }

                Group {
                    Anchor: (Width: 2);
                }

                DropdownBox #TameworkLinkedPanelFilterDropdown {
                    Anchor: (Width: 92, Height: 24);
                    Style: (...$C.@DefaultDropdownBoxStyle, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, RenderUppercase: false, FontSize: 11), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, FontSize: 11), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, RenderBold: true, FontSize: 11));
                    MaxSelection: 1;
                    NoItemsText: %server.tamework.ui.linkedPanel.filter.noneOptions;
                }

                Group {
                    Anchor: (Width: 6);
                }

                Group #TameworkLinkedPanelInlineFilterTextControls {
                    Anchor: (Width: 138, Height: 24);
                    LayoutMode: Left;
                    Visible: false;

                    TextField #TameworkLinkedPanelFilterInput {
                        Style: $C.@DefaultInputFieldStyle;
                        PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
                        Background: $C.@InputBoxBackground;
                        Anchor: (Width: 138, Height: 24);
                        Padding: (Horizontal: 8);
                        PlaceholderText: %server.tamework.ui.linkedPanel.filter.placeholder;
                        MaxLength: 40;
                    }
                }
            }

            Label #TameworkLinkedPanelEmptyState {
                Anchor: (Top: 8, Height: 48);
                Text: %server.tamework.ui.linkedPanel.emptyState;
                Style: (FontSize: 14, TextColor: #b2c3d6, HorizontalAlignment: Start, VerticalAlignment: Start);
                Visible: false;
            }

            Group #TameworkLinkedPanelListViewport {
                Anchor: (Top: 1);
                FlexWeight: 1;
                KeepScrollPosition: true;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;
                Padding: (Left: 7, Right: 2, Top: 1, Bottom: 7);
                LayoutMode: TopScrolling;

                Group #TameworkLinkedPanelList {
                    LayoutMode: Top;
                    Anchor: (Bottom: 6);
                }
            }
        }

        Group #TameworkLinkedPanelGroupAssignOverlay {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
            Background: #060b13(0.78);
            Visible: false;

            Group #TameworkLinkedPanelGroupAssignModal {
                Anchor: (Top: 190, Left: 36, Width: 358, Height: 176);
                Background: #102038;

                Label #TameworkLinkedPanelGroupAssignTitle {
                    Anchor: (Top: 10, Left: 14, Width: 330, Height: 24);
                    Text: %server.tamework.ui.linkedPanel.groupAssign.title;
                    Style: (FontSize: 18, RenderBold: true, TextColor: #dce8f6, HorizontalAlignment: Start, VerticalAlignment: Center);
                }

                Label #TameworkLinkedPanelGroupAssignSubtitle {
                    Anchor: (Top: 40, Left: 14, Width: 330, Height: 24);
                    Text: %server.tamework.ui.linkedPanel.groupAssign.prompt;
                    Style: (FontSize: 13, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
                }

                DropdownBox #TameworkLinkedPanelGroupAssignDropdown {
                    Anchor: (Top: 72, Left: 14, Width: 330, Height: 26);
                    Style: (...$C.@DefaultDropdownBoxStyle, HorizontalPadding: 8, LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, RenderUppercase: false, FontSize: 12), EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, FontSize: 12), SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, RenderBold: true, FontSize: 12));
                    MaxSelection: 1;
                    NoItemsText: %server.tamework.ui.linkedPanel.groupAssign.noneGroups;
                }

                Group #TameworkLinkedPanelGroupAssignButtons {
                    Anchor: (Top: 112, Left: 14, Width: 330, Height: 30);
                    LayoutMode: Left;

                    Group {
                        Anchor: (Width: 138);
                    }

                    $C.@SmallSecondaryTextButton #TameworkLinkedPanelGroupAssignCancelButton {
                        @Sounds = $C.@ButtonSounds;
                        @Anchor = (Width: 92, Height: 24);
                        @Text = %server.tamework.ui.shared.button.cancel;
                    }

                    Group {
                        Anchor: (Width: 8);
                    }

                    $C.@SmallSecondaryTextButton #TameworkLinkedPanelGroupAssignApplyButton {
                        @Sounds = $C.@ButtonSounds;
                        @Anchor = (Width: 92, Height: 24);
                        @Text = %server.tamework.ui.shared.button.apply;
                    }
                }
            }
        }
    }
}

