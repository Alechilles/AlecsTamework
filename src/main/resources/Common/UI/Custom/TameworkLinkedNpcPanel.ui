$C = "Common.ui";

Group #TameworkLinkedPanelRoot {
  Anchor: (Top: 290, Left: 132, Width: 430, Height: 640);
  LayoutMode: Top;
  Padding: (Horizontal: 14, Vertical: 12);
  Background: #0b1a2c(0.78);
  Visible: false;

  Label #TameworkLinkedPanelTitle {
    Anchor: (Height: 30);
    Text: "Linked Companions";
    Style: (
      FontSize: 24,
      RenderBold: true,
      TextColor: #eef3f8,
      HorizontalAlignment: Start,
      VerticalAlignment: Center
    );
  }

  Label #TameworkLinkedPanelSubtitle {
    Anchor: (Top: 2, Height: 20);
    Text: "No linked companions";
    Style: (
      FontSize: 14,
      TextColor: #c4d2e1,
      HorizontalAlignment: Start,
      VerticalAlignment: Center
    );
  }

  Label #TameworkLinkedPanelEmptyState {
    Anchor: (Top: 16, Height: 48);
    Text: "No linked companions yet.\nPrimary-use on an owned NPC to link it.";
    Style: (
      FontSize: 14,
      TextColor: #b2c3d6,
      HorizontalAlignment: Start,
      VerticalAlignment: Start
    );
    Visible: false;
  }

  Group #TameworkLinkedPanelListViewport {
    Anchor: (Top: 10);
    FlexWeight: 1;
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;

    Group #TameworkLinkedPanelList {
      LayoutMode: Top;
      Anchor: (Bottom: 6);
      Padding: (Right: 8);
    }
  }
}
