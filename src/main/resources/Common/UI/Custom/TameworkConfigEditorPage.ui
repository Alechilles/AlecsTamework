$A = "TameworkSlateStyles.ui";
$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  Group #TwConfigRoot {
    Anchor: (Width: 1040, Height: 680);

    // Off-atlas page plate, 1040x680 with the 48-high header band baked in (TameworkUiKit).
    AssetImage #TwConfigPlate { Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0); AssetPath: "Tamework/UI/Slate/page_config.png"; FallbackTexturePath: "UI/Custom/Tamework/Slate/Clear.png"; HitTestVisible: false; }

    Group #Title {
      Anchor: (Top: 0, Left: 0, Right: 0, Height: 48);

      Group { Anchor: (Top: 7, Left: 20, Width: 34, Height: 34); Background: "Tamework/Slate/Badge.png"; HitTestVisible: false; }

      Label #TwConfigTitle {
        Anchor: (Left: 66, Right: 250, Height: 48);
        Text: %server.tamework.ui.configEditor.title;
        Style: $A.@SlateTitle;
      }

      Group {
        Anchor: (Top: 9, Right: 16, Width: 198, Height: 30);

        TextButton #TwConfigApplyButton {
          Anchor: (Left: 0, Width: 94, Height: 30);
          Text: %server.tamework.ui.shared.button.apply;
          Style: $A.@PanelButtonPrimary;
        }

        Group {
          Anchor: (Right: 0, Width: 30, Height: 30);
          TextButton #TwConfigCloseButton {
            Anchor: (Full: 0);
            Text: "";
            TooltipText: %server.tamework.ui.shared.button.close;
            Style: $A.@ActionQuiet;
          }
          Group { Anchor: (Top: 3, Left: 3, Width: 24, Height: 24); HitTestVisible: false; Background: (TexturePath: "Tamework/PanelActions/Remove_Glyph_Default.png", Color: #c2ccd6); }
        }
      }
    }

    Group #Content {
      Anchor: (Top: 56, Left: 10, Right: 10, Bottom: 12);
      LayoutMode: Top;
      Padding: (Left: 10, Right: 10, Top: 6, Bottom: 8);

      Label #TwConfigStatusLine {
        Anchor: (Top: 0, Height: 0);
        Text: "";
        Style: (FontSize: 11, TextColor: #c2ccd6, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
        Visible: false;
      }

      Label #TwConfigWarningLine {
        Anchor: (Top: 0, Height: 0);
        Text: "";
        Style: (FontSize: 12, TextColor: #f0b45a, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
        Visible: false;
      }

      Group {
        Anchor: (Top: 2);
        FlexWeight: 1;
        LayoutMode: Left;

        Group #TwConfigLeftPane {
          Anchor: (Width: 330, Top: 0, Bottom: 0);
          LayoutMode: Top;
          Background: #000000(0.28);
          OutlineColor: #000000(0.6);
          OutlineSize: 1;
          Padding: (Left: 10, Right: 10, Top: 8, Bottom: 8);

          Label {
            Anchor: (Height: 18);
            Text: %server.tamework.ui.configEditor.mod.label;
            Style: $A.@SlateSectionLabel;
          }

          DropdownBox #TwConfigModDropdown {
            Anchor: (Top: 4, Height: 24);
            Style: (...$A.@PanelDropdown, HorizontalPadding: 8);
            MaxSelection: 1;
            NoItemsText: %server.tamework.ui.configEditor.mod.none;
          }

          Label {
            Anchor: (Top: 6, Height: 18);
            Text: %server.tamework.ui.configEditor.family.label;
            Style: $A.@SlateSectionLabel;
          }

          DropdownBox #TwConfigFamilyDropdown {
            Anchor: (Top: 4, Height: 24);
            Style: (...$A.@PanelDropdown, HorizontalPadding: 8);
            MaxSelection: 1;
            NoItemsText: %server.tamework.ui.configEditor.family.none;
          }

          Label #TwConfigAssetFamilyTitle {
            Anchor: (Top: 8, Height: 22);
            Text: %server.tamework.ui.configEditor.assets.title;
            Style: (...$A.@SlateTitle, FontSize: 14);
          }

          TextField #TwConfigAssetFilterInput {
            Anchor: (Top: 6, Height: 24);
            Style: $A.@PanelInputFieldStyle;
            PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
            Background: $A.@SlateQuiet;
            Decoration: (
              Default: (Background: $A.@SlateQuiet),
              Focused: (Background: $A.@SlateQuietFocus)
            );
            PlaceholderText: %server.tamework.ui.configEditor.assets.searchPlaceholder;
            MaxLength: 80;
            Padding: (Horizontal: 8);
          }

          Group {
            Anchor: (Top: 6, Height: 150);
            Background: $A.@SlateQuiet;

            Group #TwConfigAssetListViewport {
              Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
              LayoutMode: TopScrolling;
              KeepScrollPosition: true;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              Padding: (Left: 4, Right: 0, Top: 4, Bottom: 4);

              Group #TwConfigAssetListRows {
                LayoutMode: Top;
                Anchor: (Left: 0, Right: 0, Bottom: 0);
              }
            }

            Label #TwConfigAssetListEmpty {
              Anchor: (Top: 8, Left: 8, Right: 8, Height: 20);
              Text: %server.tamework.ui.configEditor.assets.list.empty;
              Style: (FontSize: 11, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
              Visible: false;
            }
          }

          Label #TwConfigAssetCount {
            Anchor: (Top: 4, Height: 18);
            Text: %server.tamework.ui.configEditor.assetCount.initial;
            Style: (FontSize: 12, TextColor: #c2ccd6, HorizontalAlignment: Start, VerticalAlignment: Center);
          }

          Label #TwConfigAssetScopeText {
            Anchor: (Top: 0, Height: 16);
            Text: "";
            Style: (FontSize: 10, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false);
          }

          Label {
            Anchor: (Top: 6, Height: 18);
            Text: %server.tamework.ui.configEditor.overridePath.label;
            Style: $A.@SlateSectionLabel;
          }

          Label #TwConfigOverridePath {
            Anchor: (Top: 1, Bottom: 0);
            Text: "";
            Style: (FontSize: 11, TextColor: #c2ccd6, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
          }
        }

        Group { Anchor: (Width: 8); }

        Group #TwConfigRightPane {
          Anchor: (Top: 0, Bottom: 0);
          FlexWeight: 1;
          LayoutMode: Top;

          Group {
            Anchor: (Height: 24);

            Label #TwConfigSelectedAssetTitle {
              Anchor: (Left: 0, Right: 102, Height: 24);
              Text: "";
              Style: (...$A.@SlateTitle, FontSize: 16);
            }

            TextButton #TwConfigRefreshButton {
              Anchor: (Right: 0, Width: 94, Height: 24);
              Text: %server.tamework.ui.shared.button.refresh;
              Style: $A.@PanelButtonQuiet;
            }
          }

          Label #TwConfigSelectedAssetMeta {
            Anchor: (Top: 1, Left: 0, Right: 304, Height: 18);
            Text: "";
            Style: (FontSize: 12, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
          }

          Label #TwConfigSelectedAssetFieldSummary {
            Anchor: (Top: 1, Right: 0, Width: 300, Height: 18);
            Text: "";
            Style: (FontSize: 11, TextColor: #8794a4, HorizontalAlignment: End, VerticalAlignment: Center, Wrap: false);
          }

          Group {
            Anchor: (Top: 1, Height: 16);

            Label #TwConfigSelectedAssetChain {
              Anchor: (Left: 0, Right: 330, Height: 16);
              Text: "";
              Style: (FontSize: 11, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false);
            }

            Label #TwConfigInlineNotice {
              Anchor: (Right: 0, Width: 320, Height: 16);
              Text: "";
              Style: (FontSize: 11, RenderBold: true, TextColor: #f2c66d, HorizontalAlignment: End, VerticalAlignment: Center, Wrap: false);
            }
          }

          TextField #TwConfigPropertyFilterInput {
            Anchor: (Top: 3, Height: 24);
            Style: $A.@PanelInputFieldStyle;
            PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle;
            Background: $A.@SlateQuiet;
            Decoration: (
              Default: (Background: $A.@SlateQuiet),
              Focused: (Background: $A.@SlateQuietFocus)
            );
            PlaceholderText: %server.tamework.ui.configEditor.properties.searchPlaceholder;
            MaxLength: 80;
            Padding: (Horizontal: 8);
          }

          Group #TwConfigPropertyHeaderRow {
            Anchor: (Top: 4, Height: 24);

            Group { Anchor: (Left: 0, Right: 0, Bottom: 0, Height: 1); Background: #ffffff(0.1); }

            Group {
              Anchor: (Top: 0, Left: 4, Right: 4, Bottom: 0);

              Label #TwConfigHeaderProperty {
                Anchor: (Left: 8, Width: 306, Height: 24);
                Text: %server.tamework.ui.configEditor.header.property;
                Style: $A.@SlateSectionLabel;
              }

              Label #TwConfigHeaderReset {
                Anchor: (Left: 314, Width: 56, Height: 24);
                Text: %server.tamework.ui.configEditor.header.reset;
                Style: (...$A.@SlateSectionLabel, HorizontalAlignment: Center);
              }

              Label #TwConfigHeaderSource {
                Anchor: (Left: 374, Width: 88, Height: 24);
                Text: %server.tamework.ui.configEditor.header.source;
                Style: (...$A.@SlateSectionLabel, HorizontalAlignment: Center);
              }

              Label #TwConfigHeaderValue {
                Anchor: (Left: 466, Right: 6, Height: 24);
                Text: %server.tamework.ui.configEditor.header.value;
                Style: $A.@SlateSectionLabel;
              }
            }
          }

          Group {
            Anchor: (Top: 4);
            FlexWeight: 1;
            Background: #000000(0.28);
            OutlineColor: #000000(0.6);
            OutlineSize: 1;

            Group #TwConfigPropertyViewport {
              Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
              LayoutMode: TopScrolling;
              KeepScrollPosition: true;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              Padding: (Left: 4, Right: 0, Top: 4, Bottom: 4);

              Group #TwConfigPropertyRows {
                LayoutMode: Top;
                Anchor: (Left: 0, Right: 0, Bottom: 0);
              }
            }

            Label #TwConfigPropertyEmptyState {
              Anchor: (Top: 8, Left: 8, Right: 8, Height: 22);
              Text: %server.tamework.ui.configEditor.properties.empty;
              Style: (FontSize: 13, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center);
              Visible: false;
            }
          }
        }
      }
    }

    Group #TwConfigApplyConfirmOverlay {
      Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
      Background: #05070a(0.8);
      Visible: false;

      Group {
        Anchor: (Top: 255, Left: 320, Width: 400, Height: 170);
        Background: $A.@SlateModal;

        Label {
          Anchor: (Top: 14, Left: 14, Width: 372, Height: 22);
          Text: %server.tamework.ui.configEditor.applyConfirm.title;
          Style: $A.@SlateTitle;
        }

        Label #TwConfigApplyConfirmCount {
          Anchor: (Top: 46, Left: 14, Width: 372, Height: 20);
          Text: %server.tamework.ui.configEditor.pendingDraftCount.initial;
          Style: (FontSize: 13, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center);
        }

        Label {
          Anchor: (Top: 68, Left: 14, Width: 372, Height: 40);
          Text: %server.tamework.ui.configEditor.applyConfirm.description;
          Style: (FontSize: 12, TextColor: #c2ccd6, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
        }

        Group {
          Anchor: (Top: 122, Left: 14, Width: 372, Height: 26);
          TextButton #TwConfigCancelApplyButton {
            Anchor: (Right: 96, Width: 84, Height: 24);
            Text: %server.tamework.ui.shared.button.cancel;
            Style: $A.@PanelButtonQuiet;
          }
          TextButton #TwConfigConfirmApplyButton {
            Anchor: (Right: 0, Width: 84, Height: 24);
            Text: %server.tamework.ui.shared.button.confirm;
            Style: $A.@PanelButtonPrimary;
          }
        }
      }
    }
  }
}

