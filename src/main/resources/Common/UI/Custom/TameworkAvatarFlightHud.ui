$C = "Common.ui";

@FlightControlSlotSize = 58;
@FlightControlSlotHeight = 74;
@FlightControlSlotGap = 6;
@FlightControlBindingStyle = (
    FontName: "Secondary",
    FontSize: 10,
    RenderBold: true,
    TextColor: #eaf7fb,
    Alignment: Center
);
@FlightControlBindingBackground = PatchStyle(
    TexturePath: "Tamework/AvatarFlightControls/InputBadge.png",
    Border: 8
);

Group #Root {
    Anchor: (Bottom: 178, Width: 178, Height: 70);
    Visible: false;

    Group #LaunchChargeGroup {
        Anchor: (Top: 0, Left: 0, Width: 178, Height: 12);
        Visible: false;

        Group #LaunchChargeTrack {
            Anchor: (Top: 0, Left: 12, Width: 154, Height: 10);
            Background: #203044(0.92);

            Group #LaunchChargeFill {
                Anchor: (Top: 1, Left: 1, Width: 0, Height: 8);
                Background: #ff9a4b;
            }

            Group #LaunchMinChargeMarker {
                Anchor: (Top: -2, Left: 0, Width: 2, Height: 12);
                Background: #ffd765;
                Visible: false;
            }
        }
    }

    Label #PitchLabel {
        Anchor: (Top: 18, Left: 0, Width: 178, Height: 12);
        Text: "0°";
        Style: (FontSize: 11, RenderBold: true, TextColor: #f2f6fb, HorizontalAlignment: Center, VerticalAlignment: Center);
        Visible: false;
    }

    Group #SpeedTrack {
        Anchor: (Top: 34, Left: 12, Width: 154, Height: 8);
        Background: #203044(0.92);

        Group #SpeedFill {
            Anchor: (Top: 1, Left: 1, Width: 0, Height: 6);
            Background: #6fcdf2;
        }

        Group #TargetSpeedMarker {
            Anchor: (Top: -1, Left: 0, Width: 2, Height: 10);
            Background: #f04444;
            Visible: false;
        }
    }

    Group #PipRow {
        Anchor: (Top: 50, Left: 16, Width: 145, Height: 10);
        LayoutMode: Left;

        Group #VigourPip0 {
            Anchor: (Width: 20, Height: 10);
            Background: #203044(0.92);
            Group #Fill { Anchor: (Top: 1, Left: 1, Width: 0, Height: 8); Background: #f1d36a; }
        }
        Group { Anchor: (Width: 5); }
        Group #VigourPip1 {
            Anchor: (Width: 20, Height: 10);
            Background: #203044(0.92);
            Group #Fill { Anchor: (Top: 1, Left: 1, Width: 0, Height: 8); Background: #f1d36a; }
        }
        Group { Anchor: (Width: 5); }
        Group #VigourPip2 {
            Anchor: (Width: 20, Height: 10);
            Background: #203044(0.92);
            Group #Fill { Anchor: (Top: 1, Left: 1, Width: 0, Height: 8); Background: #f1d36a; }
        }
        Group { Anchor: (Width: 5); }
        Group #VigourPip3 {
            Anchor: (Width: 20, Height: 10);
            Background: #203044(0.92);
            Group #Fill { Anchor: (Top: 1, Left: 1, Width: 0, Height: 8); Background: #f1d36a; }
        }
        Group { Anchor: (Width: 5); }
        Group #VigourPip4 {
            Anchor: (Width: 20, Height: 10);
            Background: #203044(0.92);
            Group #Fill { Anchor: (Top: 1, Left: 1, Width: 0, Height: 8); Background: #f1d36a; }
        }
        Group { Anchor: (Width: 5); }
        Group #VigourPip5 {
            Anchor: (Width: 20, Height: 10);
            Background: #203044(0.92);
            Group #Fill { Anchor: (Top: 1, Left: 1, Width: 0, Height: 8); Background: #f1d36a; }
        }
    }
}

// Self-contained controls use the same construction as the original working
// flight-control row, positioned over the lower-right native ability area.
Group #ControlsOverlay {
    Anchor: (Right: 50, Bottom: 40, Width: 250, Height: @FlightControlSlotHeight);
    LayoutMode: Left;
    Visible: false;

    Group #LaunchControl {
        Anchor: (Width: @FlightControlSlotSize, Height: @FlightControlSlotHeight);

        Group #LaunchFrame {
            Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
            Background: "Tamework/AvatarFlightControls/ControlFrame.png";

            Group #LaunchIcon {
                Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
                Background: "Tamework/AvatarFlightControls/Launch.png";
            }
        }

        Label #LaunchBinding {
            Anchor: (Top: 50, Left: 3, Width: 52, Height: 19);
            Background: @FlightControlBindingBackground;
            Text: "CROUCH";
            Style: @FlightControlBindingStyle;
        }
    }

    Group { Anchor: (Width: @FlightControlSlotGap); }

    Group #UpwardFlapControl {
        Anchor: (Width: @FlightControlSlotSize, Height: @FlightControlSlotHeight);

        Group #UpwardFlapFrame {
            Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
            Background: "Tamework/AvatarFlightControls/ControlFrame.png";

            Group #UpwardFlapIcon {
                Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
                Background: "Tamework/AvatarFlightControls/UpwardFlap.png";
            }
        }

        Label #UpwardFlapBinding {
            Anchor: (Top: 50, Left: 12, Width: 34, Height: 19);
            Background: @FlightControlBindingBackground;
            Text: "LMB";
            Style: @FlightControlBindingStyle;
        }
    }

    Group { Anchor: (Width: @FlightControlSlotGap); }

    Group #ForwardBoostControl {
        Anchor: (Width: @FlightControlSlotSize, Height: @FlightControlSlotHeight);

        Group #ForwardBoostFrame {
            Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
            Background: "Tamework/AvatarFlightControls/ControlFrame.png";

            Group #ForwardBoostIcon {
                Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
                Background: "Tamework/AvatarFlightControls/ForwardBoost.png";
            }
        }

        Label #ForwardBoostBinding {
            Anchor: (Top: 50, Left: 16, Width: 26, Height: 19);
            Background: @FlightControlBindingBackground;
            Text: "Q";
            Style: @FlightControlBindingStyle;
        }
    }

    Group { Anchor: (Width: @FlightControlSlotGap); }

    Group #AirbrakeControl {
        Anchor: (Width: @FlightControlSlotSize, Height: @FlightControlSlotHeight);

        Group #AirbrakeFrame {
            Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
            Background: "Tamework/AvatarFlightControls/ControlFrame.png";

            Group #AirbrakeIcon {
                Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
                Background: "Tamework/AvatarFlightControls/Airbrake.png";
            }
        }

        Label #AirbrakeBinding {
            Anchor: (Top: 50, Left: 12, Width: 34, Height: 19);
            Background: @FlightControlBindingBackground;
            Text: "RMB";
            Style: @FlightControlBindingStyle;
        }
    }
}
