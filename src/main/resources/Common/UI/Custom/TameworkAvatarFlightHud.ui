$A = "TameworkSlateStyles.ui";
$C = "Common.ui";

// Flight telemetry on a Slate HUD plate. AvatarFlightHudBinder sizes every fill and marker
// relative to its track, so the tracks keep their 154px width and 1px inset.
Group #Root {
    Anchor: (Bottom: 178, Width: 178, Height: 74);
    Background: $A.@SlateHud;
    Visible: false;

    Group #LaunchChargeGroup {
        Anchor: (Top: 10, Left: 0, Width: 178, Height: 12);
        Visible: false;

        Group #LaunchChargeTrack {
            Anchor: (Top: 0, Left: 12, Width: 154, Height: 10);
            Background: $A.@SlateTrack;

            Group #LaunchChargeFill {
                Anchor: (Top: 1, Left: 1, Width: 0, Height: 8);
                Background: #ff9a4b;
            }

            Group #LaunchMinChargeMarker {
                Anchor: (Top: -2, Left: 0, Width: 2, Height: 12);
                Background: #f2c66d;
                Visible: false;
            }
        }
    }

    Label #PitchLabel {
        Anchor: (Top: 24, Left: 0, Width: 178, Height: 12);
        Text: "0°";
        Style: (FontSize: 11, RenderBold: true, TextColor: #eef2f6, HorizontalAlignment: Center, VerticalAlignment: Center);
        Visible: false;
    }

    Group #SpeedTrack {
        Anchor: (Top: 40, Left: 12, Width: 154, Height: 8);
        Background: $A.@SlateTrack;

        Group #SpeedFill {
            Anchor: (Top: 1, Left: 1, Width: 0, Height: 6);
            Background: #6fcdf2;
        }

        Group #TargetSpeedMarker {
            Anchor: (Top: -1, Left: 0, Width: 2, Height: 10);
            Background: #e5786d;
            Visible: false;
        }
    }

    Group #PipRow {
        Anchor: (Top: 54, Left: 16, Width: 145, Height: 10);
        LayoutMode: Left;

        Group #VigourPip0 {
            Anchor: (Width: 20, Height: 10);
            Background: $A.@SlateTrack;
            Group #Fill { Anchor: (Top: 1, Left: 1, Width: 0, Height: 8); Background: #f2c66d; }
        }
        Group { Anchor: (Width: 5); }
        Group #VigourPip1 {
            Anchor: (Width: 20, Height: 10);
            Background: $A.@SlateTrack;
            Group #Fill { Anchor: (Top: 1, Left: 1, Width: 0, Height: 8); Background: #f2c66d; }
        }
        Group { Anchor: (Width: 5); }
        Group #VigourPip2 {
            Anchor: (Width: 20, Height: 10);
            Background: $A.@SlateTrack;
            Group #Fill { Anchor: (Top: 1, Left: 1, Width: 0, Height: 8); Background: #f2c66d; }
        }
        Group { Anchor: (Width: 5); }
        Group #VigourPip3 {
            Anchor: (Width: 20, Height: 10);
            Background: $A.@SlateTrack;
            Group #Fill { Anchor: (Top: 1, Left: 1, Width: 0, Height: 8); Background: #f2c66d; }
        }
        Group { Anchor: (Width: 5); }
        Group #VigourPip4 {
            Anchor: (Width: 20, Height: 10);
            Background: $A.@SlateTrack;
            Group #Fill { Anchor: (Top: 1, Left: 1, Width: 0, Height: 8); Background: #f2c66d; }
        }
        Group { Anchor: (Width: 5); }
        Group #VigourPip5 {
            Anchor: (Width: 20, Height: 10);
            Background: $A.@SlateTrack;
            Group #Fill { Anchor: (Top: 1, Left: 1, Width: 0, Height: 8); Background: #f2c66d; }
        }
    }
}
