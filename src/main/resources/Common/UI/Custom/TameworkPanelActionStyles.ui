$C = "Common.ui";
@IconLabel = LabelStyle(FontSize: 1, TextColor: #000000(0.0));
@Action = TextButtonStyle(Default: (Background: (TexturePath: "Tamework/PanelActions/Base_Default.png", Border: 3), LabelStyle: @IconLabel), Hovered: (Background: (TexturePath: "Tamework/PanelActions/Base_Hover.png", Border: 3), LabelStyle: @IconLabel), Pressed: (Background: (TexturePath: "Tamework/PanelActions/Base_Hover.png", Border: 3), LabelStyle: @IconLabel), Sounds: $C.@ButtonSounds);
@ActionDisabled = TextButtonStyle(Default: (Background: (TexturePath: "Tamework/PanelActions/Base_Default.png", Border: 3, Color: #ffffff(0.45)), LabelStyle: @IconLabel));
@Release = @Action;
@ReleaseDisabled = @ActionDisabled;
@Unlink = @Action;
@UnlinkDisabled = @ActionDisabled;
@Cull = @Action;
@CullDisabled = @ActionDisabled;
@Remove = @Action;
@RemoveDisabled = @ActionDisabled;
@FlightAirborne = @Action;
@FlightAirborneDisabled = @ActionDisabled;
@FlightGrounded = @Action;
@FlightGroundedDisabled = @ActionDisabled;
@ShoulderOn = @Action;
@ShoulderOnDisabled = @ActionDisabled;
@ShoulderOff = @Action;
@ShoulderOffDisabled = @ActionDisabled;
@ReturnHome = @Action;
@ReturnHomeDisabled = @ActionDisabled;
@SetHome = @Action;
@SetHomeDisabled = @ActionDisabled;
@Recall = @Action;
@RecallDisabled = @ActionDisabled;
@Locate = @Action;
@LocateDisabled = @ActionDisabled;
@BreedingOn = @Action;
@BreedingOnDisabled = @ActionDisabled;
@BreedingOff = @Action;
@BreedingOffDisabled = @ActionDisabled;
@Revive = @Action;
@ReviveDisabled = @ActionDisabled;
@Recover = @Action;
@RecoverDisabled = @ActionDisabled;

// Quiet panel fields use flat fills; raised frames identify action buttons.
@PanelDropdown = DropdownBoxStyle(
 ...$C.@DefaultDropdownBoxStyle,
 DefaultBackground: (Color: #252c27),
 HoveredBackground: (Color: #35423a),
 PressedBackground: (Color: #2d3831),
 PanelBackground: (TexturePath: "Tamework/PanelActions/Base_Default.png", Border: 3),
 LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, TextColor: #d6d9d0),
 EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #d6d9d0),
 SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #f0eee7),
 ArrowWidth: 10, ArrowHeight: 14
);

@PanelButtonLabel = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #e8e4da, Alignment: Center);
@PanelButton = TextButtonStyle(
 Default: (Background: (TexturePath: "Tamework/PanelActions/Base_Default.png", Border: 3), LabelStyle: @PanelButtonLabel),
 Hovered: (Background: (TexturePath: "Tamework/PanelActions/Base_Hover.png", Border: 3), LabelStyle: @PanelButtonLabel),
 Pressed: (Background: (TexturePath: "Tamework/PanelActions/Base_Hover.png", Border: 3), LabelStyle: @PanelButtonLabel),
 Sounds: $C.@ButtonSounds
);

@PanelButtonSelected = TextButtonStyle(Default: (Background: (TexturePath: "Tamework/PanelActions/Base_Hover.png", Border: 3), LabelStyle: @PanelButtonLabel), Hovered: (Background: (TexturePath: "Tamework/PanelActions/Base_Hover.png", Border: 3), LabelStyle: @PanelButtonLabel), Sounds: $C.@ButtonSounds);
@BackLabel = LabelStyle(FontSize: 20, RenderBold: true, TextColor: #e8e4da, Alignment: Center);
@Back = TextButtonStyle(Default: (Background: (TexturePath: "Tamework/PanelActions/Base_Default.png", Border: 3), LabelStyle: @BackLabel), Hovered: (Background: (TexturePath: "Tamework/PanelActions/Base_Hover.png", Border: 3), LabelStyle: @BackLabel), Pressed: (Background: (TexturePath: "Tamework/PanelActions/Base_Hover.png", Border: 3), LabelStyle: @BackLabel), Sounds: $C.@ButtonSounds);

// Text entry fields in this panel share the same quiet charcoal treatment as dropdowns.
// Keep the text and placeholder colors here so runtime-created filter fields can reuse it.
@PanelInputFieldStyle = InputFieldStyle(...$C.@DefaultInputFieldStyle, TextColor: #e8e4da);
@PanelInputFieldPlaceholderStyle = InputFieldStyle(...$C.@DefaultInputFieldPlaceholderStyle, TextColor: #8f9b92);

@PanelColorPicker = (...$C.@DefaultColorPickerDropdownBoxStyle, PanelBackground: (TexturePath: "Tamework/PanelActions/Base_Default.png", Border: 3));

// Group tags use quiet rows and reserve color for the small marker.
@GroupRowLabel = LabelStyle(FontSize: 12, TextColor: #d6d9d0, HorizontalAlignment: Start, VerticalAlignment: Center);
@GroupRow = TextButtonStyle(Default: (Background: (Color: #202923), LabelStyle: @GroupRowLabel), Hovered: (Background: (Color: #2d3831), LabelStyle: @GroupRowLabel), Pressed: (Background: (Color: #35423a), LabelStyle: @GroupRowLabel), Sounds: $C.@ButtonSounds);
@GroupRowSelected = TextButtonStyle(Default: (Background: (Color: #35423a), LabelStyle: (...@GroupRowLabel, TextColor: #f0eee7, RenderBold: true)), Hovered: (Background: (Color: #3e4d43), LabelStyle: @GroupRowLabel), Sounds: $C.@ButtonSounds);
@GroupDropdown = DropdownBoxStyle(...@PanelDropdown,
 DefaultBackground: (TexturePath: "Tamework/PanelActions/Base_Default.png", Border: 3),
 HoveredBackground: (TexturePath: "Tamework/PanelActions/Base_Hover.png", Border: 3),
 PressedBackground: (TexturePath: "Tamework/PanelActions/Base_Hover.png", Border: 3),
 HorizontalPadding: 6,
 LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, FontSize: 12, TextColor: #d6d9d0, RenderUppercase: false),
 EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, FontSize: 12, TextColor: #d6d9d0, RenderUppercase: false),
 SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, FontSize: 12, TextColor: #f0eee7, RenderUppercase: false),
 DefaultArrowTexturePath: "Tamework/PanelControls/GroupChevron.png", HoveredArrowTexturePath: "Tamework/PanelControls/GroupChevron.png", PressedArrowTexturePath: "Tamework/PanelControls/GroupChevron.png", ArrowWidth: 10, ArrowHeight: 6
);
