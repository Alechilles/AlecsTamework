@FlightControlSlotSize = 58;
@FlightControlSlotHeight = 74;
@FlightControlSlotGap = 6;
@FlightControlBindingStyle = (
    FontName: "Secondary",
    FontSize: 10,
    RenderBold: true,
    TextColor: #eaf7fb,
    Alignment: Center
);
@FlightControlBindingBackground = PatchStyle(
    TexturePath: "../Tamework/AvatarFlightControls/InputBadge.png",
    Border: 8
);

// Flightmaster's Talisman is tool-only, so Hytale hides its native weapon
// ability strip and this self-contained row supplies all flight controls.
Group #TameworkAvatarFlightControls {
    Anchor: (Right: 220, Bottom: 40, Width: 250, Height: @FlightControlSlotHeight);
    LayoutMode: Left;
    Visible: false;

    Group #LaunchControl {
        Anchor: (Width: @FlightControlSlotSize, Height: @FlightControlSlotHeight);

        Group #LaunchFrame {
            Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
            Background: "../Tamework/AvatarFlightControls/ControlFrame.png";

            Group #LaunchIcon {
                Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
                Background: "../Tamework/AvatarFlightControls/Launch.png";
            }
        }

        Label #LaunchBinding {
            Anchor: (Top: 50, Left: 3, Width: 52, Height: 19);
            Background: @FlightControlBindingBackground;
            Text: "CROUCH";
            Style: @FlightControlBindingStyle;
        }
    }

    Group { Anchor: (Width: @FlightControlSlotGap); }

    Group #ForwardBoostControl {
        Anchor: (Width: @FlightControlSlotSize, Height: @FlightControlSlotHeight);

        Group #ForwardBoostFrame {
            Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
            Background: "../Tamework/AvatarFlightControls/ControlFrame.png";

            Group #ForwardBoostIcon {
                Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
                Background: "../Tamework/AvatarFlightControls/ForwardBoost.png";
            }
        }

        Label #ForwardBoostBinding {
            Anchor: (Top: 50, Left: 16, Width: 26, Height: 19);
            Background: @FlightControlBindingBackground;
            Text: "Q";
            Style: @FlightControlBindingStyle;
        }
    }

    Group { Anchor: (Width: @FlightControlSlotGap); }

    Group #UpwardFlapControl {
        Anchor: (Width: @FlightControlSlotSize, Height: @FlightControlSlotHeight);

        Group #UpwardFlapFrame {
            Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
            Background: "../Tamework/AvatarFlightControls/ControlFrame.png";

            Group #UpwardFlapIcon {
                Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
                Background: "../Tamework/AvatarFlightControls/UpwardFlap.png";
            }
        }

        Label #UpwardFlapBinding {
            Anchor: (Top: 50, Left: 12, Width: 34, Height: 19);
            Background: @FlightControlBindingBackground;
            Text: "LMB";
            Style: @FlightControlBindingStyle;
        }
    }

    Group { Anchor: (Width: @FlightControlSlotGap); }

    Group #AirbrakeControl {
        Anchor: (Width: @FlightControlSlotSize, Height: @FlightControlSlotHeight);

        Group #AirbrakeFrame {
            Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
            Background: "../Tamework/AvatarFlightControls/ControlFrame.png";

            Group #AirbrakeIcon {
                Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
                Background: "../Tamework/AvatarFlightControls/Airbrake.png";
            }
        }

        Label #AirbrakeBinding {
            Anchor: (Top: 50, Left: 12, Width: 34, Height: 19);
            Background: @FlightControlBindingBackground;
            Text: "RMB";
            Style: @FlightControlBindingStyle;
        }
    }
}
