@FlightControlSlotSize = 58;
@FlightControlSlotHeight = 74;
@FlightControlBindingStyle = (
    FontName: "Secondary",
    FontSize: 10,
    RenderBold: true,
    TextColor: #eaf7fb,
    Alignment: Center
);
@FlightControlBindingBackground = PatchStyle(
    TexturePath: "../Tamework/AvatarFlightControls/InputBadge.png",
    Border: 8
);

// Flightmaster's Talisman is tool-only, so Hytale hides its native weapon
// ability strip and this self-contained cluster supplies all flight controls.
// Configured combat slots stack above flap and airbrake to keep movement keys contiguous.
Group #TameworkAvatarFlightControls {
    Anchor: (Right: 220, Bottom: 40, Width: 250, Height: 148);
    Visible: false;

    Group #Ability2Control {
        Anchor: (Top: 0, Left: 128, Width: @FlightControlSlotSize, Height: @FlightControlSlotHeight);
        Visible: false;

        Group #Ability2Frame {
            Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
            Background: "../Tamework/AvatarFlightControls/ControlFrame.png";

            Group #Ability2Glyph {
                Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
                Background: "../Tamework/AvatarFlightControls/Fireball.png";
                Visible: false;
            }

            Label #Ability2GlyphText {
                Anchor: (Top: 17, Left: 3, Width: 52, Height: 22);
                Text: "";
                Style: @FlightControlBindingStyle;
                Visible: false;
            }
        }

        Label #Ability2Binding {
            Anchor: (Top: 50, Left: 16, Width: 26, Height: 19);
            Background: @FlightControlBindingBackground;
            Text: "";
            Style: @FlightControlBindingStyle;
        }
    }

    Group #Ability3Control {
        Anchor: (Top: 0, Left: 192, Width: @FlightControlSlotSize, Height: @FlightControlSlotHeight);
        Visible: false;

        Group #Ability3Frame {
            Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
            Background: "../Tamework/AvatarFlightControls/ControlFrame.png";

            Group #Ability3Glyph {
                Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
                Background: "../Tamework/AvatarFlightControls/FireBreath.png";
                Visible: false;
            }

            Label #Ability3GlyphText {
                Anchor: (Top: 17, Left: 3, Width: 52, Height: 22);
                Text: "";
                Style: @FlightControlBindingStyle;
                Visible: false;
            }
        }

        Label #Ability3Binding {
            Anchor: (Top: 50, Left: 16, Width: 26, Height: 19);
            Background: @FlightControlBindingBackground;
            Text: "";
            Style: @FlightControlBindingStyle;
        }
    }

    Group #LaunchControl {
        Anchor: (Top: 74, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotHeight);

        Group #LaunchFrame {
            Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
            Background: "../Tamework/AvatarFlightControls/ControlFrame.png";

            Group #LaunchIcon {
                Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
                Background: "../Tamework/AvatarFlightControls/Launch.png";
            }
        }

        Label #LaunchBinding {
            Anchor: (Top: 50, Left: 3, Width: 52, Height: 19);
            Background: @FlightControlBindingBackground;
            Text: "CROUCH";
            Style: @FlightControlBindingStyle;
        }
    }

    Group #ForwardBoostControl {
        Anchor: (Top: 74, Left: 64, Width: @FlightControlSlotSize, Height: @FlightControlSlotHeight);

        Group #ForwardBoostFrame {
            Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
            Background: "../Tamework/AvatarFlightControls/ControlFrame.png";

            Group #ForwardBoostIcon {
                Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
                Background: "../Tamework/AvatarFlightControls/ForwardBoost.png";
            }
        }

        Label #ForwardBoostBinding {
            Anchor: (Top: 50, Left: 16, Width: 26, Height: 19);
            Background: @FlightControlBindingBackground;
            Text: "Q";
            Style: @FlightControlBindingStyle;
        }
    }

    Group #UpwardFlapControl {
        Anchor: (Top: 74, Left: 128, Width: @FlightControlSlotSize, Height: @FlightControlSlotHeight);

        Group #UpwardFlapFrame {
            Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
            Background: "../Tamework/AvatarFlightControls/ControlFrame.png";

            Group #UpwardFlapIcon {
                Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
                Background: "../Tamework/AvatarFlightControls/UpwardFlap.png";
            }
        }

        Label #UpwardFlapBinding {
            Anchor: (Top: 50, Left: 12, Width: 34, Height: 19);
            Background: @FlightControlBindingBackground;
            Text: "LMB";
            Style: @FlightControlBindingStyle;
        }
    }

    Group #AirbrakeControl {
        Anchor: (Top: 74, Left: 192, Width: @FlightControlSlotSize, Height: @FlightControlSlotHeight);

        Group #AirbrakeFrame {
            Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
            Background: "../Tamework/AvatarFlightControls/ControlFrame.png";

            Group #AirbrakeIcon {
                Anchor: (Top: 0, Left: 0, Width: @FlightControlSlotSize, Height: @FlightControlSlotSize);
                Background: "../Tamework/AvatarFlightControls/Airbrake.png";
            }
        }

        Label #AirbrakeBinding {
            Anchor: (Top: 50, Left: 12, Width: 34, Height: 19);
            Background: @FlightControlBindingBackground;
            Text: "RMB";
            Style: @FlightControlBindingStyle;
        }
    }
}
