@CommandHotswapSlotSize = 58;
@CommandHotswapSlotHeight = 74;
@CommandHotswapIconSize = 40;
// Slate pieces. This file sits in Hud/, so its texture paths climb one folder; the shared
// TameworkSlateStyles.ui paths are written for UI/Custom and are not imported here.
@CommandHotswapSlot = PatchStyle(TexturePath: "../Tamework/Slate/Button_Normal.png", Border: 8);
@CommandHotswapSlotPrimary = PatchStyle(TexturePath: "../Tamework/Slate/Button_Primary.png", Border: 8);
@CommandHotswapBindingStyle = (
    FontSize: 9,
    RenderBold: true,
    LetterSpacing: 1,
    TextColor: #eef2f6,
    Alignment: Center
);
@CommandHotswapFallbackStyle = (
    FontName: "Secondary",
    FontSize: 22,
    RenderBold: true,
    TextColor: #f3ead6,
    Alignment: Center
);

// Sits where the native weapon ability strip does, so a flute hotswap visually joins it.
// The left-click slot is the teal primary plate; the rest are plain Slate buttons.
Group #TameworkCommandHotswapControls {
    Anchor: (Right: 220, Bottom: 40, Width: 314, Height: 100);
    Visible: false;

    // Java tints the pill outline and the diamond with the group's colour.
    Group #CommandHotswapGroupStatus {
        Anchor: (Top: 0, Left: 55, Width: 204, Height: 24);
        Visible: false;
        Group #Accent { Anchor: (Full: 0); Background: (TexturePath: "../Tamework/Slate/PillDark.png", Border: 7, Color: #c8d1db); }
        Group #Dot { Anchor: (Top: 6, Left: 10, Width: 12, Height: 12); Background: (TexturePath: "../Tamework/PanelControls/GroupDiamond.png", Color: #c8d1db); }
        Label #Label {
            Anchor: (Top: 0, Left: 28, Right: 12, Height: 24);
            Text: "";
            Style: (FontSize: 11, RenderBold: true, TextColor: #eef2f6, HorizontalAlignment: Start, VerticalAlignment: Center);
        }
    }

    Group #CommandHotswapPrimaryControl {
        Anchor: (Top: 26, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotHeight);
        Visible: false;
        Group #Frame { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); Background: @CommandHotswapSlotPrimary; }
        Group #Icon { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); LayoutMode: Middle; Visible: false; Group #Glyph { Anchor: (Width: @CommandHotswapIconSize, Height: @CommandHotswapIconSize); Background: (TexturePath: "../Tamework/CommandHotswaps/Link.png", Color: #f3ead6); } }
        Label #FallbackGlyph { Anchor: (Top: 17, Left: 3, Width: 52, Height: 22); Text: ""; Style: @CommandHotswapFallbackStyle; Visible: false; }
        Label #Binding { Anchor: (Top: 50, Left: 12, Width: 34, Height: 18); Background: @CommandHotswapSlotPrimary; Text: "LMB"; Style: @CommandHotswapBindingStyle; }
    }

    Group #CommandHotswapSecondaryControl {
        Anchor: (Top: 26, Left: 64, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotHeight);
        Visible: false;
        Group #Frame { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); Background: @CommandHotswapSlot; }
        Group #Icon { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); LayoutMode: Middle; Visible: false; Group #Glyph { Anchor: (Width: @CommandHotswapIconSize, Height: @CommandHotswapIconSize); Background: (TexturePath: "../Tamework/CommandHotswaps/OpenMenu.png", Color: #f3ead6); } }
        Label #FallbackGlyph { Anchor: (Top: 17, Left: 3, Width: 52, Height: 22); Text: ""; Style: @CommandHotswapFallbackStyle; Visible: false; }
        Label #Binding { Anchor: (Top: 50, Left: 12, Width: 34, Height: 18); Background: @CommandHotswapSlot; Text: "RMB"; Style: @CommandHotswapBindingStyle; }
    }

    Group #CommandHotswapQControl {
        Anchor: (Top: 26, Left: 128, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotHeight);
        Visible: false;
        Group #Frame { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); Background: @CommandHotswapSlot; }
        Group #Icon { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); LayoutMode: Middle; Visible: false; Group #Glyph { Anchor: (Width: @CommandHotswapIconSize, Height: @CommandHotswapIconSize); Background: (TexturePath: "../Tamework/CommandHotswaps/Follow.png", Color: #f3ead6); } }
        Label #FallbackGlyph { Anchor: (Top: 17, Left: 3, Width: 52, Height: 22); Text: ""; Style: @CommandHotswapFallbackStyle; Visible: false; }
        Label #Binding { Anchor: (Top: 50, Left: 17, Width: 24, Height: 18); Background: @CommandHotswapSlot; Text: "Q"; Style: @CommandHotswapBindingStyle; }
    }

    Group #CommandHotswapEControl {
        Anchor: (Top: 26, Left: 192, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotHeight);
        Visible: false;
        Group #Frame { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); Background: @CommandHotswapSlot; }
        Group #Icon { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); LayoutMode: Middle; Visible: false; Group #Glyph { Anchor: (Width: @CommandHotswapIconSize, Height: @CommandHotswapIconSize); Background: (TexturePath: "../Tamework/CommandHotswaps/Follow.png", Color: #f3ead6); } }
        Label #FallbackGlyph { Anchor: (Top: 17, Left: 3, Width: 52, Height: 22); Text: ""; Style: @CommandHotswapFallbackStyle; Visible: false; }
        Label #Binding { Anchor: (Top: 50, Left: 17, Width: 24, Height: 18); Background: @CommandHotswapSlot; Text: "E"; Style: @CommandHotswapBindingStyle; }
    }

    Group #CommandHotswapRControl {
        Anchor: (Top: 26, Left: 256, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotHeight);
        Visible: false;
        Group #Frame { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); Background: @CommandHotswapSlot; }
        Group #Icon { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); LayoutMode: Middle; Visible: false; Group #Glyph { Anchor: (Width: @CommandHotswapIconSize, Height: @CommandHotswapIconSize); Background: (TexturePath: "../Tamework/CommandHotswaps/Follow.png", Color: #f3ead6); } }
        Label #FallbackGlyph { Anchor: (Top: 17, Left: 3, Width: 52, Height: 22); Text: ""; Style: @CommandHotswapFallbackStyle; Visible: false; }
        Label #Binding { Anchor: (Top: 50, Left: 17, Width: 24, Height: 18); Background: @CommandHotswapSlot; Text: "R"; Style: @CommandHotswapBindingStyle; }
    }
}
