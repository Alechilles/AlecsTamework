@CommandHotswapSlotSize = 58;
@CommandHotswapSlotHeight = 74;
@CommandHotswapIconSize = 40;
@CommandHotswapBindingStyle = (
    FontName: "Secondary",
    FontSize: 10,
    RenderBold: true,
    TextColor: #eaf7fb,
    Alignment: Center
);
@CommandHotswapBindingBackground = PatchStyle(
    TexturePath: "../Tamework/AvatarFlightControls/InputBadge.png",
    Border: 8
);
@CommandHotswapFallbackStyle = (
    FontName: "Secondary",
    FontSize: 22,
    RenderBold: true,
    TextColor: #edf5ff,
    Alignment: Center
);

// Uses the talisman's native-aligned ability frame and binding badge so a flute
// hotswap visually joins the regular weapon ability strip.
Group #TameworkCommandHotswapControls {
    Anchor: (Right: 220, Bottom: 40, Width: 314, Height: 100);
    Visible: false;

    Group #CommandHotswapGroupStatus {
        Anchor: (Top: 0, Left: 55, Width: 204, Height: 24);
        Background: #101a28(0.96);
        OutlineColor: #4d657a;
        OutlineSize: 1;
        Visible: false;
        Group #Accent { Anchor: (Top: 3, Left: 3, Width: 3, Height: 18); Background: #c8d1db; }
        Group #Dot { Anchor: (Top: 8, Left: 12, Width: 8, Height: 8); Background: #c8d1db; }
        Label #Label {
            Anchor: (Top: 2, Left: 28, Right: 6, Height: 20);
            Text: "";
            Style: (FontName: "Secondary", FontSize: 11, RenderBold: true, TextColor: #eff6fb, Alignment: Center);
        }
    }

    Group #CommandHotswapPrimaryControl {
        Anchor: (Top: 26, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotHeight);
        Visible: false;
        Group #Frame { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); Background: "../Tamework/AvatarFlightControls/ControlFrame.png"; }
        Group #Icon { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); LayoutMode: Middle; Visible: false; Group #Glyph { Anchor: (Width: @CommandHotswapIconSize, Height: @CommandHotswapIconSize); Background: "../Tamework/CommandHotswaps/Link.png"; } }
        Label #FallbackGlyph { Anchor: (Top: 17, Left: 3, Width: 52, Height: 22); Text: ""; Style: @CommandHotswapFallbackStyle; Visible: false; }
        Label #Binding { Anchor: (Top: 50, Left: 12, Width: 34, Height: 19); Background: @CommandHotswapBindingBackground; Text: "LMB"; Style: @CommandHotswapBindingStyle; }
    }

    Group #CommandHotswapSecondaryControl {
        Anchor: (Top: 26, Left: 64, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotHeight);
        Visible: false;
        Group #Frame { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); Background: "../Tamework/AvatarFlightControls/ControlFrame.png"; }
        Group #Icon { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); LayoutMode: Middle; Visible: false; Group #Glyph { Anchor: (Width: @CommandHotswapIconSize, Height: @CommandHotswapIconSize); Background: "../Tamework/CommandHotswaps/OpenMenu.png"; } }
        Label #FallbackGlyph { Anchor: (Top: 17, Left: 3, Width: 52, Height: 22); Text: ""; Style: @CommandHotswapFallbackStyle; Visible: false; }
        Label #Binding { Anchor: (Top: 50, Left: 12, Width: 34, Height: 19); Background: @CommandHotswapBindingBackground; Text: "RMB"; Style: @CommandHotswapBindingStyle; }
    }

    Group #CommandHotswapQControl {
        Anchor: (Top: 26, Left: 128, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotHeight);
        Visible: false;
        Group #Frame { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); Background: "../Tamework/AvatarFlightControls/ControlFrame.png"; }
        Group #Icon { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); LayoutMode: Middle; Visible: false; Group #Glyph { Anchor: (Width: @CommandHotswapIconSize, Height: @CommandHotswapIconSize); Background: "../Tamework/CommandHotswaps/Follow.png"; } }
        Label #FallbackGlyph { Anchor: (Top: 17, Left: 3, Width: 52, Height: 22); Text: ""; Style: @CommandHotswapFallbackStyle; Visible: false; }
        Label #Binding { Anchor: (Top: 50, Left: 16, Width: 26, Height: 19); Background: @CommandHotswapBindingBackground; Text: "Q"; Style: @CommandHotswapBindingStyle; }
    }

    Group #CommandHotswapEControl {
        Anchor: (Top: 26, Left: 192, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotHeight);
        Visible: false;
        Group #Frame { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); Background: "../Tamework/AvatarFlightControls/ControlFrame.png"; }
        Group #Icon { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); LayoutMode: Middle; Visible: false; Group #Glyph { Anchor: (Width: @CommandHotswapIconSize, Height: @CommandHotswapIconSize); Background: "../Tamework/CommandHotswaps/Follow.png"; } }
        Label #FallbackGlyph { Anchor: (Top: 17, Left: 3, Width: 52, Height: 22); Text: ""; Style: @CommandHotswapFallbackStyle; Visible: false; }
        Label #Binding { Anchor: (Top: 50, Left: 16, Width: 26, Height: 19); Background: @CommandHotswapBindingBackground; Text: "E"; Style: @CommandHotswapBindingStyle; }
    }

    Group #CommandHotswapRControl {
        Anchor: (Top: 26, Left: 256, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotHeight);
        Visible: false;
        Group #Frame { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); Background: "../Tamework/AvatarFlightControls/ControlFrame.png"; }
        Group #Icon { Anchor: (Top: 0, Left: 0, Width: @CommandHotswapSlotSize, Height: @CommandHotswapSlotSize); LayoutMode: Middle; Visible: false; Group #Glyph { Anchor: (Width: @CommandHotswapIconSize, Height: @CommandHotswapIconSize); Background: "../Tamework/CommandHotswaps/Follow.png"; } }
        Label #FallbackGlyph { Anchor: (Top: 17, Left: 3, Width: 52, Height: 22); Text: ""; Style: @CommandHotswapFallbackStyle; Visible: false; }
        Label #Binding { Anchor: (Top: 50, Left: 16, Width: 26, Height: 19); Background: @CommandHotswapBindingBackground; Text: "R"; Style: @CommandHotswapBindingStyle; }
    }
}
