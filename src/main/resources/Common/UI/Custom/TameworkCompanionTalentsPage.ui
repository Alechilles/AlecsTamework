          Label #TalentStatus5 { Anchor: (Top: 48, Left: 10, Right: 150, Height: 14); Text: "Status"; Style: (FontSize: 11, TextColor: #9fc2dd, HorizontalAlignment: Start, VerticalAlignment: Center); }
          $C.@SmallSecondaryTextButton #TalentBuyButton5 { @Sounds = $C.@ButtonSounds; @Text = %server.tamework.ui.talents.button.unlock; @Anchor = (Top: 18, Right: 10, Width: 128, Height: 30); Visible: false; }
        }

        Group #TalentRow6 { @Anchor = (Height: 68, Bottom: 8); @Background = #0a121b(0.96); Visible: false;
          Label #TalentName6 { Anchor: (Top: 6, Left: 10, Right: 150, Height: 18); Text: "Talent"; Style: (FontSize: 15, TextColor: #e4efff, HorizontalAlignment: Start, VerticalAlignment: Center, RenderBold: true); }
          Label #TalentDescription6 { Anchor: (Top: 28, Left: 10, Right: 150, Height: 16); Text: "Description"; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); }
          Label #TalentStatus6 { Anchor: (Top: 48, Left: 10, Right: 150, Height: 14); Text: "Status"; Style: (FontSize: 11, TextColor: #9fc2dd, HorizontalAlignment: Start, VerticalAlignment: Center); }
          $C.@SmallSecondaryTextButton #TalentBuyButton6 { @Sounds = $C.@ButtonSounds; @Text = %server.tamework.ui.talents.button.unlock; @Anchor = (Top: 18, Right: 10, Width: 128, Height: 30); Visible: false; }
        }

        Group #TalentRow7 { @Anchor = (Height: 68, Bottom: 8); @Background = #0a121b(0.96); Visible: false;
          Label #TalentName7 { Anchor: (Top: 6, Left: 10, Right: 150, Height: 18); Text: "Talent"; Style: (FontSize: 15, TextColor: #e4efff, HorizontalAlignment: Start, VerticalAlignment: Center, RenderBold: true); }
          Label #TalentDescription7 { Anchor: (Top: 28, Left: 10, Right: 150, Height: 16); Text: "Description"; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); }
          Label #TalentStatus7 { Anchor: (Top: 48, Left: 10, Right: 150, Height: 14); Text: "Status"; Style: (FontSize: 11, TextColor: #9fc2dd, HorizontalAlignment: Start, VerticalAlignment: Center); }
          $C.@SmallSecondaryTextButton #TalentBuyButton7 { @Sounds = $C.@ButtonSounds; @Text = %server.tamework.ui.talents.button.unlock; @Anchor = (Top: 18, Right: 10, Width: 128, Height: 30); Visible: false; }
        }
      }
    }
  }
