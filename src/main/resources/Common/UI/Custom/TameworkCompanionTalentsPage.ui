        }

        Group #TalentRow5 { @Anchor = (Height: 68, Bottom: 8); @Background = #0a121b(0.96); Visible: false;
          Label #TalentName5 { Anchor: (Top: 6, Left: 10, Right: 150, Height: 18); Text: "Talent"; Style: (FontSize: 15, TextColor: #e4efff, HorizontalAlignment: Start, VerticalAlignment: Center, RenderBold: true); }
