$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer #TameworkCompanionTalentsRoot {
    Anchor: (Width: 1120, Height: 720);

    #Title {
      $C.@Title #TameworkCompanionTalentsTitle {
        @Text = %server.tamework.ui.talents.title;
      }
    }

    #Content {
      LayoutMode: Top;

      Group #TameworkCompanionTalentsHeader {
        Anchor: (Height: 78, Bottom: 10);

        Label #TameworkCompanionTalentsLevelSummary {
          Anchor: (Top: 0, Left: 0, Width: 340, Height: 24);
          Text: "Level 1";
          Style: (FontSize: 16, TextColor: #dbe7f7, HorizontalAlignment: Start, VerticalAlignment: Center);
        }

        Label #TameworkCompanionTalentsPointsSummary {
          Anchor: (Top: 26, Left: 0, Width: 340, Height: 22);
          Text: "Talent Points: 0 available";
          Style: (FontSize: 14, TextColor: #9fc2dd, HorizontalAlignment: Start, VerticalAlignment: Center);
        }

        Label #TameworkCompanionTalentsStatus {
          Anchor: (Top: 50, Left: 0, Right: 310, Height: 22);
          Text: "";
          Style: (FontSize: 13, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
        }

        Group #TameworkCompanionTalentsButtons {
          Anchor: (Top: 8, Right: 0, Width: 288, Height: 32);
          LayoutMode: Right;

          $C.@SmallSecondaryTextButton #TameworkCompanionTalentsBackButton {
            @Sounds = $C.@ButtonSounds;
            @Text = %server.tamework.ui.talents.button.back;
            @Anchor = (MinWidth: 128);
          }

          Group {
            Anchor: (Width: 12);
          }

          $C.@SmallSecondaryTextButton #TameworkCompanionTalentsResetButton {
            @Sounds = $C.@ButtonSounds;
            @Text = %server.tamework.ui.talents.button.reset;
            @Anchor = (MinWidth: 132);
            Visible: false;
          }
        }
      }

      Group #TameworkCompanionTalentsBody {
        Anchor: (Height: 580);

        Group #TalentTreeViewport {
          Anchor: (Top: 0, Left: 0, Width: 820, Height: 560);
          Background: #07111c(0.72);
          KeepScrollPosition: true;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Left: 0, Right: 4, Top: 0, Bottom: 4);
          LayoutMode: TopScrolling;

          Group #TalentTreeCanvas {
            Anchor: (Width: 820, Height: 560);

            Group #TalentConnectorLayer {
              Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
            }

            Group #TalentBranchLayer {
              Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
            }

            Group #TalentNodeLayer {
              Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
            }
          }
        }

        Group #TalentTreePanControls {
          Anchor: (Top: 522, Left: 10, Width: 92, Height: 30);
          LayoutMode: Left;
          Visible: false;

          $C.@SmallSecondaryTextButton #TalentTreePanLeftButton {
            @Sounds = $C.@ButtonSounds;
            @Text = "<";
            @Anchor = (Width: 40, Height: 28);
            Visible: false;
          }

          Group {
            Anchor: (Width: 8);
          }

          $C.@SmallSecondaryTextButton #TalentTreePanRightButton {
            @Sounds = $C.@ButtonSounds;
            @Text = ">";
            @Anchor = (Width: 40, Height: 28);
            Visible: false;
          }
        }

        Group #TalentDetailPanel {
          Anchor: (Top: 0, Right: 0, Width: 260, Height: 560);
          Background: #0a121b(0.96);
          Padding: 14;

          Label #TalentDetailEmpty {
            Anchor: (Top: 18, Left: 12, Right: 12, Height: 64);
            Text: "Choose a talent node.";
            Style: (FontSize: 15, TextColor: #bfd0e5, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true);
          }

          Group #TalentDetailContent {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
            Visible: false;

            Label #TalentDetailName {
              Anchor: (Top: 2, Left: 0, Right: 0, Height: 48);
              Text: "Talent";
              Style: (FontSize: 18, RenderBold: true, TextColor: #f0f6ff, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
            }

            Label #TalentDetailBranch {
              Anchor: (Top: 54, Left: 0, Right: 0, Height: 20);
              Text: "Branch - Tier 1";
              Style: (FontSize: 12, TextColor: #9fc2dd, HorizontalAlignment: Start, VerticalAlignment: Center);
            }

            Label #TalentDetailStatus {
              Anchor: (Top: 80, Left: 0, Right: 0, Height: 36);
              Text: "Locked";
              Style: (FontSize: 13, TextColor: #e4efff, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
            }

            Label #TalentDetailDescription {
              Anchor: (Top: 126, Left: 0, Right: 0, Height: 96);
              Text: "Description";
              Style: (FontSize: 13, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
            }

            Label #TalentDetailRequirementsLabel {
              Anchor: (Top: 238, Left: 0, Right: 0, Height: 18);
              Text: "Requirements";
              Style: (FontSize: 12, RenderBold: true, TextColor: #dbe7f7, HorizontalAlignment: Start, VerticalAlignment: Center);
            }

            Label #TalentDetailRequirements {
              Anchor: (Top: 260, Left: 0, Right: 0, Height: 42);
              Text: "Level 1";
              Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
            }

            Label #TalentDetailEffectsLabel {
              Anchor: (Top: 318, Left: 0, Right: 0, Height: 18);
              Text: "Effects";
              Style: (FontSize: 12, RenderBold: true, TextColor: #dbe7f7, HorizontalAlignment: Start, VerticalAlignment: Center);
            }

            Label #TalentDetailEffects {
              Anchor: (Top: 340, Left: 0, Right: 0, Height: 116);
              Text: "No passive effects";
              Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
            }

            $C.@SmallSecondaryTextButton #TalentDetailUnlockButton {
              @Sounds = $C.@ButtonSounds;
              @Text = %server.tamework.ui.talents.button.unlock;
              @Anchor = (Left: 0, Right: 0, Bottom: 8, Height: 34);
              Visible: false;
            }
          }
        }
      }
    }
  }
}
