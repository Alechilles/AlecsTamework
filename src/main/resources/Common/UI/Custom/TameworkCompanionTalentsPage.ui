$A = "TameworkSlateStyles.ui";
$C = "Common.ui";

@TalentSmallCaps = LabelStyle(FontSize: 9, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center);
@TalentPointsPillLabel = LabelStyle(FontSize: 9, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #f2c66d, HorizontalAlignment: Center, VerticalAlignment: Center);
// The detail status line takes one of these from TameworkCompanionTalentsPage by the selected talent's state.
@TalentDetailStatusAvailable = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #eef2f6, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
@TalentDetailStatusPurchased = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #5fe0c0, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
@TalentDetailStatusUnaffordable = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #f0b45a, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
@TalentDetailStatusLocked = LabelStyle(FontSize: 12, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);

$C.@PageOverlay {
  LayoutMode: Middle;

  // Java resizes this root to fit the tree, so the frame is a stretchable plate with its 48 px header band baked in.
  Group #TameworkCompanionTalentsRoot {
    Anchor: (Width: 1120, Height: 720);
    Background: $A.@SlateWindowHeader48;

    Group #Title {
      Anchor: (Top: 3, Left: 3, Right: 3, Height: 45);

      Group #TameworkCompanionTalentsBadge { Anchor: (Top: 5, Left: 19, Width: 34, Height: 34); Background: "Tamework/Slate/Badge.png"; HitTestVisible: false; }

      Label #TameworkCompanionTalentsTitle {
        Anchor: (Left: 63, Right: 330, Height: 45);
        Text: %server.tamework.ui.talents.title;
        Style: $A.@SlateTitle;
      }

      Group #TameworkCompanionTalentsButtons {
        Anchor: (Top: 8, Right: 11, Width: 288, Height: 30);
        LayoutMode: Right;

        TextButton #TameworkCompanionTalentsBackButton {
          Anchor: (Width: 128, Height: 30);
          Text: %server.tamework.ui.talents.button.back;
          Style: $A.@PanelButton;
        }

        Group { Anchor: (Width: 8); }

        TextButton #TameworkCompanionTalentsResetButton {
          Anchor: (Width: 132, Height: 30);
          Text: %server.tamework.ui.talents.button.reset;
          Style: $A.@PanelButtonQuiet;
          Visible: false;
        }
      }
    }


    Group #Content {
      Anchor: (Top: 56, Left: 12, Right: 12, Bottom: 12);

      Group #TameworkCompanionTalentsHeader {
        Anchor: (Top: 0, Left: 0, Right: 0, Height: 78);
        Padding: (Left: 14, Right: 14, Top: 6, Bottom: 6);

        Label #TameworkCompanionTalentsLevelSummary {
          Anchor: (Top: 0, Left: 0, Width: 480, Height: 24);
          Text: "";
          Style: (FontSize: 16, FontName: "Secondary", TextColor: #eef2f6, HorizontalAlignment: Start, VerticalAlignment: Center);
        }

        Group #TameworkCompanionTalentsPointsPill {
          Anchor: (Top: 27, Left: 0, Width: 280, Height: 20);
          Background: (TexturePath: "Tamework/Slate/Pill.png", Border: 7, Color: #f2c66d);

          Label #TameworkCompanionTalentsPointsSummary {
            Anchor: (Top: 0, Left: 8, Right: 8, Height: 20);
            Text: "";
            Style: @TalentPointsPillLabel;
          }
        }

        Label #TameworkCompanionTalentsStatus {
          Anchor: (Top: 48, Left: 0, Width: 480, Height: 20);
          Text: "";
          Style: (FontSize: 12, TextColor: #8794a4, HorizontalAlignment: Start, VerticalAlignment: Center);
        }

        Group #TalentTreePanControls {
          Anchor: (Top: 38, Left: 500, Width: 112, Height: 28);
          LayoutMode: Left;
          Visible: false;

          TextButton #TalentTreePanLeftButton {
            Anchor: (Width: 30, Height: 28);
            Text: "<";
            Style: $A.@PanelButtonQuiet;
            Visible: false;
          }

          Label #TalentTreePanLabel {
            Anchor: (Width: 52, Height: 28);
            Text: %server.tamework.ui.talents.pan.label;
            Style: (...@TalentSmallCaps, HorizontalAlignment: Center);
          }

          TextButton #TalentTreePanRightButton {
            Anchor: (Width: 30, Height: 28);
            Text: ">";
            Style: $A.@PanelButtonQuiet;
            Visible: false;
          }
        }
      }

      Group #TameworkCompanionTalentsBody {
        Anchor: (Top: 88, Left: 0, Right: 0, Bottom: 0);

        Group #TalentTreeViewport {
          Anchor: (Top: 0, Left: 0, Width: 820, Bottom: 0);
          Background: $A.@SlateTray;
          KeepScrollPosition: true;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);
          LayoutMode: TopScrolling;

          Group #TalentTreeCanvas {
            Anchor: (Width: 820, Height: 560);

            Group #TalentConnectorLayer { Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0); }
            Group #TalentBranchLayer { Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0); }
            Group #TalentNodeLayer { Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0); }
          }
        }

        Group #TalentDetailPanel {
          Anchor: (Top: 0, Right: 0, Width: 260, Bottom: 0);
          Background: $A.@SlateTray;
          Padding: 14;

          Label #TalentDetailEmpty {
            Anchor: (Top: 18, Left: 12, Right: 12, Height: 64);
            Text: %server.tamework.ui.talents.detail.empty;
            Style: (FontSize: 13, TextColor: #8794a4, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true);
          }

          Group #TalentDetailContent {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
            Visible: false;

            Label #TalentDetailName {
              Anchor: (Top: 0, Left: 0, Right: 0, Height: 48);
              Text: "";
              Style: (FontSize: 18, FontName: "Secondary", TextColor: #eef2f6, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
            }

            Label #TalentDetailBranch {
              Anchor: (Top: 52, Left: 0, Right: 0, Height: 18);
              Text: "";
              Style: (...@TalentSmallCaps, TextColor: #5fe0c0);
            }

            Label #TalentDetailStatus {
              Anchor: (Top: 78, Left: 0, Right: 0, Height: 34);
              Text: %server.tamework.ui.talents.state.Locked;
              Style: @TalentDetailStatusLocked;
            }

            Group { Anchor: (Top: 116, Left: 0, Right: 0, Height: 1); Background: #ffffff(0.08); }

            Label #TalentDetailDescription {
              Anchor: (Top: 126, Left: 0, Right: 0, Height: 96);
              Text: "";
              Style: (FontSize: 12, TextColor: #c2ccd6, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
            }

            Label #TalentDetailRequirementsLabel {
              Anchor: (Top: 238, Left: 0, Right: 0, Height: 18);
              Text: %server.tamework.ui.talents.detail.requirements;
              Style: @TalentSmallCaps;
            }

            Label #TalentDetailRequirements {
              Anchor: (Top: 260, Left: 0, Right: 0, Height: 42);
              Text: "";
              Style: (FontSize: 12, TextColor: #eef2f6, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
            }

            Label #TalentDetailEffectsLabel {
              Anchor: (Top: 318, Left: 0, Right: 0, Height: 18);
              Text: %server.tamework.ui.talents.detail.effects;
              Style: @TalentSmallCaps;
            }

            Label #TalentDetailEffects {
              Anchor: (Top: 340, Left: 0, Right: 0, Height: 116);
              Text: %server.tamework.ui.talents.effects.none;
              Style: (FontSize: 12, TextColor: #c2ccd6, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
            }

            TextButton #TalentDetailUnlockButton {
              Anchor: (Left: 0, Right: 0, Bottom: 8, Height: 34);
              Text: %server.tamework.ui.talents.button.unlock;
              Style: $A.@PanelButtonPrimary;
              Visible: false;
            }
          }
        }
      }
    }
  }
}
