          Label #TalentStatus1 { Anchor: (Top: 48, Left: 10, Right: 150, Height: 14); Text: "Status"; Style: (FontSize: 11, TextColor: #9fc2dd, HorizontalAlignment: Start, VerticalAlignment: Center); }
          $C.@SmallSecondaryTextButton #TalentBuyButton1 { @Sounds = $C.@ButtonSounds; @Text = %server.tamework.ui.talents.button.unlock; @Anchor = (Top: 18, Right: 10, Width: 128, Height: 30); Visible: false; }
        }

