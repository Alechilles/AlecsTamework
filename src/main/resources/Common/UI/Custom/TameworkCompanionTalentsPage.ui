          $C.@SmallSecondaryTextButton #TalentBuyButton3 { @Sounds = $C.@ButtonSounds; @Text = %server.tamework.ui.talents.button.unlock; @Anchor = (Top: 18, Right: 10, Width: 128, Height: 30); Visible: false; }
        }

        Group #TalentRow4 { @Anchor = (Height: 68, Bottom: 8); @Background = #0a121b(0.96); Visible: false;
          Label #TalentName4 { Anchor: (Top: 6, Left: 10, Right: 150, Height: 18); Text: "Talent"; Style: (FontSize: 15, TextColor: #e4efff, HorizontalAlignment: Start, VerticalAlignment: Center, RenderBold: true); }
