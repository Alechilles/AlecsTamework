          Label #TalentName2 { Anchor: (Top: 6, Left: 10, Right: 150, Height: 18); Text: "Talent"; Style: (FontSize: 15, TextColor: #e4efff, HorizontalAlignment: Start, VerticalAlignment: Center, RenderBold: true); }
