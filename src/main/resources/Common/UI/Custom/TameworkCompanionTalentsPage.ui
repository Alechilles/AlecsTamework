          Label #TalentStatus4 { Anchor: (Top: 48, Left: 10, Right: 150, Height: 14); Text: "Status"; Style: (FontSize: 11, TextColor: #9fc2dd, HorizontalAlignment: Start, VerticalAlignment: Center); }
