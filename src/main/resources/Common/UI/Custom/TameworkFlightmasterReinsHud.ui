@NativeHudWidth = 329;
@NativeHudHeight = 107;
@IconMaskColor = #142431;
@BindingStyle = (
    FontName: "Secondary",
    FontSize: 10,
    RenderBold: true,
    TextColor: #eaf7fb,
    Alignment: Center
);
@BindingBackground = PatchStyle(
    TexturePath: "Tamework/AvatarFlightControls/InputBadge.png",
    Border: 8
);

// The base client hardcodes sword artwork in these three ability wells. This
// item HUD replaces only those glyphs so the native frames and state UI remain.
Group #Root {
    Anchor: (Right: 50, Bottom: 40, Width: @NativeHudWidth, Height: @NativeHudHeight);

    Group #ForwardBoostControl {
        Anchor: (Left: 68, Top: 23, Width: 50, Height: 54);
        Background: @IconMaskColor;

        Group #Icon {
            Anchor: (Left: -1, Top: 1, Width: 52, Height: 52);
            Background: "Tamework/AvatarFlightControls/ForwardBoost.png";
        }
    }

    Group #UpwardFlapControl {
        Anchor: (Left: 168, Top: 28, Width: 40, Height: 44);
        Background: @IconMaskColor;

        Group #Icon {
            Anchor: (Left: -1, Top: 1, Width: 42, Height: 42);
            Background: "Tamework/AvatarFlightControls/UpwardFlap.png";
        }
    }

    Group #AirbrakeControl {
        Anchor: (Left: 254, Top: 28, Width: 40, Height: 44);
        Background: @IconMaskColor;

        Group #Icon {
            Anchor: (Left: -1, Top: 1, Width: 42, Height: 42);
            Background: "Tamework/AvatarFlightControls/Airbrake.png";
        }
    }

    Group #LaunchControl {
        Anchor: (Left: -36, Top: 20, Width: 58, Height: 78);

        Group #Frame {
            Anchor: (Left: 0, Top: 0, Width: 58, Height: 58);
            Background: "Tamework/AvatarFlightControls/ControlFrame.png";

            Group #Icon {
                Anchor: (Left: 0, Top: 0, Width: 58, Height: 58);
                Background: "Tamework/AvatarFlightControls/Launch.png";
            }
        }

        Label #Binding {
            Anchor: (Left: 3, Top: 55, Width: 52, Height: 19);
            Background: @BindingBackground;
            Text: "CROUCH";
            Style: @BindingStyle;
        }
    }
}
