$A = "TameworkPanelActionStyles.ui";
$C = "Common.ui";

@LinkedActiveStateButtonLabelStyle = LabelStyle(FontSize: 1, TextColor: #000000(0.0));
@LinkedActiveStateOnButtonStyle = TextButtonStyle(Default: (Background: (TexturePath: "Tamework/LinkedPanelToggleActive_On_Default.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Hovered: (Background: (TexturePath: "Tamework/LinkedPanelToggleActive_On_Hover.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Pressed: (Background: (TexturePath: "Tamework/LinkedPanelToggleActive_On_Pressed.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Disabled: (Background: (TexturePath: "Tamework/LinkedPanelToggleActive_On_Disabled.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Sounds: $C.@ButtonSounds);
@LinkedActiveStateOffButtonStyle = TextButtonStyle(Default: (Background: (TexturePath: "Tamework/LinkedPanelToggleActive_Off_Default.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Hovered: (Background: (TexturePath: "Tamework/LinkedPanelToggleActive_Off_Hover.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Pressed: (Background: (TexturePath: "Tamework/LinkedPanelToggleActive_Off_Pressed.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Disabled: (Background: (TexturePath: "Tamework/LinkedPanelToggleActive_Off_Disabled.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Sounds: $C.@ButtonSounds);
@LinkedActionTooltipStyle = $C.@DefaultTextTooltipStyle;
@LinkedProgressionTooltipStyle = $C.@DefaultTextTooltipStyle;
@TraitTooltipLabelStyle = LabelStyle(FontSize: 1, TextColor: #000000(0.0));
@TraitTooltipButtonStyle = TextButtonStyle(Default: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle), Hovered: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle), Pressed: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle), Disabled: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle));
@ActionCaptionStyle = LabelStyle(FontSize: 11, TextColor: #b7c9d8, HorizontalAlignment: Center, VerticalAlignment: Center);

Group {
    Anchor: (Top: 3, Left: 0, Right: 0, Height: 164);
    Background: #102333;
    OutlineColor: #2b465d;
    OutlineSize: 1;
    Padding: (Left: 10, Right: 10, Top: 8, Bottom: 8);

    Group { Anchor: (Top: -8, Left: -10, Right: -10, Height: 36); Background: #152c3e; HitTestVisible: false; }

    Group #GroupTab {
        Anchor: (Top: 8, Left: -10, Width: 5, Height: 112);
        Background: #4b657f;
