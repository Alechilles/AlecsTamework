                Anchor: (Top: 3, Left: 3, Width: 18, Height: 18);
                Background: #081220;
            }

            Group #NeedIconImage {
                Anchor: (Top: 6, Left: 6, Width: 12, Height: 12);
                Background: (TexturePath: "Tamework/LinkedPanelIcons/Need_Thirst.png");
                Visible: false;
            }

            Label #NeedIcon {
                Anchor: (Top: 4, Left: 4, Width: 16, Height: 16);
                Text: "W";
                Style: (FontSize: 10, RenderBold: true, TextColor: #deebff, HorizontalAlignment: Center, VerticalAlignment: Center);
            }

            TextButton #NeedTooltip {
                Anchor: (Top: 0, Left: 0, Width: 24, Height: 24);
                Style: @TraitTooltipButtonStyle;
                Text: "";
                TooltipText: "Thirst";
                TextTooltipStyle: @LinkedActionTooltipStyle;
            }
        }

        Group {
            Anchor: (Width: 6);
        }

        Group #BreedingCooldown {
            Anchor: (Width: 24, Height: 24);
            Visible: false;

            Group #RingTrackTopLeft {
                Anchor: (Top: 0, Left: 0, Width: 12, Height: 3);
                Background: #23354a;
            }

            Group #RingTrackTopRight {
                Anchor: (Top: 0, Left: 12, Width: 12, Height: 3);
                Background: #23354a;
            }

            Group #RingTrackLeft {
                Anchor: (Top: 0, Left: 0, Width: 3, Height: 24);
                Background: #23354a;
            }

            Group #RingTrackBottom {
                Anchor: (Top: 21, Left: 0, Width: 24, Height: 3);
                Background: #23354a;
            }

            Group #RingTrackRight {
                Anchor: (Top: 0, Left: 21, Width: 3, Height: 24);
                Background: #23354a;
            }

            Group #RingFillBar1 {
                Anchor: (Top: 0, Left: 0, Width: 12, Height: 3);
                Background: #f6d56b;
            }

            Group #RingFillBar2 {
                Anchor: (Top: 0, Left: 0, Width: 3, Height: 24);
                Background: #f6d56b;
            }

            Group #RingFillBar3 {
                Anchor: (Top: 21, Left: 0, Width: 24, Height: 3);
                Background: #f6d56b;
            }

            Group #RingFillBar4 {
                Anchor: (Top: 0, Left: 21, Width: 3, Height: 24);
                Background: #f6d56b;
            }

            Group #RingFillBar5 {
                Anchor: (Top: 0, Left: 12, Width: 12, Height: 3);
                Background: #f6d56b;
            }

            Group #CornerMaskOverlay {
                Anchor: (Top: 0, Left: 0, Width: 24, Height: 24);
                Background: (TexturePath: "Tamework/LinkedPanelIcons/Corner_Mask_24.png");
            }

            Group {
                Anchor: (Top: 3, Left: 3, Width: 18, Height: 18);
                Background: #081220;
            }

            Label #BreedingCooldownIcon {
                Anchor: (Top: 4, Left: 4, Width: 16, Height: 16);
                Text: "B";
                Style: (FontSize: 10, RenderBold: true, TextColor: #deebff, HorizontalAlignment: Center, VerticalAlignment: Center);
            }

            TextButton #BreedingCooldownTooltip {
                Anchor: (Top: 0, Left: 0, Width: 24, Height: 24);
                Style: @TraitTooltipButtonStyle;
                Text: "";
                TooltipText: "Breeding cooldown";
                TextTooltipStyle: @LinkedActionTooltipStyle;
            }
        }
    }

    Group #FutureStatAFrame {
        Anchor: (Top: 124, Left: 0, Width: 360, Height: 10);
        Background: #0a121b(0.95);
        Visible: false;

        Group #FutureStatAFill {
            Anchor: (Left: 1, Top: 1, Width: 358, Height: 8);
            Background: #7cc6f2;
        }

        Label #FutureStatAText {
            Anchor: (Top: -16, Left: 0, Width: 360, Height: 14);
            Text: "Stat A: ?/?";
            Style: (FontSize: 10, TextColor: #9fc2dd, HorizontalAlignment: Start, VerticalAlignment: Center);
        }
    }

    Group #FutureStatBFrame {
        Anchor: (Top: 138, Left: 0, Width: 360, Height: 10);
        Background: #0a121b(0.95);
        Visible: false;

        Group #FutureStatBFill {
            Anchor: (Left: 1, Top: 1, Width: 358, Height: 8);
            Background: #f2c97c;
        }

        Label #FutureStatBText {
            Anchor: (Top: -16, Left: 0, Width: 360, Height: 14);
            Text: "Stat B: ?/?";
            Style: (FontSize: 10, TextColor: #9fc2dd, HorizontalAlignment: Start, VerticalAlignment: Center);
        }
    }

    Group #FutureActionBar {
        Anchor: (Top: 152, Left: 0, Width: 360, Height: 24);
        LayoutMode: Left;
        Visible: false;

        TextButton #TraitsButton {
            Anchor: (Left: 0, Width: 108, Height: 22);
            Text: "Traits";
            Visible: false;
        }

        TextButton #TalentsButton {
            Anchor: (Left: 6, Width: 108, Height: 22);
