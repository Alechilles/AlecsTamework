$A = "TameworkSlateStyles.ui";
$C = "Common.ui";

@LinkedActiveStateButtonLabelStyle = LabelStyle(FontSize: 16, RenderBold: true, TextColor: #eafff8, Alignment: Center);
@LinkedActionTooltipStyle = $C.@DefaultTextTooltipStyle;
@LinkedProgressionTooltipStyle = $C.@DefaultTextTooltipStyle;
@TraitTooltipLabelStyle = LabelStyle(FontSize: 1, TextColor: #000000(0.0));
@TraitTooltipButtonStyle = TextButtonStyle(Default: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle), Hovered: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle), Pressed: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle), Disabled: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle));
@LinkedActiveStateOnButtonStyle = $A.@SwitchOn;
@LinkedActiveStateOffButtonStyle = $A.@SwitchOff;
@StatePillLabel = LabelStyle(FontSize: 9, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #eef2f6, HorizontalAlignment: Center, VerticalAlignment: Center);
@ActionCaptionStyle = LabelStyle(FontSize: 10, TextColor: #c2ccd6, HorizontalAlignment: Center, VerticalAlignment: Center);

@HealthTextNormal = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center);
@HealthTextMuted = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #aab4bf, HorizontalAlignment: Center, VerticalAlignment: Center);
@HealthTextShadowNormal = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #06080b, HorizontalAlignment: Center, VerticalAlignment: Center);
@HealthTextShadowMuted = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #06080b, HorizontalAlignment: Center, VerticalAlignment: Center);
@NeedValueNormal = LabelStyle(FontSize: 9, TextColor: #c2ccd6, HorizontalAlignment: End, VerticalAlignment: Center);
@NeedValueMuted = LabelStyle(FontSize: 9, TextColor: #6b7480, HorizontalAlignment: End, VerticalAlignment: Center);
@CooldownTextNormal = LabelStyle(FontSize: 9, TextColor: #c2ccd6);
@CooldownLabelNormal = LabelStyle(FontSize: 9, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #8794a4);
@CooldownTextMuted = LabelStyle(FontSize: 9, TextColor: #6b7480);
@LifecycleAdultLabel = LabelStyle(FontSize: 9, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #78bfc1);
@LifecyclePrimeLabel = LabelStyle(FontSize: 9, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #f2c66d);
@LifecycleSeniorLabel = LabelStyle(FontSize: 9, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #f0b45a);
@InlineRecallCountdown = LabelStyle(FontSize: 9, RenderBold: true, TextColor: #ffcf6e, Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center);
@RecallCountdown = LabelStyle(FontSize: 10, RenderBold: true, TextColor: #ffcf6e, HorizontalAlignment: Center, VerticalAlignment: Center);
@StatusStripLabelDead = LabelStyle(FontSize: 10, RenderBold: true, TextColor: #f3aa9d, VerticalAlignment: Center);
@StatusStripLabelReady = LabelStyle(FontSize: 10, RenderBold: true, TextColor: #5fe0c0, VerticalAlignment: Center);
@StatusStripLabelLost = LabelStyle(FontSize: 10, RenderBold: true, TextColor: #f0b45a, VerticalAlignment: Center);
@StatusStripLabelMuted = LabelStyle(FontSize: 10, RenderBold: true, TextColor: #8794a4, VerticalAlignment: Center);
@StatusStripPrimary = LabelStyle(FontSize: 17, RenderBold: true, TextColor: #eef2f6, VerticalAlignment: Center);
@StatusStripPrimaryMuted = LabelStyle(FontSize: 18, RenderBold: true, TextColor: #aab4bf, VerticalAlignment: Center);
@RosterCaption = LabelStyle(FontSize: 10, RenderBold: true, TextColor: #8794a4, VerticalAlignment: Center);
@RosterStatus = LabelStyle(FontSize: 11, RenderBold: true, TextColor: #eef2f6, VerticalAlignment: Center);
@RosterCapacity = LabelStyle(FontSize: 10, TextColor: #8794a4, VerticalAlignment: Center);
@RosterCapacityFull = LabelStyle(FontSize: 10, RenderBold: true, TextColor: #f0b45a, VerticalAlignment: Center);
@PortraitStyle = ItemGridStyle(SlotSize: 92, SlotSpacing: 0, SlotIconSize: 92);
@PortraitCompactStyle = ItemGridStyle(SlotSize: 48, SlotSpacing: 0, SlotIconSize: 48);

Group {
    Anchor: (Top: 3, Left: 0, Right: 0, Height: 176);
    Padding: (Left: 10, Right: 10, Top: 8, Bottom: 8);

    // Off-atlas pictures (Common/Tamework/UI/Slate, drawn at 2x by the TameworkUiKit repo). The plate and the portrait
    // frame take their AssetPath from LinkedNpcPanelCardBinder by state; negative anchors make the plate cover the padding.
    AssetImage #SlatePlate { Anchor: (Top: -8, Left: -10, Right: -10, Bottom: -8); AssetPath: "Tamework/UI/Slate/card_world.png"; FallbackTexturePath: "UI/Custom/Tamework/Slate/Clear.png"; HitTestVisible: false; }
    AssetImage #SlateSelected { Anchor: (Top: -8, Left: -10, Right: -10, Bottom: -8); AssetPath: "Tamework/UI/Slate/card_selected.png"; FallbackTexturePath: "UI/Custom/Tamework/Slate/Clear.png"; HitTestVisible: false; Visible: false; }
    AssetImage #PortraitFrame { Anchor: (Top: 28, Left: 2, Width: 142, Height: 104); AssetPath: "Tamework/UI/Slate/portrait_world.png"; FallbackTexturePath: "UI/Custom/Tamework/Slate/Clear.png"; HitTestVisible: false; }

    TextField #CardTarget { Visible: false; MaxLength: 36; }

    ItemGrid #Portrait { Anchor: (Top: 34, Left: 27, Width: 92, Height: 92); SlotsPerRow: 1; RenderItemQualityBackground: false; DisplayItemQuantity: false; InfoDisplay: None; Style: @PortraitStyle; HitTestVisible: false; Visible: false; }
    Group #ContributorPortraitStars { Anchor: (Top: 33, Left: 59, Width: 80, Height: 16); HitTestVisible: false; Visible: false;
      Group #ContributorStar1 { Anchor: (Top: 0, Right: 0, Width: 16, Height: 16); Background: (TexturePath: "Tamework/PanelControls/Quality_Star.png", Color: #f2c66d); HitTestVisible: false; Visible: false; }
      Group #ContributorStar2 { Anchor: (Top: 0, Right: 16, Width: 16, Height: 16); Background: (TexturePath: "Tamework/PanelControls/Quality_Star.png", Color: #f2c66d); HitTestVisible: false; Visible: false; }
      Group #ContributorStar3 { Anchor: (Top: 0, Right: 32, Width: 16, Height: 16); Background: (TexturePath: "Tamework/PanelControls/Quality_Star.png", Color: #f2c66d); HitTestVisible: false; Visible: false; }
      Group #ContributorStar4 { Anchor: (Top: 0, Right: 48, Width: 16, Height: 16); Background: (TexturePath: "Tamework/PanelControls/Quality_Star.png", Color: #f2c66d); HitTestVisible: false; Visible: false; }
      Group #ContributorStar5 { Anchor: (Top: 0, Right: 64, Width: 16, Height: 16); Background: (TexturePath: "Tamework/PanelControls/Quality_Star.png", Color: #f2c66d); HitTestVisible: false; Visible: false; }
    }
    TextButton #ActiveToggleActiveButton { Anchor: (Top: 2, Right: 36, Width: 42, Height: 22); Style: @LinkedActiveStateOnButtonStyle; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.activeEnabled; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
    TextButton #ActiveToggleInactiveButton { Anchor: (Top: 2, Right: 36, Width: 42, Height: 22); Style: @LinkedActiveStateOffButtonStyle; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.activeDisabled; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
    Group #GenderMaleIcon { Anchor: (Top: 1, Left: 0, Width: 22, Height: 22); Background: (TexturePath: "Tamework/LinkedPanelIcons/Gender_Male.png", Color: #58c9f0); Visible: false; }
    Group #GenderFemaleIcon { Anchor: (Top: 1, Left: 0, Width: 22, Height: 22); Background: (TexturePath: "Tamework/LinkedPanelIcons/Gender_Female.png", Color: #ff86bb); Visible: false; }
    Label #Name { Anchor: (Top: 0, Left: 28, Right: 366, Height: 24); Text: %server.tamework.ui.linkedPanel.subtitle.defaultNpcName; Style: (FontSize: 17, FontName: "Secondary", TextColor: #eef2f6, HorizontalAlignment: Start, VerticalAlignment: Center); }
    Label #RoleSubtitle { Anchor: (Top: 3, Right: 180, Width: 180, Height: 20); Text: ""; Style: (FontSize: 11, TextColor: #8794a4, HorizontalAlignment: End, VerticalAlignment: Center); Visible: false; }
    // The state pill: LinkedNpcPanelCardBinder tints the outline and sets the word.
    Group #StatePill { Anchor: (Top: 4, Right: 86, Width: 88, Height: 18); Background: (TexturePath: "Tamework/Slate/Pill.png", Border: 7, Color: #8fa2b8); HitTestVisible: false; Visible: false;
      Label #StatePillText { Anchor: (Top: 0, Left: 4, Right: 4, Height: 18); Text: ""; Style: @StatePillLabel; }
    }
    Label #StatusUnloaded { Anchor: (Top: 68, Left: 0, Width: 148, Height: 18); Text: %server.tamework.ui.linkedPanel.status.unloaded; Style: (FontSize: 10, RenderBold: true, TextColor: #ffe5b4, HorizontalAlignment: Center, VerticalAlignment: Center); Visible: false; }
    Group #StatusEmblem { Anchor: (Top: 10, Left: 707, Width: 56, Height: 56); Background: "Tamework/StatusEmblems/Unloaded.png"; HitTestVisible: false; Visible: false; }
    // Dead/lost status strip for generic cards; drawn before the actions so the Revive/Recover button sits on top.
    Group #StatusStrip { Anchor: (Top: 36, Left: 432, Width: 414, Height: 64); Background: #6b4141; HitTestVisible: false; Visible: false;
        Group #Fill { Anchor: (Top: 1, Left: 1, Right: 1, Bottom: 1); Background: #2c2224; }
        Group #Icon { Anchor: (Top: 14, Left: 14, Width: 36, Height: 36); Background: (TexturePath: "Tamework/StatusEmblems/Dead.png", Color: #f5e5c1); }
        Group #Text { Anchor: (Top: 9, Left: 62, Width: 280, Height: 36);
            Label #State { Anchor: (Top: 0, Left: 0, Right: 0, Height: 14); Text: ""; Style: @StatusStripLabelDead; }
            Label #Primary { Anchor: (Top: 14, Left: 0, Right: 0, Height: 22); Text: ""; Style: @StatusStripPrimary; }
        }
        Group #Bar { Anchor: (Top: 50, Left: 62, Width: 280, Height: 4); Background: #0a0e13;
            Group #BarFill { Anchor: (Top: 0, Left: 0, Width: 0, Height: 4); Background: #c97a6e; }
        }
    }
    TextButton #RemoveButton { Anchor: (Top: 0, Right: 0, Width: 28, Height: 26); Style: $A.@Remove; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.removalMenu; TextTooltipStyle: @LinkedActionTooltipStyle; }
    Group #RemoveButtonGlyph { Anchor: (Top: 1, Right: 2, Width: 24, Height: 24); Background: (TexturePath: "Tamework/PanelActions/Remove_Glyph_Default.png", Color: #f2877b); Visible: true; HitTestVisible: false; }

    DropdownBox #GroupSelector { Anchor: (Top: 135, Left: 2, Width: 142, Height: 24); Style: $A.@CompanionGroupDropdown; ShowLabel: false; MaxSelection: 0; NoItemsText: %server.tamework.ui.linkedPanel.groupAssign.none; Visible: false; }
    Label #GroupSelectorLabel { Anchor: (Top: 135, Left: 28, Width: 94, Height: 24); Text: ""; Style: (FontSize: 12, TextColor: #c2ccd6, VerticalAlignment: Center); HitTestVisible: false; Visible: false; }
    Group #GroupSelectorMarker { Anchor: (Top: 141, Left: 10, Width: 12, Height: 12); Background: (TexturePath: "Tamework/PanelControls/GroupDiamondOutline.png", Color: #ffffff); HitTestVisible: false; Visible: false; }
    Group #TraitStrip {
        // Traits share the progression row immediately above the health bar.
        Anchor: (Top: 34, Left: 170, Width: 136, Height: 30);
        LayoutMode: Left;
        Group #TraitSlot0 {
            Anchor: (Width: 34, Height: 30); Visible: false;
            Group { Anchor: (Top: 0, Left: 2, Width: 28, Height: 30); Background: $A.@SlateQuiet; }
            Group #TraitBarTrack { Anchor: (Top: 24, Left: 6, Width: 20, Height: 3); Background: #0a0e13; }
            Group #RingFillBar1 { Anchor: (Top: 24, Left: 6, Width: 0, Height: 3); Background: #5fe0c0; }
            Group #TraitIconImage { Anchor: (Top: 3, Left: 6, Width: 20, Height: 20); Background: (TexturePath: "Tamework/LinkedPanelIcons/Trait_Disposition.png", Color: #f7ecd0); Visible: false; }
            Label #TraitIcon { Anchor: (Top: 1, Left: 4, Width: 24, Height: 22); Text: ""; Style: (FontSize: 16, TextColor: #eef2f6, HorizontalAlignment: Center, VerticalAlignment: Center); }
            TextButton #TraitTooltip { Anchor: (Top: 0, Left: 0, Width: 34, Height: 30); Style: @TraitTooltipButtonStyle; Text: ""; TextTooltipStyle: @LinkedActionTooltipStyle; }
        }
        Group #TraitSlot1 {
            Anchor: (Width: 34, Height: 30); Visible: false;
            Group { Anchor: (Top: 0, Left: 2, Width: 28, Height: 30); Background: $A.@SlateQuiet; }
            Group #TraitBarTrack { Anchor: (Top: 24, Left: 6, Width: 20, Height: 3); Background: #0a0e13; }
            Group #RingFillBar1 { Anchor: (Top: 24, Left: 6, Width: 0, Height: 3); Background: #5fe0c0; }
            Group #TraitIconImage { Anchor: (Top: 3, Left: 6, Width: 20, Height: 20); Background: (TexturePath: "Tamework/LinkedPanelIcons/Trait_Disposition.png", Color: #f7ecd0); Visible: false; }
            Label #TraitIcon { Anchor: (Top: 1, Left: 4, Width: 24, Height: 22); Text: ""; Style: (FontSize: 16, TextColor: #eef2f6, HorizontalAlignment: Center, VerticalAlignment: Center); }
            TextButton #TraitTooltip { Anchor: (Top: 0, Left: 0, Width: 34, Height: 30); Style: @TraitTooltipButtonStyle; Text: ""; TextTooltipStyle: @LinkedActionTooltipStyle; }
        }
        Group #TraitSlot2 {
            Anchor: (Width: 34, Height: 30); Visible: false;
            Group { Anchor: (Top: 0, Left: 2, Width: 28, Height: 30); Background: $A.@SlateQuiet; }
            Group #TraitBarTrack { Anchor: (Top: 24, Left: 6, Width: 20, Height: 3); Background: #0a0e13; }
            Group #RingFillBar1 { Anchor: (Top: 24, Left: 6, Width: 0, Height: 3); Background: #5fe0c0; }
            Group #TraitIconImage { Anchor: (Top: 3, Left: 6, Width: 20, Height: 20); Background: (TexturePath: "Tamework/LinkedPanelIcons/Trait_Disposition.png", Color: #f7ecd0); Visible: false; }
            Label #TraitIcon { Anchor: (Top: 1, Left: 4, Width: 24, Height: 22); Text: ""; Style: (FontSize: 16, TextColor: #eef2f6, HorizontalAlignment: Center, VerticalAlignment: Center); }
            TextButton #TraitTooltip { Anchor: (Top: 0, Left: 0, Width: 34, Height: 30); Style: @TraitTooltipButtonStyle; Text: ""; TextTooltipStyle: @LinkedActionTooltipStyle; }
        }
        Group #TraitSlot3 {
            Anchor: (Width: 34, Height: 30); Visible: false;
            Group { Anchor: (Top: 0, Left: 2, Width: 28, Height: 30); Background: $A.@SlateQuiet; }
            Group #TraitBarTrack { Anchor: (Top: 24, Left: 6, Width: 20, Height: 3); Background: #0a0e13; }
            Group #RingFillBar1 { Anchor: (Top: 24, Left: 6, Width: 0, Height: 3); Background: #5fe0c0; }
            Group #TraitIconImage { Anchor: (Top: 3, Left: 6, Width: 20, Height: 20); Background: (TexturePath: "Tamework/LinkedPanelIcons/Trait_Disposition.png", Color: #f7ecd0); Visible: false; }
            Label #TraitIcon { Anchor: (Top: 1, Left: 4, Width: 24, Height: 22); Text: ""; Style: (FontSize: 16, TextColor: #eef2f6, HorizontalAlignment: Center, VerticalAlignment: Center); }
            TextButton #TraitTooltip { Anchor: (Top: 0, Left: 0, Width: 34, Height: 30); Style: @TraitTooltipButtonStyle; Text: ""; TextTooltipStyle: @LinkedActionTooltipStyle; }
        }
    }
    Label #StatusConfirm { Anchor: (Top: 30, Left: 432, Width: 414, Height: 16); Text: %server.tamework.ui.linkedPanel.card.confirmRemove; Style: (FontSize: 11, RenderBold: true, TextColor: #ffd3d3, HorizontalAlignment: Start, VerticalAlignment: Center); Visible: false; }
    Label #StatusInactive { Anchor: (Top: 43, Left: 48, Width: 96, Height: 18); Text: %server.tamework.ui.linkedPanel.card.inactive; Style: (FontSize: 10, RenderBold: true, TextColor: #ffbd9a, HorizontalAlignment: Start, VerticalAlignment: Center); Visible: false; }
    Label #RecallCountdown { Anchor: (Top: 72, Left: 568, Width: 270, Height: 20); Text: %server.tamework.ui.linkedPanel.card.recallCountdown.default; Style: (FontSize: 10, RenderBold: true, TextColor: #ffcf6e, HorizontalAlignment: Center, VerticalAlignment: Center); Visible: false; }
    Group #InlineLocation { Anchor: (Top: 32, Left: 432, Width: 414, Height: 74); Visible: false;
        Label #Heading { Anchor: (Top: 0, Left: 0, Right: 0, Height: 16); Text: ""; Style: (FontSize: 10, RenderBold: true, TextColor: #8794a4, VerticalAlignment: Center); }
        // Two lines tall: a long container description wraps instead of being cut off.
        Label #Status { Anchor: (Top: 14, Left: 0, Right: 0, Height: 28); Text: ""; Style: (FontSize: 11, RenderBold: true, TextColor: #eef2f6, VerticalAlignment: Start, Wrap: true); Visible: false; }
        Label #World { Anchor: (Top: 36, Left: 0, Right: 0, Height: 18); Text: ""; Style: (FontSize: 11, TextColor: #8794a4, VerticalAlignment: Center); Visible: false; }
        TextField #Coordinates { Anchor: (Top: 58, Left: 0, Right: 0, Height: 26); Style: $A.@PanelInputFieldStyle; PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle; Background: $A.@SlateQuiet; Padding: (Horizontal: 8); Value: ""; MaxLength: 96; Visible: false; }
        Label #CoordinateLabel { Anchor: (Top: 74, Left: 0, Width: 380, Height: 26); Text: ""; Style: (FontSize: 12, TextColor: #eef2f6, VerticalAlignment: Center); Visible: false; }
        TextButton #CopyButton { Anchor: (Top: 74, Right: 0, Width: 28, Height: 26); Text: ""; Style: $A.@ActionQuiet; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
        Group #CopyGlyph { Anchor: (Top: 78, Right: 5, Width: 18, Height: 18); HitTestVisible: false; Visible: false; Background: (TexturePath: "Tamework/PanelActions/Copy_Glyph_Default.png", Color: #f2e8cd); }
        Label #CopyHint { Anchor: (Top: 101, Left: 0, Right: 34, Height: 13); Text: ""; Style: (FontSize: 9, TextColor: #8794a4); Visible: false; }
        Label #RelativeDistance { Anchor: (Top: 100, Left: 0, Right: 0, Height: 14); Text: ""; Style: (FontSize: 11, TextColor: #8794a4, VerticalAlignment: Center); Visible: false; }
    }
    TextButton #LinkButton { Anchor: (Top: 98, Left: 746, Width: 100, Height: 26); Style: $A.@PanelButton; Padding: (Horizontal: 4); Text: %server.tamework.ui.linkedPanel.card.button.link; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.link; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }

    TextButton #ShoulderRideButton { Anchor: (Top: 36, Right: 424, Width: 42, Height: 42); Style: $A.@ShoulderOff; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.bonded.shoulder.toMe.tooltip; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
    Group #ShoulderRideButtonGlyph { Anchor: (Top: 36, Right: 424, Width: 42, Height: 42); Background: (TexturePath: "Tamework/PanelActions/ShoulderOff_Glyph_Default.png", Color: #f9edd5); Visible: false; HitTestVisible: false; }
    Label #ShoulderRideButtonCaption { Anchor: (Top: 80, Right: 413, Width: 64, Height: 16); Text: %server.tamework.ui.linkedPanel.action.shoulderOff; Style: @ActionCaptionStyle; Visible: false; }
    TextButton #FlightToggleButton { Anchor: (Top: 36, Right: 358, Width: 42, Height: 42); Style: $A.@FlightGrounded; Text: ""; TooltipText: ""; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
    Group #FlightToggleButtonGlyph { Anchor: (Top: 36, Right: 358, Width: 42, Height: 42); Background: (TexturePath: "Tamework/PanelActions/FlightGrounded_Glyph_Default.png", Color: #f8ecd4); Visible: false; HitTestVisible: false; }
    Label #FlightToggleButtonCaption { Anchor: (Top: 80, Right: 347, Width: 64, Height: 16); Text: %server.tamework.ui.linkedPanel.action.flightGrounded; Style: @ActionCaptionStyle; Visible: false; }
    TextButton #BreedingToggleEnabledButton { Anchor: (Top: 36, Right: 292, Width: 42, Height: 42); Style: $A.@BreedingOn; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.breedingEnabled; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
    Group #BreedingToggleEnabledButtonGlyph { Anchor: (Top: 36, Right: 292, Width: 42, Height: 42); Background: (TexturePath: "Tamework/PanelActions/BreedingOn_Glyph_Default.png", Color: #f9edd5); Visible: false; HitTestVisible: false; }
    Label #BreedingToggleEnabledButtonCaption { Anchor: (Top: 80, Right: 281, Width: 64, Height: 16); Text: %server.tamework.ui.linkedPanel.action.breedingOn; Style: @ActionCaptionStyle; Visible: false; }
    TextButton #BreedingToggleDisabledButton { Anchor: (Top: 36, Right: 292, Width: 42, Height: 42); Style: $A.@BreedingOff; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.breedingDisabled; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
    Group #BreedingToggleDisabledButtonGlyph { Anchor: (Top: 36, Right: 292, Width: 42, Height: 42); Background: (TexturePath: "Tamework/PanelActions/BreedingOff_Glyph_Default.png", Color: #f9edd5); Visible: false; HitTestVisible: false; }
    Label #BreedingToggleDisabledButtonCaption { Anchor: (Top: 80, Right: 281, Width: 64, Height: 16); Text: %server.tamework.ui.linkedPanel.action.breedingOff; Style: @ActionCaptionStyle; Visible: false; }
    TextButton #LocateButton { Anchor: (Top: 36, Right: 226, Width: 42, Height: 42); Style: $A.@Locate; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.locate; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
    Group #LocateButtonGlyph { Anchor: (Top: 36, Right: 226, Width: 42, Height: 42); Background: (TexturePath: "Tamework/PanelActions/Locate_Glyph_Default.png", Color: #f8ecd4); Visible: false; HitTestVisible: false; }
    Label #LocateButtonCaption { Anchor: (Top: 80, Right: 215, Width: 64, Height: 16); Text: %server.tamework.ui.linkedPanel.action.locate; Style: @ActionCaptionStyle; Visible: false; }
    TextButton #RecallButton { Anchor: (Top: 36, Right: 160, Width: 42, Height: 42); Style: $A.@Recall; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.recall; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
    Group #RecallButtonGlyph { Anchor: (Top: 36, Right: 160, Width: 42, Height: 42); Background: (TexturePath: "Tamework/PanelActions/Recall_Glyph_Default.png", Color: #f9edd5); Visible: false; HitTestVisible: false; }
    Label #RecallButtonCaption { Anchor: (Top: 80, Right: 149, Width: 64, Height: 16); Text: %server.tamework.ui.linkedPanel.action.recall; Style: @ActionCaptionStyle; Visible: false; }
    TextButton #SetHomeButton { Anchor: (Top: 36, Right: 94, Width: 42, Height: 42); Style: $A.@SetHome; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.setHome; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
    Group #SetHomeButtonGlyph { Anchor: (Top: 36, Right: 94, Width: 42, Height: 42); Background: (TexturePath: "Tamework/PanelActions/SetHome_Glyph_Default.png", Color: #f9edd5); Visible: false; HitTestVisible: false; }
    Label #SetHomeButtonCaption { Anchor: (Top: 80, Right: 83, Width: 64, Height: 16); Text: %server.tamework.ui.linkedPanel.action.setHome; Style: @ActionCaptionStyle; Visible: false; }
    TextButton #ReturnHomeButton { Anchor: (Top: 36, Right: 28, Width: 42, Height: 42); Style: $A.@ReturnHome; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.returnHome; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
    Group #ReturnHomeButtonGlyph { Anchor: (Top: 36, Right: 28, Width: 42, Height: 42); Background: (TexturePath: "Tamework/PanelActions/ReturnHome_Glyph_Default.png", Color: #f9edd5); Visible: false; HitTestVisible: false; }
    Label #ReturnHomeButtonCaption { Anchor: (Top: 80, Right: 17, Width: 64, Height: 16); Text: %server.tamework.ui.linkedPanel.action.returnHome; Style: @ActionCaptionStyle; Visible: false; }
    TextButton #ReleaseButton { Anchor: (Top: 36, Right: 424, Width: 42, Height: 42); Style: $A.@Release; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.release; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
    Group #ReleaseButtonGlyph { Anchor: (Top: 36, Right: 424, Width: 42, Height: 42); Background: (TexturePath: "Tamework/PanelActions/Release_Glyph_Default.png", Color: #f9edd5); Visible: false; HitTestVisible: false; }
