    Label #StatusConfirm {
        Anchor: (Top: 30, Right: 18, Width: 118, Height: 18);
        Text: "CONFIRM REMOVE";
        Style: (FontSize: 10, RenderBold: true, TextColor: #ffd3d3, HorizontalAlignment: Center, VerticalAlignment: Center);
        Visible: false;
    }

    Label #StatusInactive {
        Anchor: (Top: 30, Right: 34, Width: 74, Height: 18);
        Text: "INACTIVE";
        Style: (FontSize: 10, RenderBold: true, TextColor: #ffbd9a, HorizontalAlignment: Center, VerticalAlignment: Center);
        Visible: false;
    }

    TextButton #LinkButton {
        Anchor: (Top: 56, Right: 0, Width: 64, Height: 22);
        Style: (...$C.@SmallSecondaryTextButtonStyle, Sounds: $C.@ButtonSounds);
        Padding: (Horizontal: 8);
        Text: "Link";
        TooltipText: "Link companion";
        TextTooltipStyle: @LinkedActionTooltipStyle;
        Visible: false;
    }

    TextButton #ReleaseButton {
        Anchor: (Top: 56, Right: 66, Width: 72, Height: 22);
        Style: (...$C.@SmallSecondaryTextButtonStyle, Sounds: $C.@ButtonSounds);
        Padding: (Horizontal: 4);
        Text: "Release";
        TooltipText: "Animal will be released to the wild and disappear permanently.";
        TextTooltipStyle: @LinkedActionTooltipStyle;
        Visible: false;
    }

    TextButton #CullButton {
        Anchor: (Top: 56, Right: 0, Width: 62, Height: 22);
        Style: (...$C.@SmallSecondaryTextButtonStyle, Sounds: $C.@ButtonSounds);
        Padding: (Horizontal: 4);
        Text: "Cull";
        TooltipText: "Animal will be slaughtered and cannot be revived.";
        TextTooltipStyle: @LinkedActionTooltipStyle;
        Visible: false;
    }

    TextButton #ActiveToggleActiveButton {
        Anchor: (Top: 4, Left: 0, Width: 14, Height: 14);
        Style: @LinkedActiveStateOnButtonStyle;
        Text: "";
        TooltipText: "Active: receives bulk commands. Click to set inactive.";
        TextTooltipStyle: @LinkedActionTooltipStyle;
        Visible: false;
    }

    TextButton #ActiveToggleInactiveButton {
        Anchor: (Top: 4, Left: 0, Width: 14, Height: 14);
        Style: @LinkedActiveStateOffButtonStyle;
        Text: "";
        TooltipText: "Inactive: ignored by bulk commands. Click to set active.";
        TextTooltipStyle: @LinkedActionTooltipStyle;
        Visible: false;
    }

    TextButton #BreedingToggleEnabledButton {
        Anchor: (Top: 30, Left: 210, Width: 14, Height: 14);
