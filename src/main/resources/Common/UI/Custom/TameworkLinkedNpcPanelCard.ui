        Label #Status { Anchor: (Top: 18, Left: 0, Right: 0, Height: 32); Text: ""; Style: (FontSize: 12, RenderBold: true, TextColor: #e8e4da, Wrap: true, VerticalAlignment: Center); Visible: false; }
        Label #World { Anchor: (Top: 36, Left: 0, Right: 0, Height: 18); Text: ""; Style: (FontSize: 11, TextColor: #a9b69f, VerticalAlignment: Center); Visible: false; }
        TextField #Coordinates { Anchor: (Top: 58, Left: 0, Right: 0, Height: 26); Style: $A.@PanelInputFieldStyle; PlaceholderStyle: $A.@PanelInputFieldPlaceholderStyle; Background: #181c1a; OutlineColor: #4a5a50; OutlineSize: 1; Padding: (Horizontal: 8); Value: ""; MaxLength: 96; Visible: false; }
        Label #CoordinateLabel { Anchor: (Top: 74, Left: 0, Width: 380, Height: 26); Text: ""; Style: (FontSize: 12, TextColor: #e8e4da, VerticalAlignment: Center); Visible: false; }
        TextButton #CopyButton { Anchor: (Top: 74, Right: 0, Width: 28, Height: 26); Text: ""; Style: $A.@PanelButton; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
