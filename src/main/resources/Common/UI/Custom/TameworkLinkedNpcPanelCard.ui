$A = "TameworkPanelActionStyles.ui";
$C = "Common.ui";

@LinkedActiveStateButtonLabelStyle = LabelStyle(FontSize: 16, RenderBold: true, TextColor: #c2dec8, Alignment: Center);
@LinkedActiveStateOnButtonStyle = TextButtonStyle(Default: (Background: (TexturePath: "Tamework/PanelControls/Toggle_On_Default.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Hovered: (Background: (TexturePath: "Tamework/PanelControls/Toggle_On_Hover.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Pressed: (Background: (TexturePath: "Tamework/PanelControls/Toggle_On_Hover.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Sounds: $C.@ButtonSounds);
@LinkedActiveStateOffButtonStyle = TextButtonStyle(Default: (Background: (TexturePath: "Tamework/PanelControls/Toggle_Off_Default.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Hovered: (Background: (TexturePath: "Tamework/PanelControls/Toggle_Off_Hover.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Pressed: (Background: (TexturePath: "Tamework/PanelControls/Toggle_Off_Hover.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Sounds: $C.@ButtonSounds);
@LinkedActionTooltipStyle = $C.@DefaultTextTooltipStyle;
@LinkedProgressionTooltipStyle = $C.@DefaultTextTooltipStyle;
@TraitTooltipLabelStyle = LabelStyle(FontSize: 1, TextColor: #000000(0.0));
@TraitTooltipButtonStyle = TextButtonStyle(Default: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle), Hovered: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle), Pressed: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle), Disabled: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle));
@ActionCaptionStyle = LabelStyle(FontSize: 10, TextColor: #c8ccc5, HorizontalAlignment: Center, VerticalAlignment: Center);

Group {
    Anchor: (Top: 3, Left: 0, Right: 0, Height: 158);
    Background: #202423;
    OutlineColor: #414845;
    OutlineSize: 1;
    Padding: (Left: 10, Right: 10, Top: 8, Bottom: 8);

    Group { Anchor: (Top: 0, Left: 156, Bottom: 0, Width: 1); Background: #414845; }

    TextButton #ActiveToggleActiveButton { Anchor: (Top: 42, Left: 0, Width: 40, Height: 20); Style: @LinkedActiveStateOnButtonStyle; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.activeEnabled; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
