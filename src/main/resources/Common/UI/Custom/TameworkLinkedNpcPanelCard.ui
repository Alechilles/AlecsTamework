$A = "TameworkPanelActionStyles.ui";
$C = "Common.ui";

@LinkedActiveStateButtonLabelStyle = LabelStyle(FontSize: 16, RenderBold: true, TextColor: #c2dec8, Alignment: Center);
@LinkedActiveStateOnButtonStyle = TextButtonStyle(Default: (Background: (TexturePath: "Tamework/PanelControls/Toggle_On_Default.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Hovered: (Background: (TexturePath: "Tamework/PanelControls/Toggle_On_Hover.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Pressed: (Background: (TexturePath: "Tamework/PanelControls/Toggle_On_Hover.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Sounds: $C.@ButtonSounds);
@LinkedActiveStateOffButtonStyle = TextButtonStyle(Default: (Background: (TexturePath: "Tamework/PanelControls/Toggle_Off_Default.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Hovered: (Background: (TexturePath: "Tamework/PanelControls/Toggle_Off_Hover.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Pressed: (Background: (TexturePath: "Tamework/PanelControls/Toggle_Off_Hover.png"), LabelStyle: @LinkedActiveStateButtonLabelStyle), Sounds: $C.@ButtonSounds);
@LinkedActionTooltipStyle = $C.@DefaultTextTooltipStyle;
@LinkedProgressionTooltipStyle = $C.@DefaultTextTooltipStyle;
@TraitTooltipLabelStyle = LabelStyle(FontSize: 1, TextColor: #000000(0.0));
@TraitTooltipButtonStyle = TextButtonStyle(Default: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle), Hovered: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle), Pressed: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle), Disabled: (Background: (Color: #000000(0.0)), LabelStyle: @TraitTooltipLabelStyle));
@ActionCaptionStyle = LabelStyle(FontSize: 10, TextColor: #c8ccc5, HorizontalAlignment: Center, VerticalAlignment: Center);

@HealthTextNormal = LabelStyle(FontSize: 13, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center);
@HealthTextMuted = LabelStyle(FontSize: 13, RenderBold: true, TextColor: #c0c5c0, HorizontalAlignment: Center, VerticalAlignment: Center);
@HealthTextShadowNormal = LabelStyle(FontSize: 13, RenderBold: true, TextColor: #101510, HorizontalAlignment: Center, VerticalAlignment: Center);
@HealthTextShadowMuted = LabelStyle(FontSize: 13, RenderBold: true, TextColor: #171c17, HorizontalAlignment: Center, VerticalAlignment: Center);
@NeedValueNormal = LabelStyle(FontSize: 9, TextColor: #d3d7cf, HorizontalAlignment: End, VerticalAlignment: Center);
@NeedValueMuted = LabelStyle(FontSize: 9, TextColor: #858b85, HorizontalAlignment: End, VerticalAlignment: Center);
@CooldownTextNormal = LabelStyle(FontSize: 9, TextColor: #d3d7cf);
@CooldownLabelNormal = LabelStyle(FontSize: 9, TextColor: #b9beb8);
@CooldownTextMuted = LabelStyle(FontSize: 9, TextColor: #858b85);
@LifecycleAdultLabel = LabelStyle(FontSize: 9, TextColor: #78bfc1);
@LifecyclePrimeLabel = LabelStyle(FontSize: 9, TextColor: #d9c878);
@LifecycleSeniorLabel = LabelStyle(FontSize: 9, TextColor: #d9a86f);
@PortraitStyle = ItemGridStyle(SlotSize: 92, SlotSpacing: 0, SlotIconSize: 92);
@PortraitCompactStyle = ItemGridStyle(SlotSize: 48, SlotSpacing: 0, SlotIconSize: 48);

Group {
    Anchor: (Top: 3, Left: 0, Right: 0, Height: 176);
    Background: #202423;
    OutlineColor: #414845;
    OutlineSize: 1;
    Padding: (Left: 10, Right: 10, Top: 8, Bottom: 8);

    Group { Anchor: (Top: 36, Left: 156, Bottom: 0, Width: 1); Background: #414845; }

    Group { Anchor: (Top: 26, Left: 0, Right: 36, Height: 1); Background: #343c37; HitTestVisible: false; }

    ItemGrid #Portrait { Anchor: (Top: 28, Left: 28, Width: 92, Height: 92); SlotsPerRow: 1; RenderItemQualityBackground: false; DisplayItemQuantity: false; InfoDisplay: None; Style: @PortraitStyle; HitTestVisible: false; Visible: false; }
    Group #ContributorPortraitStars { Anchor: (Top: 28, Left: 68, Width: 80, Height: 16); HitTestVisible: false; Visible: false;
      Group #ContributorStar1 { Anchor: (Top: 0, Right: 0, Width: 16, Height: 16); Background: (TexturePath: "Tamework/PanelControls/Quality_Star.png"); HitTestVisible: false; Visible: false; }
      Group #ContributorStar2 { Anchor: (Top: 0, Right: 16, Width: 16, Height: 16); Background: (TexturePath: "Tamework/PanelControls/Quality_Star.png"); HitTestVisible: false; Visible: false; }
      Group #ContributorStar3 { Anchor: (Top: 0, Right: 32, Width: 16, Height: 16); Background: (TexturePath: "Tamework/PanelControls/Quality_Star.png"); HitTestVisible: false; Visible: false; }
      Group #ContributorStar4 { Anchor: (Top: 0, Right: 48, Width: 16, Height: 16); Background: (TexturePath: "Tamework/PanelControls/Quality_Star.png"); HitTestVisible: false; Visible: false; }
      Group #ContributorStar5 { Anchor: (Top: 0, Right: 64, Width: 16, Height: 16); Background: (TexturePath: "Tamework/PanelControls/Quality_Star.png"); HitTestVisible: false; Visible: false; }
    }
    TextButton #ActiveToggleActiveButton { Anchor: (Top: 42, Left: 0, Width: 40, Height: 20); Style: @LinkedActiveStateOnButtonStyle; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.activeEnabled; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
    TextButton #ActiveToggleInactiveButton { Anchor: (Top: 42, Left: 0, Width: 40, Height: 20); Style: @LinkedActiveStateOffButtonStyle; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.activeDisabled; TextTooltipStyle: @LinkedActionTooltipStyle; Visible: false; }
    Group #GenderMaleIcon { Anchor: (Top: 1, Left: 34, Width: 22, Height: 22); Background: (TexturePath: "Tamework/LinkedPanelIcons/Gender_Male.png"); Visible: false; }
    Group #GenderFemaleIcon { Anchor: (Top: 1, Left: 34, Width: 22, Height: 22); Background: (TexturePath: "Tamework/LinkedPanelIcons/Gender_Female.png"); Visible: false; }
    Label #Name { Anchor: (Top: 0, Left: 28, Right: 36, Height: 24); Text: %server.tamework.ui.linkedPanel.subtitle.defaultNpcName; Style: (FontSize: 18, RenderBold: true, TextColor: #f0eee7, HorizontalAlignment: Start, VerticalAlignment: Center); }
    Label #RoleSubtitle { Anchor: (Top: 37, Left: 0, Width: 148, Height: 18); Text: ""; Style: (FontSize: 11, TextColor: #afb6b0, VerticalAlignment: Center); Visible: false; }
    Label #StatusUnloaded { Anchor: (Top: 68, Left: 0, Width: 148, Height: 18); Text: %server.tamework.ui.linkedPanel.status.unloaded; Style: (FontSize: 10, RenderBold: true, TextColor: #ffe5b4, HorizontalAlignment: Center, VerticalAlignment: Center); Visible: false; }
    Group #StatusEmblem { Anchor: (Top: 10, Left: 707, Width: 56, Height: 56); Background: "Tamework/StatusEmblems/Unloaded.png"; HitTestVisible: false; Visible: false; }
    TextButton #RemoveButton { Anchor: (Top: 0, Right: 0, Width: 28, Height: 28); Style: $A.@Remove; Text: ""; TooltipText: %server.tamework.ui.linkedPanel.card.tooltip.removalMenu; TextTooltipStyle: @LinkedActionTooltipStyle; }
    Group #RemoveButtonGlyph { Anchor: (Top: 0, Right: 0, Width: 28, Height: 28); Background: (TexturePath: "Tamework/PanelActions/Remove_Glyph_Default.png"); Visible: true; HitTestVisible: false; }

    DropdownBox #GroupSelector { Anchor: (Top: 120, Left: 0, Width: 144, Height: 26); Style: $A.@GroupDropdown; ShowLabel: false; MaxSelection: 1; NoItemsText: %server.tamework.ui.linkedPanel.groupAssign.none; Visible: false; }
    Label #GroupSelectorLabel { Anchor: (Top: 120, Left: 26, Width: 96, Height: 26); Text: ""; Style: (FontSize: 12, TextColor: #d6d9d0, VerticalAlignment: Center); HitTestVisible: false; Visible: false; }
    Group #GroupSelectorMarker { Anchor: (Top: 127, Left: 7, Width: 12, Height: 12); Background: "Tamework/PanelControls/GroupDiamondOutline.png"; HitTestVisible: false; Visible: false; }
    Group #TraitStrip {
        // Traits share the progression row immediately above the health bar.
        Anchor: (Top: 36, Left: 172, Width: 128, Height: 30);
        LayoutMode: Left;
        Group #TraitSlot0 {
            Anchor: (Width: 32, Height: 30); Visible: false;
            Group #TraitBarTrack { Anchor: (Top: 1, Left: 6, Width: 22, Height: 3); Background: #3d4840; }
            Group #RingFillBar1 { Anchor: (Top: 1, Left: 6, Width: 0, Height: 3); Background: #6fc576; }
            Group #TraitIconImage { Anchor: (Top: 5, Left: 6, Width: 22, Height: 22); Background: "Tamework/LinkedPanelIcons/Trait_Disposition.png"; Visible: false; }
            Label #TraitIcon { Anchor: (Top: 4, Left: 5, Width: 24, Height: 24); Text: ""; Style: (FontSize: 18, TextColor: #e8e4da, HorizontalAlignment: Center, VerticalAlignment: Center); }
            TextButton #TraitTooltip { Anchor: (Top: 0, Left: 0, Width: 32, Height: 30); Style: @TraitTooltipButtonStyle; Text: ""; TextTooltipStyle: @LinkedActionTooltipStyle; }
        }
        Group #TraitSlot1 {
            Anchor: (Width: 32, Height: 30); Visible: false;
            Group #TraitBarTrack { Anchor: (Top: 1, Left: 6, Width: 22, Height: 3); Background: #3d4840; }
            Group #RingFillBar1 { Anchor: (Top: 1, Left: 6, Width: 0, Height: 3); Background: #6fc576; }
            Group #TraitIconImage { Anchor: (Top: 5, Left: 6, Width: 22, Height: 22); Background: "Tamework/LinkedPanelIcons/Trait_Disposition.png"; Visible: false; }
            Label #TraitIcon { Anchor: (Top: 4, Left: 5, Width: 24, Height: 24); Text: ""; Style: (FontSize: 18, TextColor: #e8e4da, HorizontalAlignment: Center, VerticalAlignment: Center); }
            TextButton #TraitTooltip { Anchor: (Top: 0, Left: 0, Width: 32, Height: 30); Style: @TraitTooltipButtonStyle; Text: ""; TextTooltipStyle: @LinkedActionTooltipStyle; }
        }
        Group #TraitSlot2 {
            Anchor: (Width: 32, Height: 30); Visible: false;
            Group #TraitBarTrack { Anchor: (Top: 1, Left: 6, Width: 22, Height: 3); Background: #3d4840; }
            Group #RingFillBar1 { Anchor: (Top: 1, Left: 6, Width: 0, Height: 3); Background: #6fc576; }
            Group #TraitIconImage { Anchor: (Top: 5, Left: 6, Width: 22, Height: 22); Background: "Tamework/LinkedPanelIcons/Trait_Disposition.png"; Visible: false; }
            Label #TraitIcon { Anchor: (Top: 4, Left: 5, Width: 24, Height: 24); Text: ""; Style: (FontSize: 18, TextColor: #e8e4da, HorizontalAlignment: Center, VerticalAlignment: Center); }
            TextButton #TraitTooltip { Anchor: (Top: 0, Left: 0, Width: 32, Height: 30); Style: @TraitTooltipButtonStyle; Text: ""; TextTooltipStyle: @LinkedActionTooltipStyle; }
        }
        Group #TraitSlot3 {
            Anchor: (Width: 32, Height: 30); Visible: false;
            Group #TraitBarTrack { Anchor: (Top: 1, Left: 6, Width: 22, Height: 3); Background: #3d4840; }
            Group #RingFillBar1 { Anchor: (Top: 1, Left: 6, Width: 0, Height: 3); Background: #6fc576; }
            Group #TraitIconImage { Anchor: (Top: 5, Left: 6, Width: 22, Height: 22); Background: "Tamework/LinkedPanelIcons/Trait_Disposition.png"; Visible: false; }
            Label #TraitIcon { Anchor: (Top: 4, Left: 5, Width: 24, Height: 24); Text: ""; Style: (FontSize: 18, TextColor: #e8e4da, HorizontalAlignment: Center, VerticalAlignment: Center); }
            TextButton #TraitTooltip { Anchor: (Top: 0, Left: 0, Width: 32, Height: 30); Style: @TraitTooltipButtonStyle; Text: ""; TextTooltipStyle: @LinkedActionTooltipStyle; }
        }
    }
