        TextButton #GroupTabButton {
            Anchor: (Top: 0, Left: 0, Width: 5, Height: 148);
            Style: @TraitTooltipButtonStyle;
            Text: "";
            TooltipText: %server.tamework.ui.linkedPanel.card.group.setTooltip;
            TextTooltipStyle: @LinkedActionTooltipStyle;
        }
    }

